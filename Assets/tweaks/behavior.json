[
  {
    "id": "ads_unwanted",
    "category": "Davranışlar (Behavior)",
    "title": "Otomatik İstenmeyen Uygulama İndirmelerini Kapat",
    "description": "Windows'un arka planda sessizce oyun ve reklam uygulamaları (Candy Crush, TikTok vb.) indirmesini ve Başlat önerilerini engeller.",
    "icon": "DismissCircle24",
    "recommended": true,
    "requiresRestart": false,
    "on": [
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SilentInstalledAppsEnabled",
        "dword": 0
      },
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SystemPaneSuggestionsEnabled",
        "dword": 0
      },
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338388Enabled",
        "dword": 0
      },
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338389Enabled",
        "dword": 0
      }
    ],
    "off": [
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SilentInstalledAppsEnabled",
        "dword": 1
      },
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SystemPaneSuggestionsEnabled",
        "dword": 1
      },
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338388Enabled",
        "dword": 1
      },
      {
        "op": "SetDword",
        "root": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338389Enabled",
        "dword": 1
      }
    ]
  },
  {
    "id": "auto_reg_backup",
    "category": "Davranışlar (Behavior)",
    "title": "Otomatik Kayıt Defteri (RegBack) Yedeklemesini Aktif Et",
    "description": "Windows 10/11'de kapatılan otomatik sistem kovanı (Registry) yedeklemesini System32\\config\\RegBack altında yeniden başlatır.",
    "icon": "Save24",
    "recommended": true,
    "requiresRestart": true,
    "on": [
      {
        "op": "SetDword",
        "root": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Configuration Manager",
        "name": "EnableDirBackup",
        "dword": 1
      }
    ],
    "off": [
      {
        "op": "DeleteValue",
        "root": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Configuration Manager",
        "name": "EnableDirBackup"
      }
    ]
  },
