<UserControl x:Class="Bakım.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        KPI kartı (Fluent 2): simge + etiket + büyük değer + alt açıklama + opsiyonel trend rozeti.
        Responsive: Kapsayıcı Grid sütununa dinamik uyar, metin taşmalarını kırpar (TextTrimming).
    -->

    <Border x:Name="CardBorder"
            RenderTransformOrigin="0.5,0.5">

        <!--
            Fluent kartı: kenarlık her zaman nötr (CardStroke). Anlam (Intent) yalnızca simge rengiyle
            verilir; renkli kenarlık ve fareyle yükselme kullanılmaz. Tıklanabilir kartta zemin bir
            ton açılır; seçili (filtre olarak kullanılan) kartta vurgu kenarlığı seçimi gösterir.
        -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Card.Stroke.Glass}"/>
                <Setter Property="Background" Value="{DynamicResource Card.Fill}"/>
                <Setter Property="BorderThickness" Value="{StaticResource Stroke.Thin}"/>
                <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}"/>
                <Setter Property="Padding" Value="{StaticResource Pad.CardCompact}"/>
                <Style.Triggers>
                    <!-- Özet şeridi içinde: zemin ve çerçeve şeridin, burada yalnızca sol ayırıcı -->
                    <DataTrigger Binding="{Binding IsEmbedded, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Divider.Stroke}"/>
                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                        <Setter Property="CornerRadius" Value="{StaticResource Radius.None}"/>
                        <Setter Property="Padding" Value="20,2,16,2"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEmbedded, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding ShowDivider, ElementName=Root}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,2,16,2"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsInteractive, ElementName=Root}" Value="True">
                        <Setter Property="Cursor" Value="Hand"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsInteractive, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Card.Fill.Hover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Card.Stroke.Glass}"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource Card.Fill.Hover}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Simge + etiket + trend -->
                <RowDefinition Height="Auto"/> <!-- Değer -->
                <RowDefinition Height="Auto"/> <!-- Alt açıklama -->
            </Grid.RowDefinitions>

            <!-- Row 0: Simge + Başlık + Trend Pill -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon FontSize="{StaticResource Icon.SM}"
                                   Margin="{StaticResource Gap.IconText}"
                                   VerticalAlignment="Center"
                                   Symbol="{Binding Icon, ElementName=Root, Converter={StaticResource SafeSymbol}}"
                                   Visibility="{Binding Icon, ElementName=Root, Converter={StaticResource StringToVis}}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Accent">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Success">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Caution">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Critical">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <TextBlock Text="{Binding Label, ElementName=Root}"
                               FontSize="{StaticResource Font.Caption}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Trend / Badge Pill -->
                <Border Grid.Column="1" 
                        CornerRadius="{StaticResource Radius.Pill}"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        Visibility="{Binding TrendText, ElementName=Root, Converter={StaticResource StringToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Caution">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Caution.Subtle}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Critical">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Critical.Subtle}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Accent">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TrendText, ElementName=Root}" 
                               FontSize="{StaticResource Font.Micro}" 
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Success">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Caution">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Critical">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrendIntent, ElementName=Root}" Value="Accent">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Row 1: Değer -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Value, ElementName=Root}"
                       FontSize="{StaticResource Font.Title}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource Gap.Top.XS}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <!-- Row 2: Alt Açıklama -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Caption, ElementName=Root}"
                       FontSize="{StaticResource Font.Caption}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource Gap.Top.XS}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding Caption, ElementName=Root, Converter={StaticResource StringToVis}}"/>
        </Grid>
    </Border>
</UserControl>
