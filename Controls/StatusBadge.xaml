<UserControl x:Class="Bakım.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        Durum rozeti: "Canlı Telemetri Aktif", "Yüksek Risk", "Güvenli" vb.

        ERİŞİLEBİLİRLİK: Rozet her zaman bir simge VEYA nokta gösterir.
        Anlam yalnızca renge bırakılmaz (WCAG 1.4.1 — Renk Kullanımı);
        renk körü kullanıcılar için biçim de ayırt edici olmalıdır.
    -->

    <Border BorderThickness="{StaticResource Stroke.Thin}"
            CornerRadius="{StaticResource Radius.XS}"
            Padding="{StaticResource Pad.Badge}"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Text, ElementName=Root}">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Accent">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Success">
                        <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Caution">
                        <Setter Property="Background" Value="{DynamicResource Brush.Caution.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Critical">
                        <Setter Property="Background" Value="{DynamicResource Brush.Critical.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Simge verilmişse simge, verilmemişse nokta göstergesi -->
            <ui:SymbolIcon FontSize="{StaticResource Icon.XS}"
                           Margin="{StaticResource Gap.IconText}"
                           VerticalAlignment="Center"
                           Symbol="{Binding Icon, ElementName=Root, Converter={StaticResource SafeSymbol}}"
                           Visibility="{Binding Icon, ElementName=Root, Converter={StaticResource StringToVis}}">
                <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Accent">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Success">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Caution">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Caution.Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Critical">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Critical.Text}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:SymbolIcon.Style>
            </ui:SymbolIcon>

            <Ellipse Width="7" Height="7"
                     Margin="{StaticResource Gap.IconText}"
                     VerticalAlignment="Center"
                     Visibility="{Binding Icon, ElementName=Root, Converter={StaticResource InverseStringToVis}}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Accent">
                                <Setter Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Success">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Caution">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Critical">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock Text="{Binding Text, ElementName=Root}"
                       FontSize="{StaticResource Font.Caption}"
                       FontWeight="Medium"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Success">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Caution">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Caution.Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent, ElementName=Root}" Value="Critical">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Critical.Text}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
