<UserControl x:Class="Bakım.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        Her modülün ve kartın tepesinde tekrarlanan başlık bloğu:
        simge + başlık + açıklama, sağda eylem düğmeleri.
        14 modülde elle kopyalanmış ~25 satırlık deseni tek bileşende toplar.
    -->

    <Grid Margin="{Binding HeaderMargin, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <ui:SymbolIcon FontSize="{StaticResource Icon.LG}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Symbol="{Binding Icon, ElementName=Root, Converter={StaticResource SafeSymbol}}"
                               Visibility="{Binding Icon, ElementName=Root, Converter={StaticResource StringToVis}}"/>

                <TextBlock Text="{Binding Title, ElementName=Root}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Varsayılan: kart içi bölüm başlığı -->
                            <Setter Property="FontSize" Value="{StaticResource Font.SectionTitle}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <!-- Modülün en üstündeki sayfa başlığı -->
                                <DataTrigger Binding="{Binding IsPageTitle, ElementName=Root}" Value="True">
                                    <Setter Property="FontSize" Value="{StaticResource Font.TitleLarge}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Başlığın yanındaki canlı rozet / durum kapsülü -->
                <ContentPresenter Content="{Binding TitleAdornment, ElementName=Root}"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding Description, ElementName=Root}"
                       FontSize="{StaticResource Font.BodyLarge}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource Gap.Top.XS}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding Description, ElementName=Root, Converter={StaticResource StringToVis}}"/>
        </StackPanel>

        <!-- Sağ taraf: yenile / dışa aktar gibi eylemler -->
        <ContentPresenter Grid.Column="1"
                          Content="{Binding Actions, ElementName=Root}"
                          VerticalAlignment="Center"
                          Margin="{StaticResource Gap.Right.SM}"/>
    </Grid>
</UserControl>
