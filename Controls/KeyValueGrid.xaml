<UserControl x:Class="Bakım.Controls.KeyValueGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Bakım.Models"
             x:Name="Root">
    <!-- Özellik listesi (§3.5): etiket / değer, kopyala düğmesi, isteğe bağlı eş aralıklı yazı. -->
    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:KeyValueRow}">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding KeyColumnWidth, ElementName=Root}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" FontSize="{StaticResource Font.Body}" VerticalAlignment="Top"
                               TextWrapping="Wrap" Margin="{StaticResource Gap.Right.SM}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource Font.Body}"
                               TextWrapping="Wrap" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonospace, ElementName=Root}" Value="True">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4" VerticalAlignment="Top"
                               Icon="{ui:SymbolIcon Copy16}" ToolTip="Kopyala"
                               Click="OnCopyClicked" Tag="{Binding Value}"
                               AutomationProperties.Name="{Binding Key, StringFormat='{}{0} değerini kopyala'}"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
