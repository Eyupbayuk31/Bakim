<UserControl x:Class="Bakım.Controls.SensorValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        Ölçüm gösterimi (§3.5, D-1'in arayüz tarafı):
          Measured    → "54 °C"
          Estimated   → "≈54 °C" + ipucunda neden
          Unavailable → "—"      + ipucunda neden (uydurma değer ASLA gösterilmez)
    -->
    <TextBlock x:Name="Display"
               Typography.NumeralAlignment="Tabular"
               FontSize="{Binding FontSize, ElementName=Root}"
               FontWeight="{Binding FontWeight, ElementName=Root}"
               Foreground="{Binding Foreground, ElementName=Root}"
               TextTrimming="CharacterEllipsis"/>
</UserControl>
