<UserControl x:Class="Bakım.Controls.StepList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gm="clr-namespace:Bakım.Core.GameMode"
             x:Name="Root"
             Focusable="False">

    <!--
        Durumlu adım listesi (GameModeStep). Her satır: adım simgesi, başlık + ayrıntı, sağda durum.
        Durum hiçbir zaman yalnızca renkle anlatılmaz: simge biçimi de değişir
          Uygulanacak  ✓ halka (vurgu)     Uygulandı  ✓ dolu (başarı)
          Atlanacak    – (üçüncül)         Başarısız  ! (kritik)
    -->

    <ItemsControl ItemsSource="{Binding Steps, ElementName=Root}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type gm:GameModeStep}">
                <Grid Margin="0,0,0,12" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Detail}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" FontSize="20" VerticalAlignment="Top" Margin="0,0,12,0"
                                   Symbol="{Binding Icon, Converter={StaticResource SafeSymbol}}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static gm:GameModeStepState.Skipped}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="{StaticResource Font.Body}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static gm:GameModeStepState.Skipped}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Detail, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="2" FontSize="16" VerticalAlignment="Top" Margin="12,2,0,0">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle16"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="ToolTip" Value="Uygulanacak"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static gm:GameModeStepState.Applied}">
                                        <Setter Property="Filled" Value="True"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        <Setter Property="ToolTip" Value="Uygulandı"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static gm:GameModeStepState.Skipped}">
                                        <Setter Property="Symbol" Value="Subtract16"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter Property="ToolTip" Value="Uygulanmayacak"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static gm:GameModeStepState.Failed}">
                                        <Setter Property="Symbol" Value="ErrorCircle16"/>
                                        <Setter Property="Filled" Value="True"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        <Setter Property="ToolTip" Value="Uygulanamadı"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
