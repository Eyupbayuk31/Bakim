<Application x:Class="Bakım.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Bakım"
             xmlns:conv="clr-namespace:Bakım.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Wpf.Ui Core Dictionaries -->
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>

                <!--
                    TASARIM SİSTEMİ TOKENLARI
                    Sıra önemlidir: palet WPF-UI'dan SONRA gelmeli ki aynı adlı
                    anahtarları gölgeleyebilsin. Çalışma zamanında ThemeService
                    bu anahtarları Application.Resources üzerine doğrudan yazarak
                    tema değişimini yönetir.
                -->
                <ResourceDictionary Source="Themes/Tokens/Palette.Bootstrap.xaml"/>
                <ResourceDictionary Source="Themes/Tokens/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Tokens/Spacing.xaml"/>
                <ResourceDictionary Source="Themes/Tokens/Motion.xaml"/>
                <ResourceDictionary Source="Themes/Tokens/SegmentedControl.xaml"/>
                <ResourceDictionary Source="Themes/Controls/NavItem.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisConverter x:Key="BoolToVis"/>
            <conv:BoolToVisConverter x:Key="InverseBoolToVis" Invert="True"/>
            <conv:BoolToVisConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True"/>
            <conv:BoolToVisConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:ProcessGroupSummaryConverter x:Key="ProcessGroupSummary"/>
            <conv:IntToVisConverter x:Key="IntToVis"/>
            <conv:PercentageToBrushConverter x:Key="PercentageToBrush"/>
            <conv:ImpactLevelToBrushConverter x:Key="ImpactLevelToBrush"/>
            <conv:StringToVisConverter x:Key="StringToVis"/>
            <conv:StringToVisConverter x:Key="InverseStringToVis" Invert="True"/>
            <conv:StringToNavAppearanceConverter x:Key="StringToNavAppearance"/>
            <conv:BoolToNavAppearanceConverter x:Key="BoolToNavAppearance"/>
            <conv:BoolToNavAppearanceConverter x:Key="InverseBoolToNavAppearance" Invert="True"/>
            <conv:SafeSymbolConverter x:Key="SafeSymbol"/>
            <conv:BoolToTextConverter x:Key="GameModeStatusText" TrueText="Açık" FalseText="Kapalı"/>
            <conv:EventLevelToBrushConverter x:Key="EventLevelToBrush"/>
            <conv:CategoryToForegroundConverter x:Key="CategoryToForeground"/>
            <conv:CategoryToBackgroundConverter x:Key="CategoryToBackground"/>
            <conv:IntEqualsToVisConverter x:Key="IntEqualsToVis"/>
            <conv:IntEqualsToVisConverter x:Key="InverseIntEqualsToVis" Invert="True"/>
            <conv:IntEqualsToAppearanceConverter x:Key="IntEqualsToAppearance"/>
            <conv:EntropyToPercentConverter x:Key="EntropyToPercent"/>


            <!--
                Anlamsal fırçalar artık Themes/Tokens/Palette.Bootstrap.xaml içinde
                tanımlanır ve çalışma zamanında ThemeService tarafından yönetilir.
            -->

            <!--
                Tıklanabilir kart (ui:Card). Fluent'te kartlar üzerine gelince yükselmez ve
                vurgu çerçevesi almaz; yalnızca zemin bir ton açılır (SettingsCard davranışı).
            -->
            <Style x:Key="InteractiveCard" TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Global FadeInSlideLeft Page Transition Storyboard -->
            <Storyboard x:Key="FadeInSlideLeft">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                 From="16" To="0" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Application.Resources>
</Application>
