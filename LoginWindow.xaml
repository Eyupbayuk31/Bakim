<ui:FluentWindow x:Class="Bakım.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Bakım"
        xmlns:helpers="clr-namespace:Bakım.Helpers"
        xmlns:vm="clr-namespace:Bakım.ViewModels"
        mc:Ignorable="d"
        Title="Bakım Sistemi - Giriş" 
        MinWidth="420" MinHeight="560"
        Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wpf.Ui Native Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Bakım Giriş Paneli" ShowMaximize="False"/>

        <!-- Center Card Container (Responsive, No fixed Width/Height, No Margin Hacks) -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="28" MaxWidth="380">
            <ui:Card Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- InfoBar Error -->
                        <RowDefinition Height="Auto"/> <!-- Username -->
                        <RowDefinition Height="Auto"/> <!-- Password -->
                        <RowDefinition Height="Auto"/> <!-- Submit Button -->
                        <RowDefinition Height="Auto"/> <!-- Footer Theme Button -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Wpf.Ui SymbolIcon -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Row="0" 
                                HorizontalAlignment="Center" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                BorderThickness="1.5" 
                                CornerRadius="8" 
                                Padding="14" 
                                Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>

                        <TextBlock Grid.Row="1" 
                                   Text="Giriş Yap" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="2" 
                                   Text="Bakım ve Sistem Yönetim Paneli" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" 
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Row 1: Wpf.Ui Native InfoBar for Error Display -->
                    <ui:InfoBar Grid.Row="1" 
                                IsOpen="{Binding HasError}" 
                                Severity="Error" 
                                Title="Giriş Başarısız" 
                                Message="{Binding ErrorMessage}" 
                                Margin="0,0,0,16"/>

                    <!-- Row 2: Username (Wpf.Ui TextBox with VerticalContentAlignment="Center" and Padding="12,10") -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Kullanıcı Adı" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,6"/>

                        <ui:TextBox Grid.Row="1" 
                                    x:Name="TxtUser"
                                    PlaceholderText="Kullanıcı adınızı girin"
                                    Icon="{ui:SymbolIcon Person24}"
                                    ClearButtonEnabled="True"
                                    VerticalContentAlignment="Center"
                                    Padding="12,10"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Row 3: Password (Wpf.Ui PasswordBox with VerticalContentAlignment="Center" and Padding="12,10") -->
                    <Grid Grid.Row="3" Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Şifre" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,6"/>

                        <ui:PasswordBox Grid.Row="1" 
                                        PlaceholderText="Şifrenizi girin"
                                        Icon="{ui:SymbolIcon Key24}"
                                        VerticalContentAlignment="Center"
                                        Padding="12,10"
                                        Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Row 4: Submit Button (Wpf.Ui Button with VerticalContentAlignment="Center") -->
                    <ui:Button Grid.Row="4" 
                               Content="Giriş Yap" 
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowRight24}"
                               HorizontalAlignment="Stretch"
                               VerticalContentAlignment="Center"
                               Padding="16,12"
                               Command="{Binding LoginCommand}" 
                               IsDefault="True"/>

                    <!-- Row 5: Theme Toggle Footer -->
                    <Grid Grid.Row="5" Margin="0,18,0,0">
                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Center" 
                                   VerticalContentAlignment="Center"
                                   Padding="14,8"
                                   Icon="{ui:SymbolIcon DarkTheme24}"
                                   Content="Temayı Değiştir"
                                   Command="{Binding ToggleThemeCommand}"/>
                    </Grid>

                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
