<ui:FluentWindow x:Class="Bakım.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Bakım"
        xmlns:helpers="clr-namespace:Bakım.Helpers"
        xmlns:vm="clr-namespace:Bakım.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Bakım - Giriş" 
        MinWidth="420" MinHeight="580"
        Width="440" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Bakim;component/Assets/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Native Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Bakım" ShowMaximize="False"/>

        <!-- Center Card Container -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="28,10,28,24" MaxWidth="380">
            <ui:Card Padding="28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Brand Header -->
                        <RowDefinition Height="Auto"/> <!-- Segmented Mode Switcher -->
                        <RowDefinition Height="Auto"/> <!-- Status Messages (Error / Success) -->
                        <RowDefinition Height="Auto"/> <!-- Form Fields -->
                        <RowDefinition Height="Auto"/> <!-- Submit Button -->
                        <RowDefinition Height="Auto"/> <!-- Footer Theme Switcher -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: App Brand & Icon Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Width="52" Height="52"
                                CornerRadius="14"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Image Source="pack://application:,,,/Bakim;component/Assets/app.png" 
                                   Width="34" Height="34" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Text="BAKIM" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Sistem Yönetim &amp; Optimizasyon" 
                                   FontSize="11.5" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   Margin="0,3,0,0" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 1: Fluent Segmented Mode Switcher (Giriş Yap / Kayıt Ol) -->
                    <!-- İlk kurulumda gizlenir: henüz giriş yapılabilecek bir hesap yoktur. -->
                    <Border Grid.Row="1"
                            Visibility="{Binding CanSwitchMode, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Giriş Yap Sekmesi -->
                            <ui:Button Grid.Column="0" 
                                       Command="{Binding SwitchToLoginCommand}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalContentAlignment="Center"
                                       Padding="0,7"
                                       CornerRadius="6">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="False">
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PersonKey20" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Giriş Yap" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Kayıt Ol Sekmesi -->
                            <ui:Button Grid.Column="1" 
                                       Command="{Binding SwitchToRegisterCommand}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalContentAlignment="Center"
                                       Padding="0,7"
                                       CornerRadius="6">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PersonAdd20" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kayıt Ol" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- Row 2: Status Messages (Error / Success InfoBars) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <!-- Hata Mesajı -->
                        <ui:InfoBar IsOpen="{Binding HasError}" 
                                    Severity="Error" 
                                    Title="Hata" 
                                    Message="{Binding ErrorMessage}"/>

                        <!-- Başarı Mesajı -->
                        <ui:InfoBar IsOpen="{Binding IsSuccess}" 
                                    Severity="Success" 
                                    Title="Başarılı" 
                                    Message="{Binding SuccessMessage}"/>
                    </StackPanel>

                    <!-- Row 3: Form Input Fields -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <!-- 1. Kullanıcı Adı -->
                        <TextBlock Text="Kullanıcı Adı" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11.5" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="TxtUser"
                                    PlaceholderText="Kullanıcı adınızı girin"
                                    Icon="{ui:SymbolIcon Person20}"
                                    ClearButtonEnabled="True"
                                    VerticalContentAlignment="Center"
                                    Padding="12,9"
                                    Margin="0,0,0,12"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kullanıcı adınızı girin"/>

                        <!-- 2. Şifre -->
                        <TextBlock Text="Şifre" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11.5" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,5"/>
                        <ui:PasswordBox x:Name="TxtPassword"
                                        PlaceholderText="Şifrenizi girin"
                                        Icon="{ui:SymbolIcon Key20}"
                                        VerticalContentAlignment="Center"
                                        Padding="12,9"
                                        Margin="0,0,0,12"/>

                        <!-- 3. Şifre Tekrarı (Sadece Kayıt Ol Modunda Görünür) -->
                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Şifre Tekrarı" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="11.5" 
                                       FontWeight="Medium" 
                                       Margin="0,0,0,5"/>
                            <ui:PasswordBox x:Name="TxtConfirmPassword"
                                            PlaceholderText="Şifrenizi doğrulayın"
                                            Icon="{ui:SymbolIcon CheckmarkCircle20}"
                                            VerticalContentAlignment="Center"
                                            Padding="12,9"
                                            Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- 4. Beni Hatırla (Sadece Giriş Yap Modunda Görünür - Sade & Net) -->
                        <Grid Visibility="{Binding IsRegisterMode, Converter={StaticResource InverseBoolToVis}}" Margin="2,0,0,0">
                            <CheckBox Content="Beni Hatırla" 
                                      IsChecked="{Binding RememberMe}"
                                      FontSize="11.5"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Row 4: Submit Button -->
                    <ui:Button Grid.Row="4" 
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               VerticalContentAlignment="Center"
                               Padding="16,10"
                               Height="42"
                               Command="{Binding SubmitCommand}" 
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               IsDefault="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding SubmitButtonText}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Row 5: Footer (Theme Switcher & Sürüm) -->
                    <Grid Grid.Row="5" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent"
                                       VerticalContentAlignment="Center"
                                       Padding="8,4"
                                       Icon="{ui:SymbolIcon DarkTheme20}"
                                       Content="Temayı Değiştir"
                                       AutomationProperties.Name="Uygulama temasını değiştir"
                                       Command="{Binding ToggleThemeCommand}"
                                       FontSize="11"/>

                            <!-- Kurtarma: yerel kilidi unutan kullanıcı uygulamadan dışlanmaz. -->
                            <ui:Button Appearance="Transparent"
                                       VerticalContentAlignment="Center"
                                       Padding="8,4"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding CanSwitchMode, Converter={StaticResource BoolToVis}}"
                                       Icon="{ui:SymbolIcon ArrowReset20}"
                                       Content="Hesapları Sıfırla"
                                       ToolTip="Bu cihazdaki yerel Bakım hesaplarını siler ve kurulumu yeniden başlatır."
                                       AutomationProperties.Name="Bu cihazdaki yerel hesapları sıfırla"
                                       Command="{Binding ResetAccountsCommand}"
                                       FontSize="11"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="v3.1.0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
