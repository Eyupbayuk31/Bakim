<ui:FluentWindow x:Class="Bakım.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Bakım"
        xmlns:helpers="clr-namespace:Bakım.Helpers"
        xmlns:vm="clr-namespace:Bakım.ViewModels"
        mc:Ignorable="d"
        Title="Bakım - Giriş ve Yetkilendirme" 
        MinWidth="440" MinHeight="620"
        Width="460" Height="660"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Native Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Bakım Sistemi" ShowMaximize="False"/>

        <!-- 2. Center Card Container -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="28,10,28,24" MaxWidth="390">
            <ui:Card Padding="28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & App Icon -->
                        <RowDefinition Height="Auto"/> <!-- Segmented Mode Switcher -->
                        <RowDefinition Height="Auto"/> <!-- Status Messages (Error / Success) -->
                        <RowDefinition Height="Auto"/> <!-- Form Fields -->
                        <RowDefinition Height="Auto"/> <!-- Submit Button -->
                        <RowDefinition Height="Auto"/> <!-- Footer Theme Button -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: App Brand & Icon Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Width="56" Height="56"
                                CornerRadius="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Image Source="pack://application:,,,/Assets/app.png" 
                                   Width="38" Height="38" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Text="BAKIM SİSTEMİ" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Güvenli Yönetim ve Optimizasyon Paneli" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   Margin="0,2,0,0" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 1: Fluent Segmented Mode Switcher (Giriş Yap / Kayıt Ol) -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="3" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Giriş Yap Sekmesi -->
                            <ui:Button Grid.Column="0" 
                                       Command="{Binding SwitchToLoginCommand}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalContentAlignment="Center"
                                       Padding="0,7"
                                       CornerRadius="6">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="False">
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PersonKey20" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Giriş Yap" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Kayıt Ol Sekmesi -->
                            <ui:Button Grid.Column="1" 
                                       Command="{Binding SwitchToRegisterCommand}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalContentAlignment="Center"
                                       Padding="0,7"
                                       CornerRadius="6">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PersonAdd20" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kayıt Ol" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- Row 2: Status Messages (Error / Success InfoBars) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <!-- Hata Mesajı -->
                        <ui:InfoBar IsOpen="{Binding HasError}" 
                                    Severity="Error" 
                                    Title="İşlem Başarısız" 
                                    Message="{Binding ErrorMessage}"/>

                        <!-- Başarı Mesajı -->
                        <ui:InfoBar IsOpen="{Binding IsSuccess}" 
                                    Severity="Success" 
                                    Title="Başarılı" 
                                    Message="{Binding SuccessMessage}"/>
                    </StackPanel>

                    <!-- Row 3: Form Input Fields -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <!-- 1. Kullanıcı Adı -->
                        <TextBlock Text="Kullanıcı Adı" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11.5" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="TxtUser"
                                    PlaceholderText="Kullanıcı adınızı girin"
                                    Icon="{ui:SymbolIcon Person24}"
                                    ClearButtonEnabled="True"
                                    VerticalContentAlignment="Center"
                                    Padding="12,9"
                                    Margin="0,0,0,12"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 2. Şifre -->
                        <TextBlock Text="Şifre" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11.5" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,6"/>
                        <ui:PasswordBox x:Name="TxtPassword"
                                        PlaceholderText="Şifrenizi girin"
                                        Icon="{ui:SymbolIcon Key24}"
                                        VerticalContentAlignment="Center"
                                        Padding="12,9"
                                        Margin="0,0,0,12"/>

                        <!-- 3. Şifre Tekrarı (Sadece Kayıt Ol Modunda Görünür) -->
                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Şifre Tekrarı" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="11.5" 
                                       FontWeight="Medium" 
                                       Margin="0,0,0,6"/>
                            <ui:PasswordBox x:Name="TxtConfirmPassword"
                                            PlaceholderText="Şifrenizi doğrulayın"
                                            Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                            VerticalContentAlignment="Center"
                                            Padding="12,9"
                                            Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- 4. Beni Hatırla (Sadece Giriş Yap Modunda Görünür) -->
                        <Grid Visibility="{Binding IsRegisterMode, Converter={StaticResource InverseBoolToVis}}" Margin="2,0,0,4">
                            <CheckBox Content="Beni Hatırla (Windows DPAPI Korumalı)" 
                                      IsChecked="{Binding RememberMe}"
                                      FontSize="11.5"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Row 4: Submit Button -->
                    <ui:Button Grid.Row="4" 
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               VerticalContentAlignment="Center"
                               Padding="16,11"
                               Command="{Binding SubmitCommand}" 
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               IsDefault="True">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Giriş Yap"/>
                                <Setter Property="Icon" Value="{ui:SymbolIcon ArrowRight24}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="Content" Value="Hesap Oluştur ve Kaydol"/>
                                        <Setter Property="Icon" Value="{ui:SymbolIcon PersonAdd24}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Row 5: Footer (Theme Switcher) -->
                    <Grid Grid.Row="5" Margin="0,16,0,0">
                        <ui:Button Appearance="Transparent" 
                                   HorizontalAlignment="Center" 
                                   VerticalContentAlignment="Center"
                                   Padding="12,6"
                                   Icon="{ui:SymbolIcon DarkTheme24}"
                                   Content="Temayı Değiştir"
                                   Command="{Binding ToggleThemeCommand}"
                                   FontSize="11"/>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
