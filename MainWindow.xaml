<ui:FluentWindow x:Class="Bakım.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Bakım"
        xmlns:vm="clr-namespace:Bakım.ViewModels"
        xmlns:modules="clr-namespace:Bakım.Views.Modules"
        xmlns:models="clr-namespace:Bakım.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Bakım - Sistem Temizlik ve Optimizasyon" 
        MinWidth="1020" MinHeight="680"
        Width="1280" Height="840"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Bakim;component/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenCommandPaletteCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Implicit DataTemplates for Modular MVVM View Mapping -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <modules:DashboardModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanerViewModel}">
            <modules:CleanerModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizerViewModel}">
            <modules:OptimizerModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <modules:StartupModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
            <modules:SystemInfoModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkMonitorViewModel}">
            <modules:NetworkMonitorModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServiceManagerViewModel}">
            <modules:ServiceManagerModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyDebloatViewModel}">
            <modules:PrivacyDebloatModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CrashAnalyzerViewModel}">
            <modules:CrashAnalyzerModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UninstallerViewModel}">
            <modules:UninstallerModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyzerViewModel}">
            <modules:AnalyzerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsTweakerViewModel}">
            <modules:WindowsTweakerModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <modules:SettingsModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StoreViewModel}">
            <modules:StoreModuleView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Main Body (Sidebar + Content Viewport) -->
        </Grid.RowDefinitions>

        <!-- Wpf.Ui Native Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Bakım - Sistem Yönetim Paneli" Icon="{ui:SymbolIcon Shield24}">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Live Mini Telemetry Chip (CPU / RAM) -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="8,3" 
                            Margin="0,0,8,0"
                            ToolTip="Anlık Sistem Yükü (Canlı CPU &amp; RAM)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="CPU: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding MiniCpuText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>

                            <ui:SymbolIcon Symbol="TopSpeed20" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="RAM: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding MiniRamText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Ultra Game Mode TitleBar Toggle -->
                    <ui:Button Appearance="{Binding IsGameModeActive, Converter={StaticResource BoolToNavAppearance}}" 
                               Padding="8,3"
                               Command="{Binding ToggleGameModeCommand}"
                               Margin="0,0,8,0"
                               ToolTip="Ultra Oyun Modu: Arka plan servislerini dondurur, RAM'i temizler ve Güç Planını Maksimum Performansa kilitler"
                               Icon="{ui:SymbolIcon TopSpeed20}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮 Oyun Modu: " FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="AÇIK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding IsGameModeActive, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="KAPALI" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsGameModeActive, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Command Palette (Ctrl+K) Button -->
                    <ui:Button Appearance="Secondary" 
                               Padding="10,3"
                               Command="{Binding OpenCommandPaletteCommand}"
                               Margin="0,0,8,0"
                               ToolTip="Hızlı Arama &amp; Komut Paleti (Ctrl+K)"
                               Icon="{ui:SymbolIcon Search20}"
                               Content="Ara (Ctrl+K)"/>

                    <!-- UAC Admin Badge -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="8,3" 
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Shield20" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="Yetki: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Yönetici" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Standart" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Elevate to Admin Button (If not admin) -->
                    <ui:Button Appearance="Secondary" 
                               Padding="8,3"
                               Command="{Binding RestartAsAdminCommand}"
                               Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"
                               Margin="0,0,8,0"
                               Content="Yönetici Ol"
                               Icon="{ui:SymbolIcon ShieldKeyhole20}"/>

                    <!-- Theme Switcher -->
                    <ui:Button Appearance="Secondary" 
                               Padding="8,3"
                               Command="{Binding ToggleThemeCommand}" 
                               Margin="0,0,8,0" 
                               ToolTip="Açık / Koyu Tema"
                               Icon="{ui:SymbolIcon DarkTheme20}" AutomationProperties.Name="Açık / Koyu Tema"/>

                    <!-- Current Windows User Badge -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Person20" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Main Body: Fluent Collapsible Sidebar + Dynamic Content Host -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Collapsible Navigation Sidebar (64px to 260px) -->
                <ColumnDefinition Width="*"/>   <!-- Active Module Content Viewport -->
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (Collapsible Drawer with 300ms CubicEaseOut Animation) -->
            <Border x:Name="NavSidebar"
                    Grid.Column="0" 
                    Width="260"
                    ClipToBounds="True"
                    Background="Transparent" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,1,0" 
                    Padding="10,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                             <DoubleAnimation Storyboard.TargetProperty="Width" 
                                                              To="64" 
                                                              Duration="0:0:0.3">
                                                 <DoubleAnimation.EasingFunction>
                                                     <CubicEase EasingMode="EaseOut"/>
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </DataTrigger.EnterActions>
                                 <DataTrigger.ExitActions>
                                     <BeginStoryboard>
                                         <Storyboard>
                                             <DoubleAnimation Storyboard.TargetProperty="Width" 
                                                              To="260" 
                                                              Duration="0:0:0.3">
                                                 <DoubleAnimation.EasingFunction>
                                                     <CubicEase EasingMode="EaseOut"/>
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </DataTrigger.ExitActions>
                             </DataTrigger>
                         </Style.Triggers>
                     </Style>
                 </Border.Style>
 
                 <Grid>
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto"/> <!-- Hamburger & Brand Header -->
                         <RowDefinition Height="*"/>    <!-- Scrollable Navigation Items List -->
                         <RowDefinition Height="Auto"/> <!-- Bottom Status Card -->
                     </Grid.RowDefinitions>
 
                     <!-- Top Hamburger & Brand Header -->
                     <Grid Grid.Row="0" Margin="0,0,0,14">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         
                         <!-- Hamburger Toggle Button -->
                         <ui:Button Grid.Column="0" 
                                    Appearance="Secondary"
                                    Padding="8,8"
                                    Width="42" Height="40"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="Menüyü Daralt / Genişlet"
                                    Icon="{ui:SymbolIcon Navigation24}" AutomationProperties.Name="Menüyü Daralt / Genişlet"/>
 
                         <!-- Brand Title (Visible only when Expanded) -->
                         <Grid Grid.Column="1" 
                               Margin="10,0,0,0" 
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                             <StackPanel>
                                  <TextBlock Text="BAKIM v3.17.5" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                 <TextBlock Text="Sistem Optimize &amp; Güvenlik" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                             </StackPanel>
                         </Grid>
                     </Grid>

                    <!-- Scrollable Navigation Items List -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel Margin="0,0,4,0">
                            <!-- 1. Dashboard Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Dashboard'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Dashboard"
                                       Icon="{ui:SymbolIcon Home24}"
                                       ToolTip="Genel Bakış">
                                <TextBlock Text="Genel Bakış" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 2. Cleaner Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Cleaner'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Cleaner"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       ToolTip="Sistem Temizliği">
                                <TextBlock Text="Sistem Temizliği" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 3. Optimizer Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Optimizer'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Optimizer"
                                       Icon="{ui:SymbolIcon TopSpeed24}"
                                       ToolTip="RAM &amp; Süreçler">
                                <TextBlock Text="RAM &amp; Süreçler" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 4. Startup Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Startup'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Startup"
                                       Icon="{ui:SymbolIcon Apps24}"
                                       ToolTip="Başlangıç Programları">
                                <TextBlock Text="Başlangıç Programları" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 5. System Info Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='SystemInfo'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="SystemInfo"
                                       Icon="{ui:SymbolIcon Desktop24}"
                                       ToolTip="Donanım &amp; Disk">
                                <TextBlock Text="Donanım &amp; Disk" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 6. Network Monitor Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Network'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Network"
                                       Icon="{ui:SymbolIcon Globe24}"
                                       ToolTip="Ağ &amp; Port İzleyici">
                                <TextBlock Text="Ağ &amp; Port İzleyici" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 7. Services & Driver Manager Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='ServiceManager'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="ServiceManager"
                                       Icon="{ui:SymbolIcon DeveloperBoard24}"
                                       ToolTip="Hizmet &amp; Sürücüler">
                                <TextBlock Text="Hizmet &amp; Sürücüler" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 8. Crash Analyzer & Event Logs Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='CrashAnalyzer'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="CrashAnalyzer"
                                       Icon="{ui:SymbolIcon HeartPulse24}"
                                       ToolTip="Olay Günlüğü &amp; Sağlık">
                                <TextBlock Text="Olay Günlüğü &amp; Sağlık" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 10. Smart Uninstaller Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Uninstaller'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Uninstaller"
                                       Icon="{ui:SymbolIcon Apps24}"
                                       ToolTip="Program Kaldırıcı">
                                <TextBlock Text="Program Kaldırıcı" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 11. Yazılım & Runtimes Mağazası Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Store'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Store"
                                       Icon="{ui:SymbolIcon AppsAddIn24}"
                                       ToolTip="Yazılım &amp; Runtimes Mağazası">
                                <TextBlock Text="Yazılım &amp; Runtimes" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 12. Analizör — Kalıcılık & Dosya Röntgeni Modülü -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Analyzer'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Analyzer"
                                       Icon="{ui:SymbolIcon ShieldTask24}"
                                       ToolTip="Analizör — Kalıcılık &amp; Dosya Röntgeni">
                                <TextBlock Text="Analizör" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 12. Windows Tweaker Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Tweaker'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Tweaker"
                                       Icon="{ui:SymbolIcon Wrench24}"
                                       ToolTip="Windows Tweaker &amp; İnce Ayarlar">
                                <TextBlock Text="Windows Tweaker" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>

                            <!-- 12. Settings Module Button -->
                            <ui:Button Appearance="{Binding CurrentNavKey, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Settings'}"
                                       HorizontalAlignment="Stretch" 
                                       HorizontalContentAlignment="Left"
                                       Padding="10,8" 
                                       Margin="0,0,0,4"
                                       Command="{Binding NavigateCommand}" 
                                       CommandParameter="Settings"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       ToolTip="Ayarlar">
                                <TextBlock Text="Ayarlar" 
                                           Margin="6,0,0,0" 
                                           VerticalAlignment="Center" 
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </ui:Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Security Card (Visible only when Expanded) -->
                    <ui:Card Grid.Row="2" 
                             Padding="12,9" 
                             Margin="0,8,0,0"
                             Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Sistem Koruması: Aktif" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Kritik sistem dosyaları güvende" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Border>

            <!-- Dynamic Module Content Host (Pure MVVM DataTemplate View Switcher) -->
            <ContentControl Grid.Column="1" 
                            Content="{Binding CurrentView}" 
                            HorizontalContentAlignment="Stretch" 
                            VerticalContentAlignment="Stretch"/>

            <!-- Floating Toast Notifications Host (Bottom-Right) -->
            <ItemsControl Grid.Column="1"
                          ItemsSource="{Binding ActiveToasts}" 
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Bottom" 
                          Margin="0,0,24,24"
                          Panel.ZIndex="100">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ToastNotificationItem}">
                        <ui:Card Padding="14,10"
                                 Margin="0,0,0,8"
                                 MinWidth="320"
                                 MaxWidth="420"
                                 BorderBrush="{DynamicResource Brush.Accent}"
                                 BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" 
                                               Symbol="{Binding IconName, Converter={StaticResource SafeSymbol}}" 
                                               FontSize="18" 
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ui:Button Grid.Column="2" 
                                           Appearance="Transparent" 
                                           Padding="4"
                                           Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Dismiss20}"
                                           ToolTip="Kapat" AutomationProperties.Name="Kapat"/>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Global Command Palette Modal (Raycast / Linear Ctrl+K) -->
        <Grid Grid.RowSpan="2"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource Brush.Overlay.Scrim}"
              Panel.ZIndex="999">
            <Grid.InputBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}"/>
            </Grid.InputBindings>

            <!-- Centered Floating Solid Card (No Mica transparency bleed) -->
            <Border MaxWidth="640"
                    MaxHeight="540"
                    Padding="0"
                    VerticalAlignment="Top"
                    Margin="24,80,24,0"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Search Header -->
                        <RowDefinition Height="Auto"/>  <!-- Separator -->
                        <RowDefinition Height="*"/>     <!-- Results List -->
                        <RowDefinition Height="Auto"/>  <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- ═══ Row 0: Search Header ═══ -->
                    <Grid Grid.Row="0" Margin="16,14,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Search24"
                                       FontSize="20"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                        <ui:TextBox Grid.Column="1"
                                    PlaceholderText="Sayfa, ayar veya komut ara... (Örn: RAM, Temizle)"
                                    Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                    ClearButtonEnabled="True"
                                    FontSize="14"
                                    Padding="0,6"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalContentAlignment="Center" AutomationProperties.Name="Sayfa, ayar veya komut ara... (Örn: RAM, Temizle)">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ExecuteCommandCommand}"
                                            CommandParameter="{Binding SelectedCommand}"/>
                                <KeyBinding Key="Down"
                                            Command="{Binding SelectNextCommandCommand}"/>
                                <KeyBinding Key="Up"
                                            Command="{Binding SelectPreviousCommandCommand}"/>
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>

                        <ui:Button Grid.Column="2"
                                   Appearance="Transparent"
                                   Padding="6,4"
                                   Margin="8,0,0,0"
                                   Command="{Binding CloseCommandPaletteCommand}"
                                   Icon="{ui:SymbolIcon Dismiss20}"
                                   ToolTip="Kapat (Esc)" AutomationProperties.Name="Kapat (Esc)"/>
                    </Grid>

                    <!-- ═══ Row 1: Separator ═══ -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Margin="0,0,0,4"/>

                    <!-- ═══ Row 2: Results List ═══ -->
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding FilteredCommands}"
                              SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                              MaxHeight="400"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="6,4"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.InputBindings>
                            <KeyBinding Key="Return"
                                        Command="{Binding ExecuteCommandCommand}"
                                        CommandParameter="{Binding SelectedCommand}"/>
                        </ListView.InputBindings>

                        <!-- Item container with selection styling -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemContainerBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    BorderThickness="1"
                                                    BorderBrush="Transparent"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemContainerBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CommandPaletteItem}">
                                <Button Command="{Binding DataContext.ExecuteCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,8"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- Colored Icon Box -->
                                            <ColumnDefinition Width="*"/>     <!-- Title + Desc -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Shortcut Pill -->
                                        </Grid.ColumnDefinitions>

                                        <!-- ── Colored Icon Box ── -->
                                        <Border Grid.Column="0"
                                                Width="38" Height="38"
                                                CornerRadius="9"
                                                Background="{Binding Category, Converter={StaticResource CategoryToBackground}}"
                                                BorderBrush="{Binding Category, Converter={StaticResource CategoryToForeground}}"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding IconName, Converter={StaticResource SafeSymbol}}"
                                                           FontSize="17"
                                                           Foreground="{Binding Category, Converter={StaticResource CategoryToForeground}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- ── Title + Category Pill + Description ── -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">

                                            <!-- Title row + category pill -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Category Pill -->
                                                <Border CornerRadius="10"
                                                        Padding="7,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Category, Converter={StaticResource CategoryToBackground}}"
                                                        BorderBrush="{Binding Category, Converter={StaticResource CategoryToForeground}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding Category, Converter={StaticResource CategoryToForeground}}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- ── Keyboard Shortcut Pill ── -->
                                        <Border Grid.Column="2"
                                                CornerRadius="5"
                                                Padding="7,3"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding KeyboardShortcut, Converter={StaticResource StringToVis}}">
                                            <TextBlock Text="{Binding KeyboardShortcut}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- ═══ Row 3: Footer ═══ -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,8"
                            CornerRadius="0,0,12,12">
                        <Grid>
                            <!-- Left: Keyboard hints -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="↑↓" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Text="Seçin" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="Enter" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Text="Aç" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="Esc" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Text="Kapat" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Right: Brand -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Search24" FontSize="11"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Margin="0,0,4,0"/>
                                <TextBlock Text="Bakım Komut Paleti"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
