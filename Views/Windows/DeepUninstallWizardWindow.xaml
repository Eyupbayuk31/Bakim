<Window x:Class="Bakım.Views.Windows.DeepUninstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:Bakım.Models"
        Title="Bakım • Kaldırma ve Kalıntı Temizleme Asistanı"
        Width="880" Height="680"
        MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <!-- Solid Fluent 2 Slate Dark Container with Rounded Corners & Deep Glow -->
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="14"
            MouseDown="Window_MouseDown"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.85" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Stepper Breadcrumb -->
                <RowDefinition Height="*"/>    <!-- Wizard Step Content -->
                <RowDefinition Height="Auto"/> <!-- Global Status Line -->
            </Grid.RowDefinitions>

            <!-- 0. Custom Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30"
                            CornerRadius="7"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Delete24"
                                       FontSize="16"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Bakım • Gelişmiş Kaldırma ve Kalıntı Temizleme Asistanı"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Close / Dismiss Button -->
                <ui:Button Grid.Column="2"
                           Appearance="Transparent"
                           Padding="8,5"
                           Command="{Binding SkipCleanupCommand}"
                           Icon="{ui:SymbolIcon Dismiss20}"
                           ToolTip="Kapat ve İptal Et"
                           AutomationProperties.Name="Kapat"/>
            </Grid>

            <!-- 1. Stepper Breadcrumb Indicator -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Margin="0,0,6,0">
                            <TextBlock Text="1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Hazırlık" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight20" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                    <!-- Step 2 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                Margin="0,0,6,0">
                            <TextBlock Text="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Kaldırma" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="3" Symbol="ArrowRight20" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                    <!-- Step 3 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                Margin="0,0,6,0">
                            <TextBlock Text="3" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tarama" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="5" Symbol="ArrowRight20" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                    <!-- Step 4 -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                Margin="0,0,6,0">
                            <TextBlock Text="4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Kalıntı Seçimi" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="7" Symbol="ArrowRight20" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                    <!-- Step 5 -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                Margin="0,0,6,0">
                            <TextBlock Text="5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Rapor" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Wizard Body Content (Controlled by StepNumber) -->
            <Grid Grid.Row="2">

                <!-- ========================================================= -->
                <!-- STEP 1: Program Analysis & Preparation                    -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding StepNumber, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Info Card -->
                        <RowDefinition Height="*"/>    <!-- Options & Safeguards -->
                        <RowDefinition Height="Auto"/> <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- App Info Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- App Icon -->
                            <Border Grid.Column="0"
                                    Width="56" Height="56"
                                    CornerRadius="12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding TargetApp.IconSource}"
                                           Width="38" Height="38"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding TargetApp.IconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <ui:SymbolIcon Symbol="Apps24"
                                                   FontSize="28"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding TargetApp.IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- App Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppName}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Border CornerRadius="4"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="6,2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayVersion}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Publisher}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,3,0,4"/>

                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Folder20" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding InstallLocation}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="480"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Size Pill -->
                            <Border Grid.Column="2"
                                    CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="12,8"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tahmini Boyut" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Safeguard Options Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Kaldırma ve Güvenlik Tercihleri"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- Restore Point Option -->
                            <CheckBox IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}"
                                      Margin="0,0,0,12"
                                      Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Windows Geri Yükleme Noktası Oluştur (Önerilen)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Kaldırma öncesinde sistem kararlılığını garantiye almak için geri dönüş noktası alır (~15 sn)."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- Kill Processes Option -->
                            <CheckBox IsChecked="{Binding KillRelatedProcesses, Mode=TwoWay}"
                                      Margin="0,0,0,12"
                                      Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="İlişkili Çalışan Süreçleri Otomatik Kapat"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Uygulamanın arka planda kilitli dosya bırakmaması için açık süreçlerini güvenle sonlandırır."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- Backup Registry Option -->
                            <CheckBox IsChecked="{Binding BackupRegistryBeforeClean, Mode=TwoWay}"
                                      Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Kayıt Defteri Temizliği Öncesinde .reg Yedeği Al"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Silinecek kayıt defteri anahtarlarını yerel yedek dosyasına kaydeder; dilediğiniz an geri yükleyebilirsiniz."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Footer Action Bar -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="1"
                                   Content="Programı Kaldır ve Kalıntıları Tara"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Delete20}"
                                   Command="{Binding StartUninstallCommand}"
                                   Padding="24,10"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Grid>

                <!-- ========================================================= -->
                <!-- STEP 2: Official Uninstaller Running                     -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding StepNumber, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="500">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="54" Height="54"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                         Margin="0,0,0,20"/>

                        <TextBlock Text="Resmi Kaldırıcı Çalışıyor..."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Lütfen programın açılan penceresindeki kaldırma adımlarını tamamlayın. Kaldırıcı kapandığında Bakım otomatik olarak sistem kalıntılarını taramaya başlayacaktır."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LiveProcessStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- STEP 3: Deep Residual Scanning                           -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding StepNumber, Converter={StaticResource IntEqualsToVis}, ConverterParameter=3}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="500">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="54" Height="54"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                         Margin="0,0,0,20"/>

                        <TextBlock Text="Derin Sistem Kalıntıları Taranıyor..."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Kaldırıcı kapandı. Kayıt defteri (HKLM, HKCU, Classes), AppData klasörleri ve yetim kısayollar taranıyor..."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LiveProcessStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- STEP 4: Kaldırma Başarılı & İnteraktif Kalıntı Yönetimi   -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding StepNumber, Converter={StaticResource IntEqualsToVis}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Success Banner -->
                        <RowDefinition Height="Auto"/> <!-- Toolbar (Search & Category Filter) -->
                        <RowDefinition Height="*"/>    <!-- Leftovers List (Virtualizing) -->
                        <RowDefinition Height="Auto"/> <!-- Actions Footer -->
                    </Grid.RowDefinitions>

                    <!-- Success Banner -->
                    <Border Grid.Row="0"
                            Background="#1010B981"
                            BorderBrush="#4010B981"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="CheckmarkCircle24"
                                           FontSize="26"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text=" Başarıyla Kaldırıldı!" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Sistemde bulunan artık kalıntılar listelenmiştir. Silinmesini istemediğiniz ögelerin işaretini kaldırabilirsiniz:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Toolbar (Search & Category Filter) -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Master Select -->
                                <ColumnDefinition Width="Auto"/> <!-- Category RadioButtons -->
                                <ColumnDefinition Width="*"/>    <!-- Search Box -->
                                <ColumnDefinition Width="Auto"/> <!-- Safe Only -->
                                <ColumnDefinition Width="Auto"/> <!-- Summary Badge -->
                            </Grid.ColumnDefinitions>

                            <!-- Master Checkbox -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                      Command="{Binding ToggleSelectAllCommand}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Cursor="Hand">
                                <TextBlock Text="Tümü" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </CheckBox>

                            <!-- Category Filter Tabs -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <RadioButton Content="Tümü"
                                             GroupName="WizardCategory"
                                             IsChecked="True"
                                             Command="{Binding SetFilterCommand}"
                                             CommandParameter="All"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             Margin="0,0,8,0"
                                             Cursor="Hand"/>
                                <RadioButton Content="Kayıt Defteri"
                                             GroupName="WizardCategory"
                                             Command="{Binding SetFilterCommand}"
                                             CommandParameter="Registry"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                             Margin="0,0,8,0"
                                             Cursor="Hand"/>
                                <RadioButton Content="Klasörler"
                                             GroupName="WizardCategory"
                                             Command="{Binding SetFilterCommand}"
                                             CommandParameter="Folders"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                             Margin="0,0,8,0"
                                             Cursor="Hand"/>
                                <RadioButton Content="Dosyalar"
                                             GroupName="WizardCategory"
                                             Command="{Binding SetFilterCommand}"
                                             CommandParameter="Files"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                             Cursor="Hand"/>
                            </StackPanel>

                            <!-- Search Box -->
                            <ui:TextBox Grid.Column="2"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Kalıntılarda filtrele (yol, anahtar, ad)..."
                                        Icon="{ui:SymbolIcon Search20}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"/>

                            <!-- Safe Only Button -->
                            <ui:Button Grid.Column="3"
                                       Content="Yalnızca Güvenliler"
                                       Appearance="Secondary"
                                       Command="{Binding SelectSafeOnlyCommand}"
                                       Padding="8,4"
                                       FontSize="11.5"
                                       Margin="0,0,10,0"/>

                            <!-- Count Badge -->
                            <Border Grid.Column="4"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                                    <TextBlock Text="/" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"/>
                                    <TextBlock Text=" Kalıntı" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Leftovers Virtualized List -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <ListBox ItemsSource="{Binding FilteredResiduals}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="2,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ResidualItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Checkbox (Şunu silme seçimi) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Type Badge -->
                                            <ColumnDefinition Width="*"/>    <!-- Path & Info -->
                                            <ColumnDefinition Width="Auto"/> <!-- Size & Risk -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Context Menu -->
                                        <Grid.ContextMenu>
                                            <ContextMenu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <MenuItem Header="Konumu Gezginde Göster"
                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                          Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Yolu Panoya Kopyala"
                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                          Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Cursor="Hand"
                                                  ToolTip="İşareti kaldırarak bu kalıntının silinmesini önleyebilirsiniz"/>

                                        <!-- Type Badge -->
                                        <Border Grid.Column="1"
                                                CornerRadius="5"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="6,3"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeName}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>

                                        <!-- Path & Description -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Path}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Size & Risk Badge -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <Border CornerRadius="4"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskBadgeText}"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           FontSize="10.5"
                                                           FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Step 4 Footer Actions -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection Summary -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Temizlenecek Alan: " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding FormattedSelectedSize}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text=" (" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding SelectedCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text=" Öğe)" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ui:Button Content="Atla ve Temizleme"
                                       Appearance="Secondary"
                                       Command="{Binding SkipCleanupCommand}"
                                       Padding="16,8"
                                       Margin="0,0,10,0"/>

                            <ui:Button Content="Seçilen Kalıntıları Temizle"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Delete20}"
                                       Command="{Binding CleanSelectedResidualsCommand}"
                                       Padding="20,8"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ========================================================= -->
                <!-- STEP 5: Temizlik Tamamlandı Raporu                       -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding StepNumber, Converter={StaticResource IntEqualsToVis}, ConverterParameter=5}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="540">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="#1510B981"
                                BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                BorderThickness="2"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,18">
                            <ui:SymbolIcon Symbol="Checkmark24"
                                           FontSize="32"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Sistem Başarıyla Temizlendi!"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Uygulamaya ait tüm yetim dosyalar ve kayıt defteri anahtarları güvenle temizlendi."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,22"/>

                        <!-- KPI Summary Cards -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Temizlenen Kalıntı" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CleanedCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Kurtarılan Disk Alanı" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedCleanedSize}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Registry Backup Information -->
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Visibility="{Binding HasRegistryBackup, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Kayıt Defteri Yedeği Alındı" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding RegistryBackupFilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           Content="Yedeği Göster"
                                           Appearance="Secondary"
                                           Command="{Binding OpenBackupFolderCommand}"
                                           Padding="8,4"
                                           FontSize="11.5"/>
                            </Grid>
                        </Border>

                        <ui:Button Content="Tamamla ve Kapat"
                                   Appearance="Primary"
                                   Command="{Binding CloseCommand}"
                                   HorizontalAlignment="Center"
                                   Padding="30,10"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- 3. Global Status Bar -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,4,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
