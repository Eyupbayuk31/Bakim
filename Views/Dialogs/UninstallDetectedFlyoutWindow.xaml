<Window x:Class="Bakım.Views.Dialogs.UninstallDetectedFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Program kaldırıldı"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Loaded="OnWindowLoaded">

    <!-- Bakım dışından kaldırılan program için kalıntı önerisi (Kurulum Nöbetçisi bildirimiyle aynı dil). -->
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource Divider.Stroke}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.XL}"
            Padding="18"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource Color.Shadow}"/>
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource Radius.MD}"
                        Margin="0,0,12,0" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="AppIcon" Width="24" Height="24" Visibility="Collapsed"/>
                        <ui:SymbolIcon x:Name="FallbackIcon" Symbol="Delete24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Program kaldırıldı" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="AppNameText" Text="Uygulama" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" VerticalAlignment="Top"
                           Click="OnDismissClicked" ToolTip="Kapat" AutomationProperties.Name="Kapat">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>
            </Grid>

            <TextBlock x:Name="DetailText"
                       Margin="0,12,0,0"
                       Text="Windows'tan kaldırıldı. Geride dosya, kayıt defteri anahtarı, hizmet ya da zamanlanmış görev kalmış olabilir."
                       FontSize="{StaticResource Font.Caption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" LineHeight="18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Appearance="Secondary" Content="Şimdi değil" Padding="12,6" Margin="0,0,8,0" Click="OnDismissClicked"/>
                <ui:Button Appearance="Primary" Padding="12,6" Click="OnScanClicked" Icon="{ui:SymbolIcon Search24}" Content="Kalıntıları tara"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
