<Window x:Class="Bakım.Views.Dialogs.SetupDetectedFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Kurulum Nöbetçisi"
        Width="440" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Loaded="OnWindowLoaded">

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
            BorderThickness="1.5"
            CornerRadius="{StaticResource Radius.XL}"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 1. ACTIVE MONITORING STATE -->
            <Grid x:Name="MonitoringPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource Radius.MD}"
                                Padding="8"
                                Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kurulum Nöbetçisi Devrede" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border x:Name="FlyoutProtectionBadge" Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="{StaticResource Radius.XS}" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FlyoutProtectionText" Text="Tam Koruma" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="MonitoringAppNameText" Text="Yeni Yazılım Kurulumu İzleniyor..." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Appearance="Transparent"
                               Padding="6"
                               Click="OnDismissClicked"
                               ToolTip="Arka Plana Al"
                               VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </ui:Button>
                </Grid>

                <!-- Status Body -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,12">
                    <TextBlock Text="Kurulum süreci ve alt süreçler izleniyor. Sisteme eklenen dosyalar, kayıt defteri anahtarları ve servisler anlık olarak yakalanmaktadır."
                               FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"/>

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- Bottom Status -->
                <Grid Grid.Row="2">
                    <TextBlock x:Name="MonitoringStatusDetailText" Text="Canlı dosya sistemi ve kayıt defteri nöbetçisi aktif" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <ui:Button Appearance="Secondary" Content="Arka Planda İzle" HorizontalAlignment="Right" Padding="12,6" Click="OnDismissClicked"/>
                </Grid>
            </Grid>

            <!-- 2. INSTALLATION FINISHED & THREAT SCAN PROMPT STATE -->
            <Grid x:Name="FinishedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource Radius.MD}"
                                Padding="8"
                                Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kurulum Tamamlandı" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="FinishedAppNameText" Text="Uygulama Adı" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Appearance="Transparent"
                               Padding="6"
                               Click="OnDismissClicked"
                               ToolTip="Kapat"
                               VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </ui:Button>
                </Grid>

                <!-- Body & Summary Pills -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                    <TextBlock Text="Kurulan dosyalar Analizör ile güvenlik, dijital imza ve VirusTotal taramasından geçirilsin mi?"
                               FontSize="{StaticResource Font.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"/>

                    <!-- Risk / Triage Summary Row (Faz 0 Hızlı Kazanım) -->
                    <Border x:Name="RiskSummaryCard"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.SM}"
                            Padding="8,5"
                            Margin="0,8,0,2"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="QuickRiskSummaryText"
                                       Text="Risk analizi hazırlandı"
                                       FontSize="{StaticResource Font.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric Badges Row -->
                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="8,4"
                                Margin="0,0,6,6">
                            <TextBlock x:Name="FilesBadgeText" Text="+0 Dosya" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="8,4"
                                Margin="0,0,6,6">
                            <TextBlock x:Name="ExecutablesBadgeText" Text="+0 Yürütülebilir" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="8,4"
                                Margin="0,0,6,6">
                            <TextBlock x:Name="RegistryBadgeText" Text="+0 Kayıt Defteri" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="8,4"
                                Margin="0,0,6,6">
                            <TextBlock x:Name="SizeBadgeText" Text="0 MB" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Actions -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Appearance="Secondary"
                               Click="OnInspectDeltaClicked"
                               Padding="10,6"
                               ToolTip="Tüm dosya ve kayıt defteri listesini inceleyin">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="İncele" FontSize="{StaticResource Font.Caption}"/>
                        </StackPanel>
                    </ui:Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary"
                                   Content="Raporu Kaydet"
                                   Padding="10,6"
                                   Margin="0,0,8,0"
                                   Click="OnSaveReportClicked"/>

                        <ui:Button Appearance="Primary"
                                   Click="OnAnalyzeThreatClicked"
                                   Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shield24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Analizör ile Tara" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
