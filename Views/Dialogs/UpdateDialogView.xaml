<ui:FluentWindow x:Class="Bakım.Views.Dialogs.UpdateDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Yeni güncelleme mevcut"
        Width="540" Height="480"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Bakim;component/Assets/app.ico"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">

    <Border Background="Transparent"
            Padding="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Version Badges -->
                <RowDefinition Height="*"/>    <!-- Release Notes -->
                <RowDefinition Height="Auto"/> <!-- Progress -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Close -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                            CornerRadius="{StaticResource Radius.MD}" 
                            Padding="8" 
                            Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yeni sürüm güncellemesi!" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Bakım için yeni performans ve güvenlik paketi yayınlandı." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" 
                           Appearance="Transparent" 
                           Padding="6" 
                           Click="OnCloseClicked" 
                           ToolTip="Kapat"
                           VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>
            </Grid>

            <!-- 2. Version Badges -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <!-- Current Version Badge -->
                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="{StaticResource Radius.SM}" 
                        Padding="10,6" 
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mevcut: " FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="CurrentVersionText" Text="" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <ui:SymbolIcon Symbol="ArrowRight16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Latest Version Badge -->
                <Border Background="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                        CornerRadius="{StaticResource Radius.SM}" 
                        Padding="10,6" 
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Yeni sürüm: " FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource ApplicationBackgroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LatestVersionText" Text="v2.6.0" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource ApplicationBackgroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- File Size Badge -->
                <Border x:Name="SizeBadge" 
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="{StaticResource Radius.SM}" 
                        Padding="10,6">
                    <TextBlock x:Name="SizeText" Text="45.8 MB" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- 3. Release Notes Card -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource Radius.MD}" 
                    Padding="14" 
                    Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Değişiklik notları (Changelog):" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReleaseNotesText" 
                                   Text="Yükleniyor..." 
                                   FontSize="{StaticResource Font.Caption}" 
                                   TextWrapping="Wrap" 
                                   LineHeight="18" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 4. Download Progress Section (Hidden initially) -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="StatusLabel" Text="Güncelleme paketi indiriliyor..." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="PercentageLabel" Text="%0" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- 5. Action Buttons -->
            <Grid Grid.Row="4">
                <!-- Action Group -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button x:Name="LaterButton" 
                               Appearance="Secondary" 
                               Click="OnLaterClicked" 
                               Content="Daha sonra" 
                               Margin="0,0,10,0"/>

                    <ui:Button x:Name="UpdateButton" 
                               Appearance="Primary" 
                               Click="OnUpdateNowClicked" 
                               Content="Hemen güncelle" 
                               Icon="{ui:SymbolIcon ArrowSync24}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
