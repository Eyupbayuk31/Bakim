<Window x:Class="Bakım.Views.Dialogs.HunterActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Avcı Modu - Hedef Eylemleri"
        Width="520" Height="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <!-- 100% Solid, Fully Opaque Slate Dark Surface (Zero Background Bleed) -->
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource Radius.XL}"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.9" Color="{DynamicResource Color.Shadow}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Target Info Card -->
                <RowDefinition Height="*"/>    <!-- Action Buttons -->
                <RowDefinition Height="Auto"/> <!-- Footer / Cancel -->
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Target24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Avcı Modu - Hedef Yakalandı" FontSize="{StaticResource Font.Subtitle}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Seçilen hedef üzerinde gerçekleştirmek istediğiniz işlemi seçin" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Appearance="Transparent"
                           HorizontalAlignment="Right"
                           Padding="6,4"
                           Click="Cancel_Click"
                           Icon="{ui:SymbolIcon Dismiss20}"
                           ToolTip="Kapat" AutomationProperties.Name="Kapat"/>
            </Grid>

            <!-- 1. Target Details Card (Solid Deep Slate #0F172A) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.LG}"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0" 
                            Width="52" Height="52" 
                            CornerRadius="{StaticResource Radius.MD}" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="TargetAppIcon" 
                                   Width="36" Height="36" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <ui:SymbolIcon x:Name="FallbackIcon" 
                                           Symbol="Apps24" 
                                           FontSize="28" 
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Info Texts -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDisplayName" Text="Uygulama Adı" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="TxtProcessInfo" Text="chrome.exe (PID: 1234)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtMatchStatus" Text=" • [Kayıtlı Program]" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtExePath" 
                                   Text="C:\Program Files\..." 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Actions List (High Contrast Solid Buttons) -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <!-- Action 1: Standard Uninstall -->
                <ui:Button Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Padding="16,12"
                           Margin="0,0,0,10"
                           Click="Uninstall_Click"
                           Icon="{ui:SymbolIcon Delete24}">
                    <ui:Button.Content>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Uygulamayı Kaldır (Uninstall)" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Resmi kaldırma sihirbazını başlatır ve ardından artık dosyaları temizler" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ui:Button.Content>
                </ui:Button>

                <!-- Action 2: Force Uninstall -->
                <ui:Button Appearance="Secondary"
                           HorizontalAlignment="Stretch"
                           Padding="16,12"
                           Margin="0,0,0,10"
                           Click="ForceUninstall_Click"
                           Icon="{ui:SymbolIcon Broom24}">
                    <ui:Button.Content>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Zorla Kaldır (Force Uninstall)" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            <TextBlock Text="Kaldırıcıyı beklemeden süreci kapatır, tüm klasör ve kayıt defteri artıklarını zorla söker" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ui:Button.Content>
                </ui:Button>

                <!-- 3 Column Row for Secondary Actions -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Action 3: Threat Analysis -->
                    <ui:Button Grid.Column="0"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="8,10"
                               Click="ThreatAnalysis_Click"
                               Icon="{ui:SymbolIcon ShieldKeyhole20}">
                        <ui:Button.Content>
                            <TextBlock Text="Tehdit Analizi" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </ui:Button.Content>
                    </ui:Button>

                    <!-- Action 4: Kill Process -->
                    <ui:Button Grid.Column="2"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="8,10"
                               Click="KillProcess_Click"
                               Icon="{ui:SymbolIcon Stop20}">
                        <ui:Button.Content>
                            <TextBlock Text="Süreci Kapat" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </ui:Button.Content>
                    </ui:Button>

                    <!-- Action 5: Open File Location -->
                    <ui:Button Grid.Column="4"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="8,10"
                               Click="OpenFileLocation_Click"
                               Icon="{ui:SymbolIcon FolderOpen20}">
                        <ui:Button.Content>
                            <TextBlock Text="Konumu Aç" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </ui:Button.Content>
                    </ui:Button>
                </Grid>
            </StackPanel>

            <!-- 3. Footer Cancel -->
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <ui:Button Appearance="Transparent"
                           HorizontalAlignment="Right"
                           Padding="18,6"
                           Click="Cancel_Click"
                           Content="Vazgeç"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
