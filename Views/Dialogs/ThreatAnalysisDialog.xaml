<ui:FluentWindow x:Class="Bakım.Views.Dialogs.ThreatAnalysisDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
                 xmlns:models="clr-namespace:Bakım.Models"
                 xmlns:vm="clr-namespace:Bakım.ViewModels"
                 xmlns:c="clr-namespace:Bakım.Controls"
                 xmlns:local="clr-namespace:Bakım.Views.Dialogs"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ThreatAnalysisViewModel}"
                 Title="Dosya analizi"
                 Width="940" Height="780"
                 MinWidth="820" MinHeight="640"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Bakim;component/Assets/app.ico">

    <!--
        v3.11 yeniden yazım notları
        ===========================
        • Eski sürüm `Window` + AllowsTransparency="True" kullanıyordu. Bu, Mica
          arka planıyla birlikte ÇALIŞMAZ ve WPF'i yazılım render'a düşürür —
          ekran görüntüsündeki kopuk mor çerçevenin sebebi buydu.
          Artık ui:FluentWindow + Mica, uygulamanın geri kalanıyla aynı dil.
        • Alt buton çubuğu 6 sabit butondan oluşuyordu ve "Kapat" pencere
          kenarından taşıp kırpılıyordu. Artık 3 birincil buton + taşma menüsü.
        • Tüm renkler tema token'larından gelir; hiçbir hex kod yoktur.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Dosya analizi"
                     ShowMaximize="True"
                     ShowMinimize="False"
                     Icon="{ui:SymbolIcon ShieldTask24}"/>

        <!-- İçerik ortak görünümdedir (Analizör'de sayfa içi de kullanılır) -->
        <local:ThreatAnalysisView Grid.Row="1"/>
    </Grid>
</ui:FluentWindow>
