<Window x:Class="Bakım.Views.Dialogs.ThreatAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:Bakım.Models"
        Title="Sezgisel AI Tehdit &amp; Risk Analizörü"
        Width="780" Height="700"
        MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <!-- 100% Solid, Fully Opaque Slate Dark Surface (Zero Background Bleed) -->
    <Border Background="#1E293B"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.9" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Risk Score & Overview Card -->
                <RowDefinition Height="Auto"/> <!-- Active Process Alert Banner -->
                <RowDefinition Height="*"/>    <!-- Detailed Analysis Factors -->
                <RowDefinition Height="Auto"/> <!-- Recommendation Box -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="10"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shield24" FontSize="24" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sezgisel Tehdit &amp; Güvenlik Analizi"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                        <TextBlock Text=" • AI Heuristic Engine"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#38BDF8"
                                   Margin="6,1,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding FilePath}"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"
                               ToolTip="{Binding FilePath}"/>
                </StackPanel>

                <ui:Button Grid.Column="2"
                           Appearance="Transparent"
                           Padding="6,4"
                           Command="{Binding CloseCommand}"
                           Icon="{ui:SymbolIcon Dismiss20}"
                           ToolTip="Kapat"/>
            </Grid>

            <!-- 1. Risk Score & Overview Card -->
            <Border Grid.Row="1"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Risk Gauge / Meter Box -->
                    <Border Grid.Column="0"
                            Width="150" Height="100"
                            CornerRadius="10"
                            Background="{Binding RiskBackgroundBrush}"
                            BorderBrush="{Binding RiskColor}"
                            BorderThickness="2"
                            Padding="12"
                            Margin="0,0,18,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="RİSK SKORU"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RiskScore, StringFormat='%{0}'}"
                                       FontSize="30"
                                       FontWeight="Black"
                                       Foreground="{Binding RiskColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,2"/>
                            <Border CornerRadius="4"
                                    Background="#20000000"
                                    Padding="6,2"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RiskLevelText}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding RiskColor}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Technical Overview Grid -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dijital İmza -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Dijital Sertifika" FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Result.DigitalSignatureText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- VirusTotal -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="VirusTotal Taraması" FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Result.VirusTotalSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Entropi -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Shannon Entropi" FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Result.EntropyText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Dosya Boyutu & Hash -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="Boyut &amp; Mimari" FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Result.FileSizeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. Active Process Alert Banner (Visible only if process is running) -->
            <Border Grid.Row="2"
                    Background="#25EF4444"
                    BorderBrush="#EF4444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasActiveProcess, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Warning20" FontSize="18" Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DİKKAT: Bu dosya şu anda sistem belleğinde aktif olarak çalışıyor!"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"/>
                        <TextBlock Text="{Binding ActiveProcessId, StringFormat='Süreç Kimliği (PID): {0}'}"
                                   FontSize="11"
                                   Foreground="#FCA5A5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               Appearance="Danger"
                               Content="Süreci Sonlandır"
                               Icon="{ui:SymbolIcon Dismiss20}"
                               Command="{Binding KillProcessCommand}"
                               Padding="12,6"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Detailed Analysis Factors List -->
            <Border Grid.Row="3"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Neden Tehdit Olabilir? (Tespit Edilen Güvenlik Faktörleri)"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               Margin="8,6,8,8"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Result.Factors}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="2,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ThreatFactor}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity Badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="6"
                                            Background="{Binding SeverityBackground}"
                                            BorderBrush="{Binding SeverityColor}"
                                            BorderThickness="1"
                                            Padding="6,3"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SeverityBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SeverityColor}"/>
                                    </Border>

                                    <!-- Title & Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Score Impact -->
                                    <Border Grid.Column="2"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScoreImpact, StringFormat='+%{0} Risk'}"
                                                   FontSize="10.5"
                                                   FontWeight="Medium"
                                                   Foreground="{Binding SeverityColor}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 4. Recommendation Box -->
            <Border Grid.Row="4"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Info20" FontSize="18" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sistem Güvenlik Tavsiyesi:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding Recommendation}" FontSize="11.5" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Footer Actions -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Helper Actions: Konum, VT, Kopyala -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               ToolTip="Dosyayı Windows Gezgininde Göster"
                               Icon="{ui:SymbolIcon Folder20}"
                               Command="{Binding OpenLocationCommand}"
                               Padding="10,6"
                               Margin="0,0,6,0"/>

                    <ui:Button Appearance="Secondary"
                               Content="VirusTotal"
                               Icon="{ui:SymbolIcon Globe20}"
                               Command="{Binding OpenVirusTotalCommand}"
                               Padding="10,6"
                               Margin="0,0,6,0"/>

                    <ui:Button Appearance="Secondary"
                               Content="Raporu Kopyala"
                               Icon="{ui:SymbolIcon Copy20}"
                               Command="{Binding CopyReportCommand}"
                               Padding="10,6"/>
                </StackPanel>

                <!-- Right Remediation Actions: Başlangıçtan Kaldır, Zorla Sil, Kapat -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Content="Başlangıçtan Kaldır"
                               Icon="{ui:SymbolIcon Power20}"
                               Command="{Binding DisableStartupCommand}"
                               Visibility="{Binding CanDisableStartup, Converter={StaticResource BoolToVis}}"
                               Padding="12,6"
                               Margin="0,0,6,0"/>

                    <ui:Button Appearance="Danger"
                               Content="Zorla Sil &amp; Sahiplik Al"
                               Icon="{ui:SymbolIcon Delete20}"
                               Command="{Binding DeleteFileCommand}"
                               Padding="12,6"
                               Margin="0,0,8,0"/>

                    <ui:Button Appearance="Primary"
                               Content="Kapat"
                               Command="{Binding CloseCommand}"
                               Padding="18,6"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
