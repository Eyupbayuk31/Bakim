<Window x:Class="Bakım.Views.Dialogs.HunterTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Avcı Modu (Hunter Mode)"
        Width="260" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
            BorderThickness="2"
            CornerRadius="16"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Close -->
                <RowDefinition Height="*"/>    <!-- Draggable Crosshair -->
                <RowDefinition Height="Auto"/> <!-- Hint text -->
            </Grid.RowDefinitions>

            <!-- Title & Close -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Target24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="Avcı Modu" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <ui:Button Appearance="Transparent"
                           HorizontalAlignment="Right"
                           Padding="4,2"
                           Click="CloseButton_Click"
                           Icon="{ui:SymbolIcon Dismiss20}"
                           ToolTip="Kapat"/>
            </Grid>

            <!-- Draggable Crosshair Target -->
            <Border Grid.Row="1"
                    x:Name="TargetCrosshair"
                    Width="80" Height="80"
                    CornerRadius="40"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="2"
                    Cursor="Cross"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="TargetCrosshair_MouseLeftButtonDown"
                    MouseLeftButtonUp="TargetCrosshair_MouseLeftButtonUp"
                    MouseMove="TargetCrosshair_MouseMove">
                <Grid>
                    <ui:SymbolIcon Symbol="Target24" 
                                   FontSize="40" 
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Instructions -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Hedefi bir pencereye veya simgeye sürükleyip bırakın"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
