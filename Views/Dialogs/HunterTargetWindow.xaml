<Window x:Class="Bakım.Views.Dialogs.HunterTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Avcı modu"
        Width="180" Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
            BorderThickness="2"
            CornerRadius="24"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.7" Color="{DynamicResource Color.Shadow}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Center Target -->
                <RowDefinition Height="Auto"/> <!-- Footer Hint -->
            </Grid.RowDefinitions>

            <!-- 0. Header (Title & Close) -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Target24" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Avcı modu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <ui:Button Appearance="Transparent"
                           HorizontalAlignment="Right"
                           Padding="4,2"
                           Click="CloseButton_Click"
                           Icon="{ui:SymbolIcon Dismiss16}"
                           ToolTip="Avcı modunu kapat" AutomationProperties.Name="Avcı Modunu Kapat"/>
            </Grid>

            <!-- 1. Center Interactive Draggable Target -->
            <Border Grid.Row="1"
                    x:Name="TargetCrosshair"
                    Width="84" Height="84"
                    CornerRadius="42"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="2.5"
                    Cursor="Cross"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Basılı tutun ve hedef pencereye sürükleyin"
                    MouseLeftButtonDown="TargetCrosshair_MouseLeftButtonDown"
                    MouseLeftButtonUp="TargetCrosshair_MouseLeftButtonUp"
                    MouseMove="TargetCrosshair_MouseMove">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource Color.Accent}" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <!-- Concentric Rings for High-Tech Reticle -->
                    <Ellipse Width="56" Height="56" Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="1" Opacity="0.5"/>
                    <Ellipse Width="32" Height="32" Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="1.5" Opacity="0.8"/>
                    <ui:SymbolIcon Symbol="Target24" 
                                   FontSize="36" 
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 2. Footer Hint -->
            <TextBlock Grid.Row="2"
                       Text="Pencereye sürükleyin"
                       FontSize="{StaticResource Font.Micro}"
                       FontWeight="Medium"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </Grid>
    </Border>
</Window>
