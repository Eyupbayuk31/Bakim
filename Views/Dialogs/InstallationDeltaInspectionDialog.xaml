<ui:FluentWindow x:Class="Bakım.Views.Dialogs.InstallationDeltaInspectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:Bakım.Controls"
        mc:Ignorable="d"
        Title="Kurulum değişiklikleri raporu"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">

    <Border Background="Transparent"
            Padding="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header -->
                <RowDefinition Height="Auto"/> <!-- 1. KPI Cards -->
                <RowDefinition Height="Auto"/> <!-- 2. Search & Filter -->
                <RowDefinition Height="*"/>    <!-- 3. Tab Content -->
                <RowDefinition Height="Auto"/> <!-- 4. Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 0. Header & Window Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource Radius.MD}"
                            Padding="10"
                            Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Document24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitleText" Text="Kurulum değişiklikleri raporu" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border x:Name="ProtectionStatusBadge" Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="{StaticResource Radius.XS}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProtectionStatusText" Text="Tam koruma modu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DialogSubtitleText" Text="Sistem izleme detayları" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Padding="6"
                           Click="OnCloseClicked"
                           ToolTip="Kapat"
                           VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>
            </Grid>

            <!-- 1. KPI Metrics Row -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Files Card -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Eklenen dosyalar" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="KpiFilesText" Text="0" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Executables Card -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Yürütülebilir (.exe / .dll)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="KpiExecutablesText" Text="0" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Registry Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Kayıt Defteri girdileri" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="KpiRegistryText" Text="0" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Services Card -->
                <Border Grid.Column="3" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Servis ve başlangıç" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="KpiServicesText" Text="0" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Search & Real-time Filter -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Padding="10,7"
                         TextChanged="OnSearchBoxTextChanged"
                         Tag="Dosya yolu veya anahtar adı ile filtreleyin..."
                         FontSize="{StaticResource Font.Caption}"/>

                <TextBlock Grid.Column="1"
                           x:Name="FilteredCountText"
                           Text="Tüm kayıtlar gösteriliyor"
                           FontSize="{StaticResource Font.Caption}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>

            <!-- 3. Tabs & Content Lists -->
            <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
                <!-- Tab 0: Özet (Nöbetçi v2: karar, bulgular, kurulum dosyası) -->
                <TabItem Header="Özet" IsSelected="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,0">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <c:RiskBadge x:Name="VerdictBadge" Level="Clean" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="VerdictText" Text="Değerlendirilmedi" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="VerdictDetailText" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="FindingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Content="{Binding ActionLabel}" Tag="{Binding}" Click="OnFindingActionClicked"
                                                       IsEnabled="{Binding CanAct}"
                                                       Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                                       AutomationProperties.Name="{Binding ActionLabel}"/>
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                    <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Technique, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ResultText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Kurulum dosyası" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <TextBlock x:Name="InstallerInfoText" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 1: Added Files -->
                <TabItem Header="Eklenen dosyalar">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.MD}"
                            ClipToBounds="True">
                        <ListView x:Name="FilesListView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                                    CornerRadius="{StaticResource Radius.XS}"
                                                    Padding="6,2"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding FullPath}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Secondary"
                                                           Padding="8,4"
                                                           Margin="0,0,6,0"
                                                           ToolTip="Dosya konumunu aç"
                                                           Tag="{Binding FullPath}"
                                                           Click="OnOpenFolderForFileClicked">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14"/>
                                                </ui:Button>

                                                <ui:Button Appearance="Primary"
                                                           Padding="8,4"
                                                           ToolTip="Analizör ile Güvenlik Taraması Yap"
                                                           Tag="{Binding FullPath}"
                                                           Click="OnAnalyzeSingleFileClicked">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Shield24" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Analiz et" FontSize="{StaticResource Font.Caption}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </TabItem>

                <!-- Tab 2: Registry Changes -->
                <TabItem Header="Kayıt Defteri">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.MD}"
                            ClipToBounds="True">
                        <ListView x:Name="RegistryListView"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                                    CornerRadius="{StaticResource Radius.XS}"
                                                    Padding="6,2"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Hive}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KeyPath}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Details}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </TabItem>

                <!-- Tab 3: Services & Autorun -->
                <TabItem Header="Servisler ve başlangıç">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.MD}"
                            ClipToBounds="True">
                        <ListView x:Name="ServicesListView"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PathOrKey}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </TabItem>

                <!-- Tab 4: Sistem alanları (NÖB 2.3/2.5) -->
                <TabItem Header="Sistem">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.MD}"
                            ClipToBounds="True">
                        <ListView x:Name="SystemListView"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                        <StackPanel>
                                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Area, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Kind, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Key}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Key}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- 4. Footer Actions -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="SandboxPreviewButton"
                               Appearance="Secondary"
                               Click="OnSandboxPreviewClicked"
                               Padding="12,7"
                               Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Sandbox'ta önizle" FontSize="{StaticResource Font.Caption}"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Click="OnExportJsonClicked"
                               Padding="12,7"
                               Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="JSON olarak dışa aktar" FontSize="{StaticResource Font.Caption}"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Click="OnOpenFolderClicked"
                               Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Klasörde göster" FontSize="{StaticResource Font.Caption}"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Appearance="Primary"
                               Click="OnAnalyzeAllExecutablesClicked"
                               Padding="14,7"
                               Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Tüm yürütülebilirleri Analizörde tara" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Content="Kapat"
                               Padding="14,7"
                               Click="OnCloseClicked"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
