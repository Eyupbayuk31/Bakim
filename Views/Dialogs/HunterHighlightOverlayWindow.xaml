<Window x:Class="Bakım.Views.Dialogs.HunterHighlightOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="HunterOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Left="0" Top="0" Width="100" Height="100"
        Visibility="Collapsed">

    <Grid>
        <!-- Glowing Neon Target Frame -->
        <Border x:Name="TargetFrame"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="3"
                CornerRadius="6"
                Background="{DynamicResource Brush.Accent.Subtle}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Accent}" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
            </Border.Effect>
        </Border>

        <!-- Floating HUD Header at Top-Left of Window -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8,8,0,0"
                Background="{DynamicResource Brush.Overlay.Scrim}"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="10,6">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Shadow}" BlurRadius="12" ShadowDepth="3" Opacity="0.7"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon x:Name="HudIcon" Symbol="Target24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock x:Name="HudTitle" Text="Hedef Tespit Edildi" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="HudSubtitle" Text="PID: ---" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
