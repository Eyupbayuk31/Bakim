<Window x:Class="Bakım.Views.Dialogs.ResidualCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:Bakım.Models"
        Title="Kalıntı Temizleme Asistanı"
        Width="740" Height="620"
        MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <!-- 100% Solid, Fully Opaque Slate Dark Surface (Zero Background Bleed) -->
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
            BorderThickness="1.5"
            CornerRadius="{StaticResource Radius.XL}"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.85" Color="{DynamicResource Color.Shadow}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filter & Selection Toolbar -->
                <RowDefinition Height="*"/>    <!-- Residual Items List -->
                <RowDefinition Height="Auto"/> <!-- Progress / Status Bar -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="{StaticResource Radius.LG}"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="ImgAppIcon"
                               Width="30" Height="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <ui:SymbolIcon x:Name="FallbackIcon"
                                       Symbol="Delete24"
                                       FontSize="24"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AppName}"
                                   FontSize="{StaticResource Font.Subtitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="450"/>
                        <TextBlock Text=" • Kalıntı Temizleyici"
                                   FontSize="{StaticResource Font.Subtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Kaldırma işlemi bitti. Sistemde kalan artık klasör, dosya ve kayıt defteri girdileri bulundu."
                               FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <ui:Button Grid.Column="2"
                           Appearance="Transparent"
                           Padding="6,4"
                           Command="{Binding CancelCommand}"
                           Icon="{ui:SymbolIcon Dismiss20}"
                           ToolTip="Kapat ve Atla" AutomationProperties.Name="Kapat ve Atla"/>
            </Grid>

            <!-- 1. Filter & Selection Toolbar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="12,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master Checkbox -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAllSelected, Mode=TwoWay}" AutomationProperties.Name="Tüm kalıntıları seç"
                              Command="{Binding ToggleSelectAllCommand}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Cursor="Hand">
                        <TextBlock Text="Tümünü Seç / Kaldır"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontSize="{StaticResource Font.Caption}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Padding="6,0,0,0"/>
                    </CheckBox>

                    <!-- Category Filter Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton Content="Tümü"
                                     GroupName="ResidualCategory"
                                     IsChecked="True"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="All"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Margin="0,0,10,0"
                                     Cursor="Hand"/>
                        <RadioButton Content="Klasörler"
                                     GroupName="ResidualCategory"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Folders"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                     Margin="0,0,10,0"
                                     Cursor="Hand"/>
                        <RadioButton Content="Dosyalar"
                                     GroupName="ResidualCategory"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Files"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                     Margin="0,0,10,0"
                                     Cursor="Hand"/>
                        <RadioButton Content="Kayıt Defteri"
                                     GroupName="ResidualCategory"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Registry"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                     Cursor="Hand"/>
                    </StackPanel>

                    <!-- Selection Summary -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.SM}"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="{StaticResource Font.Caption}"/>
                            <TextBlock Text="/" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="{StaticResource Font.Caption}"/>
                            <TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="{StaticResource Font.Caption}"/>
                            <TextBlock Text=" Kalıntı" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="{StaticResource Font.Caption}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Residual Items List (Virtualized) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="4">
                <ListBox ItemsSource="{Binding FilteredResiduals}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="2,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource Radius.SM}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ResidualItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                    <ColumnDefinition Width="Auto"/> <!-- Type Badge / Icon -->
                                    <ColumnDefinition Width="*"/>    <!-- Path & Info -->
                                    <ColumnDefinition Width="Auto"/> <!-- Size & Risk Badge -->
                                </Grid.ColumnDefinitions>

                                <!-- Context Menu -->
                                <Grid.ContextMenu>
                                    <ContextMenu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <MenuItem Header="Dosya Gezgininde Göster"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Yolu Panoya Kopyala"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Path}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Cursor="Hand"/>

                                <!-- Type Icon -->
                                <Border Grid.Column="1"
                                        Width="30" Height="30"
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeName}"
                                               FontSize="{StaticResource Font.Micro}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Path & Description -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Path}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="{StaticResource Font.Caption}"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="{StaticResource Font.Caption}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Size & Risk Badge -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormattedSize}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               FontSize="{StaticResource Font.Caption}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <Border CornerRadius="{StaticResource Radius.XS}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RiskBadgeText}"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   FontSize="{StaticResource Font.Caption}"
                                                   FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 3. Progress Bar & Status Message -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Height="4"
                                 IsIndeterminate="{Binding IsCleaning}"
                                 Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"
                                 Margin="0,4,0,0"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 Background="{DynamicResource ApplicationBackgroundBrush}"/>
                </StackPanel>

                <!-- Selected Total Size Footprint -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Temizlenecek Alan: "
                               FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding FormattedSelectedSize}"
                               FontSize="{StaticResource Font.Caption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 4. Footer Actions -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Help / Note -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="İpucu: Sağ tıklayarak konumu dosya gezgininde inceleyebilirsiniz."
                               FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Atla ve Kapat"
                               Appearance="Secondary"
                               Command="{Binding CancelCommand}"
                               IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBool}}"
                               Padding="16,8"
                               Margin="0,0,10,0"/>

                    <ui:Button Content="Seçilenleri Temizle"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Delete20}"
                               Command="{Binding CleanSelectedCommand}"
                               IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBool}}"
                               Padding="20,8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
