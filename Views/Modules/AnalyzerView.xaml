<UserControl x:Class="Bakım.Views.Modules.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:dialogs="clr-namespace:Bakım.Views.Dialogs"
             xmlns:local="clr-namespace:Bakım.Views.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">

    <c:ModulePage Title="Analizör"
                  Subtitle="Başlangıç noktalarını, WMI kalıcılığını ve dosya imzalarını tarar; isteğe bağlı VirusTotal denetimi yapar. Dosyaları analiz için buraya sürükleyebilirsiniz."
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <ui:DropDownButton Appearance="Secondary"
                                       Padding="{StaticResource Pad.Control}"
                                       Margin="{StaticResource Gap.Right.SM}"
                                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                                       Content="VirusTotal"
                                       AutomationProperties.Name="VirusTotal ve rapor eylemleri">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="VirusTotal ile toplu tara"
                                          Command="{Binding ScanAllVisibleWithVirusTotalCommand}"
                                          IsEnabled="{Binding IsVirusTotalScanning, Converter={StaticResource InverseBool}}"
                                          Icon="{ui:SymbolIcon ShieldTask20}"/>
                                <MenuItem Header="VT API anahtarını yönet"
                                          Command="{Binding OpenApiKeyDialogCommand}"
                                          Icon="{ui:SymbolIcon Key20}"/>
                                <Separator/>
                                <MenuItem Header="Tümünü derinlemesine analiz et"
                                          Command="{Binding DeepAnalyzeAllCommand}"
                                          IsEnabled="{Binding IsDeepAnalyzing, Converter={StaticResource InverseBool}}"
                                          Icon="{ui:SymbolIcon DocumentSearch20}"/>
                                <Separator/>
                                <MenuItem Header="CSV raporu dışa aktar"
                                          Command="{Binding ExportReportCsvCommand}"
                                          Icon="{ui:SymbolIcon ArrowDownload20}"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding PickAndAnalyzeFileCommand}"
                               Padding="{StaticResource Pad.Control}"
                               Margin="{StaticResource Gap.Right.SM}"
                               Icon="{ui:SymbolIcon DocumentSearch24}"
                               Content="Dosya incele"
                               ToolTip="Herhangi bir .exe, .dll veya başlangıç dosyasını analiz et"
                               AutomationProperties.Name="Bir dosyayı seçip derinlemesine incele"/>

                    <ui:Button Appearance="Primary"
                               Command="{Binding ScanCommand}"
                               IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                               Padding="14,8"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Yeniden tara"
                               ToolTip="Tüm kalıcılık noktalarını yeniden tara"
                               AutomationProperties.Name="Kalıcılık noktalarını yeniden tara"/>
                </StackPanel>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Global Actions -->
            <RowDefinition Height="Auto"/> <!-- 1: Sekmeler (Tarama / Geçmiş / Değişiklikler) -->
            <RowDefinition Height="Auto"/> <!-- 2: KPI Statistics Cards -->
            <RowDefinition Height="Auto"/> <!-- 3: Category Filter Bar & Options -->
            <RowDefinition Height="*"/>    <!-- 4: Virtualized Items List -->
            <RowDefinition Height="Auto"/> <!-- 5: Status Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Sekmeler: Tarama | Geçmiş | Değişiklikler (Analizör Geçmişi, §6) -->
        <Border Grid.Row="1"
                HorizontalAlignment="Left"
                Background="{DynamicResource Card.Fill}"
                BorderBrush="{DynamicResource Card.Stroke.Glass}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="4"
                Margin="{StaticResource Gap.Bottom.MD}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Tarama"
                           Icon="{ui:SymbolIcon ShieldTask20}" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsScanTab}"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Scan" Margin="{StaticResource Gap.Right.XS}"/>
                <ui:Button Icon="{ui:SymbolIcon History20}" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsHistoryTab}"
                           Command="{Binding SwitchTabCommand}" CommandParameter="History" Margin="{StaticResource Gap.Right.XS}"
                           AutomationProperties.Name="Analizör geçmişi">
                    <TextBlock>
                        <Run Text="Geçmiş ("/><Run Text="{Binding History.TotalCount, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </ui:Button>
                <ui:Button Icon="{ui:SymbolIcon BranchCompare20}" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsChangesTab}"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Changes"
                           AutomationProperties.Name="Taramalar arası değişiklikler">
                    <TextBlock>
                        <Run Text="Değişiklikler ("/><Run Text="{Binding History.PendingChangesCount, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- Geçmiş ve Değişiklikler sekmeleri: tarama içeriğinin yerini alır -->
        <local:AnalyzerHistoryPanel Grid.Row="2" Grid.RowSpan="4"
                                    DataContext="{Binding History}"
                                    Visibility="{Binding DataContext.IsHistoryTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        <local:AnalyzerChangesPanel Grid.Row="2" Grid.RowSpan="4"
                                    DataContext="{Binding History}"
                                    Visibility="{Binding DataContext.IsChangesTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

        <!-- 1. KPI kartları — tasarım sistemi bileşeni (önceki 76 satırlık elle yazım yerine) -->
        <c:SummaryStrip Grid.Row="2" Margin="{StaticResource Gap.Bottom.LG}" Visibility="{Binding ShowScanContent, Converter={StaticResource BoolToVis}}">
            <c:StatCard Icon="Apps24"
                        Intent="Accent"
                        Label="Aktif kalıcılık"
                        Value="{Binding TotalCount}"
                        Caption="Taranan tüm başlangıç vektörleri"/>

            <c:StatCard Icon="ShieldDismiss24"
                        Intent="Critical"
                        Label="Yüksek risk"
                        Value="{Binding HighRiskCount}"
                        Caption="Listenin en üstünde sıralanır"/>

            <c:StatCard Icon="Warning24"
                        Intent="Caution"
                        Label="İmzasız / şüpheli"
                        Value="{Binding UnsignedCount}"
                        Caption="Dijital imzası doğrulanamayan girdiler"/>

            <c:StatCard Icon="ShieldCheckmark24"
                        Intent="Success"
                        Label="Doğrulanmış imza"
                        Value="{Binding VerifiedCount}"
                        Caption="Gömülü veya katalog imzası geçerli"/>

            <c:StatCard Icon="CalendarClock24"
                        Intent="Caution"
                        Label="Son 7 günde eklenen"
                        Value="{Binding RecentlyAddedCount}"
                        Caption="Taze başlangıç girdisi = erken bulaşma sinyali"/>
        </c:SummaryStrip>

        <!-- 2. Category Toolbar & Options -->
        <Border Grid.Row="3" Visibility="{Binding ShowScanContent, Converter={StaticResource BoolToVis}}" 
                Background="{DynamicResource Card.Fill}"
                BorderBrush="{DynamicResource Card.Stroke.Glass}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.LG}"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Category Filter Buttons -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="All"
                               Appearance="{Binding IsAllCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Tümü"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Registry"
                               Appearance="{Binding IsRegistryCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Kayıt Defteri (Run)" Icon="{ui:SymbolIcon Document20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Startup"
                               Appearance="{Binding IsStartupCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Başlangıç klasörü" Icon="{ui:SymbolIcon Folder20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Tasks"
                               Appearance="{Binding IsTasksCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Zamanlanmış görevler" Icon="{ui:SymbolIcon CalendarClock20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Services"
                               Appearance="{Binding IsServicesCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Windows servisleri" Icon="{ui:SymbolIcon DeveloperBoard20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Wmi"
                               Appearance="{Binding IsWmiCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="WMI kalıcılığı" Icon="{ui:SymbolIcon Flash20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Shell"
                               Appearance="{Binding IsShellCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Shell eklentileri" Icon="{ui:SymbolIcon Desktop20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Drivers"
                               Appearance="{Binding IsDriversCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Sürücüler" Icon="{ui:SymbolIcon Wrench20}"
                               ToolTip="Çekirdek ve dosya sistemi sürücüleri. Yalnızca incelenir; buradan kapatılamaz."/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Hooks"
                               Appearance="{Binding IsHooksCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Sistem kancaları" Icon="{ui:SymbolIcon PlugConnected20}"
                               ToolTip="AppInit/AppCert DLL, LSA paketleri, yazdırma izleyicileri, Winsock, Netsh, BootExecute ve PowerShell profilleri."/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Browser"
                               Appearance="{Binding IsBrowserCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Tarayıcı eklentileri" Icon="{ui:SymbolIcon Globe20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Office"
                               Appearance="{Binding IsOfficeCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Office eklentileri" Icon="{ui:SymbolIcon DocumentBulletList20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Files"
                               Appearance="{Binding IsFilesCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="İncelenen dosyalar" Icon="{ui:SymbolIcon DocumentSearch20}"
                               ToolTip="Kurulum Nöbetçisi'nden ya da elle incelemeye gönderilen dosyalar (başlangıç kaydı değil)."/>
                </WrapPanel>

                <!-- Row 2: Search Box & Sysinternals Filter Toggles -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" MaxWidth="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <ui:TextBox Grid.Column="0" 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="İsim, yol, yayıncı veya SHA-256 ara..."
                                Icon="{ui:SymbolIcon Search20}"
                                ClearButtonEnabled="True"
                                VerticalContentAlignment="Center"
                                Padding="10,6" AutomationProperties.Name="İsim, yol, yayıncı veya SHA-256 ara..."/>

                    <!-- Filter Switches (Sysinternals Hide Microsoft) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Doğrulanmış Microsoft girdilerini gizle" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                       ToolTip="Yalnızca imzası Windows tarafından doğrulanan Microsoft dosyaları gizlenir. Geçersiz imzalı ya da imzasız dosyalar Windows klasöründe olsa bile her zaman görünür."/>
                            <ui:ToggleSwitch IsChecked="{Binding HideMicrosoftEntries, Mode=TwoWay}" AutomationProperties.Name="İmzası doğrulanmış Microsoft girdilerini gizle" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Canlı izleme" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                       ToolTip="Yeni başlangıç girdisi, hizmet, zamanlanmış görev ya da WMI aboneliği eklendiği anda değerlendirir; riskliyse bildirir ve Etkinlik Merkezi'ne yazar."/>
                            <ui:ToggleSwitch IsChecked="{Binding LiveWatchEnabled, Mode=TwoWay}" AutomationProperties.Name="Canlı kalıcılık izlemeyi aç veya kapat" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Yalnızca imzasızları göster" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding ShowOnlyUnsigned, Mode=TwoWay}" AutomationProperties.Name="Yalnızca imzasız girdileri göster" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Virtualized Persistence Items List -->
        <!-- Sayfa içi dosya analizi (ANL Faz 5): özet, filtre ve listenin yerini alır; "Listeye dön" ile kapanır -->
        <Border Grid.Row="2" Grid.RowSpan="3"
                Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.None}"
                Visibility="{Binding ShowInPageAnalysis, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource Divider.Stroke}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Padding="{StaticResource Pad.Control}" Margin="{StaticResource Gap.Right.MD}"
                                   Icon="{ui:SymbolIcon ArrowLeft20}" Content="Listeye dön"
                                   Command="{Binding CloseInPageAnalysisCommand}"
                                   AutomationProperties.Name="Dosya analizinden kalıcılık listesine dön"/>
                        <TextBlock Text="Dosya analizi" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <dialogs:ThreatAnalysisView DataContext="{Binding InPageAnalysis}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Visibility="{Binding ShowScanContent, Converter={StaticResource BoolToVis}}">

            <!-- Boş durum: filtre hiçbir şey döndürmediğinde kullanıcıyı yalnız bırakma -->
            <c:EmptyState Icon="Search24"
                          Title="Bu filtrelerle eşleşen kalıcılık girdisi yok"
                          Description="Arama metnini temizlemeyi, kategori filtresini &quot;Tümü&quot; yapmayı veya &quot;Doğrulanmış Microsoft girdilerini gizle&quot; anahtarını kapatmayı deneyin."
                          Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>

        <DockPanel Visibility="{Binding HasNoResults, Converter={StaticResource InverseBoolToVis}}">

            <!-- Toplu eylem çubuğu (ANL Faz 5): seçim sayısı ve seçilenlere uygulanacak eylemler -->
            <Grid DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom.SM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button Appearance="Transparent" Padding="{StaticResource Pad.Control}"
                           Icon="{ui:SymbolIcon CheckboxChecked20}" Content="Görünenlerin tümünü seç"
                           Command="{Binding CheckAllVisibleCommand}"
                           AutomationProperties.Name="Filtreyle görünen tüm girdileri toplu işlem için seç"/>
                <TextBlock Grid.Column="1" Text="{Binding CheckedText}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="{StaticResource Gap.Right.MD}" TextAlignment="Right"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding HasChecked}">
                    <ui:Button Appearance="Secondary" Padding="{StaticResource Pad.Control}" Margin="{StaticResource Gap.Right.SM}"
                               Icon="{ui:SymbolIcon ToggleLeft20}" Content="Seçilenleri kapat"
                               Command="{Binding DisableCheckedCommand}"
                               ToolTip="Seçilen girdiler Windows açılışında çalışmaz; Etkinlik Merkezi'nden geri alınabilir. Kilitli girdiler atlanır."/>
                    <ui:Button Appearance="Secondary" Padding="{StaticResource Pad.Control}" Margin="{StaticResource Gap.Right.SM}"
                               Icon="{ui:SymbolIcon ShieldProhibited20}" Content="Karantinaya al"
                               Command="{Binding QuarantineCheckedCommand}"
                               ToolTip="Seçilen girdilerin dosyaları karantinaya alınır (doğrulanmış Microsoft dosyaları hariç); geri alınabilir."/>
                    <ui:Button Appearance="Transparent" Padding="{StaticResource Pad.Control}"
                               Icon="{ui:SymbolIcon Dismiss20}" Content="Seçimi temizle"
                               Command="{Binding ClearCheckedCommand}"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Card.Fill}"
                BorderBrush="{DynamicResource Card.Stroke.Glass}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.LG}"
                Padding="8">
            <ListBox ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     AutomationProperties.Name="Kalıcılık girdileri"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Grid.IsSharedSizeScope="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.MD}">
                                            <ContentPresenter/>
                                        </Border>
                                        <!-- Seçili (kanıt panelinde açık) satır: vurgu kenarı + sol gösterge -->
                                        <Border x:Name="SelectionRing" CornerRadius="{StaticResource Radius.MD}" BorderThickness="{StaticResource Stroke.Medium}"
                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Border x:Name="Indicator" Width="3" Height="18" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="{StaticResource Radius.Indicator}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PersistenceItem}">
                        <Border Background="{DynamicResource Card.Fill.Secondary}"
                                BorderBrush="{DynamicResource Divider.Stroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.MD}"
                                Padding="12,10">
                            <Border.ContextMenu>
                                <ContextMenu Background="{DynamicResource Acrylic.Fill}" BorderBrush="{DynamicResource Divider.Stroke}">
                                    <MenuItem Header="Sezgisel tehdit analizi yap"
                                              Icon="{ui:SymbolIcon Shield24}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              FontWeight="SemiBold"
                                              Command="{Binding DataContext.AnalyzeThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="VirusTotal ile doğrula"
                                              Icon="{ui:SymbolIcon Search24}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Command="{Binding DataContext.ScanItemWithVirusTotalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Dosya konumunu aç"
                                              Icon="{ui:SymbolIcon FolderOpen24}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="SHA-256 kopyala"
                                              Icon="{ui:SymbolIcon Copy24}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Command="{Binding DataContext.CopySha256Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="StatusCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="IconCol"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CatCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SigCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="VtCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ActionCol"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: açma/kapama yalnızca eylem politikası izin veriyorsa (ANL Z1);
                                     sürücü, kritik hizmet, Windows görevi, WMI ve Winlogon satırlarında kilit ve gerekçe -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                          Margin="{StaticResource Gap.Right.SM}" MinWidth="0"
                                          Command="{Binding DataContext.UpdateCheckedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='{}{0} toplu işlem için seç'}"/>

                                <Grid Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                     Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                                                     ToolTip="Başlangıçta çalışmayı aç / kapat (geri alınabilir)" AutomationProperties.Name="Başlangıçta çalışmayı aç veya kapat"/>
                                    <ui:SymbolIcon Symbol="LockClosed20"
                                                   FontSize="16"
                                                   Width="40"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding CanToggle, Converter={StaticResource InverseBoolToVis}}"
                                                   ToolTip="{Binding ToggleLockReason}"
                                                   AutomationProperties.Name="{Binding ToggleLockReason}"/>
                                </Grid>

                                <!-- Column 1: Application Icon -->
                                <Border Grid.Column="2" 
                                        Width="36" Height="36" 
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding IconSource}" 
                                               Width="24" Height="24"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <ui:SymbolIcon Symbol="Document24" 
                                                       FontSize="18" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Name, Path & Location Source -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding LocationSource, StringFormat=' ({0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding FilePath}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding Publisher, StringFormat='Yayıncı: {0}'}"
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding CollectorNotes}"
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasCollectorNotes, Converter={StaticResource BoolToVis}}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding Provenance}"
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasProvenance, Converter={StaticResource BoolToVis}}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding HostDisplay}"
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RawCommand}"
                                               Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Column 3: tek ölçekli risk rozeti (ANL Faz 2) ve kategori; ipucunda "neden bu puan?" -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <c:StatusBadge
                                               Text="{Binding RiskLabel}"
                                               Intent="{Binding RiskIntent}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               ToolTip="{Binding RiskReasonsText}"
                                               AutomationProperties.Name="{Binding RiskLabel, StringFormat='Risk: {0}'}"/>
                                <!-- Column 3b: Category Badge (kanıt paneli açıkken panelde) -->
                                <Border Visibility="{Binding DataContext.HasSelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}"
                                        
                                        Background="{DynamicResource Card.Fill.Secondary}"
                                        BorderBrush="{DynamicResource Divider.Stroke}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryDisplayName}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                                </StackPanel>

                                <!-- Column 4: Digital Signature Badge (kanıt paneli açıkken panelde) -->
                                <Border Grid.Column="5" Visibility="{Binding DataContext.HasSelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}"
                                        
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Caution.Subtle}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Critical.Subtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="12" Margin="0,0,4,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding Signature}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                            <Setter Property="Text" Value="Doğrulandı"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Unsigned">
                                                            <Setter Property="Text" Value="İmzasız"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                            <Setter Property="Text" Value="Geçersiz İmza"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Column 5: VirusTotal Score Badge (kanıt paneli açıkken panelde) -->
                                <Border Grid.Column="6" Visibility="{Binding DataContext.HasSelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}"
                                        
                                        Background="{DynamicResource Brush.Muted.Subtle}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Shield20" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding VirusTotalScore}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!--
                                    Column 6: Satır eylemleri.

                                    Önceki sürümde 6 etiketsiz simge yan yana duruyordu ve
                                    ikisi kalkandı (ShieldKeyhole = dosya analizi, Shield =
                                    VirusTotal sorgusu). Görsel olarak neredeyse aynı, işleri
                                    tamamen farklı — hangisine basılacağı belirsizdi.

                                    Artık: etiketli birincil eylem + taşma menüsü + yıkıcı eylem.
                                -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding DataContext.HasSelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}">

                                    <!-- Birincil eylem: metinli, tereddütsüz -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="10,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.AnalyzeThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon ShieldTask20}"
                                               Content="Analiz et"
                                               ToolTip="Dosyayı derinlemesine incele: PE yapısı, imza, entropi ve risk skoru"
                                               AutomationProperties.Name="{Binding Name, StringFormat='{}{0} dosyasını analiz et'}"/>

                                    <!-- İkincil eylemler taşma menüsünde -->
                                    <ui:DropDownButton Appearance="Secondary"
                                                       Padding="8,5"
                                                       Margin="0,0,6,0"
                                                       Icon="{ui:SymbolIcon MoreHorizontal20}"
                                                       ToolTip="Diğer eylemler"
                                                       AutomationProperties.Name="{Binding Name, StringFormat='{}{0} için diğer eylemler'}">
                                        <ui:DropDownButton.Flyout>
                                            <ContextMenu>
                                                <MenuItem Header="VirusTotal ile sorgula"
                                                          Command="{Binding DataContext.ScanItemWithVirusTotalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Icon="{ui:SymbolIcon Shield20}"/>
                                                <MenuItem Header="VirusTotal raporunu tarayıcıda aç"
                                                          Command="{Binding DataContext.OpenVirusTotalWebCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Icon="{ui:SymbolIcon Globe20}"/>
                                                <Separator/>
                                                <MenuItem Header="Dosya konumunu aç"
                                                          Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Icon="{ui:SymbolIcon FolderOpen20}"/>
                                                <MenuItem Header="SHA-256 özetini kopyala"
                                                          Command="{Binding DataContext.CopySha256Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Icon="{ui:SymbolIcon Copy20}"/>
                                                <Separator/>
                                                <MenuItem Header="Zaman çizelgesi"
                                                          Command="{Binding DataContext.ShowTimelineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Icon="{ui:SymbolIcon History20}"/>
                                            </ContextMenu>
                                        </ui:DropDownButton.Flyout>
                                    </ui:DropDownButton>

                                    <!-- Yıkıcı eylem görünür kalır: kırmızı ve beklenen konumda -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Delete20}"
                                               Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                               ToolTip="Başlangıç kaydını kaldır (kayıt yedeklenir, kısayol Geri Dönüşüm Kutusu'na gider; programa dokunulmaz)"
                                               AutomationProperties.Name="{Binding Name, StringFormat='{}{0} girdisini sil'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

                <!-- Kanıt paneli (ANL Faz 5): seçili girdinin tüm kanıtı ve izinli eylemleri -->
                <Border Grid.Column="1" Width="340" Margin="16,0,0,0"
                        Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.CardCompact}"
                        Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card.IconTile}" Width="40" Height="40" Margin="{StaticResource Gap.Right.MD}" VerticalAlignment="Top">
                                <Grid>
                                    <Image Source="{Binding SelectedItem.IconSource}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <ui:SymbolIcon Symbol="Document24" FontSize="20"
                                                   Visibility="{Binding SelectedItem.IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.CategoryDisplayName}" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" VerticalAlignment="Top"
                                       Icon="{ui:SymbolIcon Dismiss20}" ToolTip="Paneli kapat"
                                       Command="{Binding CloseDetailsCommand}" AutomationProperties.Name="Kanıt panelini kapat"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="{StaticResource Gap.Top.MD}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <WrapPanel>
                                    <c:StatusBadge Text="{Binding SelectedItem.RiskLabel}" Intent="{Binding SelectedItem.RiskIntent}" Margin="{StaticResource Gap.Right.XS}"/>
                                    <c:StatusBadge Text="Microsoft" Intent="Neutral" Margin="{StaticResource Gap.Right.XS}"
                                                   Visibility="{Binding SelectedItem.IsMicrosoft, Converter={StaticResource BoolToVis}}"/>
                                    <c:StatusBadge Text="Güvenilen" Intent="Success"
                                                   Visibility="{Binding SelectedItem.IsUserTrusted, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>

                                <TextBlock Text="Neden bu puan?" Style="{StaticResource Text.SectionLabel}" Margin="{StaticResource Gap.Top.MD}"/>
                                <Border Style="{StaticResource Card.Inset}" Margin="{StaticResource Gap.Top.XS}">
                                    <TextBlock Text="{Binding SelectedItem.RiskReasonsText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Komut ve hedef" Style="{StaticResource Text.SectionLabel}" Margin="{StaticResource Gap.Top.MD}"/>
                                <Border Style="{StaticResource Card.Inset}" Margin="{StaticResource Gap.Top.XS}">
                                    <StackPanel>
                                        <TextBlock Text="Ham komut" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock Text="{Binding SelectedItem.RawCommand}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Çözümlenen hedef" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.SM}"/>
                                        <TextBlock Text="{Binding SelectedItem.FilePath}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedItem.ResolutionText}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.XS}"/>
                                        <TextBlock Text="{Binding SelectedItem.HostDisplay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Visibility="{Binding SelectedItem.HasHost, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Konum" Style="{StaticResource Text.SectionLabel}" Margin="{StaticResource Gap.Top.MD}"/>
                                <Border Style="{StaticResource Card.Inset}" Margin="{StaticResource Gap.Top.XS}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedItem.LocationSource}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedItem.Provenance}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Gap.Top.XS}"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding SelectedItem.HasProvenance, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding SelectedItem.CollectorNotes}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Gap.Top.XS}"
                                                   Visibility="{Binding SelectedItem.HasCollectorNotes, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Dosya" Style="{StaticResource Text.SectionLabel}" Margin="{StaticResource Gap.Top.MD}"/>
                                <Border Style="{StaticResource Card.Inset}" Margin="{StaticResource Gap.Top.XS}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Yayıncı" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Right.MD}"/>
                                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedItem.Publisher}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="İmza" Style="{StaticResource Text.Caption}" Margin="0,8,12,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedItem.SignatureText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="{StaticResource Gap.Top.SM}"/>
                                        <TextBlock Grid.Row="2" Text="VirusTotal" Style="{StaticResource Text.Caption}" Margin="0,8,12,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedItem.VirusTotalScore}" Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Top.SM}"/>
                                        <TextBlock Grid.Row="3" Text="SHA-256" Style="{StaticResource Text.Caption}" Margin="0,8,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Sha256Hash}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedItem.Sha256Hash}" VerticalAlignment="Center" Margin="{StaticResource Gap.Top.SM}"/>
                                        <ui:Button Grid.Row="3" Grid.Column="2" Appearance="Transparent" Padding="6,4" Margin="{StaticResource Gap.Top.XS}"
                                                   Icon="{ui:SymbolIcon Copy20}" ToolTip="Kopyala"
                                                   Command="{Binding CopySha256Command}" CommandParameter="{Binding SelectedItem}"
                                                   AutomationProperties.Name="SHA-256 değerini kopyala"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="İzin verilen eylemler" Style="{StaticResource Text.SectionLabel}" Margin="{StaticResource Gap.Top.MD}"/>
                                <Border Style="{StaticResource Card.Inset}" Margin="{StaticResource Gap.Top.XS}">
                                    <StackPanel>
                                        <DockPanel>
                                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ToggleLeft20" FontSize="16" Margin="{StaticResource Gap.IconText}" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding SelectedItem.ToggleAvailabilityText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="{StaticResource Gap.Top.SM}">
                                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Delete20" FontSize="16" Margin="{StaticResource Gap.IconText}" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding SelectedItem.DeleteAvailabilityText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Eylemler -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider.Stroke}" BorderThickness="0,1,0,0"
                                Margin="{StaticResource Gap.Top.MD}" Padding="{StaticResource Gap.Top.MD}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Padding="{StaticResource Pad.Control}" Margin="{StaticResource Gap.Right.SM}"
                                           Icon="{ui:SymbolIcon ShieldTask20}" Content="Analiz et"
                                           Command="{Binding AnalyzeThreatCommand}" CommandParameter="{Binding SelectedItem}"/>
                                <ui:Button Appearance="Secondary" Padding="8,6" Margin="{StaticResource Gap.Right.SM}"
                                           Icon="{ui:SymbolIcon History20}" ToolTip="Zaman çizelgesi"
                                           AutomationProperties.Name="Zaman çizelgesi"
                                           Command="{Binding ShowTimelineCommand}" CommandParameter="{Binding SelectedItem}"/>
                                <ui:DropDownButton Appearance="Secondary" Padding="{StaticResource Pad.Control}"
                                                   Icon="{ui:SymbolIcon MoreHorizontal20}" ToolTip="Diğer eylemler" AutomationProperties.Name="Diğer eylemler">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem Header="VirusTotal ile sorgula" Icon="{ui:SymbolIcon Shield20}"
                                                      Command="{Binding ScanItemWithVirusTotalCommand}" CommandParameter="{Binding SelectedItem}"/>
                                            <MenuItem Header="VirusTotal raporunu tarayıcıda aç" Icon="{ui:SymbolIcon Globe20}"
                                                      Command="{Binding OpenVirusTotalWebCommand}" CommandParameter="{Binding SelectedItem}"/>
                                            <MenuItem Header="Dosya konumunu aç" Icon="{ui:SymbolIcon FolderOpen20}"
                                                      Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding SelectedItem}"/>
                                            <Separator/>
                                            <MenuItem Header="Başlangıç kaydını sil…" Icon="{ui:SymbolIcon Delete20}"
                                                      IsEnabled="{Binding SelectedItem.CanDelete}"
                                                      ToolTip="{Binding SelectedItem.DeleteAvailabilityText}"
                                                      Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
        </Grid>

        <!-- 4. Status Footer -->
        <Grid Grid.Row="5" Margin="0,10,0,0" Visibility="{Binding IsScanTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" 
                                 Width="16" Height="16" 
                                 Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ScanStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Bakım Güvenlik Kalkanı v41.0" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>

    <!-- VirusTotal API Key Input Modal Overlay -->
    <Grid Background="{DynamicResource Brush.Overlay.Scrim}"
          Visibility="{Binding IsApiKeyDialogOpen, Converter={StaticResource BoolToVis}}"
          Panel.ZIndex="999">
        <Border MaxWidth="500"
                Margin="24,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource Acrylic.Fill}"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource Radius.XL}"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.85" Color="{DynamicResource Color.Shadow}"/>
            </Border.Effect>
            <StackPanel>
                <!-- Modal Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Key24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="VirusTotal API entegrasyonu" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="SHA-256 hash'lerini otomatik sorgulamak için API anahtarınızı girin" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Right"
                               Padding="6,4"
                               Command="{Binding CloseApiKeyDialogCommand}"
                               Icon="{ui:SymbolIcon Dismiss20}"
                               ToolTip="Kapat" AutomationProperties.Name="Kapat"/>
                </Grid>

                <!-- API Key Input Field -->
                <TextBlock Text="VirusTotal API anahtarı (v3):" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                <ui:TextBox Text="{Binding ApiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="64 karakterlik VirusTotal API anahtarınızı buraya yapıştırın..."
                            ClearButtonEnabled="True"
                            Padding="12,10"
                            Margin="0,0,0,12" AutomationProperties.Name="64 karakterlik VirusTotal API anahtarınızı buraya yapıştırın..."/>

                <!-- Status Message -->
                <TextBlock Text="{Binding ApiKeyStatusText}" 
                           FontSize="{StaticResource Font.Caption}" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           FontWeight="Medium"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="virustotal.com üzerinden ücretsiz alabilirsiniz." 
                               FontSize="{StaticResource Font.Caption}" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                               VerticalAlignment="Center"/>

                    <ui:Button Grid.Column="1"
                               Appearance="Secondary"
                               Content="İptal"
                               Padding="16,8"
                               Command="{Binding CloseApiKeyDialogCommand}"/>

                    <ui:Button Grid.Column="3"
                               Appearance="Secondary"
                               Content="Doğrula ve kaydet"
                               Padding="16,8"
                               Icon="{ui:SymbolIcon Checkmark20}"
                               Command="{Binding SaveApiKeyCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
    </c:ModulePage>
</UserControl>
