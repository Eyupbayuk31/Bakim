<UserControl x:Class="Bakım.Views.Modules.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Global Actions -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Statistics Cards -->
            <RowDefinition Height="Auto"/> <!-- 2: Category Filter Bar & Options -->
            <RowDefinition Height="*"/>    <!-- 3: Virtualized Items List -->
            <RowDefinition Height="Auto"/> <!-- 4: Status Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Başlık — tasarım sistemi bileşeni -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         Icon="ShieldTask24"
                         HeaderMargin="0,0,0,18"
                         Title="Analizör"
                         Description="Sysinternals derinliğinde Windows başlangıç vektörleri, WMI kalıcılıkları, dijital imza ve VirusTotal taraması.">

            <!-- Canlı VirusTotal tarama göstergesi -->
            <c:SectionHeader.TitleAdornment>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsVirusTotalScanning, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding VirusTotalScanProgress}"
                                   FontSize="{StaticResource Font.Caption}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsDeepAnalyzing, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DeepAnalysisProgress}"
                                   FontSize="{StaticResource Font.Caption}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="340"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </c:SectionHeader.TitleAdornment>

            <!--
                Beş buton dar pencerede taşıyordu. Artık iki birincil eylem
                görünür, kalanlar taşma menüsünde. Ayrıca emoji içerikler
                (🔑 🛡️ 🔍) Fluent simge sistemiyle değiştirildi.
            -->
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <ui:DropDownButton Appearance="Secondary"
                                       Padding="{StaticResource Pad.Control}"
                                       Margin="{StaticResource Gap.Right.SM}"
                                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                                       Content="VirusTotal"
                                       AutomationProperties.Name="VirusTotal ve rapor eylemleri">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="VirusTotal ile Toplu Tara"
                                          Command="{Binding ScanAllVisibleWithVirusTotalCommand}"
                                          IsEnabled="{Binding IsVirusTotalScanning, Converter={StaticResource InverseBool}}"
                                          Icon="{ui:SymbolIcon ShieldTask20}"/>
                                <MenuItem Header="VT API Anahtarını Yönet"
                                          Command="{Binding OpenApiKeyDialogCommand}"
                                          Icon="{ui:SymbolIcon Key20}"/>
                                <Separator/>
                                <MenuItem Header="Tümünü Derinlemesine Analiz Et"
                                          Command="{Binding DeepAnalyzeAllCommand}"
                                          IsEnabled="{Binding IsDeepAnalyzing, Converter={StaticResource InverseBool}}"
                                          Icon="{ui:SymbolIcon DocumentSearch20}"/>
                                <Separator/>
                                <MenuItem Header="CSV Raporu Dışa Aktar"
                                          Command="{Binding ExportReportCsvCommand}"
                                          Icon="{ui:SymbolIcon ArrowDownload20}"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding PickAndAnalyzeFileCommand}"
                               Padding="{StaticResource Pad.Control}"
                               Margin="{StaticResource Gap.Right.SM}"
                               Icon="{ui:SymbolIcon DocumentSearch24}"
                               Content="Dosya İncele"
                               ToolTip="Herhangi bir .exe, .dll veya başlangıç dosyasını röntgenle"
                               AutomationProperties.Name="Bir dosyayı seçip derinlemesine incele"/>

                    <ui:Button Appearance="Primary"
                               Command="{Binding ScanCommand}"
                               IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                               Padding="14,8"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Yeniden Tara"
                               ToolTip="Tüm kalıcılık noktalarını yeniden tara"
                               AutomationProperties.Name="Kalıcılık noktalarını yeniden tara"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. KPI kartları — tasarım sistemi bileşeni (önceki 76 satırlık elle yazım yerine) -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="{StaticResource Gap.Bottom.LG}">
            <c:StatCard Icon="Apps24"
                        Intent="Accent"
                        Label="Aktif Kalıcılık"
                        Value="{Binding TotalCount}"
                        Caption="Taranan tüm başlangıç vektörleri"
                        Margin="0,0,6,0"/>

            <c:StatCard Icon="ShieldDismiss24"
                        Intent="Critical"
                        Label="Yüksek Risk"
                        Value="{Binding HighRiskCount}"
                        Caption="Listenin en üstünde sıralanır"
                        Margin="6,0,6,0"/>

            <c:StatCard Icon="Warning24"
                        Intent="Caution"
                        Label="İmzasız / Şüpheli"
                        Value="{Binding UnsignedCount}"
                        Caption="Dijital imzası doğrulanamayan girdiler"
                        Margin="6,0,6,0"/>

            <c:StatCard Icon="ShieldCheckmark24"
                        Intent="Success"
                        Label="Doğrulanmış İmza"
                        Value="{Binding VerifiedCount}"
                        Caption="Gömülü veya katalog imzası geçerli"
                        Margin="6,0,6,0"/>

            <c:StatCard Icon="CalendarClock24"
                        Intent="Caution"
                        Label="Son 7 Günde Eklenen"
                        Value="{Binding RecentlyAddedCount}"
                        Caption="Taze başlangıç girdisi = erken bulaşma sinyali"
                        Margin="6,0,0,0"/>
        </UniformGrid>

        <!-- 2. Category Toolbar & Options -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Category Filter Buttons -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="All"
                               Appearance="{Binding IsAllCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Tümü"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Registry"
                               Appearance="{Binding IsRegistryCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Kayıt Defteri (Run)" Icon="{ui:SymbolIcon Document20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Startup"
                               Appearance="{Binding IsStartupCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Başlangıç Klasörü" Icon="{ui:SymbolIcon Folder20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Tasks"
                               Appearance="{Binding IsTasksCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Zamanlanmış Görevler" Icon="{ui:SymbolIcon CalendarClock20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Services"
                               Appearance="{Binding IsServicesCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Windows Servisleri" Icon="{ui:SymbolIcon DeveloperBoard20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Wmi"
                               Appearance="{Binding IsWmiCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="WMI Kalıcılığı" Icon="{ui:SymbolIcon Flash20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Shell"
                               Appearance="{Binding IsShellCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Shell Eklentileri" Icon="{ui:SymbolIcon Desktop20}"/>
                </WrapPanel>

                <!-- Row 2: Search Box & Sysinternals Filter Toggles -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" MaxWidth="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <ui:TextBox Grid.Column="0" 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="İsim, yol, yayıncı veya SHA-256 ara..."
                                Icon="{ui:SymbolIcon Search20}"
                                ClearButtonEnabled="True"
                                VerticalContentAlignment="Center"
                                Padding="10,6" AutomationProperties.Name="İsim, yol, yayıncı veya SHA-256 ara..."/>

                    <!-- Filter Switches (Sysinternals Hide Microsoft) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Microsoft Girdilerini Gizle" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding HideMicrosoftEntries, Mode=TwoWay}" AutomationProperties.Name="Microsoft imzalı girdileri gizle" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Yalnızca İmzasızları Göster" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding ShowOnlyUnsigned, Mode=TwoWay}" AutomationProperties.Name="Yalnızca imzasız girdileri göster" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Virtualized Persistence Items List -->
        <Grid Grid.Row="3">

            <!-- Boş durum: filtre hiçbir şey döndürmediğinde kullanıcıyı yalnız bırakma -->
            <c:EmptyState Icon="Search24"
                          Title="Bu filtrelerle eşleşen kalıcılık girdisi yok"
                          Description="Arama metnini temizlemeyi, kategori filtresini &quot;Tümü&quot; yapmayı veya &quot;Microsoft girdilerini gizle&quot; anahtarını kapatmayı deneyin."
                          Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>

        <Border Visibility="{Binding HasNoResults, Converter={StaticResource InverseBoolToVis}}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <ListBox ItemsSource="{Binding FilteredItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Grid.IsSharedSizeScope="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PersistenceItem}">
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Border.ContextMenu>
                                <ContextMenu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <MenuItem Header="🛡️ Sezgisel AI Tehdit Analizi Yap"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              FontWeight="SemiBold"
                                              Command="{Binding DataContext.AnalyzeThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="🔍 VirusTotal API ile Doğrula"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Command="{Binding DataContext.ScanItemWithVirusTotalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="📁 Dosya Konumunu Aç"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="📋 SHA-256 Kopyala"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Command="{Binding DataContext.CopySha256Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="StatusCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="IconCol"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CatCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SigCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="VtCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ActionCol"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Safe Enable/Disable ToggleSwitch -->
                                <ui:ToggleSwitch Grid.Column="0" 
                                                 IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                 Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,14,0"
                                                 ToolTip="Başlangıçta çalışmayı aktif et / güvenli devre dışı bırak" AutomationProperties.Name="Başlangıçta çalışmayı aktif et / güvenli devre dışı bırak"/>

                                <!-- Column 1: Application Icon -->
                                <Border Grid.Column="1" 
                                        Width="36" Height="36" 
                                        CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding IconSource}" 
                                               Width="24" Height="24"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <ui:SymbolIcon Symbol="Document24" 
                                                       FontSize="18" 
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Name, Path & Location Source -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding LocationSource, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding FilePath}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding Publisher, StringFormat='Yayıncı: {0}'}" 
                                               FontSize="10.5" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Column 3: Category Badge -->
                                <Border Grid.Column="3" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryDisplayName}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <!-- Column 4: Digital Signature Badge -->
                                <Border Grid.Column="4" 
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Caution.Subtle}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Critical.Subtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="12" Margin="0,0,4,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding Signature}" FontSize="11" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                            <Setter Property="Text" Value="Doğrulandı"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Unsigned">
                                                            <Setter Property="Text" Value="İmzasız"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                            <Setter Property="Text" Value="Geçersiz İmza"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Column 5: VirusTotal Score Badge -->
                                <Border Grid.Column="5" 
                                        Background="{DynamicResource Brush.Muted.Subtle}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Shield20" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding VirusTotalScore}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Column 6: Action Buttons (VirusTotal, Open Location, Delete) -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- AI Heuristic Threat Analyzer Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.AnalyzeThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon ShieldKeyhole20}"
                                               ToolTip="Sezgisel AI Tehdit Analizi Yap (% Risk Skoru &amp; Detaylar)" AutomationProperties.Name="Sezgisel AI Tehdit Analizi Yap (% Risk Skoru &amp; Detaylar)"/>

                                    <!-- VirusTotal API Quick Scan Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.ScanItemWithVirusTotalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Shield20}"
                                               ToolTip="Bu Dosyayı VirusTotal API ile Sorgula" AutomationProperties.Name="Bu Dosyayı VirusTotal API ile Sorgula"/>

                                    <!-- VirusTotal Web Lookup Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.OpenVirusTotalWebCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Globe20}"
                                               ToolTip="VirusTotal'de SHA-256 Raporunu Aç" AutomationProperties.Name="VirusTotal'de SHA-256 Raporunu Aç"/>

                                    <!-- Open File Location Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon FolderOpen20}"
                                               ToolTip="Dosya Konumunu Windows Gezgini'nde Aç" AutomationProperties.Name="Dosya Konumunu Windows Gezgini'nde Aç"/>

                                    <!-- Copy Hash Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.CopySha256Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Copy20}"
                                               ToolTip="SHA-256 Hash'ini Panoya Kopyala" AutomationProperties.Name="SHA-256 Hash'ini Panoya Kopyala"/>

                                    <!-- Permanent Delete Button -->
                                    <ui:Button Appearance="Danger"
                                               Padding="8,5"
                                               Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Delete20}"
                                               ToolTip="Kalıcı Olarak Sil" AutomationProperties.Name="Kalıcı Olarak Sil"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        </Grid>

        <!-- 4. Status Footer -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" 
                                 Width="16" Height="16" 
                                 Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ScanStatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Bakım Güvenlik Kalkanı v41.0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>

    <!-- VirusTotal API Key Input Modal Overlay -->
    <Grid Background="{DynamicResource Brush.Overlay.Scrim}"
          Visibility="{Binding IsApiKeyDialogOpen, Converter={StaticResource BoolToVis}}"
          Panel.ZIndex="999">
        <Border MaxWidth="500"
                Margin="24,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="2"
                CornerRadius="14"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.85" Color="{DynamicResource Color.Shadow}"/>
            </Border.Effect>
            <StackPanel>
                <!-- Modal Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Key24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="VirusTotal API Entegrasyonu" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="SHA-256 hash'lerini otomatik sorgulamak için API anahtarınızı girin" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Right"
                               Padding="6,4"
                               Command="{Binding CloseApiKeyDialogCommand}"
                               Icon="{ui:SymbolIcon Dismiss20}"
                               ToolTip="Kapat" AutomationProperties.Name="Kapat"/>
                </Grid>

                <!-- API Key Input Field -->
                <TextBlock Text="VirusTotal API Anahtarı (v3):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                <ui:TextBox Text="{Binding ApiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="64 karakterlik VirusTotal API anahtarınızı buraya yapıştırın..."
                            ClearButtonEnabled="True"
                            Padding="12,10"
                            Margin="0,0,0,12" AutomationProperties.Name="64 karakterlik VirusTotal API anahtarınızı buraya yapıştırın..."/>

                <!-- Status Message -->
                <TextBlock Text="{Binding ApiKeyStatusText}" 
                           FontSize="12" 
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                           FontWeight="Medium"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="virustotal.com üzerinden ücretsiz alabilirsiniz." 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                               VerticalAlignment="Center"/>

                    <ui:Button Grid.Column="1"
                               Appearance="Secondary"
                               Content="İptal"
                               Padding="16,8"
                               Command="{Binding CloseApiKeyDialogCommand}"/>

                    <ui:Button Grid.Column="3"
                               Appearance="Primary"
                               Content="Doğrula &amp; Kaydet"
                               Padding="16,8"
                               Icon="{ui:SymbolIcon Checkmark20}"
                               Command="{Binding SaveApiKeyCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
