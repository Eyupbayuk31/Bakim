<UserControl x:Class="Bakım.Views.Modules.SentinelModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SentinelViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık -->
            <RowDefinition Height="Auto"/> <!-- 1: Durum kartı -->
            <RowDefinition Height="Auto"/> <!-- 2: Özet -->
            <RowDefinition Height="Auto"/> <!-- 3: Arama -->
            <RowDefinition Height="*"/>    <!-- 4: Geçmiş -->
        </Grid.RowDefinitions>

        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         Icon="ShieldCheckmark24"
                         HeaderMargin="0,0,0,18"
                         Title="Kurulum Nöbetçisi"
                         Description="Programlar kurulurken eklenen dosyaları, başlangıç girdilerini ve hizmetleri kaydeder. Her kurulumun raporu burada saklanır.">
            <c:SectionHeader.Actions>
                <ui:Button Appearance="Secondary"
                           Padding="{StaticResource Pad.Control}"
                           Icon="{ui:SymbolIcon ArrowClockwise20}"
                           Content="Yenile"
                           Command="{Binding RefreshCommand}"
                           AutomationProperties.Name="Kurulum geçmişini yenile"/>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. Durum -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="{StaticResource Pad.Card}"
                Margin="{StaticResource Gap.Bottom.MD}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="32" Filled="{Binding IsEnabled}"
                               Margin="{StaticResource Gap.Right.MD}" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0"
                                         Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                               Margin="{StaticResource Gap.Top.XS}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                 OnContent="Açık" OffContent="Kapalı"
                                 AutomationProperties.Name="Kurulum Nöbetçisini aç veya kapat"/>
            </Grid>
        </Border>

        <!-- 2. Özet -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="{StaticResource Gap.Bottom.MD}">
            <c:StatCard Icon="BoxCheckmark24" Label="Kayıtlı oturum" Value="{Binding TotalCount}" Intent="Neutral" Margin="{StaticResource Gap.Right.SM}"/>
            <c:StatCard Icon="CalendarLtr24" Label="Son 30 gün" Value="{Binding Last30Count}" Intent="Accent" Margin="{StaticResource Gap.Right.SM}"/>
            <c:StatCard Icon="Rocket24" Label="Başlangıca/hizmete ekleyen" Value="{Binding PersistenceCount}" Intent="Caution"/>
        </UniformGrid>

        <!-- 3. Arama -->
        <ui:TextBox Grid.Row="3"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Program adına ya da kurulum dosyasına göre ara…"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    Margin="{StaticResource Gap.Bottom.MD}"
                    AutomationProperties.Name="Kurulum geçmişinde ara"/>

        <!-- 4. Geçmiş -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}">
            <Grid>
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                         SelectedItem="{Binding Selected}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         AutomationProperties.Name="Kurulum geçmişi">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                               Margin="12,12,0,4" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SentinelReportRow}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="{StaticResource Gap.Right.SM}">
                                    <TextBlock FontSize="{StaticResource Font.BodyLarge}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{Binding AppName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding KindText, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding DateText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Summary, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RiskText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasRisk, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:StatusBadge Text="Eksik olabilir" Intent="Caution" Margin="{StaticResource Gap.Right.XS}"
                                                   Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                    <c:StatusBadge Text="{Binding PersistenceText}" Intent="{Binding Intent}" Margin="{StaticResource Gap.Right.SM}"/>
                                    <ui:Button Appearance="Secondary" Padding="8,4"
                                               Icon="{ui:SymbolIcon DocumentSearch24}"
                                               Content="Raporu aç"
                                               Command="{Binding DataContext.InspectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding}"
                                               AutomationProperties.Name="Kurulum raporunu aç"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <c:EmptyState Icon="ShieldCheckmark24"
                              Title="Henüz kayıtlı kurulum yok"
                              Description="Nöbetçi açıkken bir program kurduğunuzda, kurulumun eklediği dosyalar, başlangıç girdileri ve hizmetler burada raporlanır."
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
