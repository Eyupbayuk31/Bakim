<UserControl x:Class="Bakım.Views.Modules.SystemInfoModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel}"
             d:DesignHeight="950" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="SI.Key" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style x:Key="SI.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Resources>

    <c:ModulePage Title="Sistem Bilgisi"
                  Subtitle="Cihazın donanımı, Windows sürümü ve disklerin S.M.A.R.T. sağlık durumu."
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Padding="14,8"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık -->
            <RowDefinition Height="Auto"/> <!-- 1: Sekmeler -->
            <RowDefinition Height="*"/>    <!-- 2: Etkin sekme -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource Gap.Bottom.MD}">
            <ui:Button Style="{StaticResource Tab.Item}" Content="Donanım"
                       helpers:NavSelection.IsSelected="{Binding IsHardwareTab}"
                       Command="{Binding SwitchSubTabCommand}" CommandParameter="Hardware"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Disk sağlığı"
                       helpers:NavSelection.IsSelected="{Binding IsSmartTab}"
                       Command="{Binding SwitchSubTabCommand}" CommandParameter="Smart"/>
        </StackPanel>

        <!-- ========================================================================= -->
        <!-- 1: TAB 1 - DONANIM & TELEMETRİ (OVERHAUL)                                  -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsHardwareTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <!-- Cihaz kartı (Windows 11 Ayarlar > Sistem > Hakkında) -->
                <Border Style="{StaticResource Card.Surface.Hero}" Margin="{StaticResource Gap.Bottom.LG}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card.IconTile}" Margin="0,0,16,0" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Laptop24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Hardware.MachineName}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Hardware.OsVersion}" Style="{StaticResource Text.SettingDescription}" MaxWidth="720"/>
                            <TextBlock Text="{Binding WindowsSupport.Text}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWindowsSupportWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Caution.Text}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding Hardware.UserName, Mode=OneWay}"/><Run Text=" · açık kalma süresi "/><Run Text="{Binding Hardware.SystemUptimeText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="Kopyala" Icon="{ui:SymbolIcon Copy20}"
                                   Command="{Binding CopySpecsToClipboardCommand}" VerticalAlignment="Top"
                                   ToolTip="Donanım özetini panoya kopyalar"/>
                    </Grid>
                </Border>

                <TextBlock Text="Donanım" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8"/>

                <ui:CardExpander Icon="{ui:SymbolIcon DeveloperBoard24}" Margin="{StaticResource Gap.Card}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="İşlemci" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="{Binding Hardware.CpuName}" Style="{StaticResource Text.SettingDescription}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.CpuName}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hız" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.CpuClockSpeed}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Çekirdek / iş parçacığı" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.CpuCoresThreads}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Önbellek" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.CpuL3Cache}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Anlık yük" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Hardware.CpuPercentageText}" Style="{StaticResource SI.Value}"/>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander Icon="{ui:SymbolIcon Desktop24}" Margin="{StaticResource Gap.Card}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Ekran kartı" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="{Binding Hardware.GpuName}" Style="{StaticResource Text.SettingDescription}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.GpuName}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bellek" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.GpuVram}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ekran" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.DisplayResolution}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Yenileme hızı" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.DisplayRefreshRate}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Sürücü sürümü" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Hardware.GpuDriverVersion}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="İkinci ekran kartı" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Hardware.GpuSecondaryName, TargetNullValue=—}" Style="{StaticResource SI.Value}"/>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander Icon="{ui:SymbolIcon TopSpeed24}" Margin="{StaticResource Gap.Card}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Bellek" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB'}" Style="{StaticResource Text.SettingDescription}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Toplam" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB'}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hız" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.RamSpeedMhz}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kullanılan" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.UsedRamGb, StringFormat='{}{0:F1} GB'}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Boş" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.FreeRamGb, StringFormat='{}{0:F1} GB'}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Doluluk" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Hardware.RamPercentage, StringFormat='%{0}'}" Style="{StaticResource SI.Value}"/>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander Icon="{ui:SymbolIcon Board24}" Margin="{StaticResource Gap.Card}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Anakart ve BIOS" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="{Binding Hardware.MotherboardModel}" Style="{StaticResource Text.SettingDescription}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Anakart" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.MotherboardModel}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.BiosVersion}" Style="{StaticResource SI.Value}"/>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander Icon="{ui:SymbolIcon Wifi124}" Margin="{StaticResource Gap.Card}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Ağ" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="{Binding Hardware.NetworkAdapterName}" Style="{StaticResource Text.SettingDescription}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bağdaştırıcı" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.NetworkAdapterName}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bağlantı hızı" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.NetworkLinkSpeed}" Style="{StaticResource SI.Value}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="IPv4 adresi" Style="{StaticResource SI.Key}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.NetworkIpAddress}" Style="{StaticResource SI.Value}"/>
                    </Grid>
                </ui:CardExpander>

                <TextBlock Text="Depolama" Style="{StaticResource Text.SectionLabel}" Margin="0,22,0,8"/>

                <TextBlock Text="{Binding Hardware.DiskActivityText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" Visibility="{Binding Hardware.DiskActivityText, Converter={StaticResource StringToVis}}"/>

                <!-- Interactive Drive Partitions Cards -->
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Surface.Compact}" Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Ad, etiket, dosya sistemi -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding VolumeLabel}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.XS}" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DriveFormat}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding UsagePercentage, StringFormat='%{0} dolu'}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>

                                    <!-- Middle Row: Capacity Bar -->
                                    <ProgressBar Grid.Row="1" 
                                                 Value="{Binding UsagePercentage}" 
                                                 Maximum="100" 
                                                 Height="4" 
                                                 Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"
                                                 Margin="0,0,0,10"/>

                                    <!-- Bottom Row: Metrics & Quick Action Buttons -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding FormattedFree, Mode=OneWay}"/><Run Text=" boş · toplam "/><Run Text="{Binding FormattedTotal, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Direct Drive Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary"
                                                       Padding="10,4"
                                                       Margin="0,0,6,0"
                                                       Content="Disk temizleme"
                                                       Icon="{ui:SymbolIcon Broom20}"
                                                       Command="{Binding DataContext.CleanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>

                                            <ui:Button Appearance="Secondary"
                                                       Padding="10,4"
                                                       Margin="0,0,6,0"
                                                       Content="Büyük dosyaları tara"
                                                       Icon="{ui:SymbolIcon Search20}"
                                                       Command="{Binding DataContext.ScanDriveForLargeFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>

                                            <ui:Button Appearance="Secondary"
                                                       Padding="8,4"
                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                       ToolTip="Sürücüyü gezginde aç"
                                                       Command="{Binding DataContext.OpenDriveInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Güvenlik" Style="{StaticResource Text.SectionLabel}" Margin="0,22,0,8"/>
                <ui:CardExpander Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="{StaticResource Gap.Card}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Aygıt güvenliği" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Güvenli önyükleme, TPM, sanallaştırma ve oturum yetkisi" Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Güvenli önyükleme" Style="{StaticResource SI.Key}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.SecureBootStatus}" Style="{StaticResource SI.Value}"/>
                        <TextBlock Grid.Row="1" Text="TPM" Style="{StaticResource SI.Key}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.TpmStatus}" Style="{StaticResource SI.Value}"/>
                        <TextBlock Grid.Row="2" Text="Sanallaştırma" Style="{StaticResource SI.Key}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.VirtualizationStatus}" Style="{StaticResource SI.Value}"/>
                        <TextBlock Grid.Row="3" Text="Bakım'ın yetkisi" Style="{StaticResource SI.Key}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock Text="Yönetici" Style="{StaticResource SI.Value}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Standart kullanıcı" Style="{StaticResource SI.Value}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>

                <TextBlock Text="İlgili" Style="{StaticResource Text.SectionLabel}" Margin="0,22,0,8"/>
                <ui:CardAction Icon="{ui:SymbolIcon DocumentBulletList24}" Command="{Binding ExportReportHtmlCommand}" Margin="{StaticResource Gap.Card}" ToolTip="HTML raporu oluştur">
                    <StackPanel>
                        <TextBlock Text="Sistem raporu" Style="{StaticResource Text.SettingTitle}"/>
                        <TextBlock Text="Donanım ve depolama dökümünü HTML sayfası olarak kaydeder ve tarayıcıda açar." Style="{StaticResource Text.SettingDescription}"/>
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon HardDrive20}" Command="{Binding OpenDiskManagementCommand}" Margin="{StaticResource Gap.Card}" ToolTip="Disk Yönetimi'ni aç">
                    <StackPanel>
                        <TextBlock Text="Disk Yönetimi" Style="{StaticResource Text.SettingTitle}"/>
                        <TextBlock Text="Bölümleri ve sürücü harflerini yönetin (diskmgmt.msc)." Style="{StaticResource Text.SettingDescription}"/>
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenDeviceManagerCommand}" Margin="{StaticResource Gap.Card}" ToolTip="Aygıt Yöneticisi'ni aç">
                    <StackPanel>
                        <TextBlock Text="Aygıt Yöneticisi" Style="{StaticResource Text.SettingTitle}"/>
                        <TextBlock Text="Sürücüleri ve donanım aygıtlarını görüntüleyin (devmgmt.msc)." Style="{StaticResource Text.SettingDescription}"/>
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon TopSpeed24}" Command="{Binding OpenTaskManagerCommand}" Margin="{StaticResource Gap.Card}" ToolTip="Görev Yöneticisi'ni aç">
                    <StackPanel>
                        <TextBlock Text="Görev Yöneticisi" Style="{StaticResource Text.SettingTitle}"/>
                        <TextBlock Text="Çalışan uygulamaları ve kaynak kullanımını görün." Style="{StaticResource Text.SettingDescription}"/>
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- 2: TAB 2 - S.M.A.R.T. SAĞLIK & FİZİKSEL DİSK ANALİZİ                       -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSmartTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <DockPanel LastChildFill="False" Margin="{StaticResource Gap.Bottom.MD}">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Disk denetleyicisinin bildirdiği sağlık, sıcaklık ve bellenim bilgileri."
                               Style="{StaticResource Text.SettingDescription}" Margin="0"/>
                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding LoadSmartHealthCommand}"/>
                </DockPanel>

                <!-- Disks List -->
                <ItemsControl ItemsSource="{Binding SmartDisks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SmartDiskHealthItem}">
                            <Border Style="{StaticResource Card.Surface}" Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Disk Model & Health Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Model}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding InterfaceType}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding MediaType}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Sağlık rozeti: iyi → onay, değilse uyarı -->
                                        <Border Grid.Column="1" CornerRadius="{StaticResource Radius.XS}" Padding="8,3" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Status.Caution.Subtle}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HealthBadgeBrush}" Value="SystemFillColorSuccessBrush">
                                                            <Setter Property="Background" Value="{DynamicResource Status.Success.Subtle}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthBadgeBrush}" Value="SystemFillColorCriticalBrush">
                                                            <Setter Property="Background" Value="{DynamicResource Status.Critical.Subtle}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding HealthStatus}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Height="1" Margin="0,0,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                    <!-- Diagnostic Metrics (4 Columns) -->
                                    <Grid Grid.Row="2" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Durum" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding OperationalStatus}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Sıcaklık" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bellenim" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FirmwareRevision, TargetNullValue='Güncel'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Seri numarası" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding SerialNumber, TargetNullValue='Korumalı'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Actions Row: TRIM Optimization -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SSD'lerde TRIM, silinen blokları diske bildirerek yazma hızını korur." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        <ui:Button Grid.Column="1"
                                                   Appearance="Secondary"
                                                   Content="Optimize et (TRIM)"
                                                   Icon="{ui:SymbolIcon TopSpeed20}"
                                                   Command="{Binding DataContext.RunTrimCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="C"
                                                   Padding="12,5"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

    </Grid>
    </c:ModulePage>
</UserControl>
