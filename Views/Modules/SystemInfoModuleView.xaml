<UserControl x:Class="Bakım.Views.Modules.SystemInfoModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel}"
             d:DesignHeight="950" d:DesignWidth="1100">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Segmented Sub-tab Switcher -->
            <RowDefinition Height="*"/>    <!-- 1: Active Viewport Content -->
        </Grid.RowDefinitions>

        <!-- 0: Header Section & Sub-tab Switcher -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         Icon="Info24"
                         HeaderMargin="0,0,0,20"
                         Title="Sistem Bilgisi"
                         Description="Donanım ve Windows bilgileri, sürücüler ve S.M.A.R.T. disk sağlığı. Büyük dosyalar ve yinelenenler Depolama sayfasında.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Modern Fluent Segmented Sub-Tab Switcher -->
                    <Border Style="{StaticResource FluentSegmentedContainer}"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 1: Hardware -->
                            <ui:Button Appearance="{Binding IsHardwareTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="Hardware"
                                       Padding="12,6"
                                       Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Donanım" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Tab 2: S.M.A.R.T. -->
                            <ui:Button Appearance="{Binding IsSmartTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="Smart"
                                       Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="S.M.A.R.T." VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Padding="14,8"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- ========================================================================= -->
        <!-- 1: TAB 1 - DONANIM & TELEMETRİ (OVERHAUL)                                  -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsHardwareTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <!-- 6 Modern KPI Spec Cards (2 Rows x 3 Columns Grid) -->
                <Grid Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Processor (CPU) -->
                    <ui:Card Grid.Row="0" Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="İşlemci (CPU)" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hardware.CpuName}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.CpuName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.CpuClockSpeed}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Hardware.CpuL3Cache}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Crystal-Clear CPU Load Meter (No visual glitches!) -->
                                <Border Grid.Column="1" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{Binding Hardware.CpuPercentage, Converter={StaticResource PercentageToBrush}}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Hardware.CpuPercentageText}" 
                                                   FontSize="{StaticResource Font.Body}" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Hardware.CpuPercentage, Converter={StaticResource PercentageToBrush}}"/>
                                        <TextBlock Text="YÜK" 
                                                   FontSize="{StaticResource Font.Micro}" 
                                                   FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.CpuCoresThreads}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 2: Graphics (GPU) -->
                    <ui:Card Grid.Row="0" Grid.Column="2" Padding="18" ToolTip="{Binding Hardware.GpuTooltip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Desktop20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ekran Kartı (GPU)" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="{StaticResource Radius.XS}" 
                                        Padding="6,1" 
                                        Margin="8,0,0,0" 
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Hardware.HasDualGpu, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Harici + Dahili" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hardware.GpuName}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.GpuName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.GpuVram}" FontSize="{StaticResource Font.Caption}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Hardware.DisplayResolution}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Hardware.DisplayRefreshRate, StringFormat='@ {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ui:SymbolIcon Symbol="Tv20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" 
                                       Text="{Binding Hardware.GpuDriverVersion, StringFormat='Sürücü Sürümü: {0}'}" 
                                       FontSize="{StaticResource Font.Micro}" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Hardware.GpuDriverVersion, StringFormat='Sürücü Sürümü: {0}'}"/>

                            <TextBlock Grid.Row="3" 
                                       Text="{Binding Hardware.GpuSecondaryName, StringFormat='Dahili: {0}'}" 
                                       FontSize="{StaticResource Font.Micro}" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding Hardware.HasDualGpu, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 3: Memory (RAM) -->
                    <ui:Card Grid.Row="0" Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="TopSpeed20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Fiziksel Bellek (RAM)" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB'}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.RamSpeedMhz, StringFormat='{} ({0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.FreeRamGb, StringFormat='Boş: {0:F1} GB'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Hardware.UsedRamGb, StringFormat='Dolu: {0:F1} GB'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- RAM Percentage Badge -->
                                <Border Grid.Column="1" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource Radius.SM}"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Hardware.RamPercentage, StringFormat='%{0}'}" 
                                                   FontSize="{StaticResource Font.Body}" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"/>
                                        <TextBlock Text="DOLU" 
                                                   FontSize="{StaticResource Font.Micro}" 
                                                   FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.RamPercentage, StringFormat='%{0} Bellek Tüketiliyor • Havuz Aktif'}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 4: Motherboard & BIOS -->
                    <ui:Card Grid.Row="2" Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Laptop20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Anakart &amp; Bellenim" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Hardware.MotherboardModel}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.MotherboardModel}"/>
                                <TextBlock Text="{Binding Hardware.BiosVersion}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="SMBIOS / UEFI Donanım Katmanı" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 5: Network & Connectivity (NEW!) -->
                    <ui:Card Grid.Row="2" Grid.Column="2" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="WifiSettings20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ağ &amp; Bağlantı" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Hardware.NetworkAdapterName}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.NetworkAdapterName}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Hardware.NetworkLinkSpeed}" FontSize="{StaticResource Font.Caption}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Hardware.NetworkIpAddress, StringFormat='IP: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Aktif IPv4 Ağ Arabirimi" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 6: OS & System Uptime -->
                    <ui:Card Grid.Row="2" Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Settings20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="İşletim Sistemi &amp; Uptime" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Hardware.OsVersion}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.OsVersion}"/>
                                <!-- Windows destek durumu (§5.8) -->
                                <TextBlock Text="{Binding WindowsSupport.Text}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindowsSupportWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Hardware.MachineName, StringFormat='{}Cihaz: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Hardware.UserName, StringFormat='{}Kullanıcı: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.SystemUptimeText, StringFormat='Çalışma Süresi: {0}'}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Partitions Section Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sabit Sürücüler &amp; Depolama Bölümleri" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Sürücü doluluk oranları, dosya sistemleri ve doğrudan hızlı bakım eylemleri." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Hardware.DiskActivityText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Interactive Drive Partitions Cards -->
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Name, Volume, Format, Usage Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Subtitle}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding VolumeLabel, StringFormat='({0})'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.XS}" Padding="6,2">
                                                <TextBlock Text="{Binding DriveFormat}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding UsagePercentage, StringFormat='%{0} Dolu'}" 
                                                   FontSize="{StaticResource Font.Body}" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"/>
                                    </Grid>

                                    <!-- Middle Row: Capacity Bar -->
                                    <ProgressBar Grid.Row="1" 
                                                 Value="{Binding UsagePercentage}" 
                                                 Maximum="100" 
                                                 Height="8" 
                                                 Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"
                                                 Margin="0,0,0,12"/>

                                    <!-- Bottom Row: Metrics & Quick Action Buttons -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedFree}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding FormattedTotal, StringFormat='Toplam Kapasite: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Direct Drive Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary"
                                                       Padding="10,4"
                                                       Margin="0,0,6,0"
                                                       Content="Disk Temizleme"
                                                       Icon="{ui:SymbolIcon Broom20}"
                                                       Command="{Binding DataContext.CleanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>

                                            <ui:Button Appearance="Secondary"
                                                       Padding="10,4"
                                                       Margin="0,0,6,0"
                                                       Content="Büyük Dosyaları Tara"
                                                       Icon="{ui:SymbolIcon Search20}"
                                                       Command="{Binding DataContext.ScanDriveForLargeFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>

                                            <ui:Button Appearance="Secondary"
                                                       Padding="8,4"
                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                       ToolTip="Sürücüyü Gezginde Aç"
                                                       Command="{Binding DataContext.OpenDriveInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================================================================= -->
                <!-- BOTTOM HALF: PLATFORM DIAGNOSTICS & SYSTEM REPORTING (ELIMINATES EMPTY VOID!) -->
                <!-- ================================================================= -->
                
                <!-- 1. Platform Teşhis & Güvenlik Bellenimi Paneli -->
                <ui:Card Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Platform Teşhisi &amp; Bellenim Güvenliği" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="UEFI Secure Boot, Donanım TPM, CPU sanallaştırma ve Windows güvenlik katmanı durumu." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 4-Pillar Diagnostic Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pillar 1: Secure Boot -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Shield20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Güvenli Önyükleme" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.SecureBootStatus}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Pillar 2: TPM -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="TPM Güvenlik Çipi" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.TpmStatus}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Pillar 3: Virtualization -->
                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="CPU Sanallaştırma" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.VirtualizationStatus}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Pillar 4: UAC Permission -->
                            <Border Grid.Column="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="ShieldKeyhole20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="UAC Yetki Düzeyi" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Yönetici (Tam Yetkili)" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Standart Kullanıcı" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ui:Card>

                <!-- 2. Tek Tıkla Sistem Raporu & Yönetim Konsolları (2-Kartlı Modern Düzen) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kart 1: Sistem Donanım Raporu & Paylaşım -->
                    <ui:Card Grid.Column="0" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.MD}"
                                        Width="40" Height="40"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Sistem Raporu &amp; Dışa Aktarım" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Tüm donanım ve depolama dökümünü HTML sayfası olarak kaydedin veya panoya kopyalayın." 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Actions -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <ui:Button Appearance="Primary"
                                           Content="HTML Raporu Oluştur"
                                           Icon="{ui:SymbolIcon DocumentBulletList20}"
                                           Command="{Binding ExportReportHtmlCommand}"
                                           Padding="14,8"
                                           Margin="0,0,8,0"
                                           ToolTip="Tüm donanım dökümünü zengin HTML sayfası olarak dışa aktarır ve tarayıcıda açar"/>

                                <ui:Button Appearance="Secondary"
                                           Content="Özeti Panoya Kopyala"
                                           Icon="{ui:SymbolIcon Copy20}"
                                           Command="{Binding CopySpecsToClipboardCommand}"
                                           Padding="13,8"
                                           ToolTip="Sistem özetini panoya kopyalar"/>
                            </WrapPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Kart 2: Windows Hızlı Yönetim Konsolları -->
                    <ui:Card Grid.Column="2" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.MD}"
                                        Width="40" Height="40"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Yönetim Konsolları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Diskler, aygıtlar ve arka plan süreçleri için yerel Windows araçlarını doğrudan başlatın." 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Actions -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <ui:Button Appearance="Secondary"
                                           Content="Disk Yönetimi"
                                           Icon="{ui:SymbolIcon HardDrive20}"
                                           Command="{Binding OpenDiskManagementCommand}"
                                           Padding="11,8"
                                           Margin="0,0,8,0"
                                           ToolTip="Windows Disk Yönetimi konsolunu (diskmgmt.msc) açar"/>

                                <ui:Button Appearance="Secondary"
                                           Content="Aygıt Yöneticisi"
                                           Icon="{ui:SymbolIcon Settings20}"
                                           Command="{Binding OpenDeviceManagerCommand}"
                                           Padding="11,8"
                                           Margin="0,0,8,0"
                                           ToolTip="Windows Aygıt Yöneticisi konsolunu (devmgmt.msc) açar"/>

                                <ui:Button Appearance="Secondary"
                                           Content="Görev Yöneticisi"
                                           Icon="{ui:SymbolIcon TopSpeed20}"
                                           Command="{Binding OpenTaskManagerCommand}"
                                           Padding="11,8"
                                           ToolTip="Windows Görev Yöneticisi aracını (taskmgr.exe) açar"/>
                            </WrapPanel>
                        </Grid>
                    </ui:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- 2: TAB 2 - S.M.A.R.T. SAĞLIK & FİZİKSEL DİSK ANALİZİ                       -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSmartTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <!-- Info Header Card -->
                <ui:Card Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Fiziksel Sürücü Güvenlik &amp; S.M.A.R.T. Analizi" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Sürücü denetleyicisinden doğrudan çekilen arayüz protokolü, donanım sıcaklığı ve yıpranma durumu." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Content="Disk Sağlığını Yenile"
                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                   Command="{Binding LoadSmartHealthCommand}"
                                   Padding="12,7"/>
                    </Grid>
                </ui:Card>

                <!-- Disks List -->
                <ItemsControl ItemsSource="{Binding SmartDisks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SmartDiskHealthItem}">
                            <ui:Card Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Disk Model & Health Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Model}" FontSize="{StaticResource Font.Subtitle}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding InterfaceType}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding MediaType}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding FormattedSize, StringFormat='Kapasite: {0}'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Health Pill Badge -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="{StaticResource Radius.MD}" 
                                                Padding="12,6" 
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="{StaticResource Font.Caption}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Separator Grid.Row="1" Margin="0,0,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                    <!-- Diagnostic Metrics (4 Columns) -->
                                    <Grid Grid.Row="2" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Operasyonel Durum" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding OperationalStatus}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Tahmini Sıcaklık" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Firmware Sürümü" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FirmwareRevision, TargetNullValue='Güncel'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Seri Numarası" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding SerialNumber, TargetNullValue='Korumalı'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Actions Row: TRIM Optimization -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SSD / NVMe diskler için periyodik TRIM hücre bloklarını temiz tutar." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        <ui:Button Grid.Column="1"
                                                   Appearance="Secondary"
                                                   Content="TRIM Komutu Gönder"
                                                   Icon="{ui:SymbolIcon TopSpeed20}"
                                                   Command="{Binding DataContext.RunTrimCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="C"
                                                   Padding="12,5"/>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
