<UserControl x:Class="Bakım.Views.Modules.SystemInfoModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Navigation -->
            <RowDefinition Height="*"/>    <!-- 1: Active Viewport Content -->
        </Grid.RowDefinitions>

        <!-- 0: Header Section & Sub-tab Switcher -->
                <!-- Sayfa basligi — tasarim sistemi bileseni -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Donanım, Depolama &amp; S.M.A.R.T."
                         Description="Sistem donanımı, NVMe/SSD S.M.A.R.T. sağlık raporu ve diskteki 1GB+ büyük dosya analizörü.">
            <c:SectionHeader.Actions>
                <!-- Sub-Tab Switcher & Refresh Button -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                <ui:Button Content="Donanım Özeti"
                Command="{Binding SwitchSubTabCommand}"
                CommandParameter="Hardware"
                Padding="14,6"
                Margin="0,0,4,0"/>
                <ui:Button Content="S.M.A.R.T. Sağlık"
                Command="{Binding SwitchSubTabCommand}"
                CommandParameter="Smart"
                Padding="14,6"
                Margin="0,0,4,0"/>
                <ui:Button Content="Büyük Dosyalar (1GB+)"
                Command="{Binding SwitchSubTabCommand}"
                CommandParameter="LargeFiles"
                Padding="14,6"/>
                </StackPanel>
                </Border>

                <ui:Button Appearance="Secondary"
                Command="{Binding RefreshCommand}"
                Padding="14,8"
                Content="Yenile"
                Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1: Content Viewport (Tab 1: Hardware Specs & Partitions) -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsHardwareTab, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Spec Cards Grid (3 Columns) -->
                <Grid Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Processor (CPU) -->
                    <ui:Card Grid.Row="0" Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="İşlemci (CPU)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hardware.CpuName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.CpuName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.CpuClockSpeed}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Hardware.CpuL3Cache}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ui:ProgressRing Grid.Column="1" 
                                                 Progress="{Binding Hardware.CpuPercentage}" 
                                                 Width="36" 
                                                 Height="36" 
                                                 IsIndeterminate="False"
                                                 Foreground="{Binding Hardware.CpuPercentage, Converter={StaticResource PercentageToBrush}}"
                                                 Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.ProcessorCount, StringFormat='{}Çekirdek: {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 2: Graphics (GPU) -->
                    <ui:Card Grid.Row="0" Grid.Column="2" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Desktop20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ekran Kartı (GPU)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Hardware.GpuName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.GpuName}"/>
                                <TextBlock Text="{Binding Hardware.GpuVram}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" 
                                       Text="{Binding Hardware.GpuDriverVersion, StringFormat='Sürücü: {0}'}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Hardware.GpuDriverVersion, StringFormat='Sürücü Sürümü: {0}'}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 3: Memory (RAM) -->
                    <ui:Card Grid.Row="0" Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="TopSpeed20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Fiziksel Bellek (RAM)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.RamSpeedMhz, StringFormat='{} ({0})'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.FreeRamGb, StringFormat='Boş: {0:F1} GB'}" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ui:ProgressRing Grid.Column="1" 
                                                 Progress="{Binding Hardware.RamPercentage}" 
                                                 Width="36" 
                                                 Height="36" 
                                                 IsIndeterminate="False"
                                                 Foreground="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"
                                                 Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.RamPercentage, StringFormat='%{0} Bellek Tüketiliyor'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 4: Motherboard & BIOS -->
                    <ui:Card Grid.Row="2" Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Laptop20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Anakart &amp; BIOS" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Hardware.MotherboardModel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.MotherboardModel}"/>
                                <TextBlock Text="{Binding Hardware.BiosVersion}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="SMBIOS / UEFI Donanım Katmanı" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 5: Device & OS -->
                    <ui:Card Grid.Row="2" Grid.Column="2" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Settings20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Cihaz &amp; İşletim Sistemi" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Hardware.OsVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.OsVersion}"/>
                                <TextBlock Text="{Binding Hardware.MachineName, StringFormat='Cihaz: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.UserName, StringFormat='Kullanıcı: {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 6: UAC & Security Status -->
                    <ui:Card Grid.Row="2" Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Shield20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Yetki Düzeyi" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Yönetici (Tam Yetkili)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Standart Kullanıcı" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                            <ui:Button Grid.Row="2" 
                                       Appearance="Secondary" 
                                       Command="{Binding RestartAsAdminCommand}"
                                       Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource InverseBoolToVis}}"
                                       Padding="8,3" 
                                       Margin="0,4,0,0"
                                       Content="Yönetici Olarak Başlat"
                                       Icon="{ui:SymbolIcon ShieldKeyhole20}"/>
                            <TextBlock Grid.Row="2" 
                                       Text="Yönetici ayrıcalıkları devrede." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       Margin="0,4,0,0"
                                       Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Partitions Header -->
                <TextBlock Text="Sabit Sürücü Bölümleri &amp; Doluluk Oranları" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           Margin="0,0,0,14"/>

                <!-- Drive Partitions Cards -->
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding VolumeLabel, StringFormat='({0})'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DriveFormat}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding UsagePercentage, StringFormat='%{0} Dolu'}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"/>
                                    </Grid>

                                    <ProgressBar Grid.Row="1" 
                                                 Value="{Binding UsagePercentage}" 
                                                 Maximum="100" 
                                                 Height="8" 
                                                 Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"
                                                 Margin="0,0,0,10"/>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FormattedFree}" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTotal, StringFormat='Toplam Kapasite: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Content Viewport (Tab 2: S.M.A.R.T. Health Cards) -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSmartTab, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ui:Card Padding="16,12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Fiziksel Sürücü Güvenlik &amp; S.M.A.R.T. Durumu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Sürücü denetleyicisinden doğrudan çekilen arayüz tipi, sağlık durumu ve donanım ömrü." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ItemsControl ItemsSource="{Binding SmartDisks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SmartDiskHealthItem}">
                            <ui:Card Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Disk Model & Health Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding InterfaceType}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding MediaType}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding FormattedSize, StringFormat='Kapasite: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Health Pill Badge -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12,6" 
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Separator Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                    <!-- Bottom Row: Diagnostic Details -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Operasyonel Durum" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding OperationalStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Tahmini Sıcaklık" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Firmware Sürümü" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FirmwareRevision, TargetNullValue='Güncel'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Seri Numarası" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding SerialNumber, TargetNullValue='Korumalı'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 3: Content Viewport (Tab 3: Large File Finder 1GB+) -->
        <Grid Grid.Row="1" Visibility="{Binding IsLargeFilesTab, Converter={StaticResource BoolToVis}}"
              Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Scanner Controls -->
                <RowDefinition Height="*"/>    <!-- Large Files List -->
            </Grid.RowDefinitions>

            <!-- Scanner Toolbar Card -->
            <ui:Card Grid.Row="0" Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Hedef Sürücü:" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            
                            <ComboBox ItemsSource="{Binding AvailableDrives}" AutomationProperties.Name="Sürücü filtresi" 
                                      SelectedItem="{Binding SelectedDriveFilter, Mode=TwoWay}"
                                      MinWidth="140"
                                      Padding="8,4"
                                      Margin="0,0,16,0"/>

                            <TextBlock Text="Eşik: " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="1 GB ve Üzeri" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Start / Cancel Scan Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" 
                                       Content="Büyük Dosyaları Tara" 
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding ScanLargeFilesCommand}"
                                       IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                       Padding="16,8" 
                                       Margin="0,0,8,0"/>

                            <ui:Button Appearance="Danger" 
                                       Content="Durdur" 
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Command="{Binding CancelScanCommand}"
                                       IsEnabled="{Binding IsScanning}"
                                       Padding="14,8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scan Progress Bar & Animated Beam -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status row: spinner + text -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="12" Height="12"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ScanProgressText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Indeterminate progress bar -->
                        <ProgressBar Grid.Row="1"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Height="4"
                                     Margin="0,0,0,4"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                        <!-- Animated radar scan beam -->
                        <Border Grid.Row="2"
                                Height="2"
                                ClipToBounds="True"
                                Margin="0,0,0,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <Rectangle HorizontalAlignment="Left" Width="180" Height="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource Color.Accent.Glow}" Offset="0.5"/>
                                        <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="LargeFileScanBeam"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LargeFileScanBeam"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-180" To="1400"
                                                                 Duration="0:0:1.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- Large Files Virtualized ListView -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding LargeFiles}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LargeDiskFileItem}">
                        <ui:Card Padding="14,12" ClipToBounds="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LargeExtCol"/> <!-- Extension Icon -->
                                    <ColumnDefinition Width="2.5*"/> <!-- File Name & Path -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LargeSizeCol"/>  <!-- Formatted Size -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LargeBarCol"/>  <!-- Visual Space Bar -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LargeActionCol"/> <!-- Action Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- Extension Badge -->
                                <Border Grid.Column="0" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,4" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,12,0"
                                        Visibility="{Binding Extension, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <!-- File Name & Full Path -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Formatted Size -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding SizeFormatted}" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                           VerticalAlignment="Center" 
                                           TextAlignment="Right" 
                                           Margin="0,0,14,0"/>

                                <!-- Visual Size Bar -->
                                <ProgressBar Grid.Column="3" 
                                             Value="{Binding SizePercentage}" 
                                             Maximum="100" 
                                             Height="6" 
                                             MinWidth="100"
                                             MaxWidth="180"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                             VerticalAlignment="Center" 
                                             Margin="0,0,14,0"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Secondary" 
                                               Icon="{ui:SymbolIcon FolderOpen20}"
                                               Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Klasörde Göster"
                                               Padding="8,6" 
                                               Margin="0,0,6,0" AutomationProperties.Name="Klasörde Göster"/>

                                    <ui:Button Appearance="Danger" 
                                               Icon="{ui:SymbolIcon Dismiss20}"
                                               Command="{Binding DataContext.DeleteLargeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                               ToolTip="Dosyayı Güvenle Sil"
                                               Padding="8,6" AutomationProperties.Name="Dosyayı Güvenle Sil"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
