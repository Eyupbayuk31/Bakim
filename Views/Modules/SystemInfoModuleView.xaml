<UserControl x:Class="Bakım.Views.Modules.SystemInfoModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel}"
             d:DesignHeight="950" d:DesignWidth="1100">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Segmented Sub-tab Switcher -->
            <RowDefinition Height="*"/>    <!-- 1: Active Viewport Content -->
        </Grid.RowDefinitions>

        <!-- 0: Header Section & Sub-tab Switcher -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Donanım &amp; Depolama"
                         Description="Gerçek zamanlı donanım telemetrisi, NVMe/SSD S.M.A.R.T. sağlık analizi ve akıllı disk temizleme merkezi.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Modern Fluent Segmented Sub-Tab Switcher -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 1: Hardware -->
                            <ui:Button Appearance="{Binding IsHardwareTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="Hardware"
                                       Padding="12,6"
                                       Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Donanım" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Tab 2: S.M.A.R.T. -->
                            <ui:Button Appearance="{Binding IsSmartTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="Smart"
                                       Padding="12,6"
                                       Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="S.M.A.R.T." VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Tab 3: Large Files -->
                            <ui:Button Appearance="{Binding IsLargeFilesTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="LargeFiles"
                                       Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderZip20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Büyük Dosyalar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Padding="14,8"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- ========================================================================= -->
        <!-- 1: TAB 1 - DONANIM & TELEMETRİ (OVERHAUL)                                  -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsHardwareTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <!-- 6 Modern KPI Spec Cards (2 Rows x 3 Columns Grid) -->
                <Grid Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Processor (CPU) -->
                    <ui:Card Grid.Row="0" Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="İşlemci (CPU)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hardware.CpuName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.CpuName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.CpuClockSpeed}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Hardware.CpuL3Cache}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Crystal-Clear CPU Load Meter (No visual glitches!) -->
                                <Border Grid.Column="1" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{Binding Hardware.CpuPercentage, Converter={StaticResource PercentageToBrush}}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Hardware.CpuPercentageText}" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Hardware.CpuPercentage, Converter={StaticResource PercentageToBrush}}"/>
                                        <TextBlock Text="YÜK" 
                                                   FontSize="8" 
                                                   FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.CpuCoresThreads}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 2: Graphics (GPU) -->
                    <ui:Card Grid.Row="0" Grid.Column="2" Padding="18" ToolTip="{Binding Hardware.GpuTooltip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Desktop20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ekran Kartı (GPU)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="6,1" 
                                        Margin="8,0,0,0" 
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Hardware.HasDualGpu, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Harici + Dahili" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hardware.GpuName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.GpuName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.GpuVram}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Hardware.DisplayResolution}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Hardware.DisplayRefreshRate, StringFormat='@ {0}'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ui:SymbolIcon Symbol="Tv20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" 
                                       Text="{Binding Hardware.GpuDriverVersion, StringFormat='Sürücü Sürümü: {0}'}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Hardware.GpuDriverVersion, StringFormat='Sürücü Sürümü: {0}'}"/>

                            <TextBlock Grid.Row="3" 
                                       Text="{Binding Hardware.GpuSecondaryName, StringFormat='Dahili: {0}'}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding Hardware.HasDualGpu, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 3: Memory (RAM) -->
                    <ui:Card Grid.Row="0" Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="TopSpeed20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Fiziksel Bellek (RAM)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.RamSpeedMhz, StringFormat='{} ({0})'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Hardware.FreeRamGb, StringFormat='Boş: {0:F1} GB'}" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Hardware.UsedRamGb, StringFormat='Dolu: {0:F1} GB'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- RAM Percentage Badge -->
                                <Border Grid.Column="1" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Hardware.RamPercentage, StringFormat='%{0}'}" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"/>
                                        <TextBlock Text="DOLU" 
                                                   FontSize="8" 
                                                   FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.RamPercentage, StringFormat='%{0} Bellek Tüketiliyor • Havuz Aktif'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 4: Motherboard & BIOS -->
                    <ui:Card Grid.Row="2" Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Laptop20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Anakart &amp; Bellenim" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Hardware.MotherboardModel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.MotherboardModel}"/>
                                <TextBlock Text="{Binding Hardware.BiosVersion}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="SMBIOS / UEFI Donanım Katmanı" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 5: Network & Connectivity (NEW!) -->
                    <ui:Card Grid.Row="2" Grid.Column="2" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="WifiSettings20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ağ &amp; Bağlantı" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Hardware.NetworkAdapterName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.NetworkAdapterName}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Hardware.NetworkLinkSpeed}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Hardware.NetworkIpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Aktif IPv4 Ağ Arabirimi" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Card 6: OS & System Uptime -->
                    <ui:Card Grid.Row="2" Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Settings20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="İşletim Sistemi &amp; Uptime" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Hardware.OsVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.OsVersion}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Hardware.MachineName, StringFormat='{}Cihaz: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Hardware.UserName, StringFormat='{}Kullanıcı: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{Binding Hardware.SystemUptimeText, StringFormat='Çalışma Süresi: {0}'}" FontSize="10" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Partitions Section Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sabit Sürücüler &amp; Depolama Bölümleri" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Sürücü doluluk oranları, dosya sistemleri ve doğrudan hızlı bakım eylemleri." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Hardware.DiskActivityText}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Interactive Drive Partitions Cards -->
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Name, Volume, Format, Usage Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding VolumeLabel, StringFormat='({0})'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DriveFormat}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding UsagePercentage, StringFormat='%{0} Dolu'}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"/>
                                    </Grid>

                                    <!-- Middle Row: Capacity Bar -->
                                    <ProgressBar Grid.Row="1" 
                                                 Value="{Binding UsagePercentage}" 
                                                 Maximum="100" 
                                                 Height="8" 
                                                 Foreground="{Binding UsagePercentage, Converter={StaticResource PercentageToBrush}}"
                                                 Margin="0,0,0,12"/>

                                    <!-- Bottom Row: Metrics & Quick Action Buttons -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedFree}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding FormattedTotal, StringFormat='Toplam Kapasite: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Direct Drive Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary"
                                                       Padding="10,4"
                                                       Margin="0,0,6,0"
                                                       Content="Disk Temizleme"
                                                       Icon="{ui:SymbolIcon Broom20}"
                                                       Command="{Binding DataContext.CleanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>

                                            <ui:Button Appearance="Secondary"
                                                       Padding="10,4"
                                                       Margin="0,0,6,0"
                                                       Content="Büyük Dosyaları Tara"
                                                       Icon="{ui:SymbolIcon Search20}"
                                                       Command="{Binding DataContext.ScanDriveForLargeFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>

                                            <ui:Button Appearance="Secondary"
                                                       Padding="8,4"
                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                       ToolTip="Sürücüyü Gezginde Aç"
                                                       Command="{Binding DataContext.OpenDriveInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================================================================= -->
                <!-- BOTTOM HALF: PLATFORM DIAGNOSTICS & SYSTEM REPORTING (ELIMINATES EMPTY VOID!) -->
                <!-- ================================================================= -->
                
                <!-- 1. Platform Teşhis & Güvenlik Bellenimi Paneli -->
                <ui:Card Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Platform Teşhisi &amp; Bellenim Güvenliği" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="UEFI Secure Boot, Donanım TPM, CPU sanallaştırma ve Windows güvenlik katmanı durumu." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 4-Pillar Diagnostic Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pillar 1: Secure Boot -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Shield20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Güvenli Önyükleme" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.SecureBootStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Pillar 2: TPM -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="TPM Güvenlik Çipi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.TpmStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Pillar 3: Virtualization -->
                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="CPU Sanallaştırma" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.VirtualizationStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Pillar 4: UAC Permission -->
                            <Border Grid.Column="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="ShieldKeyhole20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="UAC Yetki Düzeyi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Yönetici (Tam Yetkili)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Standart Kullanıcı" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding Hardware.IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ui:Card>

                <!-- 2. Tek Tıkla Sistem Raporu & Yönetim Konsolları (2-Kartlı Modern Düzen) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kart 1: Sistem Donanım Raporu & Paylaşım -->
                    <ui:Card Grid.Column="0" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="40" Height="40"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Sistem Raporu &amp; Dışa Aktarım" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Tüm donanım ve depolama dökümünü HTML sayfası olarak kaydedin veya panoya kopyalayın." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Actions -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <ui:Button Appearance="Primary"
                                           Content="HTML Raporu Oluştur"
                                           Icon="{ui:SymbolIcon DocumentBulletList20}"
                                           Command="{Binding ExportReportHtmlCommand}"
                                           Padding="14,8"
                                           Margin="0,0,8,0"
                                           ToolTip="Tüm donanım dökümünü zengin HTML sayfası olarak dışa aktarır ve tarayıcıda açar"/>

                                <ui:Button Appearance="Secondary"
                                           Content="Özeti Panoya Kopyala"
                                           Icon="{ui:SymbolIcon Copy20}"
                                           Command="{Binding CopySpecsToClipboardCommand}"
                                           Padding="13,8"
                                           ToolTip="Sistem özetini panoya kopyalar"/>
                            </WrapPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Kart 2: Windows Hızlı Yönetim Konsolları -->
                    <ui:Card Grid.Column="2" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="40" Height="40"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Yönetim Konsolları" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Diskler, aygıtlar ve arka plan süreçleri için yerel Windows araçlarını doğrudan başlatın." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Actions -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <ui:Button Appearance="Secondary"
                                           Content="Disk Yönetimi"
                                           Icon="{ui:SymbolIcon HardDrive20}"
                                           Command="{Binding OpenDiskManagementCommand}"
                                           Padding="11,8"
                                           Margin="0,0,8,0"
                                           ToolTip="Windows Disk Yönetimi konsolunu (diskmgmt.msc) açar"/>

                                <ui:Button Appearance="Secondary"
                                           Content="Aygıt Yöneticisi"
                                           Icon="{ui:SymbolIcon Settings20}"
                                           Command="{Binding OpenDeviceManagerCommand}"
                                           Padding="11,8"
                                           Margin="0,0,8,0"
                                           ToolTip="Windows Aygıt Yöneticisi konsolunu (devmgmt.msc) açar"/>

                                <ui:Button Appearance="Secondary"
                                           Content="Görev Yöneticisi"
                                           Icon="{ui:SymbolIcon TopSpeed20}"
                                           Command="{Binding OpenTaskManagerCommand}"
                                           Padding="11,8"
                                           ToolTip="Windows Görev Yöneticisi aracını (taskmgr.exe) açar"/>
                            </WrapPanel>
                        </Grid>
                    </ui:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- 2: TAB 2 - S.M.A.R.T. SAĞLIK & FİZİKSEL DİSK ANALİZİ                       -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSmartTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <!-- Info Header Card -->
                <ui:Card Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Fiziksel Sürücü Güvenlik &amp; S.M.A.R.T. Analizi" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Sürücü denetleyicisinden doğrudan çekilen arayüz protokolü, donanım sıcaklığı ve yıpranma durumu." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Content="Disk Sağlığını Yenile"
                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                   Command="{Binding LoadSmartHealthCommand}"
                                   Padding="12,7"/>
                    </Grid>
                </ui:Card>

                <!-- Disks List -->
                <ItemsControl ItemsSource="{Binding SmartDisks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SmartDiskHealthItem}">
                            <ui:Card Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Disk Model & Health Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding InterfaceType}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding MediaType}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding FormattedSize, StringFormat='Kapasite: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Health Pill Badge -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12,6" 
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Separator Grid.Row="1" Margin="0,0,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                    <!-- Diagnostic Metrics (4 Columns) -->
                                    <Grid Grid.Row="2" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Operasyonel Durum" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding OperationalStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Tahmini Sıcaklık" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Firmware Sürümü" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FirmwareRevision, TargetNullValue='Güncel'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Seri Numarası" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding SerialNumber, TargetNullValue='Korumalı'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Actions Row: TRIM Optimization -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SSD / NVMe diskler için periyodik TRIM hücre bloklarını temiz tutar." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        <ui:Button Grid.Column="1"
                                                   Appearance="Secondary"
                                                   Content="TRIM Komutu Gönder"
                                                   Icon="{ui:SymbolIcon TopSpeed20}"
                                                   Command="{Binding DataContext.RunTrimCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="C"
                                                   Padding="12,5"/>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- 3: TAB 3 - BÜYÜK DOSYA ANALİZÖRÜ (1GB+) (OVERHAUL)                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsLargeFilesTab, Converter={StaticResource BoolToVis}}"
              Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Scanner Controls & Filters -->
                <RowDefinition Height="*"/>    <!-- Content Area (Empty States or Results) -->
            </Grid.RowDefinitions>

            <!-- 1. Scanner Toolbar Card (Fully Responsive Layout with WrapPanels) -->
            <ui:Card Grid.Row="0" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Target Drive Selector & Primary Actions -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Subtle Divider -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Threshold Chips & Category Chips (WrapPanel) -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Live Search, Multi-Sort & Summary Badge -->
                        <RowDefinition Height="Auto"/> <!-- Row 4: Progress & Radar Scan Beam -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Target Drive & Primary Actions (Scan & Stop) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drive Selector -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Hedef Sürücü:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableDrives}" AutomationProperties.Name="Sürücü filtresi" 
                                      SelectedItem="{Binding SelectedDriveFilter, Mode=TwoWay}"
                                      MinWidth="140"
                                      Padding="8,5"/>
                        </StackPanel>

                        <!-- Right: Scan & Stop Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" 
                                       Content="Büyük Dosyaları Tara" 
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding ScanLargeFilesCommand}"
                                       IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                       Padding="14,7" 
                                       Margin="0,0,8,0"/>

                            <ui:Button Appearance="Danger" 
                                       Content="Durdur" 
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Command="{Binding CancelScanCommand}"
                                       IsEnabled="{Binding IsScanning}"
                                       Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Subtle Divider -->
                    <Separator Grid.Row="1" Margin="0,2,0,10" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Row 2: Filter Presets (Threshold Chips & Category Chips in a WrapPanel) -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <!-- Boyut Eşiği Grubu -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                            <TextBlock Text="Boyut Eşiği:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Content="100 MB+" 
                                       Appearance="{Binding IsThreshold100Mb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="100" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="500 MB+" 
                                       Appearance="{Binding IsThreshold500Mb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="500" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="1 GB+" 
                                       ToolTip="Varsayılan ve önerilen boyut eşiği (1 GB ve üzeri)"
                                       Appearance="{Binding IsThreshold1Gb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="1024" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="2 GB+" 
                                       Appearance="{Binding IsThreshold2Gb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="2048" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="5 GB+" 
                                       Appearance="{Binding IsThreshold5Gb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="5120" 
                                       Padding="8,4"/>
                        </StackPanel>

                        <!-- Tür Filtresi Grubu -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="Tür Filtresi:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Content="Tümü" 
                                       Appearance="{Binding IsCategoryAll, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Tümü" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Videolar" 
                                       Appearance="{Binding IsCategoryVideo, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Video" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Disk İmajları" 
                                       Appearance="{Binding IsCategoryDiskImage, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Disk İmajı" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Arşivler" 
                                       Appearance="{Binding IsCategoryArchive, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Arşiv" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Kurulum / Oyun" 
                                       Appearance="{Binding IsCategoryInstaller, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Kurulum / Oyun" 
                                       Padding="9,4"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Row 3: Live Search, Multi-Sort Selector & Summary Badge -->
                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: SearchBox & Sort Selector in WrapPanel -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Live SearchBox -->
                            <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Dosya veya uzantı ara..."
                                        ClearButtonEnabled="True"
                                        MinWidth="170"
                                        Padding="8,5"
                                        Margin="0,0,10,4"
                                        AutomationProperties.Name="Dosya arama kutusu"/>

                            <!-- Sort Selector -->
                            <ComboBox SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      MinWidth="150"
                                      Padding="8,5"
                                      Margin="0,0,10,4"
                                      AutomationProperties.Name="Sıralama Seçici">
                                <ComboBoxItem Content="Boyut (Büyükten)" Tag="SizeDesc"/>
                                <ComboBoxItem Content="Boyut (Küçükten)" Tag="SizeAsc"/>
                                <ComboBoxItem Content="Tarih (En Yeni)" Tag="DateDesc"/>
                                <ComboBoxItem Content="Tarih (En Eski)" Tag="DateAsc"/>
                                <ComboBoxItem Content="İsim (A-Z)" Tag="NameAsc"/>
                                <ComboBoxItem Content="İsim (Z-A)" Tag="NameDesc"/>
                            </ComboBox>
                        </WrapPanel>

                        <!-- Right: File Count & Total Size Summary Badge -->
                        <Border Grid.Column="1" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12,5"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TotalLargeFilesSizeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Scan Progress & Radar Beam -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status text -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,4"
                                    Visibility="{Binding ScanProgressText, Converter={StaticResource StringToVis}}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="12" Height="12"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ScanProgressText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Indeterminate progress bar -->
                        <ProgressBar Grid.Row="1"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Height="4"
                                     Margin="0,0,0,4"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

                        <!-- Animated radar scan beam -->
                        <Border Grid.Row="2"
                                Height="2"
                                ClipToBounds="True"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <Rectangle HorizontalAlignment="Left" Width="180" Height="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource Color.Accent.Glow}" Offset="0.5"/>
                                        <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="LargeFileScanBeam"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LargeFileScanBeam"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-180" To="1400"
                                                                 Duration="0:0:1.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- 2. CONTENT AREA: HERO EMPTY STATE / ZERO-RESULTS STATE / RESULTS STATE -->
            <Grid Grid.Row="1">
                <!-- 2A. HERO EMPTY STATE (Before Scan) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Margin="0,0,0,16">
                        <!-- Sürücü Depolama Özeti Kartı -->
                        <ui:Card Padding="18,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Drive Info & Usage Percent Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedDriveName}"/><Run Text=" ("/><Run Text="{Binding SelectedDriveVolumeLabel}"/><Run Text=") - "/><Run Text="{Binding SelectedDriveFormat}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Usage Badge -->
                                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                            <Run Text="% "/><Run Text="{Binding SelectedDriveUsagePercentage}"/><Run Text=" Dolu"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Visual Drive Usage Bar -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding SelectedDriveUsagePercentage}"
                                             Maximum="100"
                                             Height="8"
                                             Margin="0,12,0,12"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                <!-- 3 Key Storage Metrics -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Metric 1: Total Capacity -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Toplam Kapasite" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedDriveTotalGb}"/><Run Text=" GB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 2: Used Space -->
                                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Kullanılan Alan" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedDriveUsedGb}"/><Run Text=" GB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 3: Free Space -->
                                    <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Boş Alan" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedDriveFreeGb}"/><Run Text=" GB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ui:Card>

                        <!-- 4 Quick Guidance Cards (2x2 Grid) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Guide 1: Videos -->
                            <ui:Card Grid.Row="0" Grid.Column="0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#20A855F7" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Video24" FontSize="18" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Büyük Videolar &amp; Kayıtlar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="MP4, MKV, AVI, TS. 4K ekran ve oyun kayıtları diskin en büyük kısmını kaplayabilir." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Guide 2: Disk Images -->
                            <ui:Card Grid.Row="0" Grid.Column="2" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2038BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sanal Diskler &amp; İmajlar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="ISO, VMDK, VHDX, IMG. Kurulum kalıpları ve sanal makineler tek başına onlarca gigabayt yer kaplar." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Guide 3: Archives -->
                            <ui:Card Grid.Row="2" Grid.Column="0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#20F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="FolderZip24" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Arşiv &amp; Sıkıştırılmış Paketler" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="ZIP, RAR, 7Z, TAR. İndirilip açıldıktan sonra unutulan büyük yedek arşivleri." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Guide 4: Installers -->
                            <ui:Card Grid.Row="2" Grid.Column="2" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Kurulum &amp; Oyun Paketleri" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="EXE, MSI, PAK, DAT. Büyük oyun yükleyicileri ve artık gereksiz kurulum paketleri." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </Grid>

                        <!-- Hero Scan CTA Callout -->
                        <ui:Card Padding="24,20" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Sürücünüzü derinlemesine tarayarak en çok alan kaplayan dosyaları bulun ve güvenle temizleyin." 
                                           FontSize="13" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <ui:Button Appearance="Primary"
                                           Content="Büyük Dosya Taramasını Başlat"
                                           Icon="{ui:SymbolIcon Search24}"
                                           Command="{Binding ScanLargeFilesCommand}"
                                           Padding="22,10"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2B. ZERO-RESULTS AFTER SCAN STATE -->
                <ui:Card Padding="32,24" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center"
                         MaxWidth="560"
                         Visibility="{Binding HasNoResultsAfterScan, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="42" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Eşik Değerinin Üzerinde Dosya Bulunamadı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Seçili sürücüde belirlenen boyut eşiğini aşan herhangi bir dosya tespit edilmedi. Daha düşük boyutlu dosyaları listelemek için aşağıdaki seçenekleri deneyebilirsiniz:" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   Margin="0,0,0,16"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Content="100 MB+ ile Yeniden Tara"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding SetThresholdCommand}"
                                       CommandParameter="100"
                                       Padding="14,8"
                                       Margin="0,0,8,0"/>
                            <ui:Button Appearance="Secondary"
                                       Content="500 MB+ ile Yeniden Tara"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding SetThresholdCommand}"
                                       CommandParameter="500"
                                       Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 2C. RESULTS STATE (Category Bar + Batch Toolbar + Virtualized List) -->
                <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Category Distribution Legend Bar -->
                        <RowDefinition Height="Auto"/> <!-- Multi-Select & Batch Actions Bar -->
                        <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                    </Grid.RowDefinitions>

                    <!-- Category Distribution Legend Bar -->
                    <ui:Card Grid.Row="0" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <!-- Video -->
                            <Border Background="#20A855F7" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Video24" FontSize="14" Foreground="#A855F7" Margin="0,0,6,0"/>
                                    <TextBlock Text="Videolar: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.VideoFormatted}" FontSize="11" FontWeight="Bold" Foreground="#A855F7"/>
                                </StackPanel>
                            </Border>
                            <!-- Disk Image -->
                            <Border Background="#2038BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="HardDrive24" FontSize="14" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                    <TextBlock Text="Disk İmajı: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.DiskImageFormatted}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                            <!-- Archive -->
                            <Border Background="#20F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" Foreground="#F59E0B" Margin="0,0,6,0"/>
                                    <TextBlock Text="Arşiv: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.ArchiveFormatted}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                </StackPanel>
                            </Border>
                            <!-- Installer -->
                            <Border Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="14" Foreground="#10B981" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kurulum/Oyun: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.InstallerFormatted}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                            <!-- Other -->
                            <Border Background="#2094A3B8" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                    <TextBlock Text="Diğer: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.OtherFormatted}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ui:Card>

                    <!-- Multi-Select & Batch Actions Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: CheckBox & Selected Count Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                      Content="Tümünü Seç"
                                      FontSize="12"
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"
                                      Margin="4,0,12,0"
                                      AutomationProperties.Name="Tümünü Seç"/>

                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Seçilen: "/><Run Text="{Binding SelectedFilesCount}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Run Text=" dosya ("/><Run Text="{Binding SelectedFilesTotalBytesFormatted}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Run Text=")"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Right: Batch Recycle & Batch Delete Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Delete20}"
                                       Content="Geri Dönüşüme Taşı"
                                       Command="{Binding RecycleSelectedFilesCommand}"
                                       IsEnabled="{Binding HasSelectedFiles}"
                                       Padding="12,6"
                                       Margin="0,0,8,0"
                                       ToolTip="Seçili dosyaları güvenle Geri Dönüşüm Kutusuna gönderir"/>
                            <ui:Button Appearance="Danger"
                                       Icon="{ui:SymbolIcon Dismiss20}"
                                       Content="Kalıcı Olarak Sil"
                                       Command="{Binding DeleteSelectedFilesCommand}"
                                       IsEnabled="{Binding HasSelectedFiles}"
                                       Padding="12,6"
                                       ToolTip="Seçili dosyaları diskten kalıcı olarak siler"/>
                        </StackPanel>
                    </Grid>

                    <!-- Virtualized ListView -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding FilteredLargeFiles}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LargeDiskFileItem}">
                                <ui:Card Padding="12,10" ClipToBounds="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>                                <!-- CheckBox -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeIconCol"/> <!-- Category Icon Symbol -->
                                            <ColumnDefinition Width="2.5*"/>                                <!-- File Name & Path -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeCatCol"/>  <!-- Category Badge -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeSizeCol"/> <!-- Formatted Size -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeActionCol"/><!-- Action Buttons -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Multi-Select CheckBox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  AutomationProperties.Name="Dosya Seçimi"/>

                                        <!-- Category Icon Symbol -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8,6" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="{Binding CategorySymbol}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>

                                        <!-- File Name, Full Path & Date -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding LastModifiedFormatted}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Category Badge -->
                                        <Border Grid.Column="3" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8,4" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <!-- Formatted Size -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding SizeFormatted}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextAlignment="Right" 
                                                   Margin="0,0,16,0"/>

                                        <!-- Action Buttons: Copy Path, Safe Recycle Bin, Folder Location, Permanent Delete -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary" 
                                                       Icon="{ui:SymbolIcon Copy20}"
                                                       Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Dosya Yolunu Panoya Kopyala"
                                                       Padding="8,6" 
                                                       Margin="0,0,6,0" 
                                                       AutomationProperties.Name="Dosya Yolunu Panoya Kopyala"/>

                                            <ui:Button Appearance="Secondary" 
                                                       Icon="{ui:SymbolIcon Delete20}"
                                                       Command="{Binding DataContext.SendToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Geri Dönüşüm Kutusuna Taşı (Güvenli Silme)"
                                                       Padding="8,6" 
                                                       Margin="0,0,6,0" 
                                                       AutomationProperties.Name="Geri Dönüşüm Kutusuna Taşı"/>

                                            <ui:Button Appearance="Secondary" 
                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                       Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Klasörde Göster"
                                                       Padding="8,6" 
                                                       Margin="0,0,6,0" 
                                                       AutomationProperties.Name="Klasörde Göster"/>

                                            <ui:Button Appearance="Danger" 
                                                       Icon="{ui:SymbolIcon Dismiss20}"
                                                       Command="{Binding DataContext.DeleteLargeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                                       ToolTip="Kalıcı Olarak Sil"
                                                       Padding="8,6" 
                                                       AutomationProperties.Name="Kalıcı Olarak Sil"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
