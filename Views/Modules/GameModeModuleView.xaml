<UserControl x:Class="Bakım.Views.Modules.GameModeModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameModeViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <c:SectionHeader IsPageTitle="True"
                             Icon="Games24"
                             HeaderMargin="0,0,0,18"
                             Title="Oyun Modu"
                             Description="Oyun oturumu boyunca performans güç planını açar ve Bakım'ın arka plan işlerini duraklatır. Kapatınca her şey önceki haline döner."/>

            <!-- Durum kartı -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="{StaticResource Pad.Card}"
                    Margin="{StaticResource Gap.Bottom.MD}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Games24" FontSize="40" Filled="{Binding IsActive}"
                                   Margin="{StaticResource Gap.Right.MD}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                   Margin="{StaticResource Gap.Top.XS}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="{StaticResource Gap.Right.SM}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <ui:Button Appearance="Primary"
                                   Padding="18,10"
                                   Icon="{ui:SymbolIcon Games24}"
                                   Content="{Binding ButtonText}"
                                   Command="{Binding ToggleCommand}"
                                   ToolTip="Kısayol: Ctrl+Shift+G"
                                   AutomationProperties.Name="Oyun Modunu aç veya kapat"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Son işlem -->
            <ui:InfoBar Title="Son işlem"
                        Message="{Binding LastSummary}"
                        IsOpen="{Binding HasLastSummary, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Informational"
                        Margin="{StaticResource Gap.Bottom.MD}"/>

            <!-- Profil (§5.5) -->
            <TextBlock Text="Profil" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Bottom.SM}"/>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="{StaticResource Pad.Card}"
                    Margin="{StaticResource Gap.Bottom.MD}">
                <StackPanel>
                    <Grid Margin="{StaticResource Gap.Bottom.MD}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Güç planı" Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Text="Kapatınca her zaman önceki plan geri yüklenir." Style="{StaticResource Text.BodySecondary}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="260" VerticalAlignment="Center"
                                  ItemsSource="{Binding PowerPlanOptions}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding PowerPlan}"
                                  AutomationProperties.Name="Oyun Modu güç planı"/>
                    </Grid>

                    <Grid Margin="{StaticResource Gap.Bottom.MD}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Çalışma kümelerini kırp" Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Text="Arka plandaki süreçlerin kullanmadığı belleği Windows'a geri verir. Etkisi geçicidir." Style="{StaticResource Text.BodySecondary}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TrimMemory}" VerticalAlignment="Center"
                                         AutomationProperties.Name="Çalışma kümelerini kırp"/>
                    </Grid>

                    <TextBlock Text="Askıya alınacak arka plan uygulamaları" Style="{StaticResource Text.BodyStrong}"/>
                    <TextBlock Text="Süreç adları, virgülle (ör. OneDrive, Teams). Oyun Modu kapanınca, Bakım kapanınca ya da çökse bile bir sonraki açılışta devam ettirilir. Windows'un kritik süreçleri askıya alınmaz."
                               Style="{StaticResource Text.BodySecondary}" Margin="{StaticResource Gap.Bottom.XS}"/>
                    <ui:TextBox Text="{Binding SuspendApps, UpdateSourceTrigger=LostFocus}"
                                PlaceholderText="OneDrive, Teams"
                                AutomationProperties.Name="Askıya alınacak uygulamalar"/>
                    <TextBlock Text="{Binding SuspendAppsPreview}" FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="{StaticResource Gap.Top.XS}"/>

                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,14"/>

                    <Grid Margin="{StaticResource Gap.Bottom.SM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Oyun başlayınca otomatik aç" Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Text="Listedeki bir oyun çalışınca Oyun Modu açılır; hepsi kapanınca kapanır. Elle açtıysanız otomatik kapatılmaz."
                                       Style="{StaticResource Text.BodySecondary}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" VerticalAlignment="Center"
                                         AutomationProperties.Name="Oyun başlayınca Oyun Modunu otomatik aç"/>
                    </Grid>
                    <ui:TextBox Text="{Binding AutoStartExes, UpdateSourceTrigger=LostFocus}"
                                PlaceholderText="cs2, valorant, eldenring"
                                IsEnabled="{Binding AutoStart}"
                                AutomationProperties.Name="Otomatik tetikleyen oyunlar"/>
                    <TextBlock Text="{Binding AutoStartPreview}" FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="{StaticResource Gap.Top.XS}"/>
                </StackPanel>
            </Border>

            <!-- Ne yapılır -->
            <TextBlock Text="Açıldığında" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Bottom.SM}"/>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="{StaticResource Pad.Card}"
                    Margin="{StaticResource Gap.Bottom.MD}">
                <StackPanel>
                    <DockPanel Margin="{StaticResource Gap.Bottom.SM}">
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="20" Margin="{StaticResource Gap.Right.SM}" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Seçili güç planı" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="O anki plan kaydedilir; kapatınca birebir geri gelir. Bakım kapanır ya da çökerse bir sonraki açılışta onarılır."
                                       FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="{StaticResource Gap.Bottom.SM}">
                        <ui:SymbolIcon Symbol="Pause24" FontSize="20" Margin="{StaticResource Gap.Right.SM}" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Bakım'ın arka plan işleri duraklatılır" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Otomatik bellek temizliği ve bakım denetimleri oyun sırasında çalışmaz."
                                       FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Ram20" FontSize="20" Margin="{StaticResource Gap.Right.SM}" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Çalışma kümeleri kırpılır" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Arka plandaki süreçlerin kullanmadığı bellek Windows'a geri verilir. Etkisi geçicidir; ölçülen sonuç işlemden sonra gösterilir."
                                       FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Son oturumlar -->
            <TextBlock Text="Son oturumlar" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Bottom.SM}"/>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="{StaticResource Pad.CardCompact}">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" MinWidth="160"
                                               FontSize="{StaticResource Font.Body}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="{StaticResource Font.Body}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <c:StatusBadge Grid.Column="2" Text="{Binding OutcomeText}" Intent="{Binding OutcomeIntent}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Henüz kayıtlı oturum yok. Oyun Modunu kapattığınızda oturum süresi ve sonucu burada görünür."
                               FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Margin="4,6"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
