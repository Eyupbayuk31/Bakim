<UserControl x:Class="Bakım.Views.Modules.WindowsToolsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowsToolsViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100">

    <c:ModulePage Title="Windows Araçları"
                  Subtitle="Kayıt Defteri Düzenleyicisi, Aygıt Yöneticisi, Görev Zamanlayıcı ve diğer yerleşik araçlar tek yerde."
                  IsScrollable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="0,0,0,20">

                <!-- Klasik fotoğraf görüntüleyicisi: tek ayar kartı -->
                <ui:CardControl Style="{StaticResource Card.Setting}" Icon="{ui:SymbolIcon Image24}" Margin="{StaticResource Gap.Bottom.MD}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Windows Fotoğraf Görüntüleyicisi" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Windows 7'deki hızlı açılan görüntüleyiciyi .jpg, .png, .bmp ve .gif için yeniden kullanılabilir yapar."
                                       Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid>
                        <TextBlock Text="Etkin" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsPhotoViewerActivated, Converter={StaticResource BoolToVis}}"/>
                        <ui:Button Appearance="Secondary" Content="Etkinleştir"
                                   Command="{Binding ActivateWindowsPhotoViewerCommand}"
                                   Visibility="{Binding IsPhotoViewerActivated, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </ui:CardControl>

                <ui:InfoBar Title="İşlem durumu"
                            Message="{Binding ToolOperationMessage}"
                            Severity="{Binding ToolOperationSeverity}"
                            IsOpen="{Binding IsToolOperationMessageOpen}"
                            Margin="{StaticResource Gap.Bottom.MD}"/>

                <!-- Filtre çipleri + arama (kartsız) -->
                <DockPanel LastChildFill="False" Margin="{StaticResource Gap.Bottom.MD}">
                    <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Tümü'}"
                                   Command="{Binding SetToolCategoryCommand}" CommandParameter="Tümü"
                                   Content="Tümü" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Sistem'}"
                                   Command="{Binding SetToolCategoryCommand}" CommandParameter="Sistem"
                                   Content="Sistem ve çekirdek" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Donanım &amp; Disk'}"
                                   Command="{Binding SetToolCategoryCommand}" CommandParameter="Donanım &amp; Disk"
                                   Content="Donanım ve disk" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Ağ &amp; Güvenlik'}"
                                   Command="{Binding SetToolCategoryCommand}" CommandParameter="Ağ &amp; Güvenlik"
                                   Content="Ağ ve güvenlik" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Hızlı Erişim'}"
                                   Command="{Binding SetToolCategoryCommand}" CommandParameter="Hızlı Erişim"
                                   Content="Klasik araçlar" Margin="0,0,6,4"/>
                    </WrapPanel>
                    <ui:TextBox DockPanel.Dock="Right"
                                Text="{Binding ToolSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Araç ara (ör. regedit, aygıt)"
                                ClearButtonEnabled="True"
                                Width="260"
                                Icon="{ui:SymbolIcon Search24}"
                                AutomationProperties.Name="Araç ara"/>
                </DockPanel>

                <!-- Araç kutucukları (Windows 11 "Windows Araçları" gibi): tüm kutucuk tıklanabilir -->
                <ItemsControl ItemsSource="{Binding DisplayClassicTools}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ClassicAppItem}">
                            <ui:CardAction IsChevronVisible="False" Margin="0,0,4,4" Padding="16,14"
                                           VerticalContentAlignment="Top"
                                           Command="{Binding DataContext.LaunchClassicToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="{Binding Title}"
                                           ToolTip="{Binding Description}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}"
                                                   FontSize="28" Margin="0,0,14,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SettingTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.SettingDescription}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="{StaticResource Font.Caption}" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </c:ModulePage>
</UserControl>
