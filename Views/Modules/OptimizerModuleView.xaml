<UserControl x:Class="Bakım.Views.Modules.OptimizerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:OptimizerViewModel}"
             d:DesignHeight="750" d:DesignWidth="950">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Actions -->
            <RowDefinition Height="Auto"/> <!-- Result Banner -->
            <RowDefinition Height="Auto"/> <!-- RAM Card -->
            <RowDefinition Height="*"/>    <!-- Top Processes Table -->
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Bellek ve Süreçler" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Fiziksel bellek kullanımı ve çalışan işlemler." 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ToggleSwitch IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                                 OnContent="Canlı İzleme"
                                 OffContent="Canlı İzleme"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>

                <ui:Button Appearance="Secondary" 
                           Command="{Binding RefreshCommand}"
                           Padding="14,8"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Margin="0,0,8,0"/>

                <ui:Button Appearance="Primary" 
                           Command="{Binding OptimizeRamCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                           Padding="16,8"
                           Content="Belleği Temizle"
                           Icon="{ui:SymbolIcon Flash24}"/>
            </StackPanel>
        </Grid>

        <!-- Result InfoBar -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="Success" 
                    Title="Optimizasyon Tamamlandı" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,16"/>

        <!-- RAM Status Overview Card -->
        <ui:Card Grid.Row="2" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Fiziksel Bellek Durumu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding Hardware.RamPercentage, StringFormat='%{0} Dolu'}" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"/>
                </Grid>

                <ProgressBar Grid.Row="1" 
                             Value="{Binding Hardware.RamPercentage}" 
                             Maximum="100" 
                             Height="8" 
                             Foreground="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"
                             Margin="0,0,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kullanılan Bellek" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Hardware.UsedRamGb, StringFormat='{}{0:F1} GB'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Kullanılabilir / Boş" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Hardware.FreeRamGb, StringFormat='{}{0:F1} GB'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Toplam Donanım RAM" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Top Processes Table Card -->
        <ui:Card Grid.Row="3" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="En Yüksek Bellek Tüketen Süreçler" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding TopProcesses.Count, StringFormat='Aktif İşlem: {0}'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <!-- Table Column Header (Strictly Matching Row Columns with Interactive Dynamic Sorting) -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                        CornerRadius="6" 
                        Padding="12,8" 
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Process Name Sort Header -->
                        <Border Grid.Column="0" Cursor="Hand" Background="Transparent" VerticalAlignment="Center">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="Name"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="İşlem Adı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"
                                               Visibility="{Binding IsNameDesc, Converter={StaticResource BoolToVis}}"/>
                                <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"
                                               Visibility="{Binding IsNameAsc, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 1: PID Sort Header -->
                        <Border Grid.Column="1" Cursor="Hand" Background="Transparent" VerticalAlignment="Center">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="PID"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PID" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"
                                               Visibility="{Binding IsPidDesc, Converter={StaticResource BoolToVis}}"/>
                                <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"
                                               Visibility="{Binding IsPidAsc, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 2: Memory (RAM) Sort Header -->
                        <Border Grid.Column="2" Cursor="Hand" Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="RAM"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Bellek (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"
                                               Visibility="{Binding IsRamDesc, Converter={StaticResource BoolToVis}}"/>
                                <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"
                                               Visibility="{Binding IsRamAsc, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Column="3" Text="Tür" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Eylem" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Process List -->
                <ListView Grid.Row="2" 
                          ItemsSource="{Binding TopProcesses}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="RowBorder" 
                                                Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}" 
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Öncelik: Yüksek Yap" 
                                                  Command="{Binding PlacementTarget.Tag.SetHighPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Öncelik: Normal Yap" 
                                                  Command="{Binding PlacementTarget.Tag.SetNormalPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="İşlemi Sonlandır (Görevi Kapat)" 
                                                  Command="{Binding PlacementTarget.Tag.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="{Binding ProcessName}" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           VerticalAlignment="Center" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,0,12,0"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Id}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           VerticalAlignment="Center" 
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="2" 
                                           Text="{Binding FormattedMemory}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                           VerticalAlignment="Center" 
                                           TextAlignment="Right" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,0,14,0"/>

                                <Border Grid.Column="3" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,4" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sistem Süreci" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding IsSystemProcess, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Kullanıcı Süreci" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding IsSystemProcess, Converter={StaticResource InverseBoolToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <ui:Button Grid.Column="4" 
                                           Appearance="Danger" 
                                           Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding IsTerminating, Converter={StaticResource InverseBool}}"
                                           Padding="6,4" 
                                           HorizontalAlignment="Right" 
                                           VerticalAlignment="Center" 
                                           ToolTip="Görevi Sonlandır" 
                                           Icon="{ui:SymbolIcon Dismiss20}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
