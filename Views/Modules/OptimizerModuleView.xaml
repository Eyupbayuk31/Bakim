<UserControl x:Class="Bakım.Views.Modules.OptimizerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:OptimizerViewModel}"
             d:DesignHeight="900" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Result Banner -->
            <RowDefinition Height="Auto"/> <!-- RAM Architecture Card -->
            <RowDefinition Height="*"/>    <!-- Process Grid + Right Drawer -->
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,16"
                         Title="Süreçler"
                         Description="Çalışan süreçler ve bellek dağılımı; kullanılmayan belleği Windows'a geri verme.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" 
                                     AutomationProperties.Name="Canlı izlemeyi aç veya kapat"
                                     OnContent="Canlı izleme"
                                     OffContent="Canlı izleme"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Padding="12,8"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Margin="0,0,8,0"/>

                    <!-- §5.4: tek, dürüst bellek eylemi. Otomatik çalışmaz; yalnızca yöneticiyken etkin. -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ClearStandbyListCommand}"
                               IsEnabled="{Binding CanClearStandby}"
                               Padding="12,8"
                               Content="Bekleme belleğini boşalt"
                               ToolTip="Windows önbelleğe aldığı (bekleme listesindeki) belleği zaten gerektiğinde kendisi boşaltır. Yalnızca bir sorun yaşıyorsanız kullanın; etkisi geçicidir. Yönetici izni gerekir."
                               AutomationProperties.Name="Bekleme belleğini boşalt"
                               Icon="{ui:SymbolIcon Shield20}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- Result InfoBar -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="Success" 
                    Title="İşlem tamamlandı" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,14"/>

        <!-- RAM Status Overview Card (Multi-Segmented Memory Breakdown + 4 KPI Cards) -->
        <ui:Card Grid.Row="2" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title + Percent -->
                    <RowDefinition Height="Auto"/> <!-- Segmented Bar -->
                    <RowDefinition Height="Auto"/> <!-- Legend -->
                    <RowDefinition Height="Auto"/> <!-- 4 KPI Cards -->
                    <RowDefinition Height="Auto"/> <!-- Progress Beam -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Bellek kullanımı" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Hardware.RamPercentage, StringFormat='%{0} dolu'}" 
                                   FontSize="{StaticResource Font.Subtitle}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{Binding Hardware.RamPercentage, Converter={StaticResource PercentageToBrush}}"/>
                        <TextBlock Text="{Binding Hardware.UsedRamGb, StringFormat=' ({0:F1} GB / '}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='{}{0:F1} GB)'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Multi-Segmented Memory Bar -->
                <Border Grid.Row="1" Height="8" CornerRadius="{StaticResource Radius.XS}" Background="{DynamicResource ControlFillColorSecondaryBrush}" ClipToBounds="True" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Composition.InUsePercent, FallbackValue=70, StringFormat='{}{0}*'}"/>
                            <ColumnDefinition Width="{Binding Composition.ModifiedPercent, FallbackValue=5, StringFormat='{}{0}*'}"/>
                            <ColumnDefinition Width="{Binding Composition.StandbyPercent, FallbackValue=15, StringFormat='{}{0}*'}"/>
                            <ColumnDefinition Width="{Binding Composition.FreePercent, FallbackValue=10, StringFormat='{}{0}*'}"/>
                        </Grid.ColumnDefinitions>

                        <!-- In Use (Cyan/Accent) -->
                        <Border Grid.Column="0" Background="{DynamicResource Chart.Series1}" ToolTip="{Binding Composition.InUseGb, StringFormat='Kullanımda: {0:F1} GB'}"/>
                        <!-- Modified (Purple) -->
                        <Border Grid.Column="1" Background="{DynamicResource Chart.Series4}" ToolTip="{Binding Composition.ModifiedGb, StringFormat='Değiştirilmiş: {0:F1} GB'}"/>
                        <!-- Standby / Cached (Green) -->
                        <Border Grid.Column="2" Background="{DynamicResource Chart.Series3}" ToolTip="{Binding Composition.StandbyGb, StringFormat='Bekleme Listesi (Önbellek): {0:F1} GB'}"/>
                        <!-- Free (Dark Slate) -->
                        <Border Grid.Column="3" Background="{DynamicResource ControlStrokeColorDefaultBrush}" ToolTip="{Binding Composition.FreeGb, StringFormat='Boş / Serbest: {0:F1} GB'}"/>
                    </Grid>
                </Border>

                <!-- Legend -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- In Use -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="{StaticResource Radius.SM}" Background="{DynamicResource Chart.Series1}" Margin="0,0,6,0"/>
                        <TextBlock Text="Kullanımda: " FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Composition.InUseGb, StringFormat='{}{0:F1} GB'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Modified -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="{StaticResource Radius.SM}" Background="{DynamicResource Chart.Series4}" Margin="0,0,6,0"/>
                        <TextBlock Text="Değiştirilmiş: " FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Composition.ModifiedGb, StringFormat='{}{0:F1} GB'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Standby / Cached -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="{StaticResource Radius.SM}" Background="{DynamicResource Chart.Series3}" Margin="0,0,6,0"/>
                        <TextBlock Text="Bekleme (Önbellek): " FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Composition.StandbyGb, StringFormat='{}{0:F1} GB'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Chart.Series3}"/>
                    </StackPanel>

                    <!-- Free -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Width="10" Height="10" CornerRadius="{StaticResource Radius.SM}" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Boş alan: " FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Composition.FreeGb, StringFormat='{}{0:F1} GB'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 4 KPI Cards (Technical Architecture) -->
                <c:SummaryStrip Grid.Row="3" Style="{StaticResource SummaryStrip.Inset}">

                    <!-- KPI 1: Speed & Slots -->
                    <c:StatCard 
                                Icon="TopSpeed20" 
                                Label="Hız ve yuvalar" 
                                Value="{Binding Hardware.RamSpeedMhz, FallbackValue='3200 MT/s'}" 
                                Caption="{Binding Composition.SlotsText}" 
                                Intent="Accent" 
                                IsInteractive="True"/>

                    <!-- KPI 2: Commit Charge / Pagefile -->
                    <c:StatCard 
                                Icon="HardDrive20" 
                                Label="Sanal bellek (sayfa dosyası)" 
                                Value="{Binding Composition.CommitTotalGb, StringFormat='{}{0:F1} GB İşlendi'}" 
                                Caption="{Binding Composition.CommitLimitGb, StringFormat='Limit: {0:F1} GB'}" 
                                Intent="Neutral" 
                                IsInteractive="True"/>

                    <!-- KPI 3: Kernel Pools -->
                    <c:StatCard 
                                Icon="DeveloperBoard20" 
                                Label="Çekirdek havuzları" 
                                Value="{Binding Composition.PagedPoolMb, StringFormat='Sayfalı: {0:F0} MB'}" 
                                Caption="{Binding Composition.NonPagedPoolMb, StringFormat='Sayfasız: {0:F0} MB'}" 
                                Intent="Neutral" 
                                IsInteractive="True"/>

                    <!-- KPI 4: Hardware Reserved -->
                    <c:StatCard 
                                Icon="ShieldCheckmark20" 
                                Label="Donanıma ayrılmış" 
                                Value="{Binding Composition.HardwareReservedText}" 
                                Caption="BIOS / entegre GPU" 
                                Intent="Neutral" 
                                IsInteractive="True"/>
                </c:SummaryStrip>

                <!-- Optimization Progress Bar (Only during optimization) -->
                <Grid Grid.Row="4" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding OptimizationStageText}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding OptimizationProgressPercent}" Maximum="100" Height="4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Process Manager Card & Right Inspection Drawer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Process Table -->
                <ColumnDefinition Width="Auto"/> <!-- Right Inspection Drawer -->
            </Grid.ColumnDefinitions>

            <!-- Main Process Table Card -->
            <ui:Card Grid.Column="0" Padding="18">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filter / Search Row -->
                        <RowDefinition Height="Auto"/> <!-- Column Headers -->
                        <RowDefinition Height="*"/>    <!-- Process ListView -->
                    </Grid.RowDefinitions>

                    <!-- Search and Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Filter Chips -->
                            <ColumnDefinition Width="*"/>    <!-- Search Box -->
                            <ColumnDefinition Width="Auto"/> <!-- Process Count -->
                        </Grid.ColumnDefinitions>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Tümü" 
                                       Appearance="{Binding IsFilterAll, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetFilterCommand}" CommandParameter="All"
                                       Padding="10,6" Margin="0,0,4,0"/>

                            <ui:Button Content="Kullanıcı" 
                                       Appearance="{Binding IsFilterUser, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetFilterCommand}" CommandParameter="User"
                                       Padding="10,6" Margin="0,0,4,0"/>

                            <ui:Button Content="Sistem" 
                                       Appearance="{Binding IsFilterSystem, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetFilterCommand}" CommandParameter="System"
                                       Padding="10,6" Margin="0,0,4,0"/>

                            <ui:Button Content="&gt;500 MB" 
                                       Appearance="{Binding IsFilterHighRam, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetFilterCommand}" CommandParameter="HighRam"
                                       Padding="10,6" Margin="0,0,12,0"/>

                            <CheckBox Content="Uygulamaya göre grupla" IsChecked="{Binding GroupByApp}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="Aynı uygulamanın süreçlerini (ör. tarayıcı sekmeleri) tek başlık altında, toplam bellekle gösterir."/>
                        </StackPanel>

                        <!-- Search Box -->
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="İşlem adı, PID veya yayıncı ara..."
                                    ClearButtonEnabled="True"
                                    VerticalContentAlignment="Center"
                                    Padding="10,6"
                                    Margin="0,0,12,0"/>

                        <!-- Process Count -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding DisplayedProcesses.Count, StringFormat='Görüntülenen: {0}'}" 
                                   FontSize="{StaticResource Font.Caption}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Table Column Header -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="{StaticResource Radius.SM}" 
                            Padding="12,8" 
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>                           <!-- Process Name & Publisher -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptPidCol"/> <!-- PID -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptCpuCol"/> <!-- CPU % -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptRamCol"/> <!-- RAM -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptTypeCol"/> <!-- Priority / Type -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptActionCol"/> <!-- Actions -->
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Process Name Sort Header -->
                            <Border Grid.Column="0" Cursor="Hand" Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="Name"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="İşlem / uygulama" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsNameDesc, Converter={StaticResource BoolToVis}}"/>
                                    <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsNameAsc, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Column 1: PID Sort Header -->
                            <Border Grid.Column="1" Cursor="Hand" Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="PID"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PID" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsPidDesc, Converter={StaticResource BoolToVis}}"/>
                                    <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsPidAsc, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Column 2: CPU % Sort Header -->
                            <Border Grid.Column="2" Cursor="Hand" Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="CPU"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="CPU %" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsCpuDesc, Converter={StaticResource BoolToVis}}"/>
                                    <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsCpuAsc, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Column 3: Memory (RAM) Sort Header -->
                            <Border Grid.Column="3" Cursor="Hand" Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSortCommand}" CommandParameter="RAM"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Bellek (RAM)" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsRamDesc, Converter={StaticResource BoolToVis}}"/>
                                    <ui:SymbolIcon Symbol="ChevronUp20" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"
                                                   Visibility="{Binding IsRamAsc, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="4" Text="Durum / öncelik" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="5" Text="Eylemler" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Process List -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding ProcessesView}"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,10,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Items, Converter={StaticResource ProcessGroupSummary}}"
                                                       FontSize="{StaticResource Font.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="46"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="{StaticResource Radius.SM}" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ayrıntıları göster" 
                                                      Command="{Binding PlacementTarget.Tag.SelectProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Dosya konumunu aç (Explorer)" 
                                                      Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="Öncelik: Yüksek yap" 
                                                      Command="{Binding PlacementTarget.Tag.SetHighPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Öncelik: Normal yap" 
                                                      Command="{Binding PlacementTarget.Tag.SetNormalPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="İşlemi askıya al / devam ettir (Freeze)" 
                                                      Command="{Binding PlacementTarget.Tag.ToggleSuspendProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="İşlemi sonlandır (görevi kapat)" 
                                                      Command="{Binding PlacementTarget.Tag.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OptPidCol"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OptCpuCol"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OptRamCol"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OptTypeCol"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OptActionCol"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Process Icon + Name + Publisher -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- High-Res Native Win32 Icon -->
                                        <Image Grid.Column="0" 
                                               Source="{Binding IconSource}" 
                                               Width="20" Height="20" 
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Margin="0,0,10,0" 
                                               VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="{StaticResource Font.Body}" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Publisher}" 
                                                       FontSize="{StaticResource Font.Micro}" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- PID -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Id}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,14,0"/>

                                    <!-- CPU % -->
                                    <Border Grid.Column="2" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{StaticResource Radius.XS}" 
                                            Padding="6,2" 
                                            Margin="0,0,14,0" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedCpu}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   TextAlignment="Right"/>
                                    </Border>

                                    <!-- Memory (RAM) -->
                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding FormattedMemory}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextAlignment="Right" 
                                               Margin="0,0,14,0"/>

                                    <!-- Status / Type Badge -->
                                    <Border Grid.Column="4" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{StaticResource Radius.SM}" 
                                            Padding="8,4" 
                                            Margin="0,0,14,0"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Askıda ⏸" 
                                                       FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding IsSuspended, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="Sistem" 
                                                       FontSize="{StaticResource Font.Micro}" 
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding IsSystemProcess, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="Kullanıcı" 
                                                       FontSize="{StaticResource Font.Micro}" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding IsSystemProcess, Converter={StaticResource InverseBoolToVis}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Inspect Button -->
                                        <ui:Button Appearance="Secondary" 
                                                   Command="{Binding DataContext.SelectProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="6,4" 
                                                   Margin="0,0,6,0"
                                                   ToolTip="Ayrıntıları göster" 
                                                   Icon="{ui:SymbolIcon Info20}"/>

                                        <!-- Kill Button -->
                                        <ui:Button Appearance="Secondary" 
                                                   Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding IsTerminating, Converter={StaticResource InverseBool}}"
                                                   Padding="6,4" 
                                                   ToolTip="Görevi sonlandır" 
                                                   Icon="{ui:SymbolIcon Dismiss20}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <!-- Right Process Inspection Drawer (Deep Röntgen Paneli) -->
            <ui:Card Grid.Column="1" 
                     Width="340" 
                     Padding="18" 
                     Margin="14,0,0,0"
                     Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Drawer Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="{Binding SelectedProcess.IconSource}" 
                                   Width="32" Height="32" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0,0,10,0" 
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedProcess.ProcessName}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedProcess.Id, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ui:Button Grid.Column="2" 
                                       Appearance="Transparent" 
                                       Command="{Binding CloseDrawerCommand}" 
                                       Icon="{ui:SymbolIcon Dismiss24}" 
                                       ToolTip="Ayrıntıları kapat"/>
                        </Grid>

                        <!-- Description / Publisher -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Yayıncı ve açıklama" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedProcess.Publisher}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedProcess.Description}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Memory Metrics Breakdown -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bellek ayrıntıları" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Çalışma kümesi (RAM)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProcess.FormattedMemory}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Özel ayrılmış (Private)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProcess.FormattedPrivateBytes}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="İş parçacıkları (Threads)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProcess.ThreadCount}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Tutamaçlar (Handles)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProcess.HandleCount}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- File Path Section -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Çalıştırılabilir dosya yolu" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedProcess.FilePath}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <ui:Button Appearance="Secondary" 
                                           Command="{Binding OpenFileLocationCommand}" 
                                           HorizontalAlignment="Stretch"
                                           Padding="8,6"
                                           Content="Dosya konumunu aç (Explorer)" 
                                           Icon="{ui:SymbolIcon FolderOpen24}"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel>
                            <ui:Button Appearance="Secondary"
                                       Command="{Binding ToggleSuspendProcessCommand}"
                                       HorizontalAlignment="Stretch"
                                       Padding="10,8"
                                       Content="İşlemi askıya al / devam et"
                                       Icon="{ui:SymbolIcon Pause24}"
                                       Margin="0,0,0,8"/>

                            <ui:Button Appearance="Secondary"
                                       Command="{Binding TrimProcessRamCommand}"
                                       HorizontalAlignment="Stretch"
                                       Padding="10,8"
                                       Content="Bu sürecin RAM'ini kırp"
                                       Icon="{ui:SymbolIcon Flash24}"
                                       Margin="0,0,0,8"/>

                            <ui:Button Appearance="Secondary"
                                       Command="{Binding ScanWithVirusTotalCommand}"
                                       HorizontalAlignment="Stretch"
                                       Padding="10,8"
                                       Content="VirusTotal güvenlik analizi"
                                       Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                       Margin="0,0,0,8"/>

                            <ui:Button Appearance="Secondary"
                                       Command="{Binding KillProcessCommand}"
                                       CommandParameter="{Binding SelectedProcess}"
                                       HorizontalAlignment="Stretch"
                                       Padding="10,8"
                                       Content="Görevi sonlandır (ağacı kapat)"
                                       Icon="{ui:SymbolIcon Dismiss24}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
