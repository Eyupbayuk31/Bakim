<UserControl x:Class="Bakım.Views.Modules.SettingsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="850" d:DesignWidth="1050">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Page Title & Top Actions -->
            <RowDefinition Height="*"/>    <!-- 1: 2-Column Settings Workspace (Categories + Active Pane) -->
        </Grid.RowDefinitions>

        <!-- 0. Header Area with Quick Tools -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Ayarlar"
                         Description="Görünüm teması, sistem performansı, başlangıç davranışı, güvenlik ve modül ayarları.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ExportSettingsCommand}"
                               Padding="12,8"
                               Margin="0,0,8,0"
                               Content="Yedekle"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               ToolTip="Ayarları JSON olarak dışa aktar"/>
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ImportSettingsCommand}"
                               Padding="12,8"
                               Margin="0,0,8,0"
                               Content="Geri yükle"
                               Icon="{ui:SymbolIcon ArrowUpload24}"
                               ToolTip="JSON yedek dosyasından ayarları içe aktar"/>
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ResetPreferencesCommand}"
                               Padding="12,8"
                               Content="Sıfırla"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               ToolTip="Varsayılan fabrika ayarlarına dön"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. Main Workspace: Category Navigation Rail + Active Card Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Left Category Sub-Menu -->
                <ColumnDefinition Width="*"/>   <!-- Right Active Category Settings -->
            </Grid.ColumnDefinitions>

            <!-- Left Category Rail -->
            <Border Grid.Column="0"
                    Margin="0,0,18,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,14,0">
                <StackPanel>
                    <!-- 1. Genel & Görünüm -->
                    <Button Style="{StaticResource Nav.ItemButton}"
                            helpers:NavSelection.IsSelected="{Binding IsGeneralSelected}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="General"
                            AutomationProperties.Name="Görünüm ve tema">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DarkTheme24"
                                           FontSize="20"
                                           Filled="{Binding IsGeneralSelected}"/>
                            <TextBlock Text="Görünüm ve tema"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Performans -->
                    <Button Style="{StaticResource Nav.ItemButton}"
                            helpers:NavSelection.IsSelected="{Binding IsPerformanceSelected}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Performance"
                            AutomationProperties.Name="Performans &amp; Bellek">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TopSpeed24"
                                           FontSize="20"
                                           Filled="{Binding IsPerformanceSelected}"/>
                            <TextBlock Text="Performans ve bellek"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. Başlangıç & Sistem -->
                    <Button Style="{StaticResource Nav.ItemButton}"
                            helpers:NavSelection.IsSelected="{Binding IsStartupSelected}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Startup"
                            AutomationProperties.Name="Sistem &amp; Başlangıç">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24"
                                           FontSize="20"
                                           Filled="{Binding IsStartupSelected}"/>
                            <TextBlock Text="Sistem ve başlangıç"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. Güvenlik & UAC -->
                    <Button Style="{StaticResource Nav.ItemButton}"
                            helpers:NavSelection.IsSelected="{Binding IsSecuritySelected}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Security"
                            AutomationProperties.Name="Güvenlik &amp; UAC">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Shield24"
                                           FontSize="20"
                                           Filled="{Binding IsSecuritySelected}"/>
                            <TextBlock Text="Güvenlik ve UAC"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. Modül Ayarları (Program Kaldırıcı & VirusTotal) -->
                    <Button Style="{StaticResource Nav.ItemButton}"
                            helpers:NavSelection.IsSelected="{Binding IsModulesSelected}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Modules"
                            AutomationProperties.Name="Modül Tercihleri">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24"
                                           FontSize="20"
                                           Filled="{Binding IsModulesSelected}"/>
                            <TextBlock Text="Modül tercihleri" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 6. Hakkında & Günlükler -->
                    <Button Style="{StaticResource Nav.ItemButton}"
                            helpers:NavSelection.IsSelected="{Binding IsAboutSelected}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="About"
                            AutomationProperties.Name="Hakkında &amp; Günlükler">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="20" Filled="{Binding IsAboutSelected}"/>
                            <TextBlock Text="Hakkında ve günlükler"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Active Category Settings Viewport -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Top">
                <Grid VerticalAlignment="Top" MaxWidth="1000" HorizontalAlignment="Left">
                    <!-- ============================================================ -->
                    <!-- 1. CATEGORY: GÖRÜNÜM & TEMA (General)                        -->
                    <!-- ============================================================ -->
                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsGeneralSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Section Header -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Görünüm" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Uygulamanın temasını ve renklerini seçin."
                                           FontSize="{StaticResource Font.Caption}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 4 Theme Selection Grid -->
                            <!-- Tema kartları: ilk ikisi Windows 11 (Fluent), diğerleri isteğe bağlı -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <UniformGrid Columns="3" Margin="0,0,-8,8">
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Padding="14,12"
                                               Margin="0,0,8,8"
                                               Appearance="{Binding IsMicaTheme, Converter={StaticResource BoolToNavAppearance}}"
                                               Command="{Binding SetMicaDarkThemeCommand}"
                                               AutomationProperties.Name="Windows 11 Koyu temasını uygula"
                                               Icon="{ui:SymbolIcon DarkTheme24}">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Windows 11 koyu"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Font.Body}"/>
                                            <TextBlock Text="Mica zemin, Fluent renkleri"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Padding="14,12"
                                               Margin="0,0,8,8"
                                               Appearance="{Binding IsLightTheme, Converter={StaticResource BoolToNavAppearance}}"
                                               Command="{Binding SetLightThemeCommand}"
                                               AutomationProperties.Name="Windows 11 Açık temasını uygula"
                                               Icon="{ui:SymbolIcon WeatherSunny24}">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Windows 11 açık"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Font.Body}"/>
                                            <TextBlock Text="Mica zemin, aydınlık"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Padding="14,12"
                                               Margin="0,0,8,8"
                                               Appearance="{Binding IsSlateTheme, Converter={StaticResource BoolToNavAppearance}}"
                                               Command="{Binding SetSlateThemeCommand}"
                                               AutomationProperties.Name="Slate Koyu temasını uygula"
                                               Icon="{ui:SymbolIcon WeatherMoon24}">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Slate koyu"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Font.Body}"/>
                                            <TextBlock Text="Lacivert-gri (v4.1)"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Padding="14,12"
                                               Margin="0,0,8,8"
                                               Appearance="{Binding IsAmoledTheme, Converter={StaticResource BoolToNavAppearance}}"
                                               Command="{Binding SetAmoledThemeCommand}"
                                               AutomationProperties.Name="AMOLED Siyah temasını uygula"
                                               Icon="{ui:SymbolIcon WeatherMoon24}">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="AMOLED siyah"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Font.Body}"/>
                                            <TextBlock Text="Saf OLED siyahı"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Padding="14,12"
                                               Margin="0,0,8,8"
                                               Appearance="{Binding IsCyberpunkTheme, Converter={StaticResource BoolToNavAppearance}}"
                                               Command="{Binding SetCyberpunkThemeCommand}"
                                               AutomationProperties.Name="Cyberpunk Mor temasını uygula"
                                               Icon="{ui:SymbolIcon Color24}">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Cyberpunk mor"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Font.Body}"/>
                                            <TextBlock Text="Neon mor ve pembe"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ui:Button>
                                </UniformGrid>
                            </Border>

                            <!-- Yüksek Kontrast (§3.1, §3.8) -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <ui:Button HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="14,10"
                                           Appearance="{Binding IsHighContrastTheme, Converter={StaticResource BoolToNavAppearance}}"
                                           Command="{Binding SetHighContrastThemeCommand}"
                                           AutomationProperties.Name="Yüksek Kontrast temasını uygula"
                                           Icon="{ui:SymbolIcon Accessibility24}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Yüksek kontrast"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource Font.Body}"/>
                                        <TextBlock Text="Windows sistem renklerini kullanır. Windows'ta Yüksek Kontrast açıksa otomatik seçilir."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ui:Button>
                            </Border>

                            <!-- Theme Status Badge -->
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="12,8"
                                    Margin="{StaticResource Gap.Card}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Checkmark20"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Margin="0,0,8,0"/>
                                    <TextBlock Text="Etkin tema: "
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentThemeStatus}"
                                               FontSize="{StaticResource Font.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Mica Effect Toggle -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Windows 11 Mica arka plan derinliği"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Masaüstü duvar kağıdıyla etkileşimli Mica saydamlık katmanını uygular."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding IsMicaEnabled, Mode=TwoWay}" AutomationProperties.Name="Mica arka plan efektini aç veya kapat"/>
                            </ui:CardControl>

                            <!-- Windows vurgu rengi (§3.1) -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Windows vurgu rengini kullan"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Düğmeler ve vurgular, Windows Ayarlar &gt; Kişiselleştirme &gt; Renkler'deki vurgu rengini alır."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding FollowWindowsAccent, Mode=TwoWay}" AutomationProperties.Name="Windows vurgu rengini kullan"/>
                            </ui:CardControl>

                            <!-- Animasyonları azalt (§3.3) -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Animasyonları azalt"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Geçiş animasyonları kapatılır. Windows'ta animasyonlar kapalıysa bu otomatik uygulanır. Bakım yeniden başlatılınca etkinleşir."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding ReduceMotion, Mode=TwoWay}" AutomationProperties.Name="Animasyonları azalt"/>
                            </ui:CardControl>
                        </StackPanel>

                    <!-- ============================================================ -->
                    <!-- 2. CATEGORY: PERFORMANS & BELLEK (Performance)               -->
                    <!-- ============================================================ -->
                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsPerformanceSelected, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Performans ve bellek" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Canlı veri yenileme sıklığı ve otomatik RAM optimizasyon aralıkları."
                                           FontSize="{StaticResource Font.Caption}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Item 1: Refresh Rate -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Canlı veri yenileme sıklığı"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Donanım sayaçları ve işlem listelerinin arka planda güncellenme sıklığı."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValuePath="Tag"
                                          SelectedValue="{Binding RefreshIntervalSeconds, Mode=TwoWay}"
                                          AutomationProperties.Name="Telemetri yenileme aralığı"
                                          Padding="10,6">
                                    <ComboBoxItem Content="Yüksek (1 saniye)" Tag="1"/>
                                    <ComboBoxItem Content="Normal (2 saniye)" Tag="2"/>
                                    <ComboBoxItem Content="Düşük (5 saniye)" Tag="5"/>
                                </ComboBox>
                            </ui:CardControl>

                            <!-- Item 2: Auto RAM Clean -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Otomatik RAM temizleme aralığı"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Kullanılmayan sistem çalışma havuzlarını arka planda periyodik olarak boşaltır."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValuePath="Tag"
                                          SelectedValue="{Binding AutoRamCleanIntervalMinutes, Mode=TwoWay}"
                                          AutomationProperties.Name="Otomatik RAM temizleme aralığı"
                                          Padding="10,6">
                                    <ComboBoxItem Content="Devre dışı (kapalı)" Tag="0"/>
                                    <ComboBoxItem Content="Her 15 dakikada" Tag="15"/>
                                    <ComboBoxItem Content="Her 30 dakikada" Tag="30"/>
                                    <ComboBoxItem Content="Her 60 dakikada" Tag="60"/>
                                </ComboBox>
                            </ui:CardControl>

                            <!-- Item 3: High RAM Warning -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Yüksek bellek tüketim uyarısı"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Sistem bellek kullanımı %85 eşiğini aştığında bildirimle uyarır."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding NotifyOnHighRam, Mode=TwoWay}" AutomationProperties.Name="Yüksek bellek kullanımında uyar"/>
                            </ui:CardControl>
                        </StackPanel>

                    <!-- ============================================================ -->
                    <!-- 3. CATEGORY: SİSTEM & BAŞLANGIÇ (Startup)                    -->
                    <!-- ============================================================ -->
                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsStartupSelected, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Başlangıç ve davranış" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Sistem açılışı, arka plan çalışma modu ve oturum temizlik davranışları."
                                           FontSize="{StaticResource Font.Caption}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Item 1: Start with Windows & Health Diagnostic -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Title & Toggle -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Windows ile birlikte başlat"
                                                   FontSize="{StaticResource Font.Body}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Bilgisayar açıldığında uygulamayı otomatik olarak başlatır (UAC uyarısız en yüksek yetki)."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Row="0"
                                                     Grid.Column="1"
                                                     IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                     AutomationProperties.Name="Windows ile birlikte başlat"
                                                     VerticalAlignment="Center"/>
                                    <!-- Diagnostic Status & Actions Container -->
                                    <Border Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.MD}"
                                            Padding="14,10"
                                            Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,0,3">
                                                    <TextBlock Text="Başlangıç durumu:"
                                                               FontSize="{StaticResource Font.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding AutostartHealthBadgeText}"
                                                               FontSize="{StaticResource Font.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AutostartDiagnosticDetails}"
                                                           FontSize="{StaticResource Font.Caption}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                <ui:Button Appearance="Secondary"
                                                           Content="Başlangıcı onar ve kur"
                                                           Icon="{ui:SymbolIcon Wrench20}"
                                                           Command="{Binding RepairAutostartCommand}"
                                                           Padding="10,6"
                                                           Margin="0,0,6,0"
                                                           ToolTip="Windows Görev Zamanlayıcısına UAC uyarısız en yüksek yetkili başlangıç görevini kaydeder ve çakışan anahtarları temizler."/>
                                                <ui:Button Appearance="Secondary"
                                                           Icon="{ui:SymbolIcon ArrowClockwise20}"
                                                           Command="{Binding RefreshAutostartStatusCommand}"
                                                           Padding="8,6"
                                                           ToolTip="Başlangıç durumunu yeniden denetle"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Warning banner if blocked -->
                                    <Border Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Visibility="{Binding IsAutostartBlocked, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource Status.Critical.Subtle}"
                                            BorderBrush="{DynamicResource Status.Critical.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.MD}"
                                            Padding="12,10"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Warning24"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource Status.Critical.Solid}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource Status.Critical.Text}">
                                                <Run FontWeight="SemiBold">Kritik Windows UAC Engeli:</Run> Uygulama 'Yönetici Olarak Çalıştır' olarak işaretlendiği için standart Kayıt Defteri başlangıcı Windows tarafından sessizce engellenmektedir. Programın sorunsuz başlaması için lütfen yukarıdaki <Run FontWeight="SemiBold">'Başlangıcı Onar &amp; Kur'</Run> butonunu kullanın.
                                        </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 2: Minimize to Tray -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Kapatıldığında sistem tepsisine küçült"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Uygulama kapatıldığında bildirim alanında (System Tray) çalışmayı sürdürür."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" AutomationProperties.Name="Simge durumunda sistem tepsisine küçült"/>
                            </ui:CardControl>

                            <!-- Son sayfa (§2.3) -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Açılışta son sayfayı aç"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Kapalıyken Bakım her zaman Kontrol Paneli ile açılır."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding OpenLastModuleOnStartup, Mode=TwoWay}" AutomationProperties.Name="Açılışta son sayfayı aç"/>
                            </ui:CardControl>

                            <!-- Item 3: Auto Clean on Exit -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Çıkışta temp dosyalarını temizle"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Uygulamadan çıkıldığında kullanıcı geçici dosyalarını güvenle temizler."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding AutoCleanOnExit, Mode=TwoWay}" AutomationProperties.Name="Çıkışta geçici dosyaları temizle"/>
                            </ui:CardControl>

                            <!-- Haftalık güvenli temizlik (§5.2) -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Haftalık güvenli temizlik"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Haftada bir, yalnızca Hızlı Bakım kapsamı: 24 saatten eski geçici dosyalar, çökme dökümleri, tarayıcı ve gölgelendirici önbellekleri. Sonuç Etkinlik Merkezi'ne yazılır."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding WeeklySafeCleanup, Mode=TwoWay}" AutomationProperties.Name="Haftalık güvenli temizlik"/>
                            </ui:CardControl>

                            <!-- Item 4: Windows Gezgini Sağ Tık Menüsü Entegrasyonu -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Windows Gezgini sağ tık menüsü"
                                                       FontSize="{StaticResource Font.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Border CornerRadius="{StaticResource Radius.XS}"
                                                    Padding="6,2"
                                                    Margin="8,0,0,0"
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Kayıtlı ve aktif"
                                                               FontSize="{StaticResource Font.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                               Visibility="{Binding IsShellContextMenuEnabled, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="Devre dışı"
                                                               FontSize="{StaticResource Font.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding IsShellContextMenuEnabled, Converter={StaticResource InverseBoolToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Masaüstü, klasör ve program dosyalarına (.exe, .lnk) sağ tıklandığında 'Bakım ile Kaldır' seçeneğini Windows bağlam menüsüne ekler."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding IsShellContextMenuEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Windows Gezgini Sağ Tık Menüsü Entegrasyonu"
                                                     VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Bakım'ın sistemde bıraktıkları (§5.18) -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Bakım'ın sistemde bıraktıkları"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="{Binding ArtifactsStatus}"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Appearance="Secondary"
                                           Padding="10,5"
                                           Content="Yenile"
                                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                                           Command="{Binding RefreshArtifactsCommand}"/>
                            </ui:CardControl>
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="{StaticResource Font.Caption}"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="{StaticResource Font.Caption}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   ToolTip="{Binding Detail}"/>
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="1"
                                                               Appearance="Secondary"
                                                               Padding="10,4"
                                                               Content="Kaldır"
                                                               VerticalAlignment="Center"
                                                               Command="{Binding DataContext.RemoveArtifactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               AutomationProperties.Name="Bakım öğesini kaldır"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                    <!-- ============================================================ -->
                    <!-- 4. CATEGORY: GÜVENLİK & YÖNETİCİ HAKLARI (Security)          -->
                    <!-- ============================================================ -->
                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsSecuritySelected, Converter={StaticResource BoolToVis}}">
                            <!-- Current Admin Status Bar -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Shield24"
                                                   FontSize="26"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Yönetici yetki seviyesi (UAC)"
                                                   FontSize="{StaticResource Font.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Yönetici ayrıcalıkları devrede. Tüm sistem alanları tam yetkiyle yönetilebilir."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="Standart kullanıcı modu. Korumalı sistem ayarlarını değiştirmek için yükseltme önerilir."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2"
                                               Appearance="Primary"
                                               Command="{Binding RestartAsAdminCommand}"
                                               Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"
                                               Padding="16,8"
                                               Content="Yönetici olarak başlat"
                                               Icon="{ui:SymbolIcon ShieldKeyhole20}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Item 1: RunAsAdmin -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Her zaman yönetici olarak çalıştır"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Uygulamanın daima yönetici ayrıcalıklarıyla açılmasını sağlar."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding IsAlwaysRunAsAdmin, Mode=TwoWay}" AutomationProperties.Name="Her zaman yönetici olarak çalıştır"/>
                            </ui:CardControl>

                            <!-- Item 2: Task Scheduler UAC Bypass -->
                            <ui:CardControl Style="{StaticResource Card.Setting}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Text="UAC uyarısız yönetici başlat"/>
                                        <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Görev Zamanlayıcı üzerinden sistem açılışında UAC onayı sormadan en yüksek yetkiyle başlatır."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding IsTaskSchedulerAutoStart, Mode=TwoWay}" AutomationProperties.Name="Görev Zamanlayıcı ile yönetici başlat"/>
                            </ui:CardControl>
                        </StackPanel>

                    <!-- ============================================================ -->
                    <!-- 5. CATEGORY: MODÜL AYARLARI (Modules)                        -->
                    <!-- ============================================================ -->
                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsModulesSelected, Converter={StaticResource BoolToVis}}">
                        <!-- Group 1: Program Uninstaller & Restore Point -->
                        <StackPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                    <TextBlock Text="Program kaldırıcı ve Sistem Geri Yükleme"
                                               FontSize="{StaticResource Font.BodyLarge}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Item 1: Prompt restore point -->
                                <ui:CardControl Style="{StaticResource Card.Setting}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Kaldırma öncesi geri yükleme noktası sor"/>
                                            <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Uygulama kaldırılmadan önce sistem kurtarma noktası oluşturmayı sorar."/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding PromptRestorePointBeforeUninstall, Mode=TwoWay}" AutomationProperties.Name="Kaldırma öncesi geri yükleme noktası sor"/>
                                </ui:CardControl>

                                <!-- Item 2: Create restore point -->
                                <ui:CardControl Style="{StaticResource Card.Setting}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.SettingTitle}" Text="Sistem Geri Yükleme koruması"/>
                                            <TextBlock Style="{StaticResource Text.SettingDescription}" Text="Kaldırma işlemlerinde otomatik kurtarma noktası oluşturur."/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding CreateRestorePointOnUninstall, Mode=TwoWay}" AutomationProperties.Name="Kaldırma sırasında geri yükleme noktası oluştur"/>
                                </ui:CardControl>

                                <!-- Item 3: Windows Gezgini Sağ Tık Menüsü -->
                                <Border Style="{StaticResource Card.Surface}"
                                        CornerRadius="{StaticResource Radius.XS}"
                                        Padding="16"
                                        Margin="{StaticResource Gap.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Windows Gezgini sağ tık menüsü"
                                                           FontSize="{StaticResource Font.Body}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border CornerRadius="{StaticResource Radius.XS}"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Kayıtlı ve aktif"
                                                                   FontSize="{StaticResource Font.Caption}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                   Visibility="{Binding IsShellContextMenuEnabled, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="Devre dışı"
                                                                   FontSize="{StaticResource Font.Caption}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{Binding IsShellContextMenuEnabled, Converter={StaticResource InverseBoolToVis}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Dosya, klasör ve kısayollara sağ tıklandığında 'Bakım ile Kaldır' seçeneğini ekler."
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1"
                                                         IsChecked="{Binding IsShellContextMenuEnabled, Mode=TwoWay}"
                                                         AutomationProperties.Name="Windows Gezgini Bağlam Menüsü Entegrasyonu"
                                                         VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                        <!-- Group 2: Kurulum Nöbetçisi (Sentinel Setup Guard) -->
                        <StackPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="Shield24"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                    <TextBlock Text="Kurulum Nöbetçisi (Sentinel Setup Guard)"
                                               FontSize="{StaticResource Font.BodyLarge}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <Border Style="{StaticResource Card.Surface}"
                                        CornerRadius="{StaticResource Radius.XS}"
                                        Padding="16"
                                        Margin="{StaticResource Gap.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Otomatik kurulum tespiti ve değişiklik izleme"
                                                           FontSize="{StaticResource Font.Body}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border CornerRadius="{StaticResource Radius.XS}"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Canlı izleme aktif"
                                                                   FontSize="{StaticResource Font.Caption}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                   Visibility="{Binding IsSentinelSetupGuardEnabled, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="Devre dışı"
                                                                   FontSize="{StaticResource Font.Caption}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{Binding IsSentinelSetupGuardEnabled, Converter={StaticResource InverseBoolToVis}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Yeni bir yazılım kurulurken arka planda eklenen dosya ve kayıt defteri değişikliklerini otomatik yakalar, kurulum bitince Analizör ile güvenlik ve VirusTotal taraması önerir."
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1"
                                                         IsChecked="{Binding IsSentinelSetupGuardEnabled, Mode=TwoWay}"
                                                         AutomationProperties.Name="Kurulum Nöbetçisi (Sentinel Setup Guard)"
                                                         VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                        <!-- Group 3: VirusTotal API Integration -->
                        <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                                       FontSize="20"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,0,8,0"/>
                                        <TextBlock Text="VirusTotal API entegrasyonu"
                                                   FontSize="{StaticResource Font.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Başlangıç dosyalarını 70+ antivirüs motoruna karşı doğrulamak için VirusTotal API v3 anahtarınızı tanımlayın."
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border Style="{StaticResource Card.Surface}"
                                        CornerRadius="{StaticResource Radius.XS}"
                                        Padding="16"
                                        Margin="{StaticResource Gap.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0"
                                                    Text="{Binding VirusTotalApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="VirusTotal API anahtarınızı (64 karakter) girin..."
                                                    ClearButtonEnabled="True"
                                                    VerticalContentAlignment="Center"
                                                    Padding="12,10"
                                                    AutomationProperties.Name="VirusTotal API anahtarınızı girin"/>
                                        <ui:Button Grid.Column="2"
                                                   Appearance="Secondary"
                                                   Command="{Binding SaveAndTestVirusTotalKeyCommand}"
                                                   IsEnabled="{Binding IsTestingVirusTotalKey, Converter={StaticResource InverseBool}}"
                                                   Padding="16,10"
                                                   Content="Doğrula ve kaydet"
                                                   Icon="{ui:SymbolIcon Checkmark20}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card.Surface}"
                                        CornerRadius="{StaticResource Radius.XS}"
                                        Padding="16"
                                        Margin="{StaticResource Gap.Card}">
                                    <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                                        <TextBlock Text="Durum: "
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding VirusTotalApiStatus}"
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text=" • Ücretsiz anahtar için virustotal.com/gui/join-us adresini ziyaret edin."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- 6. CATEGORY: HAKKINDA & GÜNLÜKLER (About)                    -->
                    <!-- ============================================================ -->
                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsAboutSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Header & Actions -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hakkında ve günlükler" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Bakım yazılımı sürüm detayları, son yenilikler ve geçmiş sürüm notları."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Appearance="Secondary"
                                                   Command="{Binding CheckForUpdatesCommand}"
                                                   Padding="12,7"
                                                   Margin="0,0,8,0"
                                                   Content="Güncellemeleri denetle"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"/>
                                        <ui:Button Appearance="Secondary"
                                                   Command="{Binding OpenLogsFolderCommand}"
                                                   Padding="12,7"
                                                   AutomationProperties.Name="Günlük klasörünü aç"
                                                   Content="Log klasörünü aç"
                                                   Icon="{ui:SymbolIcon FolderOpen20}"/>
                                        <ui:Button Appearance="Secondary"
                                                   Command="{Binding ExportDiagnosticsCommand}"
                                                   Padding="12,7"
                                                   Margin="8,0,0,0"
                                                   ToolTip="Son günlükler, ayarlar ve sistem özeti tek zip'te masaüstüne kaydedilir (kullanıcı adı maskelenir). Hata bildirirken ekleyin."
                                                   AutomationProperties.Name="Tanılama paketi oluştur"
                                                   Content="Tanılama paketi"
                                                   Icon="{ui:SymbolIcon DocumentArrowDown20}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Debug Logging Banner -->
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="14,10"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Ayrıntılı günlükleme (debug modu)"
                                                   FontSize="{StaticResource Font.Body}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Sorun analizi ve hata bildirimi için her işlem adımı günlük dosyasına kaydedilir."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     Margin="12,0,0,0"
                                                     AutomationProperties.Name="Ayrıntılı günlüklemeyi aç veya kapat"
                                                     IsChecked="{Binding VerboseLogging, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <!-- 4-Column Metadata Grid -->
                            <Border Style="{StaticResource Card.Surface}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="16"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource Radius.SM}"
                                            Padding="12,10"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Sürüm"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding AppVersion}"
                                                       FontSize="{StaticResource Font.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource Radius.SM}"
                                            Padding="12,10"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Çalışma zamanı"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FrameworkVersion}"
                                                       FontSize="{StaticResource Font.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource Radius.SM}"
                                            Padding="12,10"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Mimari"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Architecture}"
                                                       FontSize="{StaticResource Font.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource Radius.SM}"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Geliştirici"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding DeveloperName}"
                                                       FontSize="{StaticResource Font.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Update Status Banner -->
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="12,8"
                                    Margin="{StaticResource Gap.Card}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle20"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding UpdateStatus}"
                                               FontSize="{StaticResource Font.Caption}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Installation Mode Banner -->
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="12,10"
                                    Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="AppFolder24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Çalışma modu: "
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding InstallationStatus}"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstalledDirectory}"
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- What's New in Latest Release (En Son Güncellemede Ne Geldi) -->
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="18"
                                    Margin="{StaticResource Gap.Card}">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Rocket24"
                                                               FontSize="20"
                                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                               Margin="0,0,8,0"/>
                                                <TextBlock Text="En son güncellemede ne geldi?"
                                                           FontSize="{StaticResource Font.BodyLarge}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LatestRelease.Title}"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}"
                                                    CornerRadius="{StaticResource Radius.SM}"
                                                    Padding="10,4">
                                                <TextBlock Text="{Binding LatestRelease.Version, StringFormat='{}{0} - Yayında'}"
                                                           FontSize="{StaticResource Font.Caption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ApplicationBackgroundBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding LatestRelease.ReleaseDate}"
                                                       FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Highlights List -->
                                    <ItemsControl ItemsSource="{Binding LatestRelease.Highlights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0"
                                                                   Symbol="Checkmark20"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                   Margin="0,2,8,0"
                                                                   VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontSize="{StaticResource Font.Caption}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Version History & Changelog Accordion -->
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="18"
                                    Margin="{StaticResource Gap.Card}">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="History24"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Margin="0,0,8,0"/>
                                            <TextBlock Text="Sürüm geçmişi ve değişiklik günlüğü"
                                                       FontSize="{StaticResource Font.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Geçmiş sürümlerde yayınlanan tüm yenilikler ve optimizasyon notları."
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding ReleaseHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ReleaseChangelogItem}">
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Radius.SM}"
                                                        Padding="14,10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <!-- Header Row (Clickable) -->
                                                        <ui:Button Appearance="Transparent"
                                                                   Padding="0"
                                                                   HorizontalAlignment="Stretch"
                                                                   HorizontalContentAlignment="Stretch"
                                                                   Command="{Binding DataContext.ToggleChangelogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Version Badge -->
                                                                <Border Grid.Column="0"
                                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                        CornerRadius="{StaticResource Radius.XS}"
                                                                        Padding="8,3"
                                                                        Margin="0,0,10,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Version}"
                                                                               FontSize="{StaticResource Font.Caption}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                </Border>

                                                                <!-- Title & Date -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="{StaticResource Font.Caption}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ReleaseDate}"
                                                                               FontSize="{StaticResource Font.Caption}"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                               Margin="0,1,0,0"/>
                                                                </StackPanel>

                                                                <!-- Chevron Toggle -->
                                                                <StackPanel Grid.Column="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="8,0,4,0">
                                                                    <ui:SymbolIcon Symbol="ChevronUp20"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                                    <ui:SymbolIcon Symbol="ChevronDown20"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVis}}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ui:Button>

                                                        <!-- Expanded Highlights -->
                                                        <StackPanel Margin="0,10,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <Border Height="1"
                                                                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                    Margin="0,0,0,8"/>
                                                            <ItemsControl ItemsSource="{Binding Highlights}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2,0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ui:SymbolIcon Grid.Column="0"
                                                                                           Symbol="ChevronRight20"
                                                                                           FontSize="12"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                           Margin="0,3,6,0"
                                                                                           VerticalAlignment="Top"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding}"
                                                                                       FontSize="{StaticResource Font.Caption}"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
