<UserControl x:Class="Bakım.Views.Modules.AnalyzerChangesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AnalyzerHistoryViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Tarama seçici + özet -->
            <RowDefinition Height="*"/>    <!-- 1: Fark listesi -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Card.Fill}"
                BorderBrush="{DynamicResource Card.Stroke.Glass}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="{StaticResource Pad.CardCompact}"
                Margin="{StaticResource Gap.Bottom.MD}">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Önceki tarama:" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center"
                               Margin="{StaticResource Gap.Right.SM}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding OlderSnapshot}" DisplayMemberPath="Display"
                              MinWidth="260" Margin="0,0,16,0" AutomationProperties.Name="Önceki tarama"/>
                    <TextBlock Text="Sonraki tarama:" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center"
                               Margin="{StaticResource Gap.Right.SM}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding NewerSnapshot}" DisplayMemberPath="Display"
                              MinWidth="260" AutomationProperties.Name="Sonraki tarama"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.SM}">
                    <c:StatusBadge Intent="Caution" Margin="{StaticResource Gap.Right.XS}">
                        <c:StatusBadge.Text>
                            <MultiBinding StringFormat="{}{0} eklendi">
                                <Binding Path="AddedCount"/>
                            </MultiBinding>
                        </c:StatusBadge.Text>
                    </c:StatusBadge>
                    <c:StatusBadge Intent="Accent" Margin="{StaticResource Gap.Right.XS}">
                        <c:StatusBadge.Text>
                            <MultiBinding StringFormat="{}{0} değişti">
                                <Binding Path="ChangedCount"/>
                            </MultiBinding>
                        </c:StatusBadge.Text>
                    </c:StatusBadge>
                    <c:StatusBadge Intent="Neutral">
                        <c:StatusBadge.Text>
                            <MultiBinding StringFormat="{}{0} kaldırıldı">
                                <Binding Path="RemovedCount"/>
                            </MultiBinding>
                        </c:StatusBadge.Text>
                    </c:StatusBadge>
                </StackPanel>

                <TextBlock Text="{Binding DiffSummary}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                           Margin="{StaticResource Gap.Top.SM}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Card.Fill}"
                BorderBrush="{DynamicResource Card.Stroke.Glass}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}">
            <Grid>
                <ListBox ItemsSource="{Binding DiffRows}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         AutomationProperties.Name="Kalıcılık değişiklikleri">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiffRow}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold"
                                           VerticalAlignment="Top" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Column="1" Margin="{StaticResource Gap.Right.SM}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:StatusBadge Text="{Binding KindText}" Intent="{Binding Intent}" Margin="{StaticResource Gap.Right.SM}"/>
                                        <TextBlock FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="{Binding Category, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FilePath}" FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                                               Margin="{StaticResource Gap.Top.XS}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SignatureText}" FontSize="{StaticResource Font.Body}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding ChangeText}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                               Margin="{StaticResource Gap.Top.XS}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Visibility="{Binding HasChangeText, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <ui:Button Grid.Column="2" Appearance="Secondary" Padding="{StaticResource Pad.Control}"
                                           VerticalAlignment="Center"
                                           Icon="{ui:SymbolIcon DocumentSearch20}" Content="İncele"
                                           Visibility="{Binding CanInspect, Converter={StaticResource BoolToVis}}"
                                           Command="{Binding DataContext.InspectDiffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="Bu girdinin dosyasını analiz et"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <c:EmptyState Icon="BranchCompare24"
                              Title="Değişiklik yok"
                              Description="Analizör her kalıcılık taramasını kaydeder. İki tarama arasında eklenen, kaldırılan ya da yolu/imzası değişen başlangıç girdileri, zamanlanmış görevler ve hizmetler burada listelenir."
                              Visibility="{Binding HasDiff, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
