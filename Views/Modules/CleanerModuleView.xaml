<UserControl x:Class="Bakım.Views.Modules.CleanerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CleanerViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top 4 KPI Cards & Drive Health -->
            <RowDefinition Height="Auto"/> <!-- Row 1: InfoBar Operation Result -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Cleaning Targets & Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Realtime Progress & Status -->
            <RowDefinition Height="*"/>    <!-- Row 4: Virtualized Scanned Files & Drawer -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP 4 INTERACTIVE KPI CARDS & SYSTEM DRIVE GAUGE                   -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Found Bytes -->
            <ui:Card Grid.Column="0" Style="{StaticResource InteractiveCard}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Temizlenebilir Boyut" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding FormattedFoundBytes}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Margin="0,6,0,2"/>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding TotalFilesFound, StringFormat='{}{0} adet dosya tespit edildi'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Total Freed Size -->
            <ui:Card Grid.Column="2" Style="{StaticResource InteractiveCard}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Kazanılan Toplam Alan" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding FormattedFreedBytes}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               Margin="0,6,0,2"/>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding TotalFilesCleaned, StringFormat='{}{0} dosya güvenle temizlendi'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: Security Whitelist Protection Info -->
            <ui:Card Grid.Column="4" Style="{StaticResource InteractiveCard}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Sistem Koruması" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,2">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" 
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" 
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="Kalkan Aktif" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" 
                               Text="System32 &amp; Çekirdek korumalı" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 4: System Drive (C:) Health & Capacity Gauge -->
            <ui:Card Grid.Column="6" Style="{StaticResource InteractiveCard}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding SystemDrive.Name, StringFormat='Sürücü {0} (Doluluk)'}" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SystemDrive.FormattedFree}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>

                    <!-- Drive Progress Bar -->
                    <ProgressBar Grid.Row="1" 
                                 Value="{Binding SystemDrive.UsagePercentage}" 
                                 Maximum="100" 
                                 Height="8" 
                                 Margin="0,10,0,6"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding SystemDrive.UsagePercentage, StringFormat='%{0} Dolu'}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SystemDrive.FormattedTotal, StringFormat='Toplam {0}'}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 1: OPERATION RESULT BANNER                                            -->
        <!-- ========================================================================= -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="Success" 
                    Title="Operasyon Tamamlandı" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,14"/>

        <!-- ========================================================================= -->
        <!-- ROW 2: CLEANING TARGETS & TOOLBAR                                         -->
        <!-- ========================================================================= -->
        <ui:Card Grid.Row="2" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- Cyber Scan Beam Line -->
                    <RowDefinition Height="Auto"/> <!-- Category Filter Pills & Presets -->
                    <RowDefinition Height="Auto"/> <!-- Categories Grid -->
                </Grid.RowDefinitions>

                <!-- Row 0: Title, Presets & Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Temizlik Hedefleri (20 Kategori)" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Temizlenecek geçici dizinleri, önbellekleri ve uygulama kalıntılarını belirleyin." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Right: Main Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Analiz Et (Tara)" 
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding ScanCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   Padding="14,8"
                                   Margin="0,0,8,0"/>

                        <ui:Button Content="Güvenle Temizle" 
                                   Appearance="Success"
                                   Icon="{ui:SymbolIcon Broom24}"
                                   Command="{Binding CleanCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   Padding="14,8"
                                   Margin="0,0,8,0"/>

                        <ui:Button Content="İptal" 
                                   Appearance="Danger"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelCommand}"
                                   IsEnabled="{Binding IsBusy}"
                                   Padding="12,8"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Cyber Scan Beam Line -->
                <Border Grid.Row="1" Height="2" 
                        ClipToBounds="True" 
                        CornerRadius="1"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,12">
                    <Rectangle Width="260" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="0"/>
                                <GradientStop Color="{DynamicResource Color.Accent}" Offset="0.5"/>
                                <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanBeam1"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ScanBeam1"
                                                         Storyboard.TargetProperty="X"
                                                         From="-260" To="1400"
                                                         Duration="0:0:1.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Border>

                <!-- Row 2: Category Filter Pills (Left) + Quick Presets (Right) -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Group Filter Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Kategori:" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <ui:Button Content="Tümü" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding SetCategoryGroupCommand}" CommandParameter="Tümü"/>

                        <ui:Button Content="Windows &amp; Sistem" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding SetCategoryGroupCommand}" CommandParameter="Windows &amp; Sistem"/>

                        <ui:Button Content="Web Tarayıcıları" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding SetCategoryGroupCommand}" CommandParameter="Web Tarayıcıları"/>

                        <ui:Button Content="Oyunlar &amp; Medya" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding SetCategoryGroupCommand}" CommandParameter="Oyunlar &amp; Medya"/>
                    </StackPanel>

                    <!-- Quick Preset Chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profiller:" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <ui:Button Content="🛡️ Hızlı &amp; Güvenli" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding ApplyPresetCommand}" CommandParameter="quick"
                                   ToolTip="Risksiz genel temp ve tarayıcı önbelleklerini seçer."/>

                        <ui:Button Content="🚀 Kapsamlı Derin" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding ApplyPresetCommand}" CommandParameter="deep"
                                   ToolTip="Prefetch, loglar, shader ve güncelleme önbellekleri dahil tüm hedefleri seçer."/>

                        <ui:Button Content="🎮 Oyun &amp; Medya" Appearance="Secondary" Padding="10,4" Margin="0,0,4,0"
                                   Command="{Binding ApplyPresetCommand}" CommandParameter="gaming"
                                   ToolTip="Steam, Spotify, Epic ve Shader önbelleklerini odaklar."/>

                        <ui:Button Content="Tümünü Seç" Appearance="Secondary" Padding="8,4" Margin="0,0,4,0"
                                   Command="{Binding SelectAllCategoriesCommand}"/>

                        <ui:Button Content="Temizle" Appearance="Secondary" Padding="8,4"
                                   Command="{Binding DeselectAllCategoriesCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Categories Grid -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding FilteredCategoriesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12,10" Margin="3" Cursor="Hand" ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CheckBox -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected}" 
                                              AutomationProperties.Name="{Binding FileName}"
                                              Cursor="Hand"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Admin shield icon -->
                                            <ui:SymbolIcon Symbol="ShieldKeyhole20" 
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Margin="4,0,0,0"
                                                           ToolTip="Yönetici (Admin) yetkisi gerektirebilir"
                                                           Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding FormattedSize, StringFormat='Bulunan: {0}'}" 
                                                       FontSize="10" 
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            
                                            <TextBlock Text="{Binding FileCount, StringFormat=' ({0} dosya)'}" 
                                                       FontSize="10" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding FileCount, Converter={StaticResource IntToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Scanning indicator spinner on category -->
                                    <ui:ProgressRing Grid.Column="2" 
                                                     IsIndeterminate="True" 
                                                     Width="16" Height="16" 
                                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,0,0"
                                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ui:Card>

        <!-- ========================================================================= -->
        <!-- ROW 3: REALTIME STATUS & PROGRESS BAR                                     -->
        <!-- ========================================================================= -->
        <ui:Card Grid.Row="3" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status Row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TotalFilesFound, StringFormat='{}{0} dosya'}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Margin="10,0,0,0"/>
                        <TextBlock Text=" · "
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TotalFoundBytesFormatted}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Grid.Row="1"
                             Value="{Binding ProgressPercent}"
                             Maximum="100"
                             Height="4"
                             Margin="0,0,0,4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <!-- Current Scanning File ticker -->
                <TextBlock Grid.Row="2"
                           Text="{Binding CurrentScanningFile, TargetNullValue='Tarama bekleniyor...'}"
                           FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </ui:Card>

        <!-- ========================================================================= -->
        <!-- ROW 4: SCANNED FILES TABLE & RIGHT INSPECTION DRAWER                      -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main: Files List Card -->
            <ui:Card Grid.Column="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filters -->
                        <RowDefinition Height="Auto"/> <!-- Table Header -->
                        <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                    </Grid.RowDefinitions>

                    <!-- Search & Quick Size Filters -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Search Box -->
                        <ui:TextBox Grid.Column="0" 
                                    PlaceholderText="Taranan dosyalarda ara (.log, .tmp)..." 
                                    Text="{Binding SearchFileQuery, UpdateSourceTrigger=PropertyChanged}" 
                                    ClearButtonEnabled="True" 
                                    Icon="{ui:SymbolIcon Search20}" 
                                    VerticalContentAlignment="Center"
                                    Padding="10,6"/>

                        <!-- Size Filter Pills -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Boyut:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:Button Content="Tümü" Appearance="Secondary" Padding="8,3" Margin="0,0,4,0" Command="{Binding SetSizeFilterCommand}" CommandParameter="All"/>
                            <ui:Button Content="> 1 MB" Appearance="Secondary" Padding="8,3" Margin="0,0,4,0" Command="{Binding SetSizeFilterCommand}" CommandParameter="1MB"/>
                            <ui:Button Content="> 10 MB" Appearance="Secondary" Padding="8,3" Margin="0,0,4,0" Command="{Binding SetSizeFilterCommand}" CommandParameter="10MB"/>
                            <ui:Button Content="> 100 MB" Appearance="Secondary" Padding="8,3" Command="{Binding SetSizeFilterCommand}" CommandParameter="100MB"/>
                        </StackPanel>

                        <!-- Counter -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ScannedFiles.Count, StringFormat='Listelenen: {0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Table Column Header -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dosya Adı ve Konumu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Kategori" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Boyut" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="3" Text="Durum" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized ListView -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding FilteredFilesView}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="6" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: File Name & Path -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                    Visibility="{Binding Extension, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding FilePath}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="0,2,0,0"/>
                                    </Grid>

                                    <!-- Column 1: Category -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CategoryName}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,0,12,0"/>

                                    <!-- Column 2: Size -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FormattedSize}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,16,0"/>

                                    <!-- Column 3: Status Badge -->
                                    <Border Grid.Column="3" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="6,3" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="10" 
                                                   FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <!-- Column 1: Right Master-Detail Inspection Drawer -->
            <Border Grid.Column="1" 
                    Width="340" 
                    Margin="14,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Grid DataContext="{Binding SelectedFile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title + Close -->
                        <RowDefinition Height="Auto"/> <!-- File Hero Card -->
                        <RowDefinition Height="*"/>    <!-- Metadata List -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Dosya Teftiş Röntgeni" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" 
                                   Appearance="Secondary"
                                   Padding="6,4"
                                   Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   AutomationProperties.Name="Ayrıntı panelini kapat"
                                   Icon="{ui:SymbolIcon Dismiss20}"/>
                    </Grid>

                    <!-- Hero Card -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                                    Width="40" Height="40" 
                                    CornerRadius="6" 
                                    Background="{DynamicResource Brush.Accent.Subtle}" 
                                    Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Document24" 
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CategoryName}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding FormattedSize}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metadata List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Full Path -->
                            <TextBlock Text="Tam Dosya Yolu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding FilePath}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Directory Path -->
                            <TextBlock Text="Bulunduğu Dizin" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding DirectoryPath}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Last Modified -->
                            <TextBlock Text="Son Değiştirilme Tarihi" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding LastModified, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- Exclusion Status -->
                            <TextBlock Text="Temizlik Durumu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Bu dosya temizleme operasyonuna dahil edilecek." FontSize="10" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0" Visibility="{Binding IsExcluded, Converter={StaticResource InverseBoolToVis}}"/>
                                    <TextBlock Text="Bu dosya kullanıcı tarafından temizlik dışı bırakıldı." FontSize="10" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,3,0,0" Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3">
                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Dosya Konumunu Aç" 
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Padding="12,8" 
                                   Margin="0,0,0,6"/>

                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Dosya Yolunu Kopyala" 
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Padding="12,8" 
                                   Margin="0,0,0,6"/>

                        <ui:Button Appearance="Danger" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.ExcludeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Temizlikten Muaf Tut / Dahil Et" 
                                   Icon="{ui:SymbolIcon ShieldDismiss24}"
                                   Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
