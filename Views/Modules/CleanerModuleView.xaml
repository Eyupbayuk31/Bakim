<UserControl x:Class="Bakım.Views.Modules.CleanerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CleanerViewModel}"
             d:DesignHeight="750" d:DesignWidth="950">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- InfoBar Operation Result -->
            <RowDefinition Height="Auto"/> <!-- Cleaning Targets & Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Realtime Progress & Status -->
            <RowDefinition Height="*"/>    <!-- Virtualized Scanned Files List -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Scanned Found Size -->
            <ui:Card Grid.Column="0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Temizlenebilir Boyut" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="{Binding FormattedFoundBytes}" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding TotalFilesFound, StringFormat='{}{0} adet dosya tespit edildi'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Total Freed Size -->
            <ui:Card Grid.Column="2" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Kazanılan Toplam Alan" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding FormattedFreedBytes}" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding TotalFilesCleaned, StringFormat='{}{0} dosya güvenle temizlendi'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: Security Whitelist Protection Info -->
            <ui:Card Grid.Column="4" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Sistem Koruması" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Grid.Row="1" 
                               Text="Aktif" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" 
                               Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2" 
                               Text="Kritik sistem dosyaları güvende" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Row 1: Wpf.Ui InfoBar for Operation Result -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="Success" 
                    Title="Operasyon Tamamlandı" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,16"/>

        <!-- Row 2: Cleaning Targets & Action Toolbar -->
        <ui:Card Grid.Row="2" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header & Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Temizlik Hedefleri" 
                                       FontSize="15" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       Margin="0,0,16,0"/>
                            
                            <ui:Button Appearance="Secondary" 
                                       Command="{Binding SelectAllCategoriesCommand}"
                                       Padding="8,3" 
                                       Margin="0,0,6,0"
                                       Content="Tümünü Seç"/>

                            <ui:Button Appearance="Secondary" 
                                       Command="{Binding DeselectAllCategoriesCommand}"
                                       Padding="8,3"
                                       Content="Kaldır"/>
                        </StackPanel>

                        <TextBlock Text="Temizlenecek geçici dizinleri ve önbellek öğelerini seçin." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Scan / Clean / Cancel Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Analiz Et (Tara)" 
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding ScanCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   Margin="0,0,8,0"/>

                        <ui:Button Content="Güvenle Temizle" 
                                   Appearance="Success"
                                   Icon="{ui:SymbolIcon Broom24}"
                                   Command="{Binding CleanCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   Margin="0,0,8,0"/>

                        <ui:Button Content="İptal" 
                                   Appearance="Danger"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelCommand}"
                                   IsEnabled="{Binding IsBusy}"/>
                    </StackPanel>
                </Grid>

                <!-- Categories UniformGrid -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12,10" Margin="4" Cursor="Hand" ClipToBounds="False">
                                <CheckBox IsChecked="{Binding IsSelected}" 
                                          Cursor="Hand"
                                          Margin="2,0,4,0"
                                          VerticalAlignment="Center">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding FormattedSize, StringFormat='Bulunan: {0}'}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ui:Card>

        <!-- Row 3: Realtime Status & Progress Bar -->
        <ui:Card Grid.Row="3" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{Binding StatusText}" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding ProgressPercent, StringFormat='%{0}'}" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                               Margin="10,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <StackPanel Grid.Row="1">
                    <ProgressBar Value="{Binding ProgressPercent}" 
                                 Maximum="100" 
                                 Margin="0,0,0,4"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    
                    <TextBlock Text="{Binding CurrentScanningFile}" 
                               FontSize="10" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                               TextTrimming="CharacterEllipsis" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Row 4: Virtualized Scanned Files List -->
        <ui:Card Grid.Row="4" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Taranan Dosyalar" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding ScannedFiles.Count, StringFormat='Listelenen: {0}'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Grid Grid.Row="1" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Column Header (Strictly Matching Row Columns) -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CleanerSizeCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CleanerStatusCol"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dosya Adı ve Konumu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Kategori" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Boyut" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="3" Text="Durum" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized ListView with Stretch ItemContainerStyle -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding ScannedFiles}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="44"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="6" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanerSizeCol"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanerStatusCol"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: File Name & Path (Grid instead of horizontal StackPanel) -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" 
                                                   Text="{Binding FileName}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding FilePath}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="0,2,0,0"/>
                                    </Grid>

                                    <!-- Column 1: Category -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CategoryName}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,0,12,0"/>

                                    <!-- Column 2: Size -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FormattedSize}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,16,0"/>

                                    <!-- Column 3: Status Badge -->
                                    <Border Grid.Column="3" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="8,4" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Status, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="10" 
                                                   FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
