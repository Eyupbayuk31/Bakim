<UserControl x:Class="Bakım.Views.Modules.CleanerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:c="clr-namespace:Bakım.Controls"
              xmlns:vm="clr-namespace:Bakım.ViewModels"
              mc:Ignorable="d" 
              d:DataContext="{d:DesignInstance Type=vm:CleanerViewModel}"
              d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Başlık ve özet -->
            <RowDefinition Height="Auto"/> <!-- Row 1: InfoBar Operation Result -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Cleaning Targets & Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Realtime Progress & Status -->
            <RowDefinition Height="*"/>    <!-- Row 4: Virtualized Scanned Files & Drawer -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Sayfa başlığı (tek birincil eylem: Temizle) + özet şeridi -->
        <StackPanel Grid.Row="0">
            <c:SectionHeader IsPageTitle="True"
                             Icon="Broom24"
                             HeaderMargin="0,0,0,20"
                             Title="Temizleyici"
                             Description="Geçici dosyaları, önbellekleri ve uygulama kalıntılarını bulur. Silinenler Etkinlik Merkezi'ne kaydedilir.">
                <c:SectionHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Secondary"
                                   Content="İptal"
                                   Icon="{ui:SymbolIcon Dismiss20}"
                                   Command="{Binding CancelCommand}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                   Margin="{StaticResource Gap.Right.SM}"/>
                        <ui:Button Appearance="Secondary"
                                   Content="Tara"
                                   Icon="{ui:SymbolIcon Search20}"
                                   Command="{Binding ScanCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   Margin="{StaticResource Gap.Right.SM}"
                                   AutomationProperties.Name="Seçili hedefleri tara"/>
                        <ui:Button Appearance="Primary"
                                   Content="Temizle"
                                   Icon="{ui:SymbolIcon Broom20}"
                                   Command="{Binding CleanCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   AutomationProperties.Name="Seçili hedefleri güvenle temizle"/>
                    </StackPanel>
                </c:SectionHeader.Actions>
            </c:SectionHeader>

            <c:SummaryStrip>
                <c:StatCard Icon="Broom24"
                            Label="Temizlenebilir"
                            Value="{Binding FormattedFoundBytes}"
                            Caption="{Binding TotalFilesFound, StringFormat='{}{0} dosya bulundu'}"/>
                <c:StatCard Icon="CheckmarkCircle24"
                            Label="Bu oturumda temizlenen"
                            Value="{Binding FormattedFreedBytes}"
                            Caption="{Binding TotalFilesCleaned, StringFormat='{}{0} dosya'}"/>
                <c:StatCard Icon="HardDrive20"
                            Label="{Binding SystemDrive.Name, StringFormat='Sürücü {0}'}"
                            Value="{Binding SystemDrive.FormattedFree, StringFormat='{}{0} boş'}"
                            Caption="{Binding SystemDrive.UsagePercentage, StringFormat='%{0} dolu'}"/>
            </c:SummaryStrip>
        </StackPanel>

        <!-- ========================================================================= -->
        <!-- ROW 1: OPERATION RESULT BANNER                                            -->
        <!-- ========================================================================= -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="Success" 
                    Title="Temizlik tamamlandı" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,14"/>

        <!-- ========================================================================= -->
        <!-- ROW 2: CLEANING TARGETS & TOOLBAR                                         -->
        <!-- ========================================================================= -->
        <ui:Card Grid.Row="2" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- Tarama ilerlemesi -->
                    <RowDefinition Height="Auto"/> <!-- Category Filter Pills & Presets -->
                    <RowDefinition Height="Auto"/> <!-- Categories Grid -->
                </Grid.RowDefinitions>

                <!-- Row 0: Bölüm başlığı -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Temizlik hedefleri" Style="{StaticResource Text.CardTitle}"/>
                    <TextBlock Text="Temizlenecek geçici klasörleri, önbellekleri ve uygulama kalıntılarını seçin."
                               Style="{StaticResource Text.SettingDescription}" MaxWidth="10000"/>
                </StackPanel>

                <!-- Row 1: Tarama ilerlemesi (Fluent ProgressBar) -->
                <ProgressBar Grid.Row="1"
                             Style="{StaticResource Progress.Header}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <!-- Row 2: Category Filter Pills & Quick Presets (Responsive WrapPanel Layout) -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- Group Filter Pills (Segmented Container) -->
                    <Border Style="{StaticResource FluentSegmentedContainer}" Margin="0,0,14,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Tümü" Appearance="{Binding CategoryGroupFilter, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Tümü}" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding SetCategoryGroupCommand}" CommandParameter="Tümü"/>

                            <ui:Button Content="Windows ve sistem" Appearance="{Binding CategoryGroupFilter, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Windows &amp; Sistem'}" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding SetCategoryGroupCommand}" CommandParameter="Windows &amp; Sistem"/>

                            <ui:Button Content="Web tarayıcıları" Appearance="{Binding CategoryGroupFilter, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Web Tarayıcıları'}" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding SetCategoryGroupCommand}" CommandParameter="Web Tarayıcıları"/>

                            <ui:Button Content="Oyunlar ve medya" Appearance="{Binding CategoryGroupFilter, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Oyunlar &amp; Medya'}" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding SetCategoryGroupCommand}" CommandParameter="Oyunlar &amp; Medya"/>

                            <ui:Button Content="Geliştirici" Appearance="{Binding CategoryGroupFilter, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Geliştirici}" Padding="10,4"
                                       Command="{Binding SetCategoryGroupCommand}" CommandParameter="Geliştirici"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Preset Chips -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="Profiller:" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Border Style="{StaticResource FluentSegmentedContainer}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Hızlı ve güvenli" Icon="{ui:SymbolIcon ShieldCheckmark20}" Appearance="Secondary" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding ApplyPresetCommand}" CommandParameter="quick"
                                       ToolTip="Risksiz genel temp ve tarayıcı önbelleklerini seçer."/>

                            <ui:Button Content="Kapsamlı derin" Icon="{ui:SymbolIcon TopSpeed20}" Appearance="Secondary" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding ApplyPresetCommand}" CommandParameter="deep"
                                       ToolTip="Prefetch, loglar, shader ve güncelleme önbellekleri dahil tüm hedefleri seçer."/>

                            <ui:Button Content="Oyun ve medya" Icon="{ui:SymbolIcon Games20}" Appearance="Secondary" Padding="10,4" Margin="0,0,2,0"
                                       Command="{Binding ApplyPresetCommand}" CommandParameter="gaming"
                                       ToolTip="Steam, Spotify, Epic ve Shader önbelleklerini odaklar."/>

                            <ui:Button Content="Tümünü seç" Appearance="Secondary" Padding="8,4" Margin="0,0,2,0"
                                       Command="{Binding SelectAllCategoriesCommand}"/>

                            <ui:Button Content="Temizle" Appearance="Secondary" Padding="8,4"
                                       Command="{Binding DeselectAllCategoriesCommand}"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </WrapPanel>

                <!-- Row 3: Categories Grid -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding FilteredCategoriesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12,10" Margin="3" Cursor="Hand" ClipToBounds="False" ToolTip="{Binding Description}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CheckBox -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected}" 
                                              AutomationProperties.Name="{Binding Name}"
                                              AutomationProperties.HelpText="{Binding Description}"
                                              Cursor="Hand"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="{StaticResource Font.Caption}" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Admin shield icon -->
                                            <ui:SymbolIcon Symbol="ShieldKeyhole20" 
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Margin="4,0,0,0"
                                                           ToolTip="Yönetici (Admin) yetkisi gerektirebilir"
                                                           Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding FormattedSize, StringFormat='Bulunan: {0}'}" 
                                                       FontSize="{StaticResource Font.Micro}" 
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            
                                            <TextBlock Text="{Binding FileCount, StringFormat=' ({0} dosya)'}" 
                                                       FontSize="{StaticResource Font.Micro}" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding FileCount, Converter={StaticResource IntToVis}}"/>
                                        </StackPanel>

                                        <!-- İlgili uygulama açık: kilitli dosyalar atlanacak (§5.2) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding IsAppRunning, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="Warning20" FontSize="{StaticResource Icon.XS}" Margin="0,0,4,0"
                                                           Foreground="{DynamicResource Status.Caution.Text}"/>
                                            <TextBlock Text="Uygulama açık · bazı dosyalar atlanacak" FontSize="{StaticResource Font.Micro}"
                                                       Foreground="{DynamicResource Status.Caution.Text}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Kullanımdaki önbellek dosyaları silinemez. Tamamı için uygulamayı kapatıp yeniden tarayın."/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Scanning indicator spinner on category -->
                                    <ui:ProgressRing Grid.Column="2" 
                                                     IsIndeterminate="True" 
                                                     Width="16" Height="16" 
                                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,0,0"
                                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ui:Card>

        <!-- ========================================================================= -->
        <!-- ROW 3: REALTIME STATUS & PROGRESS BAR                                     -->
        <!-- ========================================================================= -->
        <ui:Card Grid.Row="3" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status Row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="{StaticResource Font.Caption}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TotalFilesFound, StringFormat='{}{0} dosya'}"
                                   FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="10,0,0,0"/>
                        <TextBlock Text=" · "
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TotalFoundBytesFormatted}"
                                   FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Grid.Row="1"
                             Value="{Binding ProgressPercent}"
                             Maximum="100"
                             Height="4"
                             Margin="0,0,0,4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <!-- Current Scanning File ticker -->
                <TextBlock Grid.Row="2"
                           Text="{Binding CurrentScanningFile, TargetNullValue='Tarama bekleniyor...'}"
                           FontSize="{StaticResource Font.Micro}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </ui:Card>

        <!-- ========================================================================= -->
        <!-- ROW 4: SCANNED FILES TABLE & RIGHT INSPECTION DRAWER                      -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main: Files List Card -->
            <ui:Card Grid.Column="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filters -->
                        <RowDefinition Height="Auto"/> <!-- Table Header -->
                        <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                    </Grid.RowDefinitions>

                    <!-- Search & Quick Size Filters (Responsive Wrap Layout) -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Live Search Box -->
                            <ui:TextBox PlaceholderText="Taranan dosyalarda ara (.log, .tmp)..." 
                                        Text="{Binding SearchFileQuery, UpdateSourceTrigger=PropertyChanged}" 
                                        ClearButtonEnabled="True" 
                                        Icon="{ui:SymbolIcon Search20}" 
                                        VerticalContentAlignment="Center"
                                        MinWidth="220" MaxWidth="360"
                                        Padding="10,6"
                                        Margin="0,0,12,4"/>

                            <!-- Size Filter Pills -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,4">
                                <TextBlock Text="Boyut:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:Button Content="Tümü" Appearance="Secondary" Padding="8,3" Margin="0,0,4,0" Command="{Binding SetSizeFilterCommand}" CommandParameter="All"/>
                                <ui:Button Content="> 1 MB" Appearance="Secondary" Padding="8,3" Margin="0,0,4,0" Command="{Binding SetSizeFilterCommand}" CommandParameter="1MB"/>
                                <ui:Button Content="> 10 MB" Appearance="Secondary" Padding="8,3" Margin="0,0,4,0" Command="{Binding SetSizeFilterCommand}" CommandParameter="10MB"/>
                                <ui:Button Content="> 100 MB" Appearance="Secondary" Padding="8,3" Command="{Binding SetSizeFilterCommand}" CommandParameter="100MB"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Counter -->
                        <Border Grid.Column="1" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="{StaticResource Radius.SM}" 
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <TextBlock Text="{Binding ScannedFiles.Count, StringFormat='Listelenen: {0}'}"
                                       FontSize="{StaticResource Font.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Table Column Header -->
                    <Border Grid.Row="1" Style="{StaticResource Table.HeaderRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dosya Adı ve Konumu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Kategori" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Boyut" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="3" Text="Durum" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized ListView -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding FilteredFilesView}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="{StaticResource Radius.SM}" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: File Name & Path -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="{StaticResource Font.Caption}" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="{StaticResource Radius.XS}" Padding="4,1" Margin="6,0,0,0"
                                                    Visibility="{Binding Extension, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Extension}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding FilePath}" 
                                                   FontSize="{StaticResource Font.Micro}" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="0,2,0,0"/>
                                    </Grid>

                                    <!-- Column 1: Category -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CategoryName}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,0,12,0"/>

                                    <!-- Column 2: Size -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FormattedSize}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,16,0"/>

                                    <!-- Column 3: Status Badge -->
                                    <Border Grid.Column="3" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{StaticResource Radius.XS}" 
                                            Padding="6,3" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="{StaticResource Font.Micro}" 
                                                   FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <!-- Column 1: Right Master-Detail Inspection Drawer -->
            <Border Grid.Column="1" 
                    Width="340" 
                    Margin="14,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="16"
                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Grid DataContext="{Binding SelectedFile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title + Close -->
                        <RowDefinition Height="Auto"/> <!-- File Hero Card -->
                        <RowDefinition Height="*"/>    <!-- Metadata List -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Dosya ayrıntıları" 
                                   FontSize="{StaticResource Font.Body}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" 
                                   Appearance="Secondary"
                                   Padding="6,4"
                                   Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   AutomationProperties.Name="Ayrıntı panelini kapat"
                                   Icon="{ui:SymbolIcon Dismiss20}"/>
                    </Grid>

                    <!-- Hero Card -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            CornerRadius="{StaticResource Radius.MD}" 
                            Padding="12" 
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                                    Width="40" Height="40" 
                                    CornerRadius="{StaticResource Radius.SM}" 
                                    Background="{DynamicResource Brush.Accent.Subtle}" 
                                    Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Document24" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" 
                                           FontSize="{StaticResource Font.Body}" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CategoryName}" 
                                           FontSize="{StaticResource Font.Caption}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding FormattedSize}" 
                                           FontSize="{StaticResource Font.Caption}" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metadata List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Full Path -->
                            <TextBlock Text="Tam dosya yolu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding FilePath}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Directory Path -->
                            <TextBlock Text="Bulunduğu dizin" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding DirectoryPath}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Last Modified -->
                            <TextBlock Text="Son değiştirilme tarihi" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding LastModified, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- Exclusion Status -->
                            <TextBlock Text="Temizlik durumu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Bu dosya temizleme operasyonuna dahil edilecek." FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,3,0,0" Visibility="{Binding IsExcluded, Converter={StaticResource InverseBoolToVis}}"/>
                                    <TextBlock Text="Bu dosya kullanıcı tarafından temizlik dışı bırakıldı." FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,3,0,0" Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3">
                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Dosya konumunu aç" 
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Padding="12,8" 
                                   Margin="0,0,0,6"/>

                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Dosya yolunu kopyala" 
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Padding="12,8" 
                                   Margin="0,0,0,6"/>

                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.ExcludeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Temizlikten muaf tut / dahil et" 
                                   Icon="{ui:SymbolIcon ShieldDismiss24}"
                                   Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
