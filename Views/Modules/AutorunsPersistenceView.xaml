<UserControl x:Class="Bakım.Views.Modules.AutorunsPersistenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Global Actions -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Statistics Cards -->
            <RowDefinition Height="Auto"/> <!-- 2: Category Filter Bar & Options -->
            <RowDefinition Height="*"/>    <!-- 3: Virtualized Items List -->
            <RowDefinition Height="Auto"/> <!-- 4: Status Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Header & Action Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Kalıcılık &amp; Autoruns Analizörü" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Sysinternals derinliğinde Windows başlangıç vektörleri, WMI kalıcılıkları, dijital imza ve VirusTotal taraması." 
                           FontSize="12.5" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="36,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" 
                           Command="{Binding ExportReportCsvCommand}"
                           Padding="12,8"
                           Margin="0,0,8,0"
                           Content="CSV Raporu"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           ToolTip="Kalıcılık listesini CSV olarak dışa aktar"/>
                
                <ui:Button Appearance="Primary" 
                           Command="{Binding ScanCommand}"
                           IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}"
                           Padding="14,8"
                           Content="Yeniden Tara"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           ToolTip="Tüm kalıcılık noktalarını yeniden tara"/>
            </StackPanel>
        </Grid>

        <!-- 1. KPI Statistics Cards (4 Columns) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Entries -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Aktif Kalıcılık" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Unsigned / High Risk -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="İmzasız / Şüpheli" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UnsignedCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Verified Trusted -->
            <Border Grid.Column="4" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Doğrulanmış İmza" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VerifiedCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Disabled Items -->
            <Border Grid.Column="6" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pause24" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Devre Dışı" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisabledCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Category Toolbar & Options -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Category Filter Buttons -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="All"
                               Appearance="{Binding IsAllCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Tümü"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Registry"
                               Appearance="{Binding IsRegistryCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Kayıt Defteri (Run)" Icon="{ui:SymbolIcon Document20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Startup"
                               Appearance="{Binding IsStartupCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Başlangıç Klasörü" Icon="{ui:SymbolIcon Folder20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Tasks"
                               Appearance="{Binding IsTasksCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Zamanlanmış Görevler" Icon="{ui:SymbolIcon CalendarClock20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Services"
                               Appearance="{Binding IsServicesCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Windows Servisleri" Icon="{ui:SymbolIcon DeveloperBoard20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Wmi"
                               Appearance="{Binding IsWmiCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="WMI Kalıcılığı" Icon="{ui:SymbolIcon Flash20}"/>
                    <ui:Button Command="{Binding SetCategoryFilterCommand}" CommandParameter="Shell"
                               Appearance="{Binding IsShellCategory, Converter={StaticResource BoolToNavAppearance}}"
                               Padding="12,6" Margin="0,0,6,4" Content="Shell Eklentileri" Icon="{ui:SymbolIcon Desktop20}"/>
                </WrapPanel>

                <!-- Row 2: Search Box & Sysinternals Filter Toggles -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <ui:TextBox Grid.Column="0" 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="İsim, yol, yayıncı veya SHA-256 ara..."
                                Icon="{ui:SymbolIcon Search20}"
                                ClearButtonEnabled="True"
                                VerticalContentAlignment="Center"
                                Padding="10,6"/>

                    <!-- Filter Switches (Sysinternals Hide Microsoft) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Microsoft Girdilerini Gizle" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding HideMicrosoftEntries, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Yalnızca İmzasızları Göster" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding ShowOnlyUnsigned, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Virtualized Persistence Items List -->
        <Border Grid.Row="3" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <ListBox ItemsSource="{Binding FilteredItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Grid.IsSharedSizeScope="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PersistenceItem}">
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="StatusCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="IconCol"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CatCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SigCol"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ActionCol"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Safe Enable/Disable ToggleSwitch -->
                                <ui:ToggleSwitch Grid.Column="0" 
                                                 IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                 Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,14,0"
                                                 ToolTip="Başlangıçta çalışmayı aktif et / güvenli devre dışı bırak"/>

                                <!-- Column 1: Application Icon -->
                                <Border Grid.Column="1" 
                                        Width="36" Height="36" 
                                        CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding IconSource}" 
                                               Width="24" Height="24"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <ui:SymbolIcon Symbol="Document24" 
                                                       FontSize="18" 
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Name, Path & Location Source -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding LocationSource, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding FilePath}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding Publisher, StringFormat='Yayıncı: {0}'}" 
                                               FontSize="10.5" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Column 3: Category Badge -->
                                <Border Grid.Column="3" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryDisplayName}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <!-- Column 4: Digital Signature Badge -->
                                <Border Grid.Column="4" 
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#15F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                    <Setter Property="Background" Value="#1510B981"/>
                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                    <Setter Property="Background" Value="#15EF4444"/>
                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="12" Margin="0,0,4,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding Signature}" FontSize="11" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Verified">
                                                            <Setter Property="Text" Value="Doğrulandı"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="Unsigned">
                                                            <Setter Property="Text" Value="İmzasız"/>
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Signature}" Value="InvalidOrTampered">
                                                            <Setter Property="Text" Value="Geçersiz İmza"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Column 5: Action Buttons (VirusTotal, Open Location, Delete) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- VirusTotal Web Lookup Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.OpenVirusTotalWebCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Globe20}"
                                               ToolTip="VirusTotal'de SHA-256 Raporunu Aç"/>

                                    <!-- Open File Location Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon FolderOpen20}"
                                               ToolTip="Dosya Konumunu Windows Gezgini'nde Aç"/>

                                    <!-- Copy Hash Button -->
                                    <ui:Button Appearance="Secondary"
                                               Padding="8,5"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.CopySha256Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Copy20}"
                                               ToolTip="SHA-256 Hash'ini Panoya Kopyala"/>

                                    <!-- Permanent Delete Button -->
                                    <ui:Button Appearance="Danger"
                                               Padding="8,5"
                                               Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Delete20}"
                                               ToolTip="Kalıcı Olarak Sil"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 4. Status Footer -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" 
                                 Width="16" Height="16" 
                                 Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ScanStatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Bakım Güvenlik Kalkanı v41.0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>
</UserControl>
