<UserControl x:Class="Bakım.Views.Modules.CrashAnalyzerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CrashAnalyzerViewModel}"
             d:DesignHeight="780" d:DesignWidth="1050">

    <c:ModulePage Title="Olaylar ve çökmeler"
                  Subtitle="Mavi ekran dökümleri, Windows hata günlükleri ve sistem dosyası onarımı."
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <ui:Button Appearance="Secondary"
                           Command="{Binding RefreshAllCommand}"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"/>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Navigation -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- 2: Sub-tab Toolbar / Filter -->
            <RowDefinition Height="*"/>    <!-- 3: Active Viewport Content -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Güvenilirlik kartı + sekmeler (SelectorBar) -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Card.Surface.Hero}" Margin="{StaticResource Gap.Bottom.MD}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card.IconTile}" VerticalAlignment="Top" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="HeartPulse24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,32,0" MinWidth="160">
                        <TextBlock Text="Sistem sağlığı" Style="{StaticResource Text.SettingDescription}" Margin="0"/>
                        <TextBlock FontSize="{StaticResource Font.TitleLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,2">
                            <Run Text="%"/><Run Text="{Binding Stats.HealthScore, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Stats.HealthStatusText}" Style="{StaticResource Text.SettingDescription}"/>
                    </StackPanel>

                    <!-- Windows Güvenilirlik İzleyicisi: son 30 günün günlük en düşük endeksi -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,24,0">
                        <ItemsControl ItemsSource="{Binding ReliabilityBars}" Height="56"
                                      Visibility="{Binding HasReliability, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="8" Height="{Binding Height}" Margin="0,0,3,0" VerticalAlignment="Bottom"
                                            CornerRadius="{StaticResource Radius.XS}" Background="{Binding Brush}" ToolTip="{Binding Tooltip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReliabilityText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                            Padding="20,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mavi ekran" Style="{StaticResource Text.SettingDescription}" Margin="0,0,24,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stats.TotalCrashesCount}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kritik olay (7 gün)" Style="{StaticResource Text.SettingDescription}" Margin="0,0,24,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.CriticalEvents7DaysCount}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hata (7 gün)" Style="{StaticResource Text.SettingDescription}" Margin="0,0,24,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stats.ErrorEvents7DaysCount}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Bottom.MD}">
                <ui:Button Content="Mavi ekranlar" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding ActiveTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Bsod}"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Bsod"/>
                <ui:Button Content="Olaylar" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding ActiveTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Events}"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Events"/>
                <ui:Button Content="Onarım" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding ActiveTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Repair}"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Repair"/>
            </StackPanel>
        </StackPanel>

        <!-- 2. Sub-tab Filter / Search Bar (Only for Events Tab) -->
        <Grid Grid.Row="2" Margin="0,0,0,14" 
              Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Events}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: Filter Buttons in WrapPanel -->
            <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <ui:Button Content="Tümü" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="All"
                           Appearance="{Binding SelectedEventLevel, Converter={StaticResource StringToNavAppearance}, ConverterParameter=All}"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Yalnızca kritik" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Kritik"
                           Appearance="{Binding SelectedEventLevel, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Kritik}"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Hatalar" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Hata"
                           Appearance="{Binding SelectedEventLevel, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Hata}"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Kernel-Power" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Kernel"
                           Appearance="{Binding SelectedEventLevel, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Kernel}"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Uygulama çökmeleri" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="App"
                           Appearance="{Binding SelectedEventLevel, Converter={StaticResource StringToNavAppearance}, ConverterParameter=App}"
                           Padding="12,6"
                           Margin="0,0,0,4"/>
            </WrapPanel>

            <!-- Row 1: Search Box & Clear Logs Button -->
            <ui:TextBox Grid.Row="1" Grid.Column="0" 
                        PlaceholderText="Kaynak, olay ID veya mesaj ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        VerticalContentAlignment="Center"
                        Padding="12,8"
                        Margin="0,0,10,0" AutomationProperties.Name="Kaynak, olay ID veya mesaj ara..."/>

            <!-- Olay Görüntüleyici (günlük silme özelliği kaldırıldı: S-15) -->
            <ui:Button Grid.Row="1" Grid.Column="1" 
                       Appearance="Secondary" 
                       Command="{Binding OpenEventViewerCommand}"
                       Padding="14,8"
                       Content="Olay Görüntüleyici"
                       Icon="{ui:SymbolIcon Open20}"
                       AutomationProperties.Name="Windows Olay Görüntüleyici'yi aç"/>
        </Grid>

        <!-- 3. Active Viewport Content -->
        <Grid Grid.Row="3">
            <!-- VIEW 1: BSOD & Crashes -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Bsod}">
                <!-- Empty State (No Crashes Found) -->
                <Border Style="{StaticResource Card.Surface}" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center" 
                         MaxWidth="560"
                         Visibility="{Binding Stats.TotalCrashesCount, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mavi ekran kaydı yok" 
                                   FontSize="{StaticResource Font.Subtitle}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="Sisteminizde kayıtlı herhangi bir Minidump dökümü veya çekirdek çökmesi tespit edilmedi. Donanımınız ve sürücüleriniz kararlı çalışıyor." 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Crashes List -->
                <ListView ItemsSource="{Binding Crashes}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BsodCrashItem}">
                            <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,8" ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Crash Details -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <!-- BugCheck String -->
                                            <TextBlock Text="{Binding BugCheckString}" 
                                                       FontSize="{StaticResource Font.BodyLarge}" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>

                                            <!-- BugCheck Code Badge -->
                                            <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,2" 
                                                    Background="{DynamicResource Card.Fill.Secondary}" 
                                                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding BugCheckCode, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding BugCheckCode}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                            </Border>

                                            <!-- Time Badge -->
                                            <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,2" 
                                                    Background="{DynamicResource Card.Fill.Secondary}" 
                                                    BorderBrush="{DynamicResource Divider.Stroke}" 
                                                    BorderThickness="1" 
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding FormattedCrashTime, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding FormattedCrashTime}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Offending Driver -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Neden olan sürücü: " FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CausedByDriver}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DriverDescription, StringFormat=' ({0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Explanation -->
                                        <TextBlock Text="{Binding Explanation}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,2,0,6"/>

                                        <!-- Dump Path -->
                                        <TextBlock Text="{Binding DumpFilePath, StringFormat='Döküm Dosyası: {0}'}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary" 
                                                   Content="Klasörde göster" 
                                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                                   Command="{Binding DataContext.OpenDumpLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="12,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 2: Critical Event Logs -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Events}"
                  Grid.IsSharedSizeScope="True">
                <ListView ItemsSource="{Binding FilteredEvents}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SystemEventItem}">
                            <Border Style="{StaticResource Card.Surface.Compact}" Margin="0,0,0,6" ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CrashEventLevelCol"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CrashEventTimeCol"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Level Badge -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="{StaticResource Radius.XS}" 
                                            Padding="8,4" 
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Card.Fill.Secondary}" 
                                            BorderBrush="{DynamicResource Divider.Stroke}" 
                                            BorderThickness="1"
                                            Visibility="{Binding Level, Converter={StaticResource NullToVisibilityConverter}}">
                                         <TextBlock Text="{Binding Level}" 
                                                    FontSize="{StaticResource Font.Caption}" 
                                                    FontWeight="SemiBold" 
                                                    Foreground="{Binding Level, Converter={StaticResource EventLevelToBrush}}"/>
                                    </Border>

                                    <!-- Event Content -->
                                    <StackPanel Grid.Column="1" Margin="6,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding EventId, StringFormat=' (Olay ID: {0})'}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding LogName, StringFormat=' [{0}]'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FormattedTime}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding FormattedTime, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 3: System Repair Tools -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Repair}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Two Action Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SFC Action Card -->
                    <Border Style="{StaticResource Card.Surface}" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="SFC sistem dosyası onarımı" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="Bozuk veya eksik Windows sistem dosyalarını otomatik olarak tarar ve önbellekteki temiz kopyalarla değiştirir (sfc /scannow)." 
                                       FontSize="{StaticResource Font.Caption}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12"/>

                            <ui:Button Grid.Row="2" 
                                       Appearance="Secondary" 
                                       Command="{Binding RunSfcCommand}"
                                       IsEnabled="{Binding IsRepairRunning, Converter={StaticResource InverseBool}}"
                                       Padding="14,8"
                                       Content="SFC taramasını başlat"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}"/>
                        </Grid>
                    </Border>

                    <!-- DISM Action Card -->
                    <Border Style="{StaticResource Card.Surface}" Grid.Column="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="DISM Windows imaj onarımı" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="Windows bileşen deposunu (Component Store) Windows Update sunucuları üzerinden indirilen sağlıklı dosyalarla onarır (DISM /RestoreHealth)." 
                                       FontSize="{StaticResource Font.Caption}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12"/>

                            <ui:Button Grid.Row="2" 
                                       Appearance="Secondary" 
                                       Command="{Binding RunDismCommand}"
                                       IsEnabled="{Binding IsRepairRunning, Converter={StaticResource InverseBool}}"
                                       Padding="14,8"
                                       Content="DISM onarımını başlat"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Live Terminal Console Card -->
                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Title & Action -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Canlı onarım konsolu" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0"
                                                 Visibility="{Binding IsRepairRunning, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1" 
                                       Appearance="Secondary" 
                                       Command="{Binding ClearConsoleCommand}"
                                       Padding="10,4"
                                       Content="Konsolu temizle"/>
                        </Grid>

                        <!-- Console Output Screen -->
                        <Border Grid.Row="1" 
                                Background="{DynamicResource ApplicationBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="{StaticResource Radius.SM}" 
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}" AutomationProperties.Name="Konsol çıktısı" 
                                         IsReadOnly="True" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                         FontFamily="Consolas, Cascadia Mono, Courier New" 
                                         FontSize="{StaticResource Font.Caption}" 
                                         TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Margin="0,12,0,0" 
                Padding="12,8" 
                Background="{DynamicResource Card.Fill}" 
                BorderBrush="{DynamicResource Card.Stroke.Glass}" 
                BorderThickness="1" 
                CornerRadius="{StaticResource Radius.MD}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" 
                                 IsIndeterminate="True" 
                                 Width="18" Height="18" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
    </c:ModulePage>
</UserControl>
