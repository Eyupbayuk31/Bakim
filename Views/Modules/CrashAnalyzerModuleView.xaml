<UserControl x:Class="Bakım.Views.Modules.CrashAnalyzerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CrashAnalyzerViewModel}"
             d:DesignHeight="780" d:DesignWidth="1050">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Navigation -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- 2: Sub-tab Toolbar / Filter -->
            <RowDefinition Height="*"/>    <!-- 3: Active Viewport Content -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header Section -->
                <!-- Sayfa basligi — tasarim sistemi bileseni -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Olay Günlüğü &amp; Sistem Sağlığı"
                         Description="Mavi ekran dökümleri, Windows hata günlükleri ve sistem dosyası onarımı.">
            <c:SectionHeader.Actions>
                <!-- Sub-Tab Switcher & Refresh Button -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource FluentSegmentedContainer}"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Mavi Ekran (BSOD)"
                                       Appearance="{Binding ActiveTab, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Bsod}"
                                       Icon="{ui:SymbolIcon DismissCircle20}"
                                       Command="{Binding SwitchTabCommand}"
                                       CommandParameter="Bsod"
                                       Padding="14,6"
                                       Margin="0,0,2,0"/>
                            <ui:Button Content="Kritik Günlükler"
                                       Appearance="{Binding ActiveTab, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Events}"
                                       Icon="{ui:SymbolIcon Warning20}"
                                       Command="{Binding SwitchTabCommand}"
                                       CommandParameter="Events"
                                       Padding="14,6"
                                       Margin="0,0,2,0"/>
                            <ui:Button Content="Sistem Onarımı"
                                       Appearance="{Binding ActiveTab, Converter={StaticResource StringToNavAppearance}, ConverterParameter=Repair}"
                                       Icon="{ui:SymbolIcon Wrench20}"
                                       Command="{Binding SwitchTabCommand}"
                                       CommandParameter="Repair"
                                       Padding="14,6"/>
                        </StackPanel>
                    </Border>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshAllCommand}"
                               Padding="12,8"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. Top KPI Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Health Score -->
            <ui:Card Grid.Column="0" Style="{StaticResource InteractiveCard}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sistem Sağlık Skoru" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="%" FontSize="{StaticResource Font.Title}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{Binding Stats.HealthScore}" FontSize="{StaticResource Font.Title}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{Binding Stats.HealthStatusText, StringFormat=' ({0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <!-- Windows Güvenilirlik İzleyicisi: son 30 günün günlük en düşük endeksi (§5.10.4) -->
                        <ItemsControl ItemsSource="{Binding ReliabilityBars}" Height="36" Margin="0,8,0,0"
                                      Visibility="{Binding HasReliability, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="5" Height="{Binding Height}" Margin="0,0,2,0" VerticalAlignment="Bottom"
                                            CornerRadius="{StaticResource Radius.XS}" Background="{Binding Brush}" ToolTip="{Binding Tooltip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReliabilityText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark24" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Total Crashes -->
            <c:StatCard Grid.Column="2" 
                        Icon="DismissCircle24" 
                        Label="Mavi Ekran / Çökme" 
                        Value="{Binding Stats.TotalCrashesCount}" 
                        Caption="adet döküm kaydı" 
                        Intent="Critical" 
                        IsInteractive="True"/>

            <!-- Card 3: Critical Events (7 Days) -->
            <c:StatCard Grid.Column="4" 
                        Icon="Warning24" 
                        Label="Kritik Olaylar (7 Gün)" 
                        Value="{Binding Stats.CriticalEvents7DaysCount}" 
                        Caption="kritik hata tespit edildi" 
                        Intent="Caution" 
                        IsInteractive="True"/>

            <!-- Card 4: Error Logs -->
            <c:StatCard Grid.Column="6" 
                        Icon="DocumentBulletList24" 
                        Label="Hata Günlükleri (7 Gün)" 
                        Value="{Binding Stats.ErrorEvents7DaysCount}" 
                        Caption="hata günlüğü kaydı" 
                        Intent="Accent" 
                        IsInteractive="True"/>
        </Grid>

        <!-- 2. Sub-tab Filter / Search Bar (Only for Events Tab) -->
        <Grid Grid.Row="2" Margin="0,0,0,14" 
              Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Events}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: Filter Buttons in WrapPanel -->
            <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <ui:Button Content="Tümü" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="All"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Yalnızca Kritik" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Kritik"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Hatalar" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Hata"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Kernel-Power" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Kernel"
                           Padding="12,6" 
                           Margin="0,0,6,4"/>
                <ui:Button Content="Uygulama Çökmeleri" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="App"
                           Padding="12,6"
                           Margin="0,0,0,4"/>
            </WrapPanel>

            <!-- Row 1: Search Box & Clear Logs Button -->
            <ui:TextBox Grid.Row="1" Grid.Column="0" 
                        PlaceholderText="Kaynak, olay ID veya mesaj ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        VerticalContentAlignment="Center"
                        Padding="12,8"
                        Margin="0,0,10,0" AutomationProperties.Name="Kaynak, olay ID veya mesaj ara..."/>

            <!-- Olay Görüntüleyici (günlük silme özelliği kaldırıldı: S-15) -->
            <ui:Button Grid.Row="1" Grid.Column="1" 
                       Appearance="Secondary" 
                       Command="{Binding OpenEventViewerCommand}"
                       Padding="14,8"
                       Content="Olay Görüntüleyici"
                       Icon="{ui:SymbolIcon Open20}"
                       AutomationProperties.Name="Windows Olay Görüntüleyici'yi aç"/>
        </Grid>

        <!-- 3. Active Viewport Content -->
        <Grid Grid.Row="3">
            <!-- VIEW 1: BSOD & Crashes -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Bsod}">
                <!-- Empty State (No Crashes Found) -->
                <ui:Card Padding="24" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center" 
                         MaxWidth="560"
                         Visibility="{Binding Stats.TotalCrashesCount, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mavi Ekran (BSOD) Çökmesi Bulunamadı!" 
                                   FontSize="{StaticResource Font.Subtitle}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="Sisteminizde kayıtlı herhangi bir Minidump dökümü veya çekirdek çökmesi tespit edilmedi. Donanımınız ve sürücüleriniz kararlı çalışıyor." 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </ui:Card>

                <!-- Crashes List -->
                <ListView ItemsSource="{Binding Crashes}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BsodCrashItem}">
                            <ui:Card Padding="18,14" Margin="0,0,0,8" ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Crash Details -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <!-- BugCheck String -->
                                            <TextBlock Text="{Binding BugCheckString}" 
                                                       FontSize="{StaticResource Font.BodyLarge}" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>

                                            <!-- BugCheck Code Badge -->
                                            <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,2" 
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding BugCheckCode, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding BugCheckCode}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                            </Border>

                                            <!-- Time Badge -->
                                            <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,2" 
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding FormattedCrashTime, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding FormattedCrashTime}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Offending Driver -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Neden Olan Sürücü: " FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CausedByDriver}" FontSize="{StaticResource Font.Caption}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DriverDescription, StringFormat=' ({0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Explanation -->
                                        <TextBlock Text="{Binding Explanation}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,2,0,6"/>

                                        <!-- Dump Path -->
                                        <TextBlock Text="{Binding DumpFilePath, StringFormat='Döküm Dosyası: {0}'}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary" 
                                                   Content="Klasörde Göster" 
                                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                                   Command="{Binding DataContext.OpenDumpLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="12,8"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 2: Critical Event Logs -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Events}"
                  Grid.IsSharedSizeScope="True">
                <ListView ItemsSource="{Binding FilteredEvents}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SystemEventItem}">
                            <ui:Card Padding="14,10" Margin="0,0,0,6" ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CrashEventLevelCol"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CrashEventTimeCol"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Level Badge -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="{StaticResource Radius.XS}" 
                                            Padding="8,4" 
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1"
                                            Visibility="{Binding Level, Converter={StaticResource NullToVisibilityConverter}}">
                                         <TextBlock Text="{Binding Level}" 
                                                    FontSize="{StaticResource Font.Caption}" 
                                                    FontWeight="SemiBold" 
                                                    Foreground="{Binding Level, Converter={StaticResource EventLevelToBrush}}"/>
                                    </Border>

                                    <!-- Event Content -->
                                    <StackPanel Grid.Column="1" Margin="6,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding EventId, StringFormat=' (Olay ID: {0})'}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding LogName, StringFormat=' [{0}]'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FormattedTime}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding FormattedTime, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 3: System Repair Tools -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Repair}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Two Action Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SFC Action Card -->
                    <ui:Card Grid.Column="0" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="SFC Sistem Dosyası Onarımı" FontSize="{StaticResource Font.BodyLarge}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="Bozuk veya eksik Windows sistem dosyalarını otomatik olarak tarar ve önbellekteki temiz kopyalarla değiştirir (sfc /scannow)." 
                                       FontSize="{StaticResource Font.Caption}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12"/>

                            <ui:Button Grid.Row="2" 
                                       Appearance="Primary" 
                                       Command="{Binding RunSfcCommand}"
                                       IsEnabled="{Binding IsRepairRunning, Converter={StaticResource InverseBool}}"
                                       Padding="14,8"
                                       Content="SFC Taramasını Başlat"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}"/>
                        </Grid>
                    </ui:Card>

                    <!-- DISM Action Card -->
                    <ui:Card Grid.Column="2" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="DISM Windows İmaj Onarımı" FontSize="{StaticResource Font.BodyLarge}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="Windows bileşen deposunu (Component Store) Windows Update sunucuları üzerinden indirilen sağlıklı dosyalarla onarır (DISM /RestoreHealth)." 
                                       FontSize="{StaticResource Font.Caption}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12"/>

                            <ui:Button Grid.Row="2" 
                                       Appearance="Success" 
                                       Command="{Binding RunDismCommand}"
                                       IsEnabled="{Binding IsRepairRunning, Converter={StaticResource InverseBool}}"
                                       Padding="14,8"
                                       Content="DISM Onarımını Başlat"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Live Terminal Console Card -->
                <ui:Card Grid.Row="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Title & Action -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Canlı Onarım Konsolu" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0"
                                                 Visibility="{Binding IsRepairRunning, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1" 
                                       Appearance="Secondary" 
                                       Command="{Binding ClearConsoleCommand}"
                                       Padding="10,4"
                                       Content="Konsolu Temizle"/>
                        </Grid>

                        <!-- Console Output Screen -->
                        <Border Grid.Row="1" 
                                Background="{DynamicResource ApplicationBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="{StaticResource Radius.SM}" 
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}" AutomationProperties.Name="Konsol çıktısı" 
                                         IsReadOnly="True" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                         FontFamily="Consolas, Cascadia Mono, Courier New" 
                                         FontSize="{StaticResource Font.Caption}" 
                                         TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Margin="0,12,0,0" 
                Padding="12,8" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="{StaticResource Radius.MD}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" 
                                 IsIndeterminate="True" 
                                 Width="18" Height="18" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
