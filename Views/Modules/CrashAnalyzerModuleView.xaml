<UserControl x:Class="Bakım.Views.Modules.CrashAnalyzerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CrashAnalyzerViewModel}"
             d:DesignHeight="780" d:DesignWidth="1050">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Navigation -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- 2: Sub-tab Toolbar / Filter -->
            <RowDefinition Height="*"/>    <!-- 3: Active Viewport Content -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Olay Günlüğü &amp; Sistem Sağlığı" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Mavi ekran (BSOD) döküm analizi, Windows hata günlükleri ve tek tıkla sistem dosyası onarımı." 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Sub-Tab Switcher & Refresh Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="4" 
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Mavi Ekran (BSOD)" 
                                   Command="{Binding SwitchTabCommand}" 
                                   CommandParameter="Bsod"
                                   Padding="14,6" 
                                   Margin="0,0,4,0"/>
                        <ui:Button Content="Kritik Günlükler" 
                                   Command="{Binding SwitchTabCommand}" 
                                   CommandParameter="Events"
                                   Padding="14,6"
                                   Margin="0,0,4,0"/>
                        <ui:Button Content="Sistem Onarımı" 
                                   Command="{Binding SwitchTabCommand}" 
                                   CommandParameter="Repair"
                                   Padding="14,6"/>
                    </StackPanel>
                </Border>

                <ui:Button Appearance="Secondary" 
                           Command="{Binding RefreshAllCommand}"
                           Padding="12,8"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"/>
            </StackPanel>
        </Grid>

        <!-- 1. Top KPI Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Health Score -->
            <ui:Card Grid.Column="0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sistem Sağlık Skoru" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{Binding Stats.HealthScore}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{Binding Stats.HealthStatusText, StringFormat=' ({0})'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark24" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Total Crashes -->
            <ui:Card Grid.Column="2" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mavi Ekran / Çökme" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.TotalCrashesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text=" adet döküm" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="DismissCircle24" FontSize="24" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: Critical Events (7 Days) -->
            <ui:Card Grid.Column="4" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kritik Olaylar (7 Gün)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.CriticalEvents7DaysCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            <TextBlock Text=" kritik hata" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Warning24" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 4: Error Logs -->
            <ui:Card Grid.Column="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hata Günlükleri (7 Gün)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.ErrorEvents7DaysCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text=" hata kaydı" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="DocumentBulletList24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 2. Sub-tab Filter / Search Bar (Only for Events Tab) -->
        <Grid Grid.Row="2" Margin="0,0,0,14" 
              Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Events}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Tümü" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="All"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Yalnızca Kritik" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Kritik"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Hatalar" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Hata"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Kernel-Power" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="Kernel"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Uygulama Çökmeleri" 
                           Command="{Binding SetEventLevelFilterCommand}" 
                           CommandParameter="App"
                           Padding="12,6"/>
            </StackPanel>

            <!-- Search Box -->
            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Kaynak, olay ID veya mesaj ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        VerticalContentAlignment="Center"
                        Padding="12,8"
                        Margin="0,0,10,0"/>

            <!-- Clear Event Logs Button -->
            <ui:Button Grid.Column="2" 
                       Appearance="Danger" 
                       Command="{Binding ClearEventLogsCommand}"
                       Padding="12,8"
                       Content="Günlükleri Temizle"
                       Icon="{ui:SymbolIcon Delete20}"/>
        </Grid>

        <!-- 3. Active Viewport Content -->
        <Grid Grid.Row="3">
            <!-- VIEW 1: BSOD & Crashes -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Bsod}">
                <!-- Empty State (No Crashes Found) -->
                <ui:Card Padding="24" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center" 
                         MaxWidth="560"
                         Visibility="{Binding Stats.TotalCrashesCount, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mavi Ekran (BSOD) Çökmesi Bulunamadı!" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="Sisteminizde kayıtlı herhangi bir Minidump dökümü veya çekirdek çökmesi tespit edilmedi. Donanımınız ve sürücüleriniz kararlı çalışıyor." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </ui:Card>

                <!-- Crashes List -->
                <ListView ItemsSource="{Binding Crashes}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BsodCrashItem}">
                            <ui:Card Padding="18,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Crash Details -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <!-- BugCheck String -->
                                            <TextBlock Text="{Binding BugCheckString}" 
                                                       FontSize="15" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>

                                            <!-- BugCheck Code Badge -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="10,0,0,0">
                                                <TextBlock Text="{Binding BugCheckCode}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                            </Border>

                                            <!-- Time Badge -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding FormattedCrashTime}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Offending Driver -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Neden Olan Sürücü: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CausedByDriver}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DriverDescription, StringFormat=' ({0})'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Explanation -->
                                        <TextBlock Text="{Binding Explanation}" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,2,0,6"/>

                                        <!-- Dump Path -->
                                        <TextBlock Text="{Binding DumpFilePath, StringFormat='Döküm Dosyası: {0}'}" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary" 
                                                   Content="Klasörde Göster" 
                                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                                   Command="{Binding DataContext.OpenDumpLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="12,8"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 2: Critical Event Logs -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Events}">
                <ListView ItemsSource="{Binding FilteredEvents}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SystemEventItem}">
                            <ui:Card Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Level Badge -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="4" 
                                            Padding="8,4" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1">
                                         <TextBlock Text="{Binding Level}" 
                                                    FontSize="11" 
                                                    FontWeight="SemiBold" 
                                                    Foreground="{Binding Level, Converter={StaticResource EventLevelToBrush}}"/>
                                    </Border>

                                    <!-- Event Content -->
                                    <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding EventId, StringFormat=' (Olay ID: {0})'}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding LogName, StringFormat=' [{0}]'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FormattedTime}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 3: System Repair Tools -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Repair}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Two Action Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SFC Action Card -->
                    <ui:Card Grid.Column="0" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="SFC Sistem Dosyası Onarımı" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="Bozuk veya eksik Windows sistem dosyalarını otomatik olarak tarar ve önbellekteki temiz kopyalarla değiştirir (sfc /scannow)." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12"/>

                            <ui:Button Grid.Row="2" 
                                       Appearance="Primary" 
                                       Command="{Binding RunSfcCommand}"
                                       IsEnabled="{Binding IsRepairRunning, Converter={StaticResource InverseBool}}"
                                       Padding="14,8"
                                       Content="SFC Taramasını Başlat"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}"/>
                        </Grid>
                    </ui:Card>

                    <!-- DISM Action Card -->
                    <ui:Card Grid.Column="2" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="DISM Windows İmaj Onarımı" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="Windows bileşen deposunu (Component Store) Windows Update sunucuları üzerinden indirilen sağlıklı dosyalarla onarır (DISM /RestoreHealth)." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12"/>

                            <ui:Button Grid.Row="2" 
                                       Appearance="Success" 
                                       Command="{Binding RunDismCommand}"
                                       IsEnabled="{Binding IsRepairRunning, Converter={StaticResource InverseBool}}"
                                       Padding="14,8"
                                       Content="DISM Onarımını Başlat"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Live Terminal Console Card -->
                <ui:Card Grid.Row="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Title & Action -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Canlı Onarım Konsolu" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0"
                                                 Visibility="{Binding IsRepairRunning, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1" 
                                       Appearance="Secondary" 
                                       Command="{Binding ClearConsoleCommand}"
                                       Padding="10,4"
                                       Content="Konsolu Temizle"/>
                        </Grid>

                        <!-- Console Output Screen -->
                        <Border Grid.Row="1" 
                                Background="#0A0F1D" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Foreground="#38BDF8" 
                                         FontFamily="Consolas, Cascadia Mono, Courier New" 
                                         FontSize="12" 
                                         TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Margin="0,12,0,0" 
                Padding="12,8" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" 
                                 IsIndeterminate="True" 
                                 Width="18" Height="18" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
