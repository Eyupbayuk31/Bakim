<UserControl x:Class="Bakım.Views.Modules.StorageLargeFilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">
    <!-- Depolama › Büyük dosyalar. -->
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Scanner Controls & Filters -->
            <RowDefinition Height="*"/>    <!-- Content Area (Empty States or Results) -->
        </Grid.RowDefinitions>

        <!-- 1. Komut satırı (kartsız): sürücü + tara | arama + sırala; altında filtre çipleri ve ilerleme -->
        <StackPanel Grid.Row="0" Margin="{StaticResource Gap.Bottom.MD}">
            <DockPanel LastChildFill="False" Margin="{StaticResource Gap.Bottom.SM}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AvailableDrives}" AutomationProperties.Name="Sürücü"
                              SelectedItem="{Binding SelectedDriveFilter, Mode=TwoWay}"
                              MinWidth="120" Margin="{StaticResource Gap.Right.SM}"/>
                    <ui:Button Appearance="{Binding HasResults, Converter={StaticResource InverseBoolToNavAppearance}}"
                               Content="Tara"
                               Icon="{ui:SymbolIcon Search24}"
                               Command="{Binding ScanLargeFilesCommand}"
                               IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                               Margin="{StaticResource Gap.Right.SM}"/>
                    <ui:Button Appearance="Secondary"
                               Content="Durdur"
                               Command="{Binding CancelScanCommand}"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Dosya veya uzantı ara"
                                Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True"
                                Width="240"
                                Margin="{StaticResource Gap.Right.SM}"
                                AutomationProperties.Name="Dosya ara"/>
                    <ComboBox SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              MinWidth="150"
                              AutomationProperties.Name="Sırala">
                        <ComboBoxItem Content="Boyut (büyükten)" Tag="SizeDesc"/>
                        <ComboBoxItem Content="Boyut (küçükten)" Tag="SizeAsc"/>
                        <ComboBoxItem Content="Tarih (en yeni)" Tag="DateDesc"/>
                        <ComboBoxItem Content="Tarih (en eski)" Tag="DateAsc"/>
                        <ComboBoxItem Content="Ad (A-Z)" Tag="NameAsc"/>
                        <ComboBoxItem Content="Ad (Z-A)" Tag="NameDesc"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <!-- Boyut eşiği -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                        <TextBlock Text="Boyut" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:Button Content="100 MB+" 
                                   Appearance="{Binding IsThreshold100Mb, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetThresholdCommand}" 
                                   CommandParameter="100" 
                                   Padding="8,4" Margin="0,0,4,0"/>
                        <ui:Button Content="500 MB+" 
                                   Appearance="{Binding IsThreshold500Mb, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetThresholdCommand}" 
                                   CommandParameter="500" 
                                   Padding="8,4" Margin="0,0,4,0"/>
                        <ui:Button Content="1 GB+" 
                                   ToolTip="Varsayılan ve önerilen boyut eşiği (1 GB ve üzeri)"
                                   Appearance="{Binding IsThreshold1Gb, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetThresholdCommand}" 
                                   CommandParameter="1024" 
                                   Padding="8,4" Margin="0,0,4,0"/>
                        <ui:Button Content="2 GB+" 
                                   Appearance="{Binding IsThreshold2Gb, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetThresholdCommand}" 
                                   CommandParameter="2048" 
                                   Padding="8,4" Margin="0,0,4,0"/>
                        <ui:Button Content="5 GB+" 
                                   Appearance="{Binding IsThreshold5Gb, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetThresholdCommand}" 
                                   CommandParameter="5120" 
                                   Padding="8,4"/>
                    </StackPanel>

                    <!-- Tür -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="Tür" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:Button Content="Tümü" 
                                   Appearance="{Binding IsCategoryAll, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetCategoryFilterCommand}" 
                                   CommandParameter="Tümü" 
                                   Padding="9,4" Margin="0,0,4,0"/>
                        <ui:Button Content="Videolar" 
                                   Appearance="{Binding IsCategoryVideo, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetCategoryFilterCommand}" 
                                   CommandParameter="Video" 
                                   Padding="9,4" Margin="0,0,4,0"/>
                        <ui:Button Content="Disk imajları" 
                                   Appearance="{Binding IsCategoryDiskImage, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetCategoryFilterCommand}" 
                                   CommandParameter="Disk İmajı" 
                                   Padding="9,4" Margin="0,0,4,0"/>
                        <ui:Button Content="Arşivler" 
                                   Appearance="{Binding IsCategoryArchive, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetCategoryFilterCommand}" 
                                   CommandParameter="Arşiv" 
                                   Padding="9,4" Margin="0,0,4,0"/>
                        <ui:Button Content="Kurulum / oyun" 
                                   Appearance="{Binding IsCategoryInstaller, Converter={StaticResource BoolToNavAppearance}}"
                                   Command="{Binding SetCategoryFilterCommand}" 
                                   CommandParameter="Kurulum / Oyun" 
                                   Padding="9,4"/>
                    </StackPanel>

                </WrapPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,0,6"
                           Text="{Binding TotalLargeFilesSizeFormatted}"
                           FontSize="{StaticResource Font.Caption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>

            <!-- Tarama ilerlemesi -->
            <TextBlock Text="{Binding ScanProgressText}"
                       FontSize="{StaticResource Font.Caption}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,4"
                       Visibility="{Binding ScanProgressText, Converter={StaticResource StringToVis}}"/>
            <ProgressBar Style="{StaticResource Progress.Header}"
                         Margin="0"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- 2. CONTENT AREA: HERO EMPTY STATE / ZERO-RESULTS STATE / RESULTS STATE -->
        <Grid Grid.Row="1">
            <!-- 2A. Tarama öncesi: sürücü özeti + boş durum -->
            <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVis}}">
                <Border Style="{StaticResource Card.Surface}" Margin="{StaticResource Gap.Bottom.LG}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding SelectedDriveName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SelectedDriveVolumeLabel, Mode=OneWay}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource Font.Caption}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding SelectedDriveFreeGb, Mode=OneWay}"/><Run Text=" GB boş · toplam "/><Run Text="{Binding SelectedDriveTotalGb, Mode=OneWay}"/><Run Text=" GB"/>
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar Value="{Binding SelectedDriveUsagePercentage, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <c:EmptyState Icon="DocumentSearch24"
                              Title="Henüz tarama yapılmadı"
                              Description="Sürücüdeki büyük dosyaları (videolar, disk imajları, arşivler, kurulum paketleri) boyutuna göre listeler. Silinenler Geri Dönüşüm Kutusu'na gider."/>
            </StackPanel>

            <!-- 2B. Tarama sonrası sonuç yok -->
            <c:EmptyState Icon="CheckmarkCircle24"
                          Title="Bu eşiğin üzerinde dosya yok"
                          Description="Daha küçük dosyaları görmek için boyut eşiğini düşürüp yeniden tarayın."
                          Visibility="{Binding HasNoResultsAfterScan, Converter={StaticResource BoolToVis}}">
                <c:EmptyState.Actions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Appearance="Secondary" Content="100 MB+"
                                   Command="{Binding SetThresholdCommand}" CommandParameter="100"
                                   Margin="{StaticResource Gap.Right.SM}"/>
                        <ui:Button Appearance="Secondary" Content="500 MB+"
                                   Command="{Binding SetThresholdCommand}" CommandParameter="500"/>
                    </StackPanel>
                </c:EmptyState.Actions>
            </c:EmptyState>

            <!-- 2C. RESULTS STATE (Category Bar + Batch Toolbar + Virtualized List) -->
            <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Category Distribution Legend Bar -->
                    <RowDefinition Height="Auto"/> <!-- Multi-Select & Batch Actions Bar -->
                    <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                </Grid.RowDefinitions>

                <!-- Tür dağılımı: renk noktalı sade gösterge -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource Gap.Bottom.SM}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Chart.Series4}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Videolar"/><Run Text=" "/><Run Text="{Binding CategoryStats.VideoFormatted, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Chart.Series1}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Disk imajları"/><Run Text=" "/><Run Text="{Binding CategoryStats.DiskImageFormatted, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Chart.Series2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Arşivler"/><Run Text=" "/><Run Text="{Binding CategoryStats.ArchiveFormatted, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Chart.Series3}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Kurulum / oyun"/><Run Text=" "/><Run Text="{Binding CategoryStats.InstallerFormatted, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Chart.Axis}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Diğer"/><Run Text=" "/><Run Text="{Binding CategoryStats.OtherFormatted, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </WrapPanel>

                <!-- Multi-Select & Batch Actions Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: CheckBox & Selected Count Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                  Content="Tümünü seç"
                                  FontSize="{StaticResource Font.Caption}"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"
                                  Margin="4,0,12,0"
                                  AutomationProperties.Name="Tümünü Seç"/>

                        <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding SelectedFilesCount, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><Run Text=" dosya seçili · "/><Run Text="{Binding SelectedFilesTotalBytesFormatted, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right: Batch Recycle & Batch Delete Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary"
                                   Icon="{ui:SymbolIcon Delete20}"
                                   Content="Geri Dönüşüm Kutusu'na taşı"
                                   Command="{Binding RecycleSelectedFilesCommand}"
                                   IsEnabled="{Binding HasSelectedFiles}"
                                   Padding="12,6"
                                   Margin="0,0,8,0"
                                   ToolTip="Seçili dosyaları güvenle Geri Dönüşüm Kutusuna gönderir"/>
                        <ui:Button Appearance="Secondary"
                                   Content="Kalıcı olarak sil"
                                   Command="{Binding DeleteSelectedFilesCommand}"
                                   IsEnabled="{Binding HasSelectedFiles}"
                                   Padding="12,6"
                                   ToolTip="Seçili dosyaları diskten kalıcı olarak siler"/>
                    </StackPanel>
                </Grid>

                <!-- Liste: tek yüzey içinde satırlar -->
                <Border Grid.Row="2" Style="{StaticResource Card.Surface}" Padding="4">
                <ListView 
                          ItemsSource="{Binding FilteredLargeFiles}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource Radius.XS}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LargeDiskFileItem}">
                            <Border Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>                                <!-- CheckBox -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LargeIconCol"/> <!-- Category Icon Symbol -->
                                        <ColumnDefinition Width="2.5*"/>                                <!-- File Name & Path -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LargeCatCol"/>  <!-- Category Badge -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LargeSizeCol"/> <!-- Formatted Size -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LargeActionCol"/><!-- Action Buttons -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Multi-Select CheckBox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              AutomationProperties.Name="Dosya Seçimi"/>

                                    <!-- Category Icon Symbol -->
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="{Binding CategorySymbol}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- File Name, Full Path & Date -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding FileName}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FilePath}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding LastModifiedFormatted}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Category Badge -->
                                    <Border Grid.Column="3" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.XS}" Padding="8,2" 
                                            VerticalAlignment="Center" 
                                            Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Category}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Formatted Size -->
                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding SizeFormatted}" 
                                               FontSize="{StaticResource Font.Body}" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center" 
                                               TextAlignment="Right" 
                                               Margin="0,0,16,0"/>

                                    <!-- Action Buttons: Copy Path, Safe Recycle Bin, Folder Location, Permanent Delete -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" 
                                                   Icon="{ui:SymbolIcon Copy20}"
                                                   Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Dosya yolunu panoya kopyala"
                                                   Padding="6" 
                                                   Margin="0,0,6,0" 
                                                   AutomationProperties.Name="Dosya Yolunu Panoya Kopyala"/>

                                        <ui:Button Appearance="Transparent" 
                                                   Icon="{ui:SymbolIcon Delete20}"
                                                   Command="{Binding DataContext.SendToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Geri Dönüşüm Kutusuna taşı (güvenli silme)"
                                                   Padding="6" 
                                                   Margin="0,0,6,0" 
                                                   AutomationProperties.Name="Geri Dönüşüm Kutusuna Taşı"/>

                                        <ui:Button Appearance="Transparent" 
                                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                                   Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Klasörde göster"
                                                   Padding="6" 
                                                   Margin="0,0,6,0" 
                                                   AutomationProperties.Name="Klasörde Göster"/>

                                        <ui:Button Appearance="Transparent" 
                                                   Icon="{ui:SymbolIcon Dismiss20}"
                                                   Command="{Binding DataContext.DeleteLargeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                                   ToolTip="Kalıcı olarak sil"
                                                   Padding="6" 
                                                   AutomationProperties.Name="Kalıcı Olarak Sil"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
