<UserControl x:Class="Bakım.Views.Modules.StorageModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}"
             d:DesignHeight="950" d:DesignWidth="1100">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık ve sekmeler -->
            <RowDefinition Height="*"/>    <!-- 1: Etkin sekme -->
        </Grid.RowDefinitions>

        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         Icon="HardDrive24"
                         HeaderMargin="0,0,0,20"
                         Title="Depolama"
                         Description="Büyük dosyaları, yinelenen dosyaları ve boş klasörleri bulur. Silinenler varsayılan olarak Geri Dönüşüm Kutusu'na gider.">
            <c:SectionHeader.Actions>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.MD}"
                        Padding="4">
                    <StackPanel Orientation="Horizontal">
                            <!-- Tab 3: Large Files -->
                            <ui:Button Appearance="{Binding IsLargeFilesTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="LargeFiles"
                                       Padding="12,6"
                                       Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderZip20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Büyük Dosyalar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Tab 4: Duplicate & Empty Folders -->
                            <ui:Button Appearance="{Binding IsDuplicatesTab, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SwitchSubTabCommand}"
                                       CommandParameter="Duplicates"
                                       Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy20" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Yinelenen &amp; Boş Klasörler" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                    </StackPanel>
                </Border>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- ========================================================================= -->
        <!-- 3: TAB 3 - BÜYÜK DOSYA ANALİZÖRÜ (1GB+) (OVERHAUL)                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsLargeFilesTab, Converter={StaticResource BoolToVis}}"
              Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Scanner Controls & Filters -->
                <RowDefinition Height="*"/>    <!-- Content Area (Empty States or Results) -->
            </Grid.RowDefinitions>

            <!-- 1. Scanner Toolbar Card (Fully Responsive Layout with WrapPanels) -->
            <ui:Card Grid.Row="0" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Target Drive Selector & Primary Actions -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Subtle Divider -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Threshold Chips & Category Chips (WrapPanel) -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Live Search, Multi-Sort & Summary Badge -->
                        <RowDefinition Height="Auto"/> <!-- Row 4: Progress & Radar Scan Beam -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Target Drive & Primary Actions (Scan & Stop) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drive Selector -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Hedef Sürücü:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableDrives}" AutomationProperties.Name="Sürücü filtresi" 
                                      SelectedItem="{Binding SelectedDriveFilter, Mode=TwoWay}"
                                      MinWidth="140"
                                      Padding="8,5"/>
                        </StackPanel>

                        <!-- Right: Scan & Stop Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" 
                                       Content="Büyük Dosyaları Tara" 
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding ScanLargeFilesCommand}"
                                       IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                       Padding="14,7" 
                                       Margin="0,0,8,0"/>

                            <ui:Button Appearance="Danger" 
                                       Content="Durdur" 
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Command="{Binding CancelScanCommand}"
                                       IsEnabled="{Binding IsScanning}"
                                       Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Subtle Divider -->
                    <Separator Grid.Row="1" Margin="0,2,0,10" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Row 2: Filter Presets (Threshold Chips & Category Chips in a WrapPanel) -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <!-- Boyut Eşiği Grubu -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                            <TextBlock Text="Boyut Eşiği:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Content="100 MB+" 
                                       Appearance="{Binding IsThreshold100Mb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="100" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="500 MB+" 
                                       Appearance="{Binding IsThreshold500Mb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="500" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="1 GB+" 
                                       ToolTip="Varsayılan ve önerilen boyut eşiği (1 GB ve üzeri)"
                                       Appearance="{Binding IsThreshold1Gb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="1024" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="2 GB+" 
                                       Appearance="{Binding IsThreshold2Gb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="2048" 
                                       Padding="8,4" Margin="0,0,4,0"/>
                            <ui:Button Content="5 GB+" 
                                       Appearance="{Binding IsThreshold5Gb, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetThresholdCommand}" 
                                       CommandParameter="5120" 
                                       Padding="8,4"/>
                        </StackPanel>

                        <!-- Tür Filtresi Grubu -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="Tür Filtresi:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Content="Tümü" 
                                       Appearance="{Binding IsCategoryAll, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Tümü" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Videolar" 
                                       Appearance="{Binding IsCategoryVideo, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Video" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Disk İmajları" 
                                       Appearance="{Binding IsCategoryDiskImage, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Disk İmajı" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Arşivler" 
                                       Appearance="{Binding IsCategoryArchive, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Arşiv" 
                                       Padding="9,4" Margin="0,0,4,0"/>
                            <ui:Button Content="Kurulum / Oyun" 
                                       Appearance="{Binding IsCategoryInstaller, Converter={StaticResource BoolToNavAppearance}}"
                                       Command="{Binding SetCategoryFilterCommand}" 
                                       CommandParameter="Kurulum / Oyun" 
                                       Padding="9,4"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Row 3: Live Search, Multi-Sort Selector & Summary Badge -->
                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: SearchBox & Sort Selector in WrapPanel -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Live SearchBox -->
                            <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Dosya veya uzantı ara..."
                                        ClearButtonEnabled="True"
                                        MinWidth="170"
                                        Padding="8,5"
                                        Margin="0,0,10,4"
                                        AutomationProperties.Name="Dosya arama kutusu"/>

                            <!-- Sort Selector -->
                            <ComboBox SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      MinWidth="150"
                                      Padding="8,5"
                                      Margin="0,0,10,4"
                                      AutomationProperties.Name="Sıralama Seçici">
                                <ComboBoxItem Content="Boyut (Büyükten)" Tag="SizeDesc"/>
                                <ComboBoxItem Content="Boyut (Küçükten)" Tag="SizeAsc"/>
                                <ComboBoxItem Content="Tarih (En Yeni)" Tag="DateDesc"/>
                                <ComboBoxItem Content="Tarih (En Eski)" Tag="DateAsc"/>
                                <ComboBoxItem Content="İsim (A-Z)" Tag="NameAsc"/>
                                <ComboBoxItem Content="İsim (Z-A)" Tag="NameDesc"/>
                            </ComboBox>
                        </WrapPanel>

                        <!-- Right: File Count & Total Size Summary Badge -->
                        <Border Grid.Column="1" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12,5"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TotalLargeFilesSizeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Scan Progress & Radar Beam -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status text -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,4"
                                    Visibility="{Binding ScanProgressText, Converter={StaticResource StringToVis}}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="12" Height="12"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ScanProgressText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Indeterminate progress bar -->
                        <ProgressBar Grid.Row="1"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Height="4"
                                     Margin="0,0,0,4"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

                        <!-- Animated radar scan beam -->
                        <Border Grid.Row="2"
                                Height="2"
                                ClipToBounds="True"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <Rectangle HorizontalAlignment="Left" Width="180" Height="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource Color.Accent.Glow}" Offset="0.5"/>
                                        <GradientStop Color="{DynamicResource Color.Accent.Transparent}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="LargeFileScanBeam"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LargeFileScanBeam"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-180" To="1400"
                                                                 Duration="0:0:1.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- 2. CONTENT AREA: HERO EMPTY STATE / ZERO-RESULTS STATE / RESULTS STATE -->
            <Grid Grid.Row="1">
                <!-- 2A. HERO EMPTY STATE (Before Scan) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Margin="0,0,0,16">
                        <!-- Sürücü Depolama Özeti Kartı -->
                        <ui:Card Padding="18,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Drive Info & Usage Percent Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedDriveName}"/><Run Text=" ("/><Run Text="{Binding SelectedDriveVolumeLabel}"/><Run Text=") - "/><Run Text="{Binding SelectedDriveFormat}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Usage Badge -->
                                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                            <Run Text="% "/><Run Text="{Binding SelectedDriveUsagePercentage}"/><Run Text=" Dolu"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Visual Drive Usage Bar -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding SelectedDriveUsagePercentage}"
                                             Maximum="100"
                                             Height="8"
                                             Margin="0,12,0,12"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                <!-- 3 Key Storage Metrics -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Metric 1: Total Capacity -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Toplam Kapasite" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedDriveTotalGb}"/><Run Text=" GB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 2: Used Space -->
                                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Kullanılan Alan" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedDriveUsedGb}"/><Run Text=" GB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 3: Free Space -->
                                    <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Boş Alan" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedDriveFreeGb}"/><Run Text=" GB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ui:Card>

                        <!-- 4 Quick Guidance Cards (2x2 Grid) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Guide 1: Videos -->
                            <ui:Card Grid.Row="0" Grid.Column="0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#20A855F7" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Video24" FontSize="18" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Büyük Videolar &amp; Kayıtlar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="MP4, MKV, AVI, TS. 4K ekran ve oyun kayıtları diskin en büyük kısmını kaplayabilir." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Guide 2: Disk Images -->
                            <ui:Card Grid.Row="0" Grid.Column="2" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2038BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sanal Diskler &amp; İmajlar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="ISO, VMDK, VHDX, IMG. Kurulum kalıpları ve sanal makineler tek başına onlarca gigabayt yer kaplar." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Guide 3: Archives -->
                            <ui:Card Grid.Row="2" Grid.Column="0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#20F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="FolderZip24" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Arşiv &amp; Sıkıştırılmış Paketler" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="ZIP, RAR, 7Z, TAR. İndirilip açıldıktan sonra unutulan büyük yedek arşivleri." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Guide 4: Installers -->
                            <ui:Card Grid.Row="2" Grid.Column="2" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Kurulum &amp; Oyun Paketleri" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="EXE, MSI, PAK, DAT. Büyük oyun yükleyicileri ve artık gereksiz kurulum paketleri." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </Grid>

                        <!-- Hero Scan CTA Callout -->
                        <ui:Card Padding="24,20" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Sürücünüzü derinlemesine tarayarak en çok alan kaplayan dosyaları bulun ve güvenle temizleyin." 
                                           FontSize="13" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <ui:Button Appearance="Primary"
                                           Content="Büyük Dosya Taramasını Başlat"
                                           Icon="{ui:SymbolIcon Search24}"
                                           Command="{Binding ScanLargeFilesCommand}"
                                           Padding="22,10"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2B. ZERO-RESULTS AFTER SCAN STATE -->
                <ui:Card Padding="32,24" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center"
                         MaxWidth="560"
                         Visibility="{Binding HasNoResultsAfterScan, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="42" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Eşik Değerinin Üzerinde Dosya Bulunamadı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Seçili sürücüde belirlenen boyut eşiğini aşan herhangi bir dosya tespit edilmedi. Daha düşük boyutlu dosyaları listelemek için aşağıdaki seçenekleri deneyebilirsiniz:" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   Margin="0,0,0,16"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Content="100 MB+ ile Yeniden Tara"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding SetThresholdCommand}"
                                       CommandParameter="100"
                                       Padding="14,8"
                                       Margin="0,0,8,0"/>
                            <ui:Button Appearance="Secondary"
                                       Content="500 MB+ ile Yeniden Tara"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding SetThresholdCommand}"
                                       CommandParameter="500"
                                       Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 2C. RESULTS STATE (Category Bar + Batch Toolbar + Virtualized List) -->
                <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Category Distribution Legend Bar -->
                        <RowDefinition Height="Auto"/> <!-- Multi-Select & Batch Actions Bar -->
                        <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                    </Grid.RowDefinitions>

                    <!-- Category Distribution Legend Bar -->
                    <ui:Card Grid.Row="0" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <!-- Video -->
                            <Border Background="#20A855F7" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Video24" FontSize="14" Foreground="#A855F7" Margin="0,0,6,0"/>
                                    <TextBlock Text="Videolar: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.VideoFormatted}" FontSize="11" FontWeight="Bold" Foreground="#A855F7"/>
                                </StackPanel>
                            </Border>
                            <!-- Disk Image -->
                            <Border Background="#2038BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="HardDrive24" FontSize="14" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                    <TextBlock Text="Disk İmajı: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.DiskImageFormatted}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                            <!-- Archive -->
                            <Border Background="#20F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" Foreground="#F59E0B" Margin="0,0,6,0"/>
                                    <TextBlock Text="Arşiv: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.ArchiveFormatted}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                </StackPanel>
                            </Border>
                            <!-- Installer -->
                            <Border Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="14" Foreground="#10B981" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kurulum/Oyun: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.InstallerFormatted}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                            <!-- Other -->
                            <Border Background="#2094A3B8" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                    <TextBlock Text="Diğer: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CategoryStats.OtherFormatted}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ui:Card>

                    <!-- Multi-Select & Batch Actions Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: CheckBox & Selected Count Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                      Content="Tümünü Seç"
                                      FontSize="12"
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"
                                      Margin="4,0,12,0"
                                      AutomationProperties.Name="Tümünü Seç"/>

                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Seçilen: "/><Run Text="{Binding SelectedFilesCount}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Run Text=" dosya ("/><Run Text="{Binding SelectedFilesTotalBytesFormatted}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Run Text=")"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Right: Batch Recycle & Batch Delete Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Delete20}"
                                       Content="Geri Dönüşüme Taşı"
                                       Command="{Binding RecycleSelectedFilesCommand}"
                                       IsEnabled="{Binding HasSelectedFiles}"
                                       Padding="12,6"
                                       Margin="0,0,8,0"
                                       ToolTip="Seçili dosyaları güvenle Geri Dönüşüm Kutusuna gönderir"/>
                            <ui:Button Appearance="Danger"
                                       Icon="{ui:SymbolIcon Dismiss20}"
                                       Content="Kalıcı Olarak Sil"
                                       Command="{Binding DeleteSelectedFilesCommand}"
                                       IsEnabled="{Binding HasSelectedFiles}"
                                       Padding="12,6"
                                       ToolTip="Seçili dosyaları diskten kalıcı olarak siler"/>
                        </StackPanel>
                    </Grid>

                    <!-- Virtualized ListView -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding FilteredLargeFiles}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LargeDiskFileItem}">
                                <ui:Card Padding="12,10" ClipToBounds="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>                                <!-- CheckBox -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeIconCol"/> <!-- Category Icon Symbol -->
                                            <ColumnDefinition Width="2.5*"/>                                <!-- File Name & Path -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeCatCol"/>  <!-- Category Badge -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeSizeCol"/> <!-- Formatted Size -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LargeActionCol"/><!-- Action Buttons -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Multi-Select CheckBox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  AutomationProperties.Name="Dosya Seçimi"/>

                                        <!-- Category Icon Symbol -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8,6" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="{Binding CategorySymbol}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>

                                        <!-- File Name, Full Path & Date -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding LastModifiedFormatted}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Category Badge -->
                                        <Border Grid.Column="3" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8,4" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <!-- Formatted Size -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding SizeFormatted}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextAlignment="Right" 
                                                   Margin="0,0,16,0"/>

                                        <!-- Action Buttons: Copy Path, Safe Recycle Bin, Folder Location, Permanent Delete -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary" 
                                                       Icon="{ui:SymbolIcon Copy20}"
                                                       Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Dosya Yolunu Panoya Kopyala"
                                                       Padding="8,6" 
                                                       Margin="0,0,6,0" 
                                                       AutomationProperties.Name="Dosya Yolunu Panoya Kopyala"/>

                                            <ui:Button Appearance="Secondary" 
                                                       Icon="{ui:SymbolIcon Delete20}"
                                                       Command="{Binding DataContext.SendToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Geri Dönüşüm Kutusuna Taşı (Güvenli Silme)"
                                                       Padding="8,6" 
                                                       Margin="0,0,6,0" 
                                                       AutomationProperties.Name="Geri Dönüşüm Kutusuna Taşı"/>

                                            <ui:Button Appearance="Secondary" 
                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                       Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Klasörde Göster"
                                                       Padding="8,6" 
                                                       Margin="0,0,6,0" 
                                                       AutomationProperties.Name="Klasörde Göster"/>

                                            <ui:Button Appearance="Danger" 
                                                       Icon="{ui:SymbolIcon Dismiss20}"
                                                       Command="{Binding DataContext.DeleteLargeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                                       ToolTip="Kalıcı Olarak Sil"
                                                       Padding="8,6" 
                                                       AutomationProperties.Name="Kalıcı Olarak Sil"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 4: TAB 4 - YİNELENEN DOSYA AVCISI & BOŞ KLASÖR TEMİZLEYİCİ                -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsDuplicatesTab, Converter={StaticResource BoolToVis}}"
              Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: 4 KPI Metrik Kartları -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Araç Çubuğu, Filtreler ve Eylemler -->
                <RowDefinition Height="*"/>    <!-- Row 2: Ana Liste Alanı (Yinelenenler veya Boş Klasörler) -->
            </Grid.RowDefinitions>

            <!-- Row 0: 4 Modern KPI Metrik Kartı -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Kart 1: Boşa Harcanan Alan -->
                <ui:Card Grid.Column="0" Margin="0,0,10,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#26F43F5E" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Storage24" FontSize="22" Foreground="#F43F5E"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalWastedFormatted}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Gereksiz İşgal Edilen Alan" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding TotalDuplicateCount, StringFormat='{}{0} Adet Kopya Dosya'}" FontSize="10" Foreground="#F43F5E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- KPI Kart 2: Yinelenen Dosya Grubu -->
                <ui:Card Grid.Column="1" Margin="0,0,10,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#2638BDF8" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="22" Foreground="#38BDF8"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DuplicateGroups.Count}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Yinelenen Dosya Grubu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="SHA-256 İçerik Doğrulama" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- KPI Kart 3: Sahipsiz Boş Klasörler -->
                <ui:Card Grid.Column="2" Margin="0,0,10,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#26A855F7" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="22" Foreground="#A855F7"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalEmptyFolderCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Sahipsiz Boş Klasör" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="0 Bayt Kalıntı Dizinler" FontSize="10" Foreground="#A855F7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- KPI Kart 4: Seçili Temizlenecek Alan -->
                <ui:Card Grid.Column="3" Margin="0,0,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#2610B981" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Broom24" FontSize="22" Foreground="#10B981"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDuplicateBytesFormatted}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Temizlenecek Alan" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedDuplicateCount, StringFormat='{}{0} Kopya Dosya Seçili'}" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Row 1: Araç Çubuğu, Filtreler, Arama ve Kontroller Kartı -->
            <ui:Card Grid.Row="1" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Üst Satır: Görünüm Modu ve Hedef Konum & Tarama Butonları -->
                        <RowDefinition Height="Auto"/> <!-- Ayırıcı -->
                        <RowDefinition Height="Auto"/> <!-- Alt Satır: Arama, Filtre Çipleri ve Akıllı Seçim -->
                        <RowDefinition Height="Auto"/> <!-- Canlı İlerleme Çubuğu -->
                        <RowDefinition Height="Auto"/> <!-- Sonuç Bildirim Bandı -->
                    </Grid.RowDefinitions>

                    <!-- Üst Satır -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: Mod Seçimi (Yinelenenler vs Boş Klasörler) -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="{Binding IsShowingDuplicates, Converter={StaticResource BoolToNavAppearance}}"
                                           Command="{Binding SwitchDuplicateViewCommand}"
                                           CommandParameter="Duplicates"
                                           Padding="12,5"
                                           Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy20" FontSize="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="Yinelenen Dosyalar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="{Binding IsShowingEmptyFolders, Converter={StaticResource BoolToNavAppearance}}"
                                           Command="{Binding SwitchDuplicateViewCommand}"
                                           CommandParameter="EmptyFolders"
                                           Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Folder20" FontSize="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="Boş Klasörler" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <!-- Orta: Hedef Sürücü / Özel Klasör Seçici -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Konum:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableDrives}"
                                      SelectedItem="{Binding DuplicateSelectedDrive, Mode=TwoWay}"
                                      MinWidth="130"
                                      Padding="8,5"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding IsCustomFolderActive, Converter={StaticResource InverseBool}}"/>

                            <ui:Button Appearance="Secondary"
                                       Content="Özel Klasör..."
                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                       Command="{Binding BrowseCustomFolderCommand}"
                                       Padding="10,5"
                                       Margin="0,0,8,0"/>

                            <!-- Seçili Özel Klasör Rozeti -->
                            <Border Visibility="{Binding IsCustomFolderActive, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomScanFolderPath}" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:Button Appearance="Transparent"
                                               Icon="{ui:SymbolIcon Dismiss20}"
                                               Command="{Binding ClearCustomFolderCommand}"
                                               ToolTip="Özel Klasörü Kaldır"
                                               Padding="4,2"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sağ: Tarama ve Durdurma Eylemleri -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Yinelenen Taraması Başlat Butonu -->
                            <ui:Button Appearance="Primary"
                                       Content="Yinelenenleri Tara"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding StartDuplicateScanCommand}"
                                       Visibility="{Binding IsShowingDuplicates, Converter={StaticResource BoolToVis}}"
                                       IsEnabled="{Binding IsDuplicatesScanning, Converter={StaticResource InverseBool}}"
                                       Padding="14,7"
                                       Margin="0,0,8,0"/>

                            <!-- Boş Klasör Taraması Başlat Butonu -->
                            <ui:Button Appearance="Primary"
                                       Content="Boş Klasörleri Tara"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding StartEmptyFolderScanCommand}"
                                       Visibility="{Binding IsShowingEmptyFolders, Converter={StaticResource BoolToVis}}"
                                       IsEnabled="{Binding IsDuplicatesScanning, Converter={StaticResource InverseBool}}"
                                       Padding="14,7"
                                       Margin="0,0,8,0"/>

                            <!-- Durdur Butonu -->
                            <ui:Button Appearance="Danger"
                                       Content="Durdur"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Command="{Binding CancelDuplicateScanCommand}"
                                       IsEnabled="{Binding IsDuplicatesScanning}"
                                       Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ayırıcı -->
                    <Separator Grid.Row="1" Margin="0,10,0,10" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Alt Satır: Arama, Filtre Çipleri, Akıllı Seçim ve Silme Butonları -->
                    <Grid Grid.Row="2">
                        <!-- Yinelenen Dosyalar Alt Çubuğu -->
                        <Grid Visibility="{Binding IsShowingDuplicates, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Kategori Çipleri ve Arama Kutusu -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Kategori Çipleri -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tür Filtresi:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:Button Content="Tümü" Appearance="{Binding IsDuplicateFilterAll, Converter={StaticResource BoolToNavAppearance}}" Command="{Binding SetDuplicateTypeFilterCommand}" CommandParameter="All" Padding="8,4" Margin="0,0,4,0"/>
                                    <ui:Button Content="Resimler" Appearance="{Binding IsDuplicateFilterImages, Converter={StaticResource BoolToNavAppearance}}" Command="{Binding SetDuplicateTypeFilterCommand}" CommandParameter="Images" Padding="8,4" Margin="0,0,4,0"/>
                                    <ui:Button Content="Videolar" Appearance="{Binding IsDuplicateFilterVideos, Converter={StaticResource BoolToNavAppearance}}" Command="{Binding SetDuplicateTypeFilterCommand}" CommandParameter="Videos" Padding="8,4" Margin="0,0,4,0"/>
                                    <ui:Button Content="Belgeler" Appearance="{Binding IsDuplicateFilterDocs, Converter={StaticResource BoolToNavAppearance}}" Command="{Binding SetDuplicateTypeFilterCommand}" CommandParameter="Documents" Padding="8,4" Margin="0,0,4,0"/>
                                    <ui:Button Content="Arşivler" Appearance="{Binding IsDuplicateFilterArchives, Converter={StaticResource BoolToNavAppearance}}" Command="{Binding SetDuplicateTypeFilterCommand}" CommandParameter="Archives" Padding="8,4" Margin="0,0,4,0"/>
                                    <ui:Button Content="Ses" Appearance="{Binding IsDuplicateFilterAudio, Converter={StaticResource BoolToNavAppearance}}" Command="{Binding SetDuplicateTypeFilterCommand}" CommandParameter="Audio" Padding="8,4"/>
                                </StackPanel>

                                <!-- Arama Kutusu -->
                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding DuplicateSearchText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Dosya adı veya klasör yolunda ara..."
                                            Icon="{ui:SymbolIcon Search20}"
                                            HorizontalAlignment="Right"
                                            MinWidth="260"
                                            Padding="8,5"/>
                            </Grid>

                            <!-- Akıllı Seçim ve Silme Eylemleri -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Akıllı Seçim Butonları -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Akıllı Seçim:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:Button Content="Kopyaları Otomatik Seç"
                                               Icon="{ui:SymbolIcon SelectAllOn20}"
                                               Command="{Binding SelectAllDuplicatesExceptOneCommand}"
                                               ToolTip="Her grupta en eski orijinal dosyayı korur, diğer kopyaları temizlemek üzere seçer"
                                               Padding="8,4"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Content="En Yenileri Seç"
                                               Command="{Binding SelectNewestDuplicatesCommand}"
                                               ToolTip="Her grupta eski dosyaları korur, en yenileri seçer"
                                               Padding="8,4"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Content="En Eskileri Seç"
                                               Command="{Binding SelectOldestDuplicatesCommand}"
                                               ToolTip="Her grupta yeni dosyaları korur, en eskileri seçer"
                                               Padding="8,4"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Content="Seçimi Temizle"
                                               Appearance="Transparent"
                                               Command="{Binding ClearDuplicateSelectionCommand}"
                                               Padding="8,4"/>
                                </StackPanel>

                                <!-- Güvenli Silme Seçeneği ve Silme Butonu -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding DeletePermanently, Mode=TwoWay}"
                                              Content="Kalıcı Sil (Geri Dönüşümü Atla)"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"/>

                                    <ui:Button Appearance="Danger"
                                               Content="Seçilen Kopyaları Sil"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Command="{Binding DeleteSelectedDuplicatesCommand}"
                                               IsEnabled="{Binding SelectedDuplicateCount, Converter={StaticResource IntToVis}}"
                                               Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Boş Klasörler Alt Çubuğu -->
                        <Grid Visibility="{Binding IsShowingEmptyFolders, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Boş Klasör Seçimi:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:Button Content="Tümünü Seç"
                                           Command="{Binding ToggleSelectAllEmptyFoldersCommand}"
                                           CommandParameter="True"
                                           Padding="8,4"
                                           Margin="0,0,4,0"/>
                                <ui:Button Content="Seçimi Kaldır"
                                           Appearance="Transparent"
                                           Command="{Binding ToggleSelectAllEmptyFoldersCommand}"
                                           CommandParameter="False"
                                           Padding="8,4"/>
                            </StackPanel>

                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding EmptyFolderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Klasör adı veya yolunda ara..."
                                        Icon="{ui:SymbolIcon Search20}"
                                        HorizontalAlignment="Center"
                                        MinWidth="280"
                                        Padding="8,5"/>

                            <ui:Button Grid.Column="2"
                                       Appearance="Danger"
                                       Content="Seçili Boş Klasörleri Temizle"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding DeleteSelectedEmptyFoldersCommand}"
                                       IsEnabled="{Binding SelectedEmptyFolderCount, Converter={StaticResource IntToVis}}"
                                       Padding="12,6"/>
                        </Grid>
                    </Grid>

                    <!-- İlerleme Çubuğu ve Durum Metni -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding IsDuplicatesScanning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{Binding DuplicateProgressPercent}" Height="4" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBlock Text="{Binding DuplicateProgressText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding DuplicateCurrentFilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>

                    <!-- İşlem Sonucu Bilgi Bandı -->
                    <Border Grid.Row="4" Margin="0,10,0,0"
                            Visibility="{Binding HasDuplicateOperationResult, Converter={StaticResource BoolToVis}}"
                            Background="#1A10B981"
                            BorderBrush="#4010B981"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" Foreground="#10B981" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DuplicateOperationResult}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Row 2: Ana Görünüm Alanı (Yinelenenler veya Boş Klasörler) -->
            <Grid Grid.Row="2">
                <!-- ================== GÖRÜNÜM 1: YİNELENEN DOSYALAR ================== -->
                <Grid Visibility="{Binding IsShowingDuplicates, Converter={StaticResource BoolToVis}}">
                    <!-- Durum 1: Henüz Tarama Yapılmadı (Hero Başlangıç Durumu) -->
                    <ui:Card Padding="40,50" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600"
                             Visibility="{Binding HasDuplicateScanned, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#1A38BDF8" CornerRadius="16" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="36" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock Text="Yinelenen Dosya Avcısı" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Diskinizdeki veya seçtiğiniz klasördeki birebir aynı içeriğe sahip (SHA-256 hash eşleşmeli) kopya dosyaları milisaniyeler içinde tespit edin. Güvenli akıllı seçim sayesinde orijinal dosyalarınız korunur, kopyalar güvenle Geri Dönüşüm Kutusu'na taşınır."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,20"/>
                            <ui:Button Appearance="Primary"
                                       Content="Yinelenen Dosyaları Taramaya Başla"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding StartDuplicateScanCommand}"
                                       HorizontalAlignment="Center"
                                       Padding="18,9"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Durum 2: Tarama Yapıldı Ama Sonuç Yok -->
                    <ui:Card Padding="30,40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500"
                             Visibility="{Binding FilteredDuplicateGroups.Count, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                        <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasDuplicateScanned, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="36" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Harika! Hiçbir Yinelenen Dosya Bulunamadı" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Belirtilen konumda aynı içeriğe sahip mükerrer dosya bulunmuyor veya arama kriterinizle eşleşen grup yok."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Durum 3: Yinelenen Gruplar Listesi -->
                    <ListView ItemsSource="{Binding FilteredDuplicateGroups}"
                              Visibility="{Binding FilteredDuplicateGroups.Count, Converter={StaticResource IntToVis}}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DuplicateFileGroup}">
                                <ui:Card Margin="0,0,0,12" Padding="16,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Grup Başlığı -->
                                            <RowDefinition Height="Auto"/> <!-- Grup Dosyaları -->
                                        </Grid.RowDefinitions>

                                        <!-- Grup Başlığı -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Sol: Grup Bilgisi -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1A38BDF8" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding GroupId, StringFormat='Grup #{0}'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                                <TextBlock Text="{Binding FileSizeFormatted, StringFormat='Tekil Boyut: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding GroupCount, StringFormat='({0} kopya dosya)'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Sağ: Boşa Harcanan Alan ve Hash -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1AF43F5E" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding TotalWastedFormatted, StringFormat='Gereksiz Alan: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#F43F5E"/>
                                                </Border>
                                                <TextBlock Text="{Binding Hash, StringFormat='SHA: {0}'}" MaxWidth="160" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Grup İçindeki Dosyalar -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:DuplicateFileItem}">
                                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10,8"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/> <!-- CheckBox -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Durum Rozeti -->
                                                                <ColumnDefinition Width="*"/>    <!-- Dosya Adı ve Yolu -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Tarih ve Boyut -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Aksiyonlar -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- CheckBox -->
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0"/>

                                                            <!-- Durum Rozeti -->
                                                            <Border Grid.Column="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#1AEC4899"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                                                                                <Setter Property="Background" Value="#1A10B981"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#EC4899"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Dosya Adı ve Dizin Yolu -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DirectoryPath}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Tarih ve Boyut -->
                                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,14,0">
                                                                <TextBlock Text="{Binding CreationTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding FormattedSize}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Klasörde Göster Butonu -->
                                                            <ui:Button Grid.Column="4"
                                                                       Appearance="Transparent"
                                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                                       Command="{Binding DataContext.OpenDuplicateFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding FilePath}"
                                                                       ToolTip="Dosyayı Klasörde Göster"
                                                                       Padding="6,4"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ================== GÖRÜNÜM 2: BOŞ KLASÖRLER ================== -->
                <Grid Visibility="{Binding IsShowingEmptyFolders, Converter={StaticResource BoolToVis}}">
                    <!-- Durum 1: Henüz Boş Klasör Taraması Yapılmadı -->
                    <ui:Card Padding="40,50" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600"
                             Visibility="{Binding HasEmptyFolderScanned, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#1AA855F7" CornerRadius="16" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="36" Foreground="#A855F7"/>
                            </Border>
                            <TextBlock Text="Sahipsiz Boş Klasör Temizleyici" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Kaldırılmış yazılımlardan, eski güncellemelerden ve taşınmış dizinlerden arta kalan 0 baytlık boş klasörleri derinlemesine tarayın. Windows ve sistem güvenlik klasörleri otomatik filtrelenir ve korunur."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,20"/>
                            <ui:Button Appearance="Primary"
                                       Content="Boş Klasörleri Taramaya Başla"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding StartEmptyFolderScanCommand}"
                                       HorizontalAlignment="Center"
                                       Padding="18,9"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Durum 2: Tarama Yapıldı Ama Boş Klasör Yok -->
                    <ui:Card Padding="30,40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500"
                             Visibility="{Binding FilteredEmptyFolders.Count, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                        <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasEmptyFolderScanned, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="36" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Sisteminiz Temiz! Boş Klasör Bulunamadı" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Belirtilen konumda temizlenecek sahipsiz boş klasör bulunmuyor."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Durum 3: Boş Klasörler Listesi -->
                    <ListView ItemsSource="{Binding FilteredEmptyFolders}"
                              Visibility="{Binding FilteredEmptyFolders.Count, Converter={StaticResource IntToVis}}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:EmptyFolderItem}">
                                <ui:Card Margin="0,0,0,6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- CheckBox -->
                                            <ColumnDefinition Width="Auto"/> <!-- Klasör İkonu -->
                                            <ColumnDefinition Width="*"/>    <!-- Klasör Adı ve Yolu -->
                                            <ColumnDefinition Width="Auto"/> <!-- Oluşturulma Tarihi -->
                                            <ColumnDefinition Width="Auto"/> <!-- Klasörde Aç -->
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>

                                        <Border Grid.Column="1" Background="#1AA855F7" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Folder20" FontSize="18" Foreground="#A855F7"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FolderName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CreationTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,14,0"/>

                                        <ui:Button Grid.Column="4"
                                                   Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                                   Command="{Binding DataContext.OpenFolderLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding FolderPath}"
                                                   ToolTip="Klasörü Aç"
                                                   Padding="6,4"/>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
