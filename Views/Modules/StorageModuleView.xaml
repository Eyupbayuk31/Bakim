<UserControl x:Class="Bakım.Views.Modules.StorageModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:local="clr-namespace:Bakım.Views.Modules"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}"
             d:DesignHeight="950" d:DesignWidth="1100">

    <c:ModulePage Title="Depolama"
                  Subtitle="Büyük dosyaları, yinelenen dosyaları ve boş klasörleri bulur. Silinenler varsayılan olarak Geri Dönüşüm Kutusu'na gider."
                  IsScrollable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık -->
            <RowDefinition Height="Auto"/> <!-- 1: Sekmeler -->
            <RowDefinition Height="*"/>    <!-- 2: Etkin sekme -->
        </Grid.RowDefinitions>

        <!-- Sekmeler (Fluent SelectorBar) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource Gap.Bottom.MD}">
            <ui:Button Style="{StaticResource Tab.Item}" Content="Disk haritası"
                       helpers:NavSelection.IsSelected="{Binding IsDiskMapTab}"
                       Command="{Binding SwitchSubTabCommand}" CommandParameter="DiskMap"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Büyük dosyalar"
                       helpers:NavSelection.IsSelected="{Binding IsLargeFilesTab}"
                       Command="{Binding SwitchSubTabCommand}" CommandParameter="LargeFiles"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Yinelenenler"
                       helpers:NavSelection.IsSelected="{Binding IsDuplicateFilesTab}"
                       Command="{Binding SwitchSubTabCommand}" CommandParameter="Duplicates"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Boş klasörler"
                       helpers:NavSelection.IsSelected="{Binding IsEmptyFoldersTab}"
                       Command="{Binding SwitchSubTabCommand}" CommandParameter="EmptyFolders"/>
        </StackPanel>

        <local:StorageDiskMapPanel Grid.Row="2" Visibility="{Binding IsDiskMapTab, Converter={StaticResource BoolToVis}}"/>
        <local:StorageLargeFilesPanel Grid.Row="2" Visibility="{Binding IsLargeFilesTab, Converter={StaticResource BoolToVis}}"/>
        <local:StorageDuplicatesPanel Grid.Row="2" Visibility="{Binding IsDuplicatesTab, Converter={StaticResource BoolToVis}}"/>
    </Grid>
    </c:ModulePage>
</UserControl>
