<UserControl x:Class="Bakım.Views.Modules.WindowsTweakerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:local="clr-namespace:Bakım.Views.Modules"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WindowsTweakerViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100">

    <c:ModulePage Title="Windows Ayarları"
                  Subtitle="Sistem davranışı, masaüstü, sağ tık menüsü ve klasik uygulamalar için ince ayarlar."
                  MaxContentWidth="{StaticResource Layout.PageMaxWidth.Narrow}"
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Content="Gezgini yeniden başlat"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               ToolTip="Masaüstü ve görev çubuğu değişikliklerinin görünmesi için Windows Gezgini'ni yeniden başlatır"
                               Command="{Binding RestartExplorerCommand}"
                               Visibility="{Binding CanRestartExplorer, Converter={StaticResource BoolToVis}}"
                               Margin="{StaticResource Gap.Right.SM}"/>
                    <ui:Button Appearance="Primary"
                               Content="Önerilenleri uygula"
                               Command="{Binding ApplyAllRecommendedCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               Margin="{StaticResource Gap.Right.SM}"/>
                    <ui:DropDownButton Appearance="Secondary"
                                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                                       ToolTip="Diğer seçenekler"
                                       AutomationProperties.Name="Diğer seçenekler">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Yenile"
                                          Command="{Binding RefreshAllCommand}"
                                          Icon="{ui:SymbolIcon ArrowClockwise20}"/>
                                <Separator/>
                                <MenuItem Header="Yedekten geri yükle"
                                          Command="{Binding RestoreFromSnapshotCommand}"
                                          Icon="{ui:SymbolIcon History20}"/>
                                <MenuItem Header="Windows varsayılanlarına dön"
                                          Command="{Binding RestoreDefaultsCommand}"
                                          Icon="{ui:SymbolIcon ArrowCounterclockwise20}"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Top Actions -->
            <RowDefinition Height="Auto"/> <!-- 1: Result Banner -->
            <RowDefinition Height="Auto"/> <!-- 2: (boş) -->
            <RowDefinition Height="*"/>    <!-- 3: Master-Detail Workspace -->
        </Grid.RowDefinitions>

        <!-- 1. Result InfoBar -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="{Binding ResultBannerSeverity}" 
                    Title="İşlem durumu" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,16"/>

        <!-- 3. Master-Detail Workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Category Navigation Rail (Column 0) -->
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Categories List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CategoryList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TweakerCategoryModel}">
                                    <Button Style="{StaticResource Nav.ItemButton}"
                                            helpers:NavSelection.IsSelected="{Binding IsSelected}"
                                            Command="{Binding DataContext.SwitchCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}"
                                               ToolTipService.InitialShowDelay="150"
                                               ToolTipService.ShowDuration="20000"
                                               ToolTipService.BetweenShowDelay="100">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountBadge}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- Rich Category Hover ToolTip -->
                                        <Button.ToolTip>
                                            <ToolTip Background="{DynamicResource Brush.Surface.Background}"
                                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Padding="14,12"
                                                     HasDropShadow="True">
                                                <StackPanel MaxWidth="320">
                                                    <!-- Header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Short Description -->
                                                    <TextBlock Text="{Binding ShortDescription}" 
                                                               FontSize="{StaticResource Font.Caption}" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                               TextWrapping="Wrap" 
                                                               Margin="0,0,0,8"/>

                                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,8"/>

                                                    <!-- Benefit / Utility -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding BenefitSummary}" 
                                                                   FontSize="{StaticResource Font.Caption}" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Category Stats Note -->
                                                    <TextBlock Margin="0,4,0,0" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="Mevcut durum: "/>
                                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" ayar listeleniyor, "/>
                                                        <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        <Run Text=" ayar devrede."/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Workspace Pane (Column 2) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Active Category Header Bar -->
                    <RowDefinition Height="*"/>    <!-- Viewport Content -->
                </Grid.RowDefinitions>

                <!-- Row 0: Search & Active Category Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14" Visibility="{Binding IsPrivacyDebloatVisible, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Category Title & Hint -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveCategoryDisplayName}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Global Smart Search Box with Results Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="0"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Search20" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SearchResultsText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ui:AutoSuggestBox x:Name="TweakerSearchBox" 
                                           PlaceholderText="Ayar ara (Ctrl+F)" 
                                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Icon="{ui:SymbolIcon Search24}"
                                           VerticalContentAlignment="Center"
                                           MinWidth="240" MaxWidth="340"/>
                    </StackPanel>
                </Grid>

                <!-- 4.1. Viewport: Virtualized Standard Tweaks List (All, Behavior, BootLogon, DesktopTaskbar, ContextMenu) -->
                <ListView Grid.Row="1" 
                          ItemsSource="{Binding FilteredTweaks}"
                          Visibility="{Binding IsTweaksListVisible, Converter={StaticResource BoolToVis}}"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="{StaticResource Gap.Card}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SystemTweakItem}">
                    <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}" ClipToBounds="False"
                             ToolTipService.InitialShowDelay="200"
                             ToolTipService.ShowDuration="30000"
                             ToolTipService.BetweenShowDelay="100">
                        <!-- Rich Hover Card for Tweak (Human-readable, No registry jargon) -->
                        <Border.ToolTip>
                            <ToolTip Background="{DynamicResource Brush.Surface.Background}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"
                                     Padding="16,14"
                                     HasDropShadow="True">
                                <StackPanel MaxWidth="380">
                                    <!-- Header: Title + Category Badge -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        <Border Grid.Column="1" CornerRadius="{StaticResource Radius.XS}" Padding="6,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- 1. Ne İşe Yarar / Kullanıcı Faydası -->
                                    <TextBlock Text="Bu ayar ne işe yarar?" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding UserBenefitText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                                    <!-- 2. Güvenlik Durumu -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Güvenlik ve uyumluluk" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SafetyNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. Uygulanma Şekli -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise20" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Uygulanma şekli" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ExecutionNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 4. Geri Alınabilirlik -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowCounterclockwise20" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Geri alınabilirlik" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding RevertNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Content: Badges, Title, Description -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <!-- Title -->
                                <TextBlock Text="{Binding Title}" 
                                           FontSize="{StaticResource Font.Body}" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextWrapping="Wrap"/>

                                <!-- Description -->
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="{StaticResource Font.Caption}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           Margin="0,2,0,0"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <!-- Category Badge -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,1" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            Margin="0,0,6,4"
                                            Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Category}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Restart Notice Badge -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,1" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            Margin="0,0,6,4"
                                            Visibility="{Binding RestartNotice, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RestartNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>

                                    <!-- Admin Badge (if needed) -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="6,1" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Margin="0,0,6,4"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Yönetici gerekir" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Güvenlik etkisi rozetleri (S-16) -->
                                    <c:StatusGlyph Intent="Critical" Text="Güvenliği azaltır" Margin="0,0,12,4"
                                                   ToolTip="{Binding SecurityWarning}"
                                                   Visibility="{Binding ReducesSecurity, Converter={StaticResource BoolToVis}}"/>
                                    <c:StatusGlyph Intent="Caution" Text="Güvenliği etkiler" Margin="0,0,12,4"
                                                   ToolTip="{Binding SecurityWarning}"
                                                   Visibility="{Binding AffectsSecurity, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>

                                <!-- Neyi değiştirir? (veri tabanlı ayarlar: gerçek kayıt yolları, §5.16 şeffaflık) -->
                                <Expander Header="Neyi değiştirir?" Margin="0,6,0,0" Padding="0"
                                          FontSize="{StaticResource Font.Caption}"
                                          Visibility="{Binding HasChangeList, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.Name="Bu ayarın değiştirdiği kayıt defteri değerleri">
                                    <TextBlock Text="{Binding ChangeListText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                               FontFamily="Consolas" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Expander>
                            </StackPanel>

                            <!-- Right Controls: ToggleSwitch, Numeric Input, or Action Button -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                <!-- Boolean ToggleSwitch -->
                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" AutomationProperties.Name="{Binding Title}"
                                                 Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                 Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}"/>

                                <!-- Numeric Input & Save Button -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVis}}">
                                    <ui:TextBox Text="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sayısal değer"
                                                Width="60"
                                                VerticalContentAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Padding="6,4"
                                                Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding NumericUnit}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,10,0"/>
                                    <ui:Button Content="Kaydet" 
                                               Appearance="Secondary"
                                               Command="{Binding DataContext.SaveNumericTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                               Padding="12,6"/>
                                </StackPanel>

                                <!-- Action Button (e.g. Volume Mixer) -->
                                <ui:Button Content="Başlat" 
                                           Appearance="Secondary"
                                           Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding DataContext.ExecuteTweakActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Padding="14,6"
                                           Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 4.2. Viewport: Tools & Utilities Tab Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsToolsTabVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Tool 1: Reset Cache Engine -->
                <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}" Margin="{StaticResource Gap.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Önbellek sıfırlama" Style="{StaticResource Text.SettingTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Bozulmuş simgeleri, beyaz dosya ikonlarını ve siyah küçük resim önizlemelerini onarmak için IconCache.db, Thumbnail ve Tray bildirim önbelleklerini temizleyip Explorer'ı yeniden başlatır." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Appearance="Secondary"
                                   Content="Sıfırla"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding ResetCachesCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   VerticalAlignment="Center"
                                   Padding="16,8"/>
                    </Grid>
                </Border>

                <!-- Tool 2: Run as TrustedInstaller -->
                <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}" Margin="{StaticResource Gap.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="TrustedInstaller olarak çalıştır" Style="{StaticResource Text.SettingTitle}"/>
                            </StackPanel>
                            <TextBlock Text="SYSTEM kullanıcısının dahi erişemediği kilitli Windows sistem dosyalarını ve kayıt defteri alanlarını yönetmek için NT AUTHORITY\TrustedInstaller imtiyazıyla komut çalıştırır." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        Text="{Binding TrustedInstallerCommandInput, Mode=TwoWay}"
                                        PlaceholderText="Komut (ör. cmd.exe, regedit.exe)"
                                        VerticalContentAlignment="Center"
                                        Padding="10,8"
                                        Margin="0,0,12,0" AutomationProperties.Name="Çalıştırılacak komut (Örn: cmd.exe, regedit.exe, powershell.exe)"/>
                            <ui:Button Grid.Column="1" 
                                       Appearance="Secondary"
                                       Content="Çalıştır"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Command="{Binding LaunchTrustedInstallerCommand}"
                                       Padding="16,8"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tool 3: Elevated Shortcut Creator -->
                <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}" Margin="{StaticResource Gap.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Link24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Onaysız yönetici kısayolu" Style="{StaticResource Text.SettingTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Görev Zamanlayıcı ile, tıklandığında UAC onayı sormadan yönetici olarak açılan bir masaüstü kısayolu üretir. Güvenlik için yalnızca Program Files ya da Windows altındaki ve standart kullanıcıların değiştiremediği programlar kabul edilir." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        Text="{Binding ElevatedShortcutTargetPath, Mode=TwoWay}"
                                        PlaceholderText="Programın tam yolu"
                                        VerticalContentAlignment="Center"
                                        Padding="10,8"
                                        Margin="0,0,10,0" AutomationProperties.Name="Programın tam yolu (Örn: C:\Program Files\App\app.exe)"/>
                            <ui:TextBox Grid.Column="1" 
                                        Text="{Binding ElevatedShortcutName, Mode=TwoWay}"
                                        PlaceholderText="Kısayol adı"
                                        VerticalContentAlignment="Center"
                                        Padding="10,8"
                                        Margin="0,0,10,0" AutomationProperties.Name="Kısayol Adı"/>
                            <ui:Button Grid.Column="2" 
                                       Appearance="Secondary"
                                       Content="Oluştur"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                       Command="{Binding CreateElevatedShortcutCommand}"
                                       Padding="16,8"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tool 4: OEM & Registered Owner Editor -->
                <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}" Margin="{StaticResource Gap.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Üretici ve kayıtlı kullanıcı bilgisi" Style="{StaticResource Text.SettingTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Windows Sistem Özellikleri sayfasında görünen Cihaz Üreticisi, Modeli, Destek Bilgileri ve Kayıtlı Kullanıcı/Kurum adını özelleştirin." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Üretici" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.Manufacturer, Mode=TwoWay}" AutomationProperties.Name="Üretici adı" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Model" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.Model, Mode=TwoWay}" AutomationProperties.Name="Model adı" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Kayıtlı sahip" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.RegisteredOwner, Mode=TwoWay}" AutomationProperties.Name="Kayıtlı sahip" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Kurum" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.RegisteredOrganization, Mode=TwoWay}" AutomationProperties.Name="Kayıtlı kuruluş" Padding="10,8"/>
                            </StackPanel>
                        </Grid>

                        <ui:Button Grid.Row="2" 
                                   Appearance="Secondary"
                                   Content="Kaydet"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding SaveOemInfoCommand}"
                                   IsEnabled="{Binding OemInfo.IsBusy, Converter={StaticResource InverseBool}}"
                                   HorizontalAlignment="Right"
                                   Padding="18,8"/>
                    </Grid>
                </Border>

                <!-- Tool 5: Reset Local Group Policy -->
                <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldDismiss24" FontSize="20" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Yerel grup ilkelerini sıfırla" Style="{StaticResource Text.SettingTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Kötü amaçlı yazılımlar veya yanlış yapılandırmalar sonucu kilitlenen tüm yerel grup politikalarını ve güvenlik şablonlarını secedit ve gpupdate /force ile sıfırlar." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Appearance="Secondary"
                                   Content="Sıfırla"
                                   Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                   Command="{Binding ResetLocalGroupPolicyCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   VerticalAlignment="Center"
                                   Padding="16,8"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4.3. Viewport: Advanced Appearance & Window Metrics Tab Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsAdvancedAppearanceTabVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Hero Info Card -->
                <Border Style="{StaticResource Card.Surface}" Padding="{StaticResource Pad.SettingsCard}" Margin="{StaticResource Gap.Bottom.MD}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="FontIncrease24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Pencere ölçüleri" Style="{StaticResource Text.SettingTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Masaüstü simge aralığı, kenarlık kalınlığı, kaydırma çubuğu ve başlık çubuğu yüksekliği. Değişiklikler kaydettiğinizde uygulanır." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Content="Kaydet"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Command="{Binding SaveWindowMetricsCommand}"
                                       Padding="16,10"
                                       Margin="0,0,8,0"/>
                            <ui:Button Appearance="Secondary"
                                       Content="Varsayılana dön"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding ResetWindowMetricsToDefaultsCommand}"
                                       Padding="14,10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Grid with 2 Configuration Cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Desktop Icons & Scrollbars -->
                    <Border Style="{StaticResource Card.Surface}" Grid.Column="0" Padding="{StaticResource Pad.Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Masaüstü simgeleri ve kaydırma çubukları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Horizontal Icon Spacing -->
                            <TextBlock Text="Yatay simge boşluğu" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="30" Maximum="150" Value="{Binding Metrics.IconSpacing, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.IconSpacing, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Vertical Icon Spacing -->
                            <TextBlock Text="Dikey simge boşluğu" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="30" Maximum="150" Value="{Binding Metrics.IconVerticalSpacing, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.IconVerticalSpacing, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Scrollbar Width -->
                            <TextBlock Text="Kaydırma çubuğu genişliği" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="10" Maximum="40" Value="{Binding Metrics.ScrollWidth, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.ScrollWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Borders & Title Bars -->
                    <Border Style="{StaticResource Card.Surface}" Grid.Column="2" Padding="{StaticResource Pad.Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Window24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Kenarlıklar ve başlık çubukları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Border Width -->
                            <TextBlock Text="Pencere kenarlık kalınlığı" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="1" Maximum="10" Value="{Binding Metrics.BorderWidth, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.BorderWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Padded Border Width -->
                            <TextBlock Text="Dolgulu kenarlık kalınlığı" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="20" Value="{Binding Metrics.PaddedBorderWidth, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.PaddedBorderWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Caption Height -->
                            <TextBlock Text="Pencere başlık çubuğu yüksekliği" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="15" Maximum="50" Value="{Binding Metrics.CaptionHeight, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.CaptionHeight, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Color & Aero Lite Card -->
                <Border Style="{StaticResource Card.Surface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="İnaktif başlık çubuğu rengi" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Arka planda kalan inaktif pencerelerin başlık çubuğu rengini belirleyin (Hex formatında örn: #2B2B2B, #1E293B, #334155)." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox Text="{Binding Metrics.InactiveTitleBarHex, Mode=TwoWay}" PlaceholderText="#2B2B2B" Width="140" Padding="10,6" Margin="0,0,12,0" AutomationProperties.Name="İnaktif Başlık Çubuğu Rengi"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Content="Aero lite temasını uygula"
                                       Icon="{ui:SymbolIcon PaintBrush24}"
                                       Command="{Binding ApplyAeroLiteThemeCommand}"
                                       Padding="16,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4.5. Viewport: Privacy & Debloat Tab Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsPrivacyDebloatVisible, Converter={StaticResource BoolToVis}}">
            <local:PrivacyDebloatModuleView DataContext="{Binding PrivacyDebloat}"/>
        </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    </c:ModulePage>
</UserControl>
