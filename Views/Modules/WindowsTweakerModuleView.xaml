<UserControl x:Class="Bakım.Views.Modules.WindowsTweakerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:local="clr-namespace:Bakım.Views.Modules"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WindowsTweakerViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Top Actions -->
            <RowDefinition Height="Auto"/> <!-- 1: Result Banner -->
            <RowDefinition Height="Auto"/> <!-- 2: Metric Cards -->
            <RowDefinition Height="*"/>    <!-- 3: Master-Detail Workspace -->
        </Grid.RowDefinitions>

        <!-- 0. Header & Top Action Buttons -->
                <!-- Sayfa basligi — tasarim sistemi bileseni -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Windows Tweaker &amp; İnce Ayarlar"
                         Description="Sistem davranışı, masaüstü, sağ tık menüsü ve klasik uygulamalar için ince ayarlar.">
            <c:SectionHeader.Actions>
                <!-- Top Actions Toolbar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary"
                Content="Varsayılanlara Dön"
                Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                ToolTip="Tüm ayarları orijinal Windows fabrika değerlerine sıfırlar"
                Command="{Binding RestoreDefaultsCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                Padding="14,8"
                Margin="0,0,8,0"/>

                <ui:Button Appearance="Secondary"
                Content="Yedekten Geri Yükle"
                Icon="{ui:SymbolIcon History24}"
                ToolTip="Sistemin ilk ayarlar yedeğini (Snapshot) geri yükler"
                Command="{Binding RestoreFromSnapshotCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                Padding="14,8"
                Margin="0,0,8,0"/>

                <ui:Button Appearance="Danger"
                Content="Gezgini Yeniden Başlat"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                ToolTip="Masaüstü ve Görev Çubuğu ayarlarının yansıması için Windows Gezgini'ni yeniden başlatır"
                Command="{Binding RestartExplorerCommand}"
                Visibility="{Binding CanRestartExplorer, Converter={StaticResource BoolToVis}}"
                Padding="14,8"
                Margin="0,0,8,0"/>

                <ui:Button Appearance="Primary"
                Content="Önerilenleri Uygula"
                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                Command="{Binding ApplyAllRecommendedCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                Padding="16,8"
                Margin="0,0,8,0"/>

                <ui:Button Appearance="Secondary"
                Content="Yenile"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Command="{Binding RefreshAllCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                Padding="14,8"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. Result InfoBar -->
        <ui:InfoBar Grid.Row="1" 
                    IsOpen="{Binding HasResultBanner}" 
                    Severity="{Binding ResultBannerSeverity}" 
                    Title="İşlem Durumu" 
                    Message="{Binding OperationResultBanner}" 
                    Margin="0,0,0,16"/>

        <!-- 2. Metric Overview Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Tweaks -->
            <ui:Card Grid.Column="0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Toplam İnce Ayar" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.TotalTweaksCount}" FontSize="{StaticResource Font.Title}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Wrench24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Active Tweaks -->
            <ui:Card Grid.Column="2" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Aktif Özelleştirme" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.ActiveTweaksCount}" FontSize="{StaticResource Font.Title}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text=" / " FontSize="{StaticResource Font.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Stats.TotalTweaksCount}" FontSize="{StaticResource Font.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: Windows 11 Ayarları -->
            <ui:Card Grid.Column="4" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Windows 11 Ayarları" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.Windows11TweaksCount}" FontSize="{StaticResource Font.Title}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="AppGeneric24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 4: Görünüm & Tema -->
            <ui:Card Grid.Column="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Görünüm &amp; Tema" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.AppearanceTweaksCount}" FontSize="{StaticResource Font.Title}" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Color24" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 3. Master-Detail Workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Category Navigation Rail (Column 0) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.LG}"
                    Padding="8,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Rail Header -->
                    <Border Grid.Row="0" Padding="10,4,10,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Grid24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="KATEGORİLER" FontSize="{StaticResource Font.Caption}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" CornerRadius="{StaticResource Radius.LG}" Padding="6,2" Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                <TextBlock Text="{Binding CategoryList.Count}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Scrollable Categories List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding CategoryList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TweakerCategoryModel}">
                                    <ui:Button Appearance="{Binding IsSelected, Converter={StaticResource BoolToNavAppearance}}"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.SwitchCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding Key}"
                                               Margin="0,0,0,4"
                                               Padding="10,8"
                                               ToolTipService.InitialShowDelay="150"
                                               ToolTipService.ShowDuration="20000"
                                               ToolTipService.BetweenShowDelay="100">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" CornerRadius="{StaticResource Radius.MD}" Padding="6,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding CountBadge}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Rich Category Hover ToolTip -->
                                        <ui:Button.ToolTip>
                                            <ToolTip Background="{DynamicResource Brush.Surface.Background}"
                                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Padding="14,12"
                                                     HasDropShadow="True">
                                                <StackPanel MaxWidth="320">
                                                    <!-- Header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Short Description -->
                                                    <TextBlock Text="{Binding ShortDescription}" 
                                                               FontSize="{StaticResource Font.Caption}" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                               TextWrapping="Wrap" 
                                                               Margin="0,0,0,8"/>

                                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,8"/>

                                                    <!-- Benefit / Utility -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding BenefitSummary}" 
                                                                   FontSize="{StaticResource Font.Caption}" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Category Stats Note -->
                                                    <TextBlock Margin="0,4,0,0" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="Mevcut Durum: "/>
                                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" ayar listeleniyor, "/>
                                                        <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        <Run Text=" ayar devrede."/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Workspace Pane (Column 2) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Active Category Header Bar -->
                    <RowDefinition Height="*"/>    <!-- Viewport Content -->
                </Grid.RowDefinitions>

                <!-- Row 0: Search & Active Category Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14" Visibility="{Binding IsPrivacyDebloatVisible, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Category Title & Hint -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="{StaticResource Radius.SM}" Padding="8,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ActiveCategoryDisplayName}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="Seçili kategorideki ince ayarları yapılandırabilir veya filtreleyebilirsiniz." 
                                   FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Global Smart Search Box with Results Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.Badge.Background}"
                                BorderBrush="{DynamicResource Brush.Badge.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="8,4"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Search20" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SearchResultsText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ui:AutoSuggestBox x:Name="TweakerSearchBox" 
                                           PlaceholderText="Ayar veya özellik ara... (Ctrl + F)" 
                                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Icon="{ui:SymbolIcon Search24}"
                                           VerticalContentAlignment="Center"
                                           MinWidth="240" MaxWidth="340"/>
                    </StackPanel>
                </Grid>

                <!-- 4.1. Viewport: Virtualized Standard Tweaks List (All, Behavior, BootLogon, DesktopTaskbar, ContextMenu) -->
                <ListView Grid.Row="1" 
                          ItemsSource="{Binding FilteredTweaks}"
                          Visibility="{Binding IsTweaksListVisible, Converter={StaticResource BoolToVis}}"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SystemTweakItem}">
                    <ui:Card Padding="18,14" ClipToBounds="False"
                             ToolTipService.InitialShowDelay="200"
                             ToolTipService.ShowDuration="30000"
                             ToolTipService.BetweenShowDelay="100">
                        <!-- Rich Hover Card for Tweak (Human-readable, No registry jargon) -->
                        <ui:Card.ToolTip>
                            <ToolTip Background="{DynamicResource Brush.Surface.Background}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"
                                     Padding="16,14"
                                     HasDropShadow="True">
                                <StackPanel MaxWidth="380">
                                    <!-- Header: Title + Category Badge -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        <Border Grid.Column="1" CornerRadius="{StaticResource Radius.XS}" Padding="6,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- 1. Ne İşe Yarar / Kullanıcı Faydası -->
                                    <TextBlock Text="Bu Ayar Ne İşe Yarar?" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding UserBenefitText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                                    <!-- 2. Güvenlik Durumu -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Güvenlik &amp; Uyumluluk" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SafetyNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. Uygulanma Şekli -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Uygulanma Şekli" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ExecutionNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 4. Geri Alınabilirlik -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowCounterclockwise20" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Geri Alınabilirlik" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding RevertNotice}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ToolTip>
                        </ui:Card.ToolTip>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Content: Badges, Title, Description -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <!-- Category Badge -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="8,2" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            Margin="0,0,8,0"
                                            Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Category}" FontSize="{StaticResource Font.Micro}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Restart Notice Badge -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="8,2" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            Margin="0,0,8,0"
                                            Visibility="{Binding RestartNotice, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RestartNotice}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>

                                    <!-- Admin Badge (if needed) -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="8,2" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Yönetici Yetkisi" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </Border>

                                    <!-- Güvenlik etkisi rozetleri (S-16) -->
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="8,2"
                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,8,0"
                                            ToolTip="{Binding SecurityWarning}"
                                            Visibility="{Binding ReducesSecurity, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Güvenliği azaltır" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </Border>
                                    <Border CornerRadius="{StaticResource Radius.XS}" Padding="8,2"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,8,0"
                                            ToolTip="{Binding SecurityWarning}"
                                            Visibility="{Binding AffectsSecurity, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Güvenliği etkiler" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </Border>

                                    <!-- Hover Info Icon -->
                                    <ui:SymbolIcon Symbol="Info20" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" ToolTip="Detaylı bilgi için fareyi kartın üzerinde tutun"/>
                                </StackPanel>

                                <!-- Title -->
                                <TextBlock Text="{Binding Title}" 
                                           FontSize="{StaticResource Font.Body}" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextWrapping="Wrap"/>

                                <!-- Description -->
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="{StaticResource Font.Caption}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           Margin="0,4,0,0"/>

                                <!-- Neyi değiştirir? (veri tabanlı ayarlar: gerçek kayıt yolları, §5.16 şeffaflık) -->
                                <Expander Header="Neyi değiştirir?" Margin="0,6,0,0" Padding="0"
                                          FontSize="{StaticResource Font.Caption}"
                                          Visibility="{Binding HasChangeList, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.Name="Bu ayarın değiştirdiği kayıt defteri değerleri">
                                    <TextBlock Text="{Binding ChangeListText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                               FontFamily="Consolas" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Expander>
                            </StackPanel>

                            <!-- Right Controls: ToggleSwitch, Numeric Input, or Action Button -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                <!-- Boolean ToggleSwitch -->
                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" AutomationProperties.Name="{Binding Title}"
                                                 Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                 Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}"/>

                                <!-- Numeric Input & Save Button -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVis}}">
                                    <ui:TextBox Text="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sayısal değer"
                                                Width="60"
                                                VerticalContentAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Padding="6,4"
                                                Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding NumericUnit}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,10,0"/>
                                    <ui:Button Content="Kaydet" 
                                               Appearance="Primary"
                                               Command="{Binding DataContext.SaveNumericTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                               Padding="12,6"/>
                                </StackPanel>

                                <!-- Action Button (e.g. Volume Mixer) -->
                                <ui:Button Content="Başlat" 
                                           Appearance="Secondary"
                                           Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding DataContext.ExecuteTweakActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Padding="14,6"
                                           Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 4.2. Viewport: Tools & Utilities Tab Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsToolsTabVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Tool 1: Reset Cache Engine -->
                <ui:Card Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Önbellek Sıfırlama Motoru (Reset Cache Engine)" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Bozulmuş simgeleri, beyaz dosya ikonlarını ve siyah küçük resim önizlemelerini onarmak için IconCache.db, Thumbnail ve Tray bildirim önbelleklerini temizleyip Explorer'ı yeniden başlatır." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Appearance="Primary"
                                   Content="Önbellekleri Sıfırla &amp; Explorer'ı Başlat"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding ResetCachesCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   VerticalAlignment="Center"
                                   Padding="16,8"/>
                    </Grid>
                </ui:Card>

                <!-- Tool 2: Run as TrustedInstaller -->
                <ui:Card Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="TrustedInstaller Yetkisiyle Program / Komut Çalıştır" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="SYSTEM kullanıcısının dahi erişemediği kilitli Windows sistem dosyalarını ve kayıt defteri alanlarını yönetmek için NT AUTHORITY\TrustedInstaller imtiyazıyla komut çalıştırır." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        Text="{Binding TrustedInstallerCommandInput, Mode=TwoWay}"
                                        PlaceholderText="Çalıştırılacak komut (Örn: cmd.exe, regedit.exe, powershell.exe)"
                                        VerticalContentAlignment="Center"
                                        Padding="10,8"
                                        Margin="0,0,12,0" AutomationProperties.Name="Çalıştırılacak komut (Örn: cmd.exe, regedit.exe, powershell.exe)"/>
                            <ui:Button Grid.Column="1" 
                                       Appearance="Danger"
                                       Content="TrustedInstaller Olarak Başlat"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Command="{Binding LaunchTrustedInstallerCommand}"
                                       Padding="16,8"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <!-- Tool 3: Elevated Shortcut Creator -->
                <ui:Card Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Link24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="UAC'siz Yönetici Kısayolu Oluştur (Elevated Shortcut)" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Görev Zamanlayıcı ile, tıklandığında UAC onayı sormadan yönetici olarak açılan bir masaüstü kısayolu üretir. Güvenlik için yalnızca Program Files ya da Windows altındaki ve standart kullanıcıların değiştiremediği programlar kabul edilir." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        Text="{Binding ElevatedShortcutTargetPath, Mode=TwoWay}"
                                        PlaceholderText="Programın tam yolu (Örn: C:\Program Files\App\app.exe)"
                                        VerticalContentAlignment="Center"
                                        Padding="10,8"
                                        Margin="0,0,10,0" AutomationProperties.Name="Programın tam yolu (Örn: C:\Program Files\App\app.exe)"/>
                            <ui:TextBox Grid.Column="1" 
                                        Text="{Binding ElevatedShortcutName, Mode=TwoWay}"
                                        PlaceholderText="Kısayol Adı"
                                        VerticalContentAlignment="Center"
                                        Padding="10,8"
                                        Margin="0,0,10,0" AutomationProperties.Name="Kısayol Adı"/>
                            <ui:Button Grid.Column="2" 
                                       Appearance="Success"
                                       Content="Kısayolu Oluştur"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                       Command="{Binding CreateElevatedShortcutCommand}"
                                       Padding="16,8"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <!-- Tool 4: OEM & Registered Owner Editor -->
                <ui:Card Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="OEM Bilgileri &amp; Kayıtlı Kullanıcı Değiştirici" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Windows Sistem Özellikleri sayfasında görünen Cihaz Üreticisi, Modeli, Destek Bilgileri ve Kayıtlı Kullanıcı/Kurum adını özelleştirin." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Üretici (Manufacturer)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.Manufacturer, Mode=TwoWay}" AutomationProperties.Name="Üretici adı" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Model" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.Model, Mode=TwoWay}" AutomationProperties.Name="Model adı" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Kayıtlı Sahip (Registered Owner)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.RegisteredOwner, Mode=TwoWay}" AutomationProperties.Name="Kayıtlı sahip" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Kayıtlı Kurum (Organization)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding OemInfo.RegisteredOrganization, Mode=TwoWay}" AutomationProperties.Name="Kayıtlı kuruluş" Padding="10,8"/>
                            </StackPanel>
                        </Grid>

                        <ui:Button Grid.Row="2" 
                                   Appearance="Primary"
                                   Content="OEM ve Kullanıcı Bilgilerini Kaydet"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding SaveOemInfoCommand}"
                                   IsEnabled="{Binding OemInfo.IsBusy, Converter={StaticResource InverseBool}}"
                                   HorizontalAlignment="Right"
                                   Padding="18,8"/>
                    </Grid>
                </ui:Card>

                <!-- Tool 5: Reset Local Group Policy -->
                <ui:Card Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldDismiss24" FontSize="20" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Yerel Grup İlkelerini Sıfırla (Reset Local GPO)" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Kötü amaçlı yazılımlar veya yanlış yapılandırmalar sonucu kilitlenen tüm yerel grup politikalarını ve güvenlik şablonlarını secedit ve gpupdate /force ile sıfırlar." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Appearance="Danger"
                                   Content="GPO İlkelerini Sıfırla"
                                   Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                   Command="{Binding ResetLocalGroupPolicyCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   VerticalAlignment="Center"
                                   Padding="16,8"/>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 4.3. Viewport: Advanced Appearance & Window Metrics Tab Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsAdvancedAppearanceTabVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Hero Info Card -->
                <ui:Card Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="FontIncrease24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Gelişmiş Görünüm &amp; Pencere Metrikleri (WindowMetrics)" FontSize="{StaticResource Font.Subtitle}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Masaüstü simge aralıkları, pencerelerin kenarlık kalınlıkları, kaydırma çubuğu genişliği, menü ve başlık çubuğu yüksekliklerini doğrudan piksel seviyesinde kontrol edin. Değişiklikler DWM yayın protokolü ile anında uygulanır." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary"
                                       Content="Metrikleri Kaydet &amp; DWM Yenile"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Command="{Binding SaveWindowMetricsCommand}"
                                       Padding="16,10"
                                       Margin="0,0,8,0"/>
                            <ui:Button Appearance="Secondary"
                                       Content="Varsayılanlara Sıfırla"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding ResetWindowMetricsToDefaultsCommand}"
                                       Padding="14,10"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Grid with 2 Configuration Cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Desktop Icons & Scrollbars -->
                    <ui:Card Grid.Column="0" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Masaüstü Simgeleri &amp; Kaydırma Çubukları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Horizontal Icon Spacing -->
                            <TextBlock Text="Yatay Simge Boşluğu (Icon Spacing)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="30" Maximum="150" Value="{Binding Metrics.IconSpacing, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.IconSpacing, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Vertical Icon Spacing -->
                            <TextBlock Text="Dikey Simge Boşluğu (Icon Vertical Spacing)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="30" Maximum="150" Value="{Binding Metrics.IconVerticalSpacing, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.IconVerticalSpacing, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Scrollbar Width -->
                            <TextBlock Text="Kaydırma Çubuğu Genişliği (Scrollbar Width)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="10" Maximum="40" Value="{Binding Metrics.ScrollWidth, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.ScrollWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Right Card: Borders & Title Bars -->
                    <ui:Card Grid.Column="2" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Window24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Kenarlıklar &amp; Başlık Çubukları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Border Width -->
                            <TextBlock Text="Pencere Kenarlık Kalınlığı (Border Width)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="1" Maximum="10" Value="{Binding Metrics.BorderWidth, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.BorderWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Padded Border Width -->
                            <TextBlock Text="Dolgulu Kenarlık Kalınlığı (Padded Border)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="20" Value="{Binding Metrics.PaddedBorderWidth, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.PaddedBorderWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Caption Height -->
                            <TextBlock Text="Pencere Başlık Çubuğu Yüksekliği (Caption Height)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="15" Maximum="50" Value="{Binding Metrics.CaptionHeight, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.CaptionHeight, StringFormat='{}{0} px'}" FontWeight="SemiBold" Width="55" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Color & Aero Lite Card -->
                <ui:Card Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="İnaktif Başlık Çubuğu Rengi (Inactive Title Bar Color)" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Arka planda kalan inaktif pencerelerin başlık çubuğu rengini belirleyin (Hex formatında örn: #2B2B2B, #1E293B, #334155)." 
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox Text="{Binding Metrics.InactiveTitleBarHex, Mode=TwoWay}" PlaceholderText="#2B2B2B" Width="140" Padding="10,6" Margin="0,0,12,0" AutomationProperties.Name="İnaktif Başlık Çubuğu Rengi"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary"
                                       Content="Aero Lite Temasını Uygula"
                                       Icon="{ui:SymbolIcon PaintBrush24}"
                                       Command="{Binding ApplyAeroLiteThemeCommand}"
                                       Padding="16,8"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 4.5. Viewport: Privacy & Debloat Tab Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsPrivacyDebloatVisible, Converter={StaticResource BoolToVis}}">
            <local:PrivacyDebloatModuleView DataContext="{Binding PrivacyDebloat}"/>
        </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
