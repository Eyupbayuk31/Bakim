<UserControl x:Class="Bakım.Views.Modules.DashboardModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="820" d:DesignWidth="1050">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Central Health Score & One-Click Booster -->
            <RowDefinition Height="Auto"/> <!-- 2: 4-Column Live Telemetry Cards -->
            <RowDefinition Height="*"/>    <!-- 3: Hardware Sensors & Top Resource Hogs Grid -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Genel Bakış" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6" 
                            Padding="8,3" 
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Canlı Telemetri Aktif" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Gerçek zamanlı sistem telemetrisi, donanım sensörleri ve tek tıkla bellek optimizasyonu." 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" 
                           Command="{Binding RefreshCommand}"
                           Padding="14,8"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"/>
            </StackPanel>
        </Grid>

        <!-- 1. Central Health Score & One-Click Booster Card -->
        <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Circular Health Gauge -->
                    <ColumnDefinition Width="*"/>    <!-- Health Breakdown & Status -->
                    <ColumnDefinition Width="Auto"/> <!-- One-Click Booster Action -->
                </Grid.ColumnDefinitions>

                <!-- Circular Progress Ring Gauge -->
                <Grid Grid.Column="0" Width="104" Height="104" Margin="0,0,24,0" VerticalAlignment="Center">
                    <ui:ProgressRing Width="104" Height="104"
                                     Progress="{Binding Health.TotalScore}" 
                                     IsIndeterminate="False"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Health.TotalScore, StringFormat='%{0}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Sağlık" 
                                   FontSize="10" 
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Health Breakdown & Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Health.ScoreTitle}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                CornerRadius="4" 
                                Padding="8,2" 
                                Margin="10,0,0,0" 
                                VerticalAlignment="Center"
                                Visibility="{Binding Health.ScoreText, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding Health.ScoreText}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Sistem performansı yüksek verimlilikle çalışıyor. Düzenli önbellek temizliği ile en yüksek kararlılığı koruyun." 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,10"/>

                    <!-- Metric Chips -->
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Metrics.RamUsagePercentage, StringFormat='RAM: %{0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Metrics.CpuUsagePercentage, StringFormat='İşlemci: %{0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="HardDrive24" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Metrics.SystemDriveUsedPercentage, StringFormat='Disk C: %{0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- One-Click Booster Button & Result -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" HorizontalAlignment="Right">
                    <ui:Button Appearance="Primary" 
                               Command="{Binding OneClickBoostCommand}"
                               Padding="20,12"
                               HorizontalAlignment="Right"
                               Icon="{ui:SymbolIcon TopSpeed24}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tek Tıkla Optimize Et" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                            <ui:ProgressRing Width="16" Height="16" 
                                             IsIndeterminate="True" 
                                             Margin="8,0,0,0"
                                             Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Optimization Result Badge -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="8,4" 
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Visibility="{Binding HasOptimizationResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OptimizationFreedBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 2. Four-Column Live Telemetry Cards (CPU, RAM, Network, Disk) -->
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Processor (CPU) -->
            <ui:Card Grid.Column="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="İşlemci (CPU)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="{Binding Metrics.CpuTemperatureC, StringFormat='{}{0}°C'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Large Value -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="{Binding Metrics.CpuUsagePercentage, StringFormat='%{0}'}" 
                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text=" Yük" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>

                    <!-- Native WPF Sparkline Chart -->
                    <Viewbox Grid.Row="2" Stretch="Fill" Margin="0,4,0,4">
                        <Canvas Width="160" Height="46" ClipToBounds="True">
                            <Polygon Points="{Binding CpuSparklinePolygonPoints}">
                                <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38BDF8" Offset="0.0"/>
                                        <GradientStop Color="#0038BDF8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Polygon.Fill>
                            </Polygon>
                            <Polyline Points="{Binding CpuSparklinePoints}" 
                                      Stroke="#38BDF8" 
                                      StrokeThickness="2" 
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Bottom Specs -->
                    <TextBlock Grid.Row="3" 
                               Text="{Binding Metrics.CpuClockSpeed, StringFormat='Saat: {0}'}" 
                               FontSize="10" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Memory (RAM) -->
            <ui:Card Grid.Column="2" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Fiziksel RAM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="{Binding Metrics.RamUsagePercentage, StringFormat='%{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Large Value -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="{Binding Metrics.UsedRamGb, StringFormat='{}{0} GB'}" 
                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding Metrics.TotalRamGb, StringFormat='{} / {0} GB'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>

                    <!-- Native WPF Sparkline Chart -->
                    <Viewbox Grid.Row="2" Stretch="Fill" Margin="0,4,0,4">
                        <Canvas Width="160" Height="46" ClipToBounds="True">
                            <Polygon Points="{Binding RamSparklinePolygonPoints}">
                                <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#10B981" Offset="0.0"/>
                                        <GradientStop Color="#0010B981" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Polygon.Fill>
                            </Polygon>
                            <Polyline Points="{Binding RamSparklinePoints}" 
                                      Stroke="#10B981" 
                                      StrokeThickness="2" 
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Bottom Specs -->
                    <TextBlock Grid.Row="3" 
                               Text="{Binding Metrics.FreeRamGb, StringFormat='{}{0} GB Kullanılabilir'}" 
                               FontSize="10" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: Network Traffic (Ağ) -->
            <ui:Card Grid.Column="4" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Ağ Trafiği" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="Aktif" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Download Speed -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,2">
                        <TextBlock Text="İndirme (Download)" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Metrics.FormattedNetworkInSpeed}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Upload Speed -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,8">
                        <TextBlock Text="Yükleme (Upload)" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Metrics.FormattedNetworkOutSpeed}" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Bottom Interface Status -->
                    <TextBlock Grid.Row="4" 
                               Text="Ethernet / Wi-Fi Bağlantısı" 
                               FontSize="10" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>

            <!-- Card 4: Disk Activity -->
            <ui:Card Grid.Column="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Disk Hızı &amp; C:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="{Binding Metrics.SystemDriveUsedPercentage, StringFormat='%{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Read / Write Speeds -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
                        <TextBlock Text="{Binding Metrics.FormattedDiskReadSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Metrics.FormattedDiskWriteSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Disk Usage Bar -->
                    <ProgressBar Grid.Row="2" 
                                 Value="{Binding Metrics.SystemDriveUsedPercentage}" 
                                 Maximum="100" 
                                 Height="6" 
                                 Margin="0,4,0,8"/>

                    <!-- Bottom Free Space -->
                    <Grid Grid.Row="3" Margin="0,0,0,2">
                        <TextBlock Text="{Binding Metrics.SystemDriveLetter, StringFormat='Sürücü {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Metrics.SystemDriveFreeGb, StringFormat='{}{0} GB Boş'}" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <TextBlock Grid.Row="4" 
                               Text="{Binding Metrics.SystemDriveTotalGb, StringFormat='Toplam: {0} GB'}" 
                               FontSize="10" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 3. Bottom Row: Hardware Sensors & Top Resource Hogs Grid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Hardware Sensors & Specs -->
            <ui:Card Grid.Column="0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Hardware Rows -->
                        <RowDefinition Height="Auto"/> <!-- Module Shortcut Button -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Donanım Özeti &amp; Sensörler" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Details Rows -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <!-- Processor -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="İşlemci Modeli" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Metrics.CpuName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Metrics.CpuTemperatureC, StringFormat='{}{0}°C'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Graphics -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Grafik Kartı (GPU)" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Metrics.GpuName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Metrics.GpuVram}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Thermal Status -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sistem Termal Durumu" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Metrics.ThermalStatus, StringFormat='Termal Durum: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Optimum" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Shortcut to Cleaner -->
                    <ui:Button Grid.Row="2" 
                               Appearance="Secondary" 
                               Command="{Binding GoToCleanerCommand}"
                               HorizontalAlignment="Left"
                               Padding="14,7"
                               Content="Sistem Temizliğini Aç"
                               Icon="{ui:SymbolIcon ArrowRight24}"/>
                </Grid>
            </ui:Card>

            <!-- Column 1: Top Resource Hogs (Süreç Canavarları) -->
            <ui:Card Grid.Column="2" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Process List -->
                        <RowDefinition Height="Auto"/> <!-- Shortcut to Optimizer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="En Çok Bellek Tüketen Süreçler" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="İlk 3 Süreç" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Items Control for Top 3 Hogs -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopHogs}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ResourceHogItem}">
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="12,7" 
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id, StringFormat='PID: {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" Margin="8,0,10,0" VerticalAlignment="Center"
                                                Visibility="{Binding FormattedMemory, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding FormattedMemory}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </Border>

                                        <!-- Quick Kill Task Button -->
                                        <ui:Button Grid.Column="2" 
                                                   Appearance="Danger" 
                                                   Padding="6,4"
                                                   Command="{Binding DataContext.KillHogProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Icon="{ui:SymbolIcon Dismiss20}"
                                                   ToolTip="Görevi Sonlandır"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Shortcut to Optimizer -->
                    <ui:Button Grid.Row="2" 
                               Appearance="Secondary" 
                               Command="{Binding GoToOptimizerCommand}"
                               HorizontalAlignment="Left"
                               Padding="14,7"
                               Content="Bellek ve Süreç Yöneticisi"
                               Icon="{ui:SymbolIcon ArrowRight24}"/>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
