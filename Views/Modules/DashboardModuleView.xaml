<UserControl x:Class="Bakım.Views.Modules.DashboardModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="900" d:DesignWidth="1300">

    <!--
        KONTROL PANELİ — düzen v2 referans sayfası (docs/FLUENT_DUZEN_PLANI.md §3.1)
        Hero (sağlık + tek birincil eylem) → Canlı durum (4 kutucuk) → Etkinlik ve oyun → Kaynaklar.
        Bölüm başlıkları kartın dışında; kartlar AdaptiveGrid ile eşit yükseklikte.
    -->
    <UserControl.Resources>
        <!-- Hero kartındaki sağlık satırı: durum simgesi · başlık · ayrıntı · puan · eylem -->
        <DataTemplate x:Key="HealthRowTemplate" DataType="{x:Type vm:HealthRow}">
            <Border Margin="0,0,0,6"
                    CornerRadius="{StaticResource Radius.SM}"
                    BorderThickness="{StaticResource Stroke.Thin}"
                    BorderBrush="{DynamicResource Divider.Stroke}"
                    Padding="{StaticResource Pad.Row}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Card.Fill.Secondary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Subtle.Fill.Hover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Durum ve kategori simge kutusu (36x36) -->
                    <Border Grid.Column="0" Width="36" Height="36"
                            CornerRadius="{StaticResource Radius.XS}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource Divider.Stroke}"
                            BorderThickness="{StaticResource Stroke.Thin}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Intent}" Value="{x:Static models:Intent.Critical}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Intent}" Value="{x:Static models:Intent.Caution}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Intent}" Value="{x:Static models:Intent.Success}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <!-- Orta: Başlık + Ayrıntı (Dikey İki Satır) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{StaticResource Font.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}"
                                   ToolTip="{Binding Detail}"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Sağ 1: Puan düşüşü rozeti (Varsa) -->
                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource Radius.XS}"
                            Padding="{StaticResource Pad.Badge}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="{StaticResource Stroke.Thin}"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasDeduction, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DeductionText, StringFormat='{}{0} puan'}"
                                   FontSize="{StaticResource Font.Caption}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Intent}" Value="{x:Static models:Intent.Critical}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Intent}" Value="{x:Static models:Intent.Caution}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Sağ 2: Aksiyon butonu (Varsa) -->
                    <ui:Button Grid.Column="3"
                               Appearance="Secondary"
                               Content="{Binding ActionText}"
                               Icon="{ui:SymbolIcon ArrowRight16}"
                               Padding="12,6"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                               Command="{Binding DataContext.OpenHealthActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: ilgili sayfayı aç'}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <c:ModulePage Title="Kontrol Paneli"
                  Subtitle="Sistem durumu, canlı kaynak kullanımı ve hızlı bakım.">
        <StackPanel>

            <!-- ================= HERO: sağlık + hızlı bakım ================= -->
            <Border Style="{StaticResource Card.Surface.Hero}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Puan halkası: kılavuz zemin + dinamik renk + puan etiketi -->
                        <Grid Grid.Column="0" Width="96" Height="96" Margin="0,0,24,0" VerticalAlignment="Center">
                            <!-- Kılavuz zemin çemberi -->
                            <Ellipse Width="96" Height="96"
                                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                     StrokeThickness="6"
                                     Opacity="0.25"/>

                            <!-- İlerleme halkası: Intent'e göre renk değiştirir -->
                            <ui:ProgressRing Width="96" Height="96" IsIndeterminate="False"
                                             Progress="{Binding HealthScoreValue}">
                                <ui:ProgressRing.Style>
                                    <Style TargetType="{x:Type ui:ProgressRing}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthIntent}" Value="{x:Static models:Intent.Success}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthIntent}" Value="{x:Static models:Intent.Caution}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthIntent}" Value="{x:Static models:Intent.Critical}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ProgressRing.Style>
                            </ui:ProgressRing>

                            <!-- Ortadaki puan ve alt etiket -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HealthScoreValue}"
                                           FontSize="{StaticResource Font.TitleLarge}"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.Name="{Binding HealthScoreValue, StringFormat='Sağlık puanı {0}'}"/>
                                <TextBlock Text="/ 100"
                                           FontSize="{StaticResource Font.Micro}"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Başlık, özet ve durum -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding HealthTitle}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <c:StatusBadge Margin="12,0,0,0" Intent="{Binding HealthIntent}"
                                               Text="{Binding HealthScoreValue, StringFormat='Puan: {0}'}"
                                               VerticalAlignment="Center"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsHealthLoading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HealthSummary}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Kalıcı sistem ve güvenlik sinyalleri analiz edilerek hesaplanmıştır."
                                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Tek birincil eylem -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0" MinWidth="200" MaxWidth="280">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise20}" Margin="0,0,8,0"
                                           Padding="10,8" ToolTip="Sağlığı yeniden denetle" Command="{Binding RefreshHealthCommand}"
                                           AutomationProperties.Name="Sağlığı yeniden denetle"/>
                                <ui:Button Appearance="Primary"
                                           Padding="16,8"
                                           Command="{Binding QuickMaintenanceCommand}"
                                           Icon="{ui:SymbolIcon Broom20}"
                                           Content="Hızlı bakım"
                                           ToolTip="Güvenli geçici dosyalar, çökme dökümleri, tarayıcı ve gölgelendirici önbellekleri ile DNS önbelleğini temizler (Temizleyici kurallarıyla)."
                                           AutomationProperties.Name="Hızlı bakım"/>
                            </StackPanel>

                            <!-- Gerçek ilerleme -->
                            <StackPanel Margin="{StaticResource Gap.Top.SM}"
                                        Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BoostStageText}" FontSize="{StaticResource Font.Caption}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                <ProgressBar Value="{Binding BoostProgressPercent}" Maximum="100" Height="4" Margin="{StaticResource Gap.Top.XS}"/>
                                <ui:Button Style="{StaticResource Link.Button}" HorizontalAlignment="Right" Content="İptal"
                                           Command="{Binding CancelMaintenanceCommand}"/>
                            </StackPanel>

                            <!-- Sonuç -->
                            <StackPanel Margin="{StaticResource Gap.Top.SM}"
                                        Visibility="{Binding HasOptimizationResult, Converter={StaticResource BoolToVis}}">
                                <c:StatusGlyph Intent="Success" Text="{Binding OptimizationFreedBadge}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding OptimizationResultMessage}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                           TextAlignment="Right" Margin="{StaticResource Gap.Top.XS}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                <ui:Button Style="{StaticResource Link.Button}" HorizontalAlignment="Right"
                                           Content="Etkinlik Merkezi'nde aç" Command="{Binding OpenActivityCenterCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Sorunlu bileşenler: hep açık -->
                    <ItemsControl Margin="0,20,0,0" Focusable="False"
                                  ItemsSource="{Binding IssueRows}"
                                  ItemTemplate="{StaticResource HealthRowTemplate}"
                                  Visibility="{Binding HasIssueRows, Converter={StaticResource BoolToVis}}"/>

                    <!-- İyi durumdaki bileşenler (açılır/kapanır akıllı kart) -->
                    <Border Margin="0,8,0,0"
                            Background="{DynamicResource Card.Fill.Secondary}"
                            BorderBrush="{DynamicResource Divider.Stroke}"
                            BorderThickness="{StaticResource Stroke.Thin}"
                            CornerRadius="{StaticResource Radius.SM}"
                            Visibility="{Binding HasHealthyRows, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ui:Button Appearance="Transparent"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       Padding="14,12"
                                       Command="{Binding ToggleHealthyRowsCommand}"
                                       AutomationProperties.Name="İyi durumdaki bileşenleri göster veya gizle">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{StaticResource Radius.XS}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource Divider.Stroke}"
                                            BorderThickness="{StaticResource Stroke.Thin}"
                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HealthyRowsText}"
                                                   FontSize="{StaticResource Font.Body}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Sorunsuz çalışan sistem bileşenleri ve arka plan servisleri"
                                                   FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="{StaticResource Radius.XS}" Padding="8,4"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Göster / gizle" FontSize="{StaticResource Font.Caption}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0"/>
                                            <ui:SymbolIcon FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="ChevronDown16"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowHealthyRows}" Value="True">
                                                                <Setter Property="Symbol" Value="ChevronUp16"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ui:Button>

                            <!-- Açılan liste -->
                            <Border Padding="10,0,10,10"
                                    Visibility="{Binding ShowHealthyRows, Converter={StaticResource BoolToVis}}">
                                <ItemsControl Focusable="False"
                                              ItemsSource="{Binding HealthyRows}"
                                              ItemTemplate="{StaticResource HealthRowTemplate}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= CANLI DURUM ================= -->
            <c:Section Header="Canlı durum">
                <c:AdaptiveGrid MinColumnWidth="220" MaxColumns="4">
                    <c:MetricTile Icon="DeveloperBoard24" Label="İşlemci"
                                  Value="{Binding Metrics.CpuUsagePercentage, StringFormat='%{0}'}"
                                  Caption="{Binding Metrics.CpuClockSpeed}"
                                  ToolTip="{Binding Metrics.CpuTemperatureTooltip}">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="160" Height="46" ClipToBounds="True">
                                <Polygon Points="{Binding CpuSparklinePolygonPoints}" Fill="{DynamicResource Chart.Series1.Subtle}"/>
                                <Polyline Points="{Binding CpuSparklinePoints}" Stroke="{DynamicResource Chart.Series1}"
                                          StrokeThickness="1.5" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </c:MetricTile>

                    <c:MetricTile Icon="TopSpeed24" Label="Bellek"
                                  Value="{Binding Metrics.UsedRamGb, StringFormat='{}{0:0.0}'}"
                                  Unit="{Binding Metrics.TotalRamGb, StringFormat='/ {0:0.0} GB'}"
                                  Caption="{Binding Metrics.FreeRamGb, StringFormat='{}{0:0.0} GB kullanılabilir'}">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="160" Height="46" ClipToBounds="True">
                                <Polygon Points="{Binding RamSparklinePolygonPoints}" Fill="{DynamicResource Chart.Series2.Subtle}"/>
                                <Polyline Points="{Binding RamSparklinePoints}" Stroke="{DynamicResource Chart.Series2}"
                                          StrokeThickness="1.5" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </c:MetricTile>

                    <c:MetricTile Icon="ArrowSync24" Label="Ağ"
                                  Value="{Binding Metrics.FormattedNetworkInSpeed}"
                                  Caption="{Binding Metrics.FormattedNetworkOutSpeed, StringFormat='İndirme · yükleme {0}'}"/>

                    <c:MetricTile Icon="HardDrive20" Label="{Binding Metrics.SystemDriveLetter, StringFormat='Disk {0}'}"
                                  Value="{Binding Metrics.SystemDriveUsedPercentage, StringFormat='%{0}'}"
                                  Unit="dolu"
                                  Caption="{Binding Metrics.SystemDriveFreeGb, StringFormat='{}{0} GB boş'}">
                        <ProgressBar Value="{Binding Metrics.SystemDriveUsedPercentage}" Maximum="100" Height="4"
                                     VerticalAlignment="Bottom" Margin="16,0,16,16"/>
                    </c:MetricTile>
                </c:AdaptiveGrid>
            </c:Section>

            <!-- ================= ETKİNLİK VE OYUN ================= -->
            <c:Section Header="Etkinlik ve oyun">
                <c:AdaptiveGrid MinColumnWidth="300" MaxColumns="3">
                    <c:ListCard c:AdaptiveGrid.Span="2"
                                Header="Son etkinlikler" HeaderIcon="History24"
                                ItemsSource="{Binding RecentActivity}">
                        <c:ListCard.HeaderTrailing>
                            <ui:Button Style="{StaticResource Link.Button}" Content="Tümü"
                                       Command="{Binding OpenActivityCenterCommand}"
                                       AutomationProperties.Name="Etkinlik Merkezi'ni aç"/>
                        </c:ListCard.HeaderTrailing>
                        <c:ListCard.EmptyContent>
                            <TextBlock Text="Henüz kayıtlı etkinlik yok. Temizlik, kaldırma ve ince ayarlar burada görünür."
                                       TextWrapping="Wrap" FontSize="{StaticResource Font.Body}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </c:ListCard.EmptyContent>
                        <c:ListCard.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <c:ListRow Icon="{Binding KindSymbol}" Title="{Binding Title}"
                                           Subtitle="{Binding Module}" Meta="{Binding TimeText}">
                                    <c:ListRow.Trailing>
                                        <c:StatusBadge Text="{Binding UndoText}" Intent="{Binding UndoIntent}"
                                                       Visibility="{Binding HasUndoText, Converter={StaticResource BoolToVis}}"/>
                                    </c:ListRow.Trailing>
                                </c:ListRow>
                            </DataTemplate>
                        </c:ListCard.ItemTemplate>
                    </c:ListCard>

                    <Border Style="{StaticResource Card.Surface}">
                        <DockPanel LastChildFill="False">
                            <c:CardHeader DockPanel.Dock="Top" Icon="Games24" Title="Oyun Modu">
                                <c:CardHeader.Trailing>
                                    <c:StatusGlyph Intent="Success" Text="Açık"
                                                   Visibility="{Binding IsGameModeActive, Converter={StaticResource BoolToVis}}"/>
                                </c:CardHeader.Trailing>
                            </c:CardHeader>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding GameModeDetail}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                                <ui:Button Appearance="Secondary" Command="{Binding ToggleGameModeCommand}"
                                           Content="{Binding GameModeButtonText}" Margin="{StaticResource Gap.Right.SM}"/>
                                <ui:Button Style="{StaticResource Link.Button}" Content="Ayrıntılar"
                                           Command="{Binding OpenGameModePageCommand}"
                                           AutomationProperties.Name="Oyun Modu sayfasını aç"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </c:AdaptiveGrid>
            </c:Section>

            <!-- ================= KAYNAKLAR ================= -->
            <c:Section Header="Kaynaklar">
                <c:AdaptiveGrid MinColumnWidth="420" MaxColumns="2">
                    <c:ListCard Header="En çok bellek kullananlar" HeaderIcon="TopSpeed24"
                                ItemsSource="{Binding TopHogs}">
                        <c:ListCard.HeaderTrailing>
                            <ui:Button Style="{StaticResource Link.Button}" Content="Süreçler"
                                       Command="{Binding GoToOptimizerCommand}"/>
                        </c:ListCard.HeaderTrailing>
                        <c:ListCard.EmptyContent>
                            <TextBlock Text="Süreç bilgisi yükleniyor…" FontSize="{StaticResource Font.Body}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </c:ListCard.EmptyContent>
                        <c:ListCard.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ResourceHogItem}">
                                <c:ListRow Icon="Apps24" Title="{Binding ProcessName}"
                                           Subtitle="{Binding Id, StringFormat='PID {0}'}"
                                           Meta="{Binding FormattedMemory}">
                                    <c:ListRow.Trailing>
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}"
                                                   Command="{Binding DataContext.KillHogProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Sonlandır" AutomationProperties.Name="Süreci sonlandır"/>
                                    </c:ListRow.Trailing>
                                </c:ListRow>
                            </DataTemplate>
                        </c:ListCard.ItemTemplate>
                    </c:ListCard>

                    <c:ListCard Header="Donanım" HeaderIcon="DeveloperBoard24">
                        <c:ListCard.HeaderTrailing>
                            <ui:Button Style="{StaticResource Link.Button}" Content="Sistem Bilgisi"
                                       Command="{Binding OpenSystemInfoPageCommand}"/>
                        </c:ListCard.HeaderTrailing>
                        <c:ListRow Icon="DeveloperBoard24" Title="{Binding Metrics.CpuName}" Subtitle="İşlemci"
                                   Meta="{Binding Metrics.CpuTemperatureText}"/>
                        <c:ListRow Icon="Desktop24" Title="{Binding Metrics.GpuName}" Subtitle="Ekran kartı"
                                   Meta="{Binding Metrics.GpuVram}" ToolTip="{Binding Metrics.GpuTooltip}"/>
                        <c:ListRow Icon="Temperature24" Title="{Binding Metrics.ThermalStatus}" Subtitle="Sıcaklık"/>
                    </c:ListCard>
                </c:AdaptiveGrid>
            </c:Section>
        </StackPanel>
    </c:ModulePage>
</UserControl>
