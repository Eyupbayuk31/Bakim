<UserControl x:Class="Bakım.Views.Modules.ServiceManagerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ServiceManagerViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Service Safety Badge Text Style -->
        <Style x:Key="ServiceSafetyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOptimizable}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Driver Signature Badge Text Style -->
        <Style x:Key="DriverSignTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProblematic}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <c:ModulePage Title="Hizmetler ve sürücüler"
                  Subtitle="Windows arka plan servisleri, güvenlik analizi ve donanım sürücüleri."
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <!-- Sub-Tab Switcher & Refresh Button -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <ui:Button Style="{StaticResource Tab.Item}" Content="Hizmetler"
                               helpers:NavSelection.IsSelected="{Binding ActiveTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Services}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Services"/>
                    <ui:Button Style="{StaticResource Tab.Item}" Content="Sürücüler"
                               helpers:NavSelection.IsSelected="{Binding ActiveTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Drivers}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Drivers"/>
                </StackPanel>

                <ui:Button Appearance="Secondary"
                Command="{Binding RefreshAllCommand}"
                Padding="14,8"
                Content="Yenile"
                Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Controls -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- Önerilen profiller (§5.7) -->
            <RowDefinition Height="Auto"/> <!-- Search & Filters -->
            <RowDefinition Height="*"/>    <!-- Active Content (Services or Drivers Table) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 2. Metric Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <!-- Services Overview Cards -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam hizmet" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.TotalServices}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Server24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Çalışan hizmetler" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.RunningServices}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Play24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Güvenli kapatılabilir" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.OptimizableServices}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="TopSpeed24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Durdurulanlar" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.StoppedServices}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Stop24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Drivers Overview Cards -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam donanım sürücüsü" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.TotalDrivers}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Desktop24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dijital imzalı sürücüler" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.SignedDrivers}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İmzasız / şüpheli sürücüler" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.ProblematicDrivers}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Warning24" FontSize="22" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Surface.Compact}" Grid.Column="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sistem entegrasyonu" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="PnP çekirdek aktif" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Laptop24" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 2b. Güvenli önerilen profiller: önizleme + tek onay + Etkinlik Merkezi'nden geri alma -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14"
                    Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
            <TextBlock Text="Önerilen profiller" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Surface.Compact}" Width="260" Margin="0,0,10,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding StepText}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding PreviewText}"/>
                                <ui:Button Content="Önizle ve uygula" Appearance="Secondary" Padding="10,4" Margin="0,8,0,0"
                                           IsEnabled="{Binding CanApply}"
                                           Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="{Binding Title}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 3. Search & Filter Bar -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <ui:TextBox Grid.Column="0" 
                        PlaceholderText="Hizmet adı, servis veya sürücü ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ClearButtonEnabled="True" 
                        Padding="12,9" 
                        Margin="0,0,12,0" 
                        Icon="{ui:SymbolIcon Search20}"
                        VerticalContentAlignment="Center" AutomationProperties.Name="Hizmet adı, servis veya sürücü ara..."/>

            <!-- Service Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
                <ui:Button Appearance="Secondary" Content="Tümü" Command="{Binding SetServiceFilterCommand}" CommandParameter="All" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="Çalışanlar" Command="{Binding SetServiceFilterCommand}" CommandParameter="Running" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="Durdurulanlar" Command="{Binding SetServiceFilterCommand}" CommandParameter="Stopped" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="Güvenli kapatılabilir" Command="{Binding SetServiceFilterCommand}" CommandParameter="Optimizable" Padding="12,8"/>
            </StackPanel>

            <!-- Driver Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
                <ui:Button Appearance="Secondary" Content="Tümü" Command="{Binding SetDriverFilterCommand}" CommandParameter="All" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="İmzalı sürücüler" Command="{Binding SetDriverFilterCommand}" CommandParameter="Signed" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="İmzasız / şüpheli" Command="{Binding SetDriverFilterCommand}" CommandParameter="Unsigned" Padding="12,8"/>
            </StackPanel>
        </Grid>

        <!-- 4. Table Area -->
        <!-- TAB 1: Services Table -->
        <Grid Grid.Row="4" Grid.IsSharedSizeScope="True" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Rows -->
            </Grid.RowDefinitions>

            <!-- Services Table Header -->
            <Border Grid.Row="0" Style="{StaticResource Table.HeaderRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/> <!-- Service & Display Name -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStatusCol"/>  <!-- Status -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStartupCol"/>  <!-- Startup Type -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcAccountCol"/>  <!-- Account & PID -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcSafetyCol"/>  <!-- Safety Badge -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcActionCol"/>  <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hizmet adı ve açıklama" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Durum" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="Başlangıç" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="3" Text="Hesap / PID" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="Güvenlik sınıfı" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="5" Text="Eylemler" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Services List -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding FilteredServices}"
                      Background="{DynamicResource Card.Fill}"
                      BorderBrush="{DynamicResource Card.Stroke.Glass}"
                      BorderThickness="1,0,1,1"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="Transparent" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="16,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ServiceItem}">
                        <Grid>
                            <!-- Context Menu -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Hizmeti başlat" 
                                              Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Hizmeti durdur" 
                                              Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Hizmeti yeniden başlat" 
                                              Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <Separator/>
                                    <MenuItem Header="Dosya konumunu aç" 
                                              Command="{Binding DataContext.OpenServiceLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStatusCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStartupCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcAccountCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcSafetyCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcActionCol"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Service & Display Name -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DisplayName}" 
                                           FontSize="{StaticResource Font.Body}" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Description}"/>
                                <TextBlock Text="{Binding ServiceName}" 
                                           FontSize="{StaticResource Font.Caption}" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                           Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Col 1: Status -->
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="{StaticResource Radius.SM}" 
                                    Padding="8,3" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding Status, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Col 2: Startup Type -->
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding StartupType}" 
                                       FontSize="{StaticResource Font.Caption}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <!-- Col 3: Account & PID -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Account}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Col 4: Safety Classification -->
                            <Border Grid.Column="4" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="{StaticResource Radius.SM}" 
                                    Padding="8,4" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding SafetyClassification, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding SafetyClassification}" 
                                           Style="{StaticResource ServiceSafetyTextStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- Col 5: Actions -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Start Button -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           Margin="0,0,4,0" 
                                           ToolTip="Hizmeti başlat"
                                           Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Play20}" AutomationProperties.Name="Hizmeti Başlat"/>

                                <!-- Stop Button -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           Margin="0,0,4,0" 
                                           ToolTip="Hizmeti durdur"
                                           Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Stop20}" AutomationProperties.Name="Hizmeti Durdur"/>

                                <!-- Restart Button -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           Margin="0,0,4,0" 
                                           ToolTip="Yeniden başlat"
                                           Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon ArrowClockwise20}" AutomationProperties.Name="Yeniden Başlat"/>

                                <!-- Open Location -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           ToolTip="Dosya konumunu aç"
                                           Command="{Binding DataContext.OpenServiceLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon FolderOpen20}" AutomationProperties.Name="Dosya Konumunu Aç"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- TAB 2: Drivers Table -->
        <Grid Grid.Row="4" Grid.IsSharedSizeScope="True" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Rows -->
            </Grid.RowDefinitions>

            <!-- Drivers Table Header -->
            <Border Grid.Row="0" Style="{StaticResource Table.HeaderRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/> <!-- Device Name -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvClassCol"/>  <!-- Device Class -->
                        <ColumnDefinition Width="1.8*"/> <!-- Manufacturer -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvVerCol"/>  <!-- Driver Version & Date -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvSignCol"/>  <!-- Digital Signature -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvActionCol"/>   <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Aygıt ve sürücü adı" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Aygıt sınıfı" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="Üretici / sağlayıcı" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="3" Text="Sürüm / tarih" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="Dijital imza" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="5" Text="Eylemler" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Drivers List -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding FilteredDrivers}"
                      Background="{DynamicResource Card.Fill}"
                      BorderBrush="{DynamicResource Card.Stroke.Glass}"
                      BorderThickness="1,0,1,1"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="Transparent" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="16,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DriverItem}">
                        <Grid>
                            <!-- Context Menu -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Aygıt kimliğini (Device ID) kopyala" 
                                              Command="{Binding DataContext.CopyDeviceIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvClassCol"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvVerCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvSignCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvActionCol"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Device Name -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DeviceName}" 
                                           FontSize="{StaticResource Font.Body}" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DeviceID}"/>
                                <TextBlock Text="{Binding Signer}" 
                                           FontSize="{StaticResource Font.Caption}" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Col 1: Device Class Badge -->
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="{StaticResource Radius.SM}" 
                                    Padding="8,3" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding DeviceClass, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding DeviceClass}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- Col 2: Manufacturer -->
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Manufacturer}" 
                                       FontSize="{StaticResource Font.Caption}" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0"/>

                            <!-- Col 3: Driver Version & Date -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding DriverVersion, StringFormat='v{0}'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DriverDate}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding OldDriverText}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,1,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding IsOld, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Col 4: Digital Signature Badge -->
                            <Border Grid.Column="4" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="{StaticResource Radius.SM}" 
                                    Padding="8,4" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding Signer, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding Signer}" 
                                           Style="{StaticResource DriverSignTextStyle}" 
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- Col 5: Actions -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Copy Device ID -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           ToolTip="Aygıt kimliğini kopyala"
                                           Command="{Binding DataContext.CopyDeviceIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Copy20}" AutomationProperties.Name="Aygıt Kimliğini Kopyala"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 5. Bottom Status Bar -->
        <Border Grid.Row="5" 
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="{StaticResource Radius.BottomOnly}" 
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="Sağ tık: Hizmet başlat / durdur, aygıt kimliği kopyalama" 
                           FontSize="{StaticResource Font.Caption}" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </c:ModulePage>
</UserControl>
