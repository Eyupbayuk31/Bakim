<UserControl x:Class="Bakım.Views.Modules.ServiceManagerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ServiceManagerViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Service Safety Badge Text Style -->
        <Style x:Key="ServiceSafetyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOptimizable}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Driver Signature Badge Text Style -->
        <Style x:Key="DriverSignTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProblematic}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Controls -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- Search & Filters -->
            <RowDefinition Height="*"/>    <!-- Active Content (Services or Drivers Table) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Hizmetler &amp; Sürücü Yönetimi" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Windows arka plan servisleri, güvenlik analizi ve donanım sürücüleri." 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Sub-Tab Switcher & Refresh Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="4" 
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Windows Hizmetleri" 
                                   Command="{Binding SwitchTabCommand}" 
                                   CommandParameter="Services"
                                   Padding="14,6" 
                                   Margin="0,0,4,0"/>
                        <ui:Button Content="Sistem Sürücüleri" 
                                   Command="{Binding SwitchTabCommand}" 
                                   CommandParameter="Drivers"
                                   Padding="14,6"/>
                    </StackPanel>
                </Border>

                <ui:Button Appearance="Secondary" 
                           Command="{Binding RefreshAllCommand}"
                           Padding="14,8"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"/>
            </StackPanel>
        </Grid>

        <!-- 2. Metric Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <!-- Services Overview Cards -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam Hizmet" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.TotalServices}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Server24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Çalışan Hizmetler" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.RunningServices}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Play24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="4" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Güvenli Kapatılabilir" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.OptimizableServices}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="TopSpeed24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="6" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Durdurulanlar" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.StoppedServices}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Stop24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Drivers Overview Cards -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam Donanım Sürücüsü" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.TotalDrivers}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Desktop24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dijital İmzalı Sürücüler" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.SignedDrivers}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="4" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İmzasız / Şüpheli Sürücüler" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{Binding Stats.ProblematicDrivers}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Warning24" FontSize="22" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="6" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sistem Entegrasyonu" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="PnP Çekirdek Aktif" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="Laptop24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <!-- 3. Search & Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <ui:TextBox Grid.Column="0" 
                        PlaceholderText="Hizmet adı, servis veya sürücü ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ClearButtonEnabled="True" 
                        Padding="12,9" 
                        Margin="0,0,12,0" 
                        Icon="{ui:SymbolIcon Search20}"
                        VerticalContentAlignment="Center"/>

            <!-- Service Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
                <ui:Button Appearance="Secondary" Content="Tümü" Command="{Binding SetServiceFilterCommand}" CommandParameter="All" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="Çalışanlar" Command="{Binding SetServiceFilterCommand}" CommandParameter="Running" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="Durdurulanlar" Command="{Binding SetServiceFilterCommand}" CommandParameter="Stopped" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="Güvenli Kapatılabilir" Command="{Binding SetServiceFilterCommand}" CommandParameter="Optimizable" Padding="12,8"/>
            </StackPanel>

            <!-- Driver Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
                <ui:Button Appearance="Secondary" Content="Tümü" Command="{Binding SetDriverFilterCommand}" CommandParameter="All" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="İmzalı Sürücüler" Command="{Binding SetDriverFilterCommand}" CommandParameter="Signed" Padding="12,8" Margin="0,0,6,0"/>
                <ui:Button Appearance="Secondary" Content="İmzasız / Şüpheli" Command="{Binding SetDriverFilterCommand}" CommandParameter="Unsigned" Padding="12,8"/>
            </StackPanel>
        </Grid>

        <!-- 4. Table Area -->
        <!-- TAB 1: Services Table -->
        <Grid Grid.Row="3" Grid.IsSharedSizeScope="True" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Services}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Rows -->
            </Grid.RowDefinitions>

            <!-- Services Table Header -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1,1,1,0" 
                    CornerRadius="6,6,0,0" 
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/> <!-- Service & Display Name -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStatusCol"/>  <!-- Status -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStartupCol"/>  <!-- Startup Type -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcAccountCol"/>  <!-- Account & PID -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcSafetyCol"/>  <!-- Safety Badge -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SvcActionCol"/>  <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hizmet Adı &amp; Açıklama" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Durum" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="Başlangıç" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="3" Text="Hesap / PID" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="Güvenlik Sınıfı" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="5" Text="Eylemler" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Services List -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding FilteredServices}"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="Transparent" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="16,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ServiceItem}">
                        <Grid>
                            <!-- Context Menu -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Hizmeti Başlat" 
                                              Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Hizmeti Durdur" 
                                              Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Hizmeti Yeniden Başlat" 
                                              Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <Separator/>
                                    <MenuItem Header="Dosya Konumunu Aç" 
                                              Command="{Binding DataContext.OpenServiceLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStatusCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcStartupCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcAccountCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcSafetyCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SvcActionCol"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Service & Display Name -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DisplayName}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Description}"/>
                                <TextBlock Text="{Binding ServiceName}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                           Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Col 1: Status -->
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,3" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding Status, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Col 2: Startup Type -->
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding StartupType}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <!-- Col 3: Account & PID -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Account}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Col 4: Safety Classification -->
                            <Border Grid.Column="4" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,4" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding SafetyClassification, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding SafetyClassification}" 
                                           Style="{StaticResource ServiceSafetyTextStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- Col 5: Actions -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Start Button -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           Margin="0,0,4,0" 
                                           ToolTip="Hizmeti Başlat"
                                           Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Play20}"/>

                                <!-- Stop Button -->
                                <ui:Button Appearance="Danger" 
                                           Padding="6,4" 
                                           Margin="0,0,4,0" 
                                           ToolTip="Hizmeti Durdur"
                                           Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Stop20}"/>

                                <!-- Restart Button -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           Margin="0,0,4,0" 
                                           ToolTip="Yeniden Başlat"
                                           Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon ArrowClockwise20}"/>

                                <!-- Open Location -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           ToolTip="Dosya Konumunu Aç"
                                           Command="{Binding DataContext.OpenServiceLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon FolderOpen20}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- TAB 2: Drivers Table -->
        <Grid Grid.Row="3" Grid.IsSharedSizeScope="True" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Rows -->
            </Grid.RowDefinitions>

            <!-- Drivers Table Header -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1,1,1,0" 
                    CornerRadius="6,6,0,0" 
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/> <!-- Device Name -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvClassCol"/>  <!-- Device Class -->
                        <ColumnDefinition Width="1.8*"/> <!-- Manufacturer -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvVerCol"/>  <!-- Driver Version & Date -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvSignCol"/>  <!-- Digital Signature -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DrvActionCol"/>   <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Aygıt &amp; Sürücü Adı" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Aygıt Sınıfı" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="Üretici / Sağlayıcı" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="3" Text="Sürüm / Tarih" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="Dijital İmza" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="5" Text="Eylemler" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Drivers List -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding FilteredDrivers}"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="Transparent" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="16,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DriverItem}">
                        <Grid>
                            <!-- Context Menu -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Aygıt Kimliğini (Device ID) Kopyala" 
                                              Command="{Binding DataContext.CopyDeviceIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvClassCol"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvVerCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvSignCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DrvActionCol"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Device Name -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DeviceName}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DeviceID}"/>
                                <TextBlock Text="{Binding Signer}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Col 1: Device Class Badge -->
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,3" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding DeviceClass, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding DeviceClass}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- Col 2: Manufacturer -->
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Manufacturer}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0"/>

                            <!-- Col 3: Driver Version & Date -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding DriverVersion, StringFormat='v{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DriverDate}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Col 4: Digital Signature Badge -->
                            <Border Grid.Column="4" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,4" 
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding Signer, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding Signer}" 
                                           Style="{StaticResource DriverSignTextStyle}" 
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- Col 5: Actions -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Copy Device ID -->
                                <ui:Button Appearance="Secondary" 
                                           Padding="6,4" 
                                           ToolTip="Aygıt Kimliğini Kopyala"
                                           Command="{Binding DataContext.CopyDeviceIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Copy20}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 5. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,6,6" 
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="Sağ Tık: Hizmet Başlat / Durdur, Aygıt Kimliği Kopyalama" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
