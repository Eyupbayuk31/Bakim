<UserControl x:Class="Bakım.Views.Modules.StoreModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StoreViewModel}"
             d:DesignHeight="950" d:DesignWidth="1200">

    <c:ModulePage Title="Mağaza"
                  Subtitle="Sık kullanılan uygulamaları ve çalışma zamanı paketlerini winget ile sessizce kurar ve günceller."
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               Command="{Binding InstallSelectedBatchCommand}"
                               Content="{Binding SelectedAppsText}"
                               Padding="14,8"
                               Margin="0,0,8,0"
                               ToolTip="Seçili uygulamaları sırayla, arka planda kurar."/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding ToggleQueueDrawerCommand}"
                               Content="İndirmeler"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Padding="12,8"
                               Margin="0,0,8,0"
                               ToolTip="Canlı indirme kuyruğunu ve log akışını aç/kapat."/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshInstalledStatusCommand}"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Padding="12,8"
                               ToolTip="Sistemdeki kurulu programları ve kütüphaneleri yeniden tara."/>
                </StackPanel>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Section Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Segmented Mode Switcher (Katalog vs Hazır Paketler) -->
            <RowDefinition Height="*"/>    <!-- 2. Active Tab Content Workspace -->
            <RowDefinition Height="Auto"/> <!-- 3. Live Queue & Console Drawer -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: SECTION HEADER                                                     -->
        <!-- ROW 1: Sekmeler (SelectorBar) ve sade sayımlar -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="{StaticResource Gap.Bottom.MD}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Style="{StaticResource Tab.Item}" Content="Katalog"
                           helpers:NavSelection.IsSelected="{Binding SelectedStoreTabIndex, Converter={StaticResource EqualsToBool}, ConverterParameter=0}"
                           Command="{Binding SwitchToCatalogCommand}"/>
                <ui:Button Style="{StaticResource Tab.Item}" Content="Hazır paketler"
                           helpers:NavSelection.IsSelected="{Binding SelectedStoreTabIndex, Converter={StaticResource EqualsToBool}, ConverterParameter=1}"
                           Command="{Binding SwitchToPresetsCommand}"/>
                <ui:Button Style="{StaticResource Tab.Item}" Content="Güncellemeler"
                           helpers:NavSelection.IsSelected="{Binding SelectedStoreTabIndex, Converter={StaticResource EqualsToBool}, ConverterParameter=2}"
                           Command="{Binding SwitchToUpdatesCommand}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding TotalAppsCount, Mode=OneWay}"/><Run Text=" uygulama · "/><Run Text="{Binding InstalledAppsCount, Mode=OneWay}"/><Run Text=" kurulu · "/><Run Text="{Binding SelectedAppsCount, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><Run Text=" seçili"/>
            </TextBlock>
        </DockPanel>

        <!-- ========================================================================= -->
        <!-- ROW 2: ACTIVE TAB WORKSPACE                                               -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">

            <!-- ===================================================================== -->
            <!-- TAB 0: UYGULAMA KATALOĞU (VARSAYILAN AÇILIŞ - TEMİZ & FERAH)          -->
            <!-- ===================================================================== -->
            <Grid Visibility="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Kategori Pills & Arama Araç Çubuğu -->
                    <RowDefinition Height="*"/>    <!-- 1: Kart Izgarası (Ferah 500px+ Alan) -->
                </Grid.RowDefinitions>

                <!-- KATEGORİ SEKMELERİ (PILLS) & ARAMA ARAÇ ÇUBUĞU -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kategori Butonları (Aktif Kategori Vurgulu, Sıfır Emoji, Fluent İkonlar) -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='All'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="All" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Tümü" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Runtimes'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Runtimes" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Çalışma zamanları" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Gaming'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Gaming" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Games24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Oyun" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Music'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Music" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Müzik ve medya" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Software'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Software" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Yazılım ve araçlar" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Browsers'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Browsers" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Tarayıcılar" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Social'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Social" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="İletişim ve sosyal" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Developer'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Developer" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Geliştirici" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>

                    <!-- Arama & Hızlı Filtre Barı + Görünüm Modu Switcher -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" 
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Uygulama veya yayıncı ara" 
                                    Icon="{ui:SymbolIcon Search24}"
                                    Margin="0,0,12,0"
                                    VerticalContentAlignment="Center"
                                    Padding="12,8"
                                    AutomationProperties.Name="Uygulama Arama"/>

                        <CheckBox Grid.Column="1" 
                                  IsChecked="{Binding OnlyUninstalled, Mode=TwoWay}" 
                                  Content="Yalnızca kurulu olmayanlar" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,12,0"
                                  AutomationProperties.Name="Yalnızca Kurulu Olmayanlar"/>

                        <ui:Button Grid.Column="2" 
                                   Appearance="Secondary" 
                                   Command="{Binding SelectAllVisibleCommand}" 
                                   Content="Görünenleri seç" 
                                   Icon="{ui:SymbolIcon CheckboxChecked24}"
                                   Margin="0,0,8,0"
                                   Padding="12,6"/>

                        <ui:Button Grid.Column="3" 
                                   Appearance="Secondary" 
                                   Command="{Binding ClearSelectionCommand}" 
                                   Content="Seçimi temizle" 
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Padding="12,6"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding SelectedAppsCount, Converter={StaticResource IntToVis}}"
                                   ToolTip="Tüm uygulama seçimlerini temizle"/>

                        <!-- Görünüm Modu Switcher (Kart vs Liste) -->
                        <Border Grid.Column="4" 
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" 
                                CornerRadius="{StaticResource Radius.MD}" 
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Command="{Binding SetGridViewCommand}" 
                                           Appearance="{Binding IsGridView, Converter={StaticResource BoolToNavAppearance}}"
                                           Padding="8,5" 
                                           Margin="0,0,2,0"
                                           ToolTip="Kart (Izgara) görünümü">
                                    <ui:SymbolIcon Symbol="Grid20" FontSize="14"/>
                                </ui:Button>
                                <ui:Button Command="{Binding SetListViewCommand}" 
                                           Appearance="{Binding IsGridView, Converter={StaticResource InverseBoolToNavAppearance}}"
                                           Padding="8,5" 
                                           ToolTip="Kompakt liste görünümü">
                                    <ui:SymbolIcon Symbol="List20" FontSize="14"/>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 1. GÖRÜNÜM: UYGULAMA KARTLARI IZGARASI (GRID VIEW) -->
                <ScrollViewer Grid.Row="1" 
                              Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding DisplayApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StoreAppItem}">
                                <Border Width="360" Margin="0,0,16,16" Padding="16,14"
                                        CornerRadius="{StaticResource Radius.MD}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- 0: Header (Icon + Name/Category + Checkbox) -->
                                            <RowDefinition Height="Auto"/> <!-- 1: Description -->
                                            <RowDefinition Height="Auto"/> <!-- 2: Ayırıcı Çizgi (Separator) -->
                                            <RowDefinition Height="Auto"/> <!-- 3: In-Card Progress Bar (when busy) -->
                                            <RowDefinition Height="Auto"/> <!-- 4: Footer Action Bar -->
                                        </Grid.RowDefinitions>

                                        <!-- ROW 0: Header: Category Tinted Icon, Name, Category Pill, CheckBox -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Dynamic Category Tinted Icon Box -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    Width="42" Height="42" 
                                                    CornerRadius="{StaticResource Radius.MD}" 
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" 
                                                               FontSize="20" 
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + Publisher & Category Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="{StaticResource Font.Body}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Publisher}" 
                                                               FontSize="{StaticResource Font.Caption}" 
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140"/>
                                                    <TextBlock Text=" • " 
                                                               FontSize="{StaticResource Font.Micro}" 
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding CategoryDisplayName}" 
                                                               FontSize="{StaticResource Font.Caption}" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Top-Right Selection CheckBox -->
                                            <Border Grid.Column="2" 
                                                    VerticalAlignment="Top" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.SM}" 
                                                    Padding="4,2">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          ToolTip="Toplu işlem için seç / kaldır"/>
                                            </Border>
                                        </Grid>

                                        <!-- ROW 1: Description -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Description}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Height="34" 
                                                   LineHeight="16"
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="0,8,0,0"/>

                                        <!-- ROW 2: Ayırıcı Çizgi (Separator) -->
                                        <Border Grid.Row="2" Height="1" 
                                                Background="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                Opacity="0.6" 
                                                Margin="0,10,0,10"/>

                                        <!-- ROW 3: In-Card Progress Bar (Visible Only when Downloading/Installing) -->
                                        <Grid Grid.Row="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{} (%{0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Maximum="100" Height="4"/>
                                        </Grid>

                                        <!-- ROW 4: Split Footer Action Bar -->
                                        <Grid Grid.Row="4" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Left: Size Pill -->
                                                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                                <ColumnDefinition Width="Auto"/> <!-- Right: Action & Status -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Size Pill -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" 
                                                    CornerRadius="{StaticResource Radius.SM}" 
                                                    Padding="7,3"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowDownload16" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SizeText}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right: Status / Action -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- State 1: INSTALLED -> Soft Green Status Badge + Quick Reinstall / Repair Icon Button -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                            BorderBrush="{DynamicResource Brush.Success}"
                                                            BorderThickness="1" 
                                                            CornerRadius="{StaticResource Radius.SM}" 
                                                            Padding="8,4"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Kurulu" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ui:Button Appearance="Transparent"
                                                               Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Width="30" Height="28"
                                                               Padding="0"
                                                               ToolTip="Sistemde mevcut. Yeniden kurmak için tıkla."
                                                               Icon="{ui:SymbolIcon ArrowClockwise16}"/>
                                                </StackPanel>

                                                <!-- State 2: NOT INSTALLED -> Sleek Modern Primary Action Button -->
                                                <ui:Button Appearance="Secondary"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                                           Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Yükle"
                                                           Icon="{ui:SymbolIcon ArrowDownload16}"
                                                           Padding="14,4"
                                                           Height="30"
                                                           FontWeight="SemiBold"
                                                           ToolTip="Bu uygulamayı hemen indir ve sessizce kur."/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 2. GÖRÜNÜM: KOMPAKT LİSTE GÖRÜNÜMÜ (LIST VIEW) -->
                <ListView Grid.Row="1"
                          Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVis}}"
                          ItemsSource="{Binding DisplayApps}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:StoreAppItem}">
                            <Border Padding="14,10" 
                                    CornerRadius="{StaticResource Radius.MD}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- 0: CheckBox -->
                                        <ColumnDefinition Width="Auto"/> <!-- 1: Icon Box -->
                                        <ColumnDefinition Width="*"/>    <!-- 2: Name + Description -->
                                        <ColumnDefinition Width="Auto"/> <!-- 3: Category Pill -->
                                        <ColumnDefinition Width="Auto"/> <!-- 4: Size -->
                                        <ColumnDefinition Width="Auto"/> <!-- 5: Status Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- 6: Action Button -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: CheckBox -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,12,0"/>

                                    <!-- Column 1: Icon Box -->
                                    <Border Grid.Column="1" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Width="34" Height="34" 
                                            CornerRadius="{StaticResource Radius.SM}" 
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" 
                                                       FontSize="17" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Column 2: Name & Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Publisher, StringFormat='{} • {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Column 3: Category Pill -->
                                    <Border Grid.Column="3" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" 
                                            CornerRadius="{StaticResource Radius.SM}" 
                                            Padding="8,3" 
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                        <TextBlock Text="{Binding CategoryDisplayName}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Column 4: Size -->
                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding SizeText}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               Width="70"
                                               Margin="0,0,14,0"/>

                                    <!-- Column 5: Status Badge -->
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource Brush.Success}"
                                                BorderThickness="1" 
                                                CornerRadius="{StaticResource Radius.SM}" 
                                                Padding="8,3"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Checkmark20" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="Kurulu" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" 
                                                CornerRadius="{StaticResource Radius.SM}" 
                                                Padding="8,3"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="Yüklü değil" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Column 6: Action Button -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                                   Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Yükle"
                                                   Icon="{ui:SymbolIcon ArrowDownload16}"
                                                   Padding="12,3"
                                                   Height="28"
                                                   FontSize="{StaticResource Font.Caption}"
                                                   FontWeight="SemiBold"/>

                                        <ui:Button Appearance="Secondary"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                   Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Yeniden kur"
                                                   Icon="{ui:SymbolIcon ArrowClockwise16}"
                                                   Padding="10,3"
                                                   Height="28"
                                                   FontSize="{StaticResource Font.Caption}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ===================================================================== -->
            <!-- TAB 1: HAZIR PAKETLER & FORMAT KURTARICI (ÖZEL KÜRATÖRLÜ HUB)         -->
            <!-- ===================================================================== -->
            <ScrollViewer Visibility="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          ScrollViewer.CanContentScroll="False"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <StackPanel Margin="0,0,0,20">

                    <!-- HERO BANNER: ALL-IN-ONE RUNTIMES (BURAYA TAŞINDI) -->
                    <Border Margin="0,0,0,20" 
                            Padding="22,18" 
                            CornerRadius="{StaticResource Radius.MD}" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    Width="48" Height="48" 
                                    CornerRadius="{StaticResource Radius.MD}" 
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="28" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Temel çalışma zamanları" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Visual C++ 2005–2022 (x86/x64), DirectX ve .NET masaüstü çalışma zamanlarını sırayla indirip sessizce kurar. Temiz kurulumdan sonra oyun ve uygulamaların açılması için gerekir." 
                                           FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ui:Button Grid.Column="2" 
                                       Appearance="Secondary" 
                                       Command="{Binding InstallAllRuntimesCommand}"
                                       Padding="18,10" 
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon ArrowDownload24}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Hepsini kur"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- SECTION HEADING -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kurulum setleri" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Bir set seçin; içindeki uygulamalar sırayla arka planda kurulur." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Command="{Binding SwitchToCatalogCommand}"
                                   Icon="{ui:SymbolIcon ArrowLeft24}"
                                   Content="Kataloğa dön"
                                   Padding="14,8"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 4 ADET ZENGİN HAZIR PAKET KARTI -->
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StorePresetItem}">
                                <Border Width="550" Margin="0,0,16,16" Padding="18" 
                                        CornerRadius="{StaticResource Radius.MD}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Header: Icon + Title + Badges -->
                                            <RowDefinition Height="Auto"/> <!-- Description -->
                                            <RowDefinition Height="Auto"/> <!-- Included Apps Label + Badges -->
                                            <RowDefinition Height="Auto"/> <!-- Separator -->
                                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon, Title, Badge, Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon Box -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    Width="48" Height="48" 
                                                    CornerRadius="{StaticResource Radius.MD}" 
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding IconSymbol}" 
                                                               FontSize="24" 
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Badge}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Live Installed Status Badge -->
                                            <Border Grid.Column="2" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="{StaticResource Radius.MD}" 
                                                    Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding InstalledStatusText}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Description}" 
                                                   FontSize="{StaticResource Font.Caption}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,0,0,12"/>

                                        <!-- Included Apps Badges -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                            <TextBlock Text="İçindekiler" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding IncludedApps}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" 
                                                                CornerRadius="{StaticResource Radius.SM}" 
                                                                Padding="8,3" 
                                                                Margin="0,0,6,6">
                                                            <TextBlock Text="{Binding}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Separator Line -->
                                        <Border Grid.Row="3" Height="1" 
                                                Background="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                Opacity="0.6" 
                                                Margin="0,0,0,12"/>

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:Button Grid.Column="0" 
                                                       Appearance="Secondary"
                                                       Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Bu paketi seç"
                                                       Icon="{ui:SymbolIcon CheckboxChecked24}"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Padding="12,7"
                                                       ToolTip="Bu paketteki tüm uygulamaları seçim listesine ekle."/>

                                            <ui:Button Grid.Column="1" 
                                                       Appearance="Secondary"
                                                       Command="{Binding DataContext.ApplyPresetAndSwitchToCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Seç ve kataloğa git"
                                                       Icon="{ui:SymbolIcon Apps24}"
                                                       Margin="0,0,8,0"
                                                       Padding="12,7"
                                                       ToolTip="Paketi seç ve doğrudan Uygulama Kataloğu görünümüne dön."/>

                                            <ui:Button Grid.Column="2" 
                                                       Appearance="Secondary"
                                                       Command="{Binding DataContext.InstallPresetImmediatelyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Hemen kur"
                                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                                       Padding="14,7"
                                                       ToolTip="Paketi seç ve doğrudan arka planda toplu kuruluma başla."/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================================================================== -->
            <!-- TAB 2: GÜNCELLEMELER (winget upgrade)                                 -->
            <!-- ===================================================================== -->
            <Grid Visibility="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                         Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding UpdatesStatus}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Padding="12,6" Margin="0,0,8,0" Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshUpdatesCommand}"/>
                        <ui:Button Appearance="Secondary" Padding="12,6" Content="Tümünü güncelle" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding UpgradeAllCommand}"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Updates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding VersionText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Id, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ResultText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="12,5" Content="Güncelle" VerticalAlignment="Center"
                                                   IsEnabled="{Binding CanUpgrade}"
                                                   Command="{Binding DataContext.UpgradePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 3: LIVE QUEUE & CONSOLE DRAWER                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" 
                Margin="0,14,0,0" 
                Padding="16" 
                CornerRadius="{StaticResource Radius.MD}" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1"
                Visibility="{Binding IsQueueDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Drawer Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Progress Bar -->
                    <RowDefinition Height="Auto"/> <!-- 2: Sub-toolbar -->
                    <RowDefinition Height="Auto"/> <!-- 3: Console Output Box -->
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="İndirmeler " FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding CurrentAppName}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="4,0,0,0"/>
                        <TextBlock Text=" (" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding QueueProgressSummary}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text=")" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding CancelCurrentOperationCommand}" 
                                   Content="Durdur" 
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ToggleQueueDrawerCommand}" 
                                   Content="Gizle" 
                                   Icon="{ui:SymbolIcon ChevronDown24}"/>
                    </StackPanel>
                </Grid>

                <!-- Overall Progress Bar -->
                <ProgressBar Grid.Row="1" Value="{Binding OverallProgress}" Maximum="100" Height="6" Margin="0,0,0,8"/>

                <!-- Console Sub-Toolbar -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Terminal Badge & Auto-scroll Toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="{StaticResource Radius.XS}" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="Çıktı" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <CheckBox IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}" 
                                  Content="Otomatik kaydır" 
                                  FontSize="{StaticResource Font.Caption}" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Clear, Copy, Expand Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ClearConsoleLogsCommand}" 
                                   ToolTip="Konsol günlüklerini temizle" 
                                   Icon="{ui:SymbolIcon Delete24}" 
                                   Content="Temizle" 
                                   Padding="10,4" 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Margin="0,0,6,0"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding CopyConsoleLogsCommand}" 
                                   ToolTip="Tüm konsol günlüklerini panoya kopyala" 
                                   Icon="{ui:SymbolIcon Copy24}" 
                                   Content="Kopyala" 
                                   Padding="10,4" 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Margin="0,0,6,0"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ToggleConsoleExpandCommand}" 
                                   ToolTip="Konsol penceresini büyüt" 
                                   Icon="{ui:SymbolIcon ArrowMaximize24}" 
                                   Content="Genişlet" 
                                   Padding="10,4" 
                                   FontSize="{StaticResource Font.Caption}"
                                   Visibility="{Binding IsConsoleExpanded, Converter={StaticResource InverseBoolToVis}}"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ToggleConsoleExpandCommand}" 
                                   ToolTip="Konsol penceresini küçült" 
                                   Icon="{ui:SymbolIcon ArrowMinimize24}" 
                                   Content="Küçült" 
                                   Padding="10,4" 
                                   FontSize="{StaticResource Font.Caption}"
                                   Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- Console Output Box -->
                <TextBox Grid.Row="3" 
                         Text="{Binding ConsoleLogs, Mode=OneWay}" 
                         IsReadOnly="True" 
                         TextChanged="OnConsoleTextBoxTextChanged"
                         FontFamily="Consolas, Cascadia Code, Courier New" 
                         FontSize="{StaticResource Font.Caption}" 
                         Background="#080C14" 
                         Foreground="#A5B4FC" 
                         BorderThickness="0" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Konsol Günlükleri">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Height" Value="110"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConsoleExpanded}" Value="True">
                                    <Setter Property="Height" Value="260"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>
    </Grid>
    </c:ModulePage>
</UserControl>
