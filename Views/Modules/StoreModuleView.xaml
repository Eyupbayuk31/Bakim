<UserControl x:Class="Bakım.Views.Modules.StoreModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StoreViewModel}"
             d:DesignHeight="950" d:DesignWidth="1200">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Section Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Segmented Mode Switcher (Katalog vs Hazır Paketler) -->
            <RowDefinition Height="*"/>    <!-- 2. Active Tab Content Workspace -->
            <RowDefinition Height="Auto"/> <!-- 3. Live Queue & Console Drawer -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: SECTION HEADER                                                     -->
        <!-- ========================================================================= -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,16"
                         Title="Yazılım &amp; Runtimes Mağazası"
                         Description="Sisteminiz için en popüler 45+ yazılımı, oyun kütüphanelerini (VC++ AIO, DirectX) ve araç setlerini tek tıkla sessizce kurun.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               Command="{Binding InstallSelectedBatchCommand}"
                               Content="{Binding SelectedAppsText}"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Padding="14,8"
                               Margin="0,0,8,0"
                               ToolTip="Seçili tüm uygulamaları sırayla arka planda sessizce kur."/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding ToggleQueueDrawerCommand}"
                               Content="İlerleme &amp; Konsol"
                               Icon="{ui:SymbolIcon WindowConsole20}"
                               Padding="12,8"
                               Margin="0,0,8,0"
                               ToolTip="Canlı indirme kuyruğunu ve log akışını aç/kapat."/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshInstalledStatusCommand}"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Padding="12,8"
                               ToolTip="Sistemdeki kurulu programları ve kütüphaneleri yeniden tara."/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- ========================================================================= -->
        <!-- ROW 1: INTEGRATED NAVIGATION SWITCHER & LIVE METRICS RIBBON               -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Segmented Tab Switcher -->
                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Live Metrics Ribbon -->
            </Grid.ColumnDefinitions>

            <!-- Segmented Mode Switcher (Katalog vs Hazır Paketler) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3">
                <StackPanel Orientation="Horizontal">
                    <!-- Sekme 1: Uygulama Kataloğu -->
                    <ui:Button Appearance="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToAppearance}, ConverterParameter=0}"
                               Command="{Binding SwitchToCatalogCommand}"
                               Padding="14,6"
                               Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Uygulama Kataloğu" FontWeight="SemiBold" FontSize="12"/>
                            <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding TotalAppsCount, StringFormat='{}{0} Yazılım'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ui:Button>

                    <!-- Sekme 2: Hazır Paketler & Format Kurtarıcı -->
                    <ui:Button Appearance="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToAppearance}, ConverterParameter=1}"
                               Command="{Binding SwitchToPresetsCommand}"
                               Padding="14,6"
                               Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Hazır Paketler &amp; Format Kurtarıcı" FontWeight="SemiBold" FontSize="12"/>
                            <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="4 Set + VC++" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </Border>
                        </StackPanel>
                    </ui:Button>

                    <!-- Sekme 3: Windows Konsolları & Klasik Araçlar -->
                    <ui:Button Appearance="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToAppearance}, ConverterParameter=2}"
                               Command="{Binding SwitchToClassicToolsCommand}"
                               Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowWrench24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Sistem Konsolları &amp; Klasik Araçlar" FontWeight="SemiBold" FontSize="12"/>
                            <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="24 Konsol" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Live Metrics Ribbon (Tek Satır Modern Metrik Barı) -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,5"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toplam Katalog -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Katalogdaki toplam paket &amp; kütüphane">
                        <ui:SymbolIcon Symbol="Apps20" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,5,0"/>
                        <TextBlock Text="Katalog: " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TotalAppsCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Kurulu -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Sisteminizde halihazırda kurulu ve kullanıma hazır olanlar">
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,5,0"/>
                        <TextBlock Text="Kurulu: " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding InstalledAppsCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>

                    <!-- Kurulabilir / Eksik -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Henüz kurulmamış, indirilmeye hazır uygulamalar">
                        <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,5,0"/>
                        <TextBlock Text="Eksik: " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding AvailableAppsCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Seçili Kurulum -->
                    <Border Background="{DynamicResource Brush.Caution.Subtle}" CornerRadius="6" Padding="8,3" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Toplu kuruluma eklenen uygulamalar">
                            <ui:SymbolIcon Symbol="CheckboxChecked20" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding SelectedAppsCount, StringFormat='{}{0} Seçili'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: ACTIVE TAB WORKSPACE                                               -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">

            <!-- ===================================================================== -->
            <!-- TAB 0: UYGULAMA KATALOĞU (VARSAYILAN AÇILIŞ - TEMİZ & FERAH)          -->
            <!-- ===================================================================== -->
            <Grid Visibility="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Kategori Pills & Arama Araç Çubuğu -->
                    <RowDefinition Height="*"/>    <!-- 1: Kart Izgarası (Ferah 500px+ Alan) -->
                </Grid.RowDefinitions>

                <!-- KATEGORİ SEKMELERİ (PILLS) & ARAMA ARAÇ ÇUBUĞU -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kategori Butonları (Aktif Kategori Vurgulu, Sıfır Emoji, Fluent İkonlar) -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='All'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="All" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Tümü" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Runtimes'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Runtimes" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Runtimes &amp; Sistem" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Gaming'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Gaming" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Games24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Oyun" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Music'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Music" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Müzik &amp; Medya" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Software'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Software" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Yazılım &amp; Araçlar" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Browsers'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Browsers" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Tarayıcılar" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Social'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Social" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="İletişim &amp; Sosyal" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="{Binding SelectedCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Developer'}" 
                                   Command="{Binding SetCategoryCommand}" CommandParameter="Developer" Margin="0,0,6,6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Geliştirici" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>

                    <!-- Arama & Hızlı Filtre Barı + Görünüm Modu Switcher -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" 
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Uygulama adı, açıklama veya yayıncı ara..." 
                                    Icon="{ui:SymbolIcon Search24}"
                                    Margin="0,0,12,0"
                                    VerticalContentAlignment="Center"
                                    Padding="12,8"
                                    AutomationProperties.Name="Uygulama Arama"/>

                        <CheckBox Grid.Column="1" 
                                  IsChecked="{Binding OnlyUninstalled, Mode=TwoWay}" 
                                  Content="Yalnızca Kurulu Olmayanlar" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,12,0"
                                  AutomationProperties.Name="Yalnızca Kurulu Olmayanlar"/>

                        <ui:Button Grid.Column="2" 
                                   Appearance="Secondary" 
                                   Command="{Binding SelectAllVisibleCommand}" 
                                   Content="Görünenleri Seç" 
                                   Icon="{ui:SymbolIcon CheckboxChecked24}"
                                   Margin="0,0,8,0"
                                   Padding="12,6"/>

                        <ui:Button Grid.Column="3" 
                                   Appearance="Secondary" 
                                   Command="{Binding ClearSelectionCommand}" 
                                   Content="Seçimi Temizle" 
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Padding="12,6"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding SelectedAppsCount, Converter={StaticResource IntToVis}}"
                                   ToolTip="Tüm uygulama seçimlerini temizle"/>

                        <!-- Görünüm Modu Switcher (Kart vs Liste) -->
                        <Border Grid.Column="4" 
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Command="{Binding SetGridViewCommand}" 
                                           Appearance="{Binding IsGridView, Converter={StaticResource BoolToNavAppearance}}"
                                           Padding="8,5" 
                                           Margin="0,0,2,0"
                                           ToolTip="Kart (Izgara) Görünümü">
                                    <ui:SymbolIcon Symbol="Grid20" FontSize="14"/>
                                </ui:Button>
                                <ui:Button Command="{Binding SetListViewCommand}" 
                                           Appearance="{Binding IsGridView, Converter={StaticResource InverseBoolToNavAppearance}}"
                                           Padding="8,5" 
                                           ToolTip="Kompakt Liste Görünümü">
                                    <ui:SymbolIcon Symbol="List20" FontSize="14"/>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 1. GÖRÜNÜM: UYGULAMA KARTLARI IZGARASI (GRID VIEW) -->
                <ScrollViewer Grid.Row="1" 
                              Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding DisplayApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StoreAppItem}">
                                <Border Width="360" Margin="0,0,16,16" Padding="16,14"
                                        CornerRadius="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- 0: Header (Icon + Name/Category + Checkbox) -->
                                            <RowDefinition Height="Auto"/> <!-- 1: Description -->
                                            <RowDefinition Height="Auto"/> <!-- 2: Ayırıcı Çizgi (Separator) -->
                                            <RowDefinition Height="Auto"/> <!-- 3: In-Card Progress Bar (when busy) -->
                                            <RowDefinition Height="Auto"/> <!-- 4: Footer Action Bar -->
                                        </Grid.RowDefinitions>

                                        <!-- ROW 0: Header: Category Tinted Icon, Name, Category Pill, CheckBox -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Dynamic Category Tinted Icon Box -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding CategoryDisplayName, Converter={StaticResource CategoryToBackground}}" 
                                                    BorderBrush="{Binding CategoryDisplayName, Converter={StaticResource CategoryToForeground}}"
                                                    BorderThickness="1"
                                                    Width="42" Height="42" 
                                                    CornerRadius="8" 
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" 
                                                               FontSize="20" 
                                                               Foreground="{Binding CategoryDisplayName, Converter={StaticResource CategoryToForeground}}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + Publisher & Category Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="13.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Publisher}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140"/>
                                                    <TextBlock Text=" • " 
                                                               FontSize="10" 
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding CategoryDisplayName}" 
                                                               FontSize="10.5" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{Binding CategoryDisplayName, Converter={StaticResource CategoryToForeground}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Top-Right Selection CheckBox -->
                                            <Border Grid.Column="2" 
                                                    VerticalAlignment="Top" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6" 
                                                    Padding="4,2">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          ToolTip="Toplu işlem için seç / kaldır"/>
                                            </Border>
                                        </Grid>

                                        <!-- ROW 1: Description -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Description}" 
                                                   FontSize="11.5" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Height="34" 
                                                   LineHeight="16"
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="0,8,0,0"/>

                                        <!-- ROW 2: Ayırıcı Çizgi (Separator) -->
                                        <Border Grid.Row="2" Height="1" 
                                                Background="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                Opacity="0.6" 
                                                Margin="0,10,0,10"/>

                                        <!-- ROW 3: In-Card Progress Bar (Visible Only when Downloading/Installing) -->
                                        <Grid Grid.Row="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{} (%{0})'}" FontSize="10.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Maximum="100" Height="4"/>
                                        </Grid>

                                        <!-- ROW 4: Split Footer Action Bar -->
                                        <Grid Grid.Row="4" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Left: Size Pill -->
                                                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                                <ColumnDefinition Width="Auto"/> <!-- Right: Action & Status -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Size Pill -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="7,3"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowDownload16" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SizeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right: Status / Action -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- State 1: INSTALLED -> Soft Green Status Badge + Quick Reinstall / Repair Icon Button -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="{DynamicResource Brush.Success.Subtle}" 
                                                            BorderBrush="{DynamicResource Brush.Success}"
                                                            BorderThickness="1" 
                                                            CornerRadius="6" 
                                                            Padding="8,4"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Kurulu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ui:Button Appearance="Transparent"
                                                               Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Width="30" Height="28"
                                                               Padding="0"
                                                               ToolTip="Sistemde mevcut. Yeniden kurmak için tıkla."
                                                               Icon="{ui:SymbolIcon ArrowClockwise16}"/>
                                                </StackPanel>

                                                <!-- State 2: NOT INSTALLED -> Sleek Modern Primary Action Button -->
                                                <ui:Button Appearance="Primary"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                                           Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Yükle"
                                                           Icon="{ui:SymbolIcon ArrowDownload16}"
                                                           Padding="14,4"
                                                           Height="30"
                                                           FontWeight="SemiBold"
                                                           ToolTip="Bu uygulamayı hemen indir ve sessizce kur."/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 2. GÖRÜNÜM: KOMPAKT LİSTE GÖRÜNÜMÜ (LIST VIEW) -->
                <ListView Grid.Row="1"
                          Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVis}}"
                          ItemsSource="{Binding DisplayApps}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:StoreAppItem}">
                            <Border Padding="14,10" 
                                    CornerRadius="8" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- 0: CheckBox -->
                                        <ColumnDefinition Width="Auto"/> <!-- 1: Icon Box -->
                                        <ColumnDefinition Width="*"/>    <!-- 2: Name + Description -->
                                        <ColumnDefinition Width="Auto"/> <!-- 3: Category Pill -->
                                        <ColumnDefinition Width="Auto"/> <!-- 4: Size -->
                                        <ColumnDefinition Width="Auto"/> <!-- 5: Status Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- 6: Action Button -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: CheckBox -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,12,0"/>

                                    <!-- Column 1: Icon Box -->
                                    <Border Grid.Column="1" 
                                            Background="{Binding CategoryDisplayName, Converter={StaticResource CategoryToBackground}}" 
                                            BorderBrush="{Binding CategoryDisplayName, Converter={StaticResource CategoryToForeground}}"
                                            BorderThickness="1"
                                            Width="34" Height="34" 
                                            CornerRadius="6" 
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" 
                                                       FontSize="17" 
                                                       Foreground="{Binding CategoryDisplayName, Converter={StaticResource CategoryToForeground}}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Column 2: Name & Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Publisher, StringFormat='{} • {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Column 3: Category Pill -->
                                    <Border Grid.Column="3" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="8,3" 
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                        <TextBlock Text="{Binding CategoryDisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding CategoryDisplayName, Converter={StaticResource CategoryToForeground}}"/>
                                    </Border>

                                    <!-- Column 4: Size -->
                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding SizeText}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               Width="70"
                                               Margin="0,0,14,0"/>

                                    <!-- Column 5: Status Badge -->
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Border Background="{DynamicResource Brush.Success.Subtle}" 
                                                BorderBrush="{DynamicResource Brush.Success}"
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8,3"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Checkmark20" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="Kurulu" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8,3"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="Yüklü Değil" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Column 6: Action Button -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Primary"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                                   Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Yükle"
                                                   Icon="{ui:SymbolIcon ArrowDownload16}"
                                                   Padding="12,3"
                                                   Height="28"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"/>

                                        <ui:Button Appearance="Secondary"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                   Command="{Binding DataContext.InstallSingleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Yeniden Kur"
                                                   Icon="{ui:SymbolIcon ArrowClockwise16}"
                                                   Padding="10,3"
                                                   Height="28"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ===================================================================== -->
            <!-- TAB 1: HAZIR PAKETLER & FORMAT KURTARICI (ÖZEL KÜRATÖRLÜ HUB)         -->
            <!-- ===================================================================== -->
            <ScrollViewer Visibility="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          ScrollViewer.CanContentScroll="False"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <StackPanel Margin="0,0,0,20">

                    <!-- HERO BANNER: ALL-IN-ONE RUNTIMES (BURAYA TAŞINDI) -->
                    <Border Margin="0,0,0,20" 
                            Padding="22,18" 
                            CornerRadius="12" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                            BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="{DynamicResource Brush.Accent.Subtle}" 
                                    Width="56" Height="56" 
                                    CornerRadius="28" 
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Format Sonrası Can Kurtaran: All-in-One Runtimes Paketi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Oyun &amp; Yazılım Garantili" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Resmi Gigabit CDN üzerinden Visual C++ (2005-2022 x86/x64) tüm kütüphanelerini, DirectX Web Setup ve .NET Desktop çalışma ortamlarını tek tuşla otomatik indirip sessizce kurar." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ui:Button Grid.Column="2" 
                                       Appearance="Primary" 
                                       Command="{Binding InstallAllRuntimesCommand}"
                                       Padding="18,10" 
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon TopSpeed24}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tüm Runtimes'ları Kur" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- SECTION HEADING -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Özenle Hazırlanmış Akıllı Kurulum Setleri" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Kullanım senaryonuza göre optimize edilmiş paketleri tek tıkla seçip tüm yazılımları sırayla arka planda kurabilirsiniz." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Command="{Binding SwitchToCatalogCommand}"
                                   Icon="{ui:SymbolIcon ArrowLeft24}"
                                   Content="Kataloğa Dön"
                                   Padding="14,8"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 4 ADET ZENGİN HAZIR PAKET KARTI -->
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StorePresetItem}">
                                <Border Width="550" Margin="0,0,16,16" Padding="18" 
                                        CornerRadius="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Header: Icon + Title + Badges -->
                                            <RowDefinition Height="Auto"/> <!-- Description -->
                                            <RowDefinition Height="Auto"/> <!-- Included Apps Label + Badges -->
                                            <RowDefinition Height="Auto"/> <!-- Separator -->
                                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon, Title, Badge, Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon Box -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource Brush.Accent.Subtle}" 
                                                    Width="48" Height="48" 
                                                    CornerRadius="12" 
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding IconSymbol}" 
                                                               FontSize="24" 
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Live Installed Status Badge -->
                                            <Border Grid.Column="2" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="8" 
                                                    Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding InstalledStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Description}" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,0,0,12"/>

                                        <!-- Included Apps Badges -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                            <TextBlock Text="Pakete Dahil Uygulamalar:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding IncludedApps}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="8,3" 
                                                                Margin="0,0,6,6">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Separator Line -->
                                        <Border Grid.Row="3" Height="1" 
                                                Background="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                Opacity="0.6" 
                                                Margin="0,0,0,12"/>

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:Button Grid.Column="0" 
                                                       Appearance="Secondary"
                                                       Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Bu Paketi Seç"
                                                       Icon="{ui:SymbolIcon CheckboxChecked24}"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Padding="12,7"
                                                       ToolTip="Bu paketteki tüm uygulamaları seçim listesine ekle."/>

                                            <ui:Button Grid.Column="1" 
                                                       Appearance="Secondary"
                                                       Command="{Binding DataContext.ApplyPresetAndSwitchToCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Seç &amp; Kataloğa Git"
                                                       Icon="{ui:SymbolIcon Apps24}"
                                                       Margin="0,0,8,0"
                                                       Padding="12,7"
                                                       ToolTip="Paketi seç ve doğrudan Uygulama Kataloğu görünümüne dön."/>

                                            <ui:Button Grid.Column="2" 
                                                       Appearance="Primary"
                                                       Command="{Binding DataContext.InstallPresetImmediatelyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Hemen Kur"
                                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                                       Padding="14,7"
                                                       ToolTip="Paketi seç ve doğrudan arka planda toplu kuruluma başla."/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================================================================== -->
            <!-- TAB 2: WINDOWS SİSTEM KONSOLLARI & KLASİK ARAÇLAR (24+ KONSOL & PHOTO VIEWER) -->
            <!-- ===================================================================== -->
            <ScrollViewer Visibility="{Binding SelectedStoreTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          ScrollViewer.CanContentScroll="False"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <StackPanel Margin="0,0,0,20">

                    <!-- HERO BANNER: KLASİK WINDOWS FOTOĞRAF GÖRÜNTÜLEYİCİSİ -->
                    <Border Margin="0,0,0,16" 
                            Padding="22,18" 
                            CornerRadius="12" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                            BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="{DynamicResource Brush.Accent.Subtle}" 
                                    Width="56" Height="56" 
                                    CornerRadius="28" 
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Image24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Klasik Windows Fotoğraf Görüntüleyicisi (Photo Viewer)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    
                                    <!-- Aktif Rozeti -->
                                    <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0"
                                            Visibility="{Binding IsPhotoViewerActivated, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Sistemde Aktif (.jpg, .png, .bmp, .gif)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </Border>
                                    
                                    <!-- Pasif Rozeti -->
                                    <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0"
                                            Visibility="{Binding IsPhotoViewerActivated, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="Varsayılan UWP / Pasif" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Windows 10 ve 11'in yavaş açılan 'Fotoğraflar' UWP uygulaması yerine, Windows 7'nin anında açılan ve renkleri doğru veren efsanevi Photo Viewer motorunu tüm formatlar için sisteme geri getirir." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ui:Button Grid.Column="2" 
                                       Appearance="Primary" 
                                       Command="{Binding ActivateWindowsPhotoViewerCommand}"
                                       Padding="18,10" 
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fotoğraf Görüntüleyicisini Sisteme Tanımla &amp; Aç" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- OPERATION RESULT INFOBAR -->
                    <ui:InfoBar Title="İşlem Durumu" 
                                Message="{Binding ToolOperationMessage}" 
                                Severity="{Binding ToolOperationSeverity}" 
                                IsOpen="{Binding IsToolOperationMessageOpen}" 
                                Margin="0,0,0,14"/>

                    <!-- FILTERS & SEARCH RIBBON -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Category Pills -->
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Tümü'}"
                                           Command="{Binding SetToolCategoryCommand}" CommandParameter="Tümü"
                                           Margin="0,0,6,0" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Grid24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Tümü (24)" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Sistem'}"
                                           Command="{Binding SetToolCategoryCommand}" CommandParameter="Sistem"
                                           Margin="0,0,6,0" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Sistem &amp; Çekirdek (6)" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Donanım &amp; Disk'}"
                                           Command="{Binding SetToolCategoryCommand}" CommandParameter="Donanım &amp; Disk"
                                           Margin="0,0,6,0" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Donanım &amp; Disk (4)" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Ağ &amp; Güvenlik'}"
                                           Command="{Binding SetToolCategoryCommand}" CommandParameter="Ağ &amp; Güvenlik"
                                           Margin="0,0,6,0" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ağ &amp; Güvenlik (5)" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="{Binding SelectedToolCategory, Converter={StaticResource StringToNavAppearance}, ConverterParameter='Hızlı Erişim'}"
                                           Command="{Binding SetToolCategoryCommand}" CommandParameter="Hızlı Erişim"
                                           Margin="0,0,6,0" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Hızlı Erişim &amp; Klasik Araçlar (9)" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>

                            <!-- Tool Search Box -->
                            <ui:TextBox Grid.Column="1" 
                                        Text="{Binding ToolSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Konsol veya araç ara (Örn: regedit, aygıt, disk)..."
                                        VerticalContentAlignment="Center"
                                        ClearButtonEnabled="True"
                                        Width="300"
                                        Padding="10,6"
                                        Icon="{ui:SymbolIcon Search24}"
                                        AutomationProperties.Name="Konsol veya araç ara"/>
                        </Grid>
                    </Border>

                    <!-- CONSOLES & TOOLS GRID (2 COLUMNS) -->
                    <ItemsControl ItemsSource="{Binding DisplayClassicTools}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ClassicAppItem}">
                                <ui:Card Padding="14" Margin="4,4,4,8" Style="{StaticResource InteractiveCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Title + Category + Description -->
                                            <ColumnDefinition Width="Auto"/> <!-- Action Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon Box -->
                                        <Border Grid.Column="0" 
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Width="44" Height="44" 
                                                CornerRadius="10" 
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={StaticResource SafeSymbol}}" 
                                                           FontSize="22" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title + Category + Description -->
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <ui:Button Grid.Column="2" 
                                                   Appearance="Secondary"
                                                   Content="Başlat"
                                                   Icon="{ui:SymbolIcon Play20}"
                                                   Command="{Binding DataContext.LaunchClassicToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   VerticalAlignment="Center"
                                                   Padding="12,6"/>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 3: LIVE QUEUE & CONSOLE DRAWER                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" 
                Margin="0,14,0,0" 
                Padding="16" 
                CornerRadius="8" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1"
                Visibility="{Binding IsQueueDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Drawer Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Progress Bar -->
                    <RowDefinition Height="Auto"/> <!-- 2: Sub-toolbar -->
                    <RowDefinition Height="Auto"/> <!-- 3: Console Output Box -->
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Canlı Kurulum Kuyruğu: " FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding CurrentAppName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0"/>
                        <TextBlock Text=" (" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding QueueProgressSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text=")" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentStatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding CancelCurrentOperationCommand}" 
                                   Content="Durdur" 
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ToggleQueueDrawerCommand}" 
                                   Content="Gizle" 
                                   Icon="{ui:SymbolIcon ChevronDown24}"/>
                    </StackPanel>
                </Grid>

                <!-- Overall Progress Bar -->
                <ProgressBar Grid.Row="1" Value="{Binding OverallProgress}" Maximum="100" Height="6" Margin="0,0,0,8"/>

                <!-- Console Sub-Toolbar -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Terminal Badge & Auto-scroll Toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="Canlı Çıktı &amp; Log Konsolu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <CheckBox IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}" 
                                  Content="Otomatik Kaydır" 
                                  FontSize="11" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Clear, Copy, Expand Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ClearConsoleLogsCommand}" 
                                   ToolTip="Konsol günlüklerini temizle" 
                                   Icon="{ui:SymbolIcon Delete24}" 
                                   Content="Temizle" 
                                   Padding="10,4" 
                                   FontSize="11" 
                                   Margin="0,0,6,0"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding CopyConsoleLogsCommand}" 
                                   ToolTip="Tüm konsol günlüklerini panoya kopyala" 
                                   Icon="{ui:SymbolIcon Copy24}" 
                                   Content="Kopyala" 
                                   Padding="10,4" 
                                   FontSize="11" 
                                   Margin="0,0,6,0"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ToggleConsoleExpandCommand}" 
                                   ToolTip="Konsol penceresini büyüt" 
                                   Icon="{ui:SymbolIcon ArrowMaximize24}" 
                                   Content="Genişlet" 
                                   Padding="10,4" 
                                   FontSize="11"
                                   Visibility="{Binding IsConsoleExpanded, Converter={StaticResource InverseBoolToVis}}"/>

                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding ToggleConsoleExpandCommand}" 
                                   ToolTip="Konsol penceresini küçült" 
                                   Icon="{ui:SymbolIcon ArrowMinimize24}" 
                                   Content="Küçült" 
                                   Padding="10,4" 
                                   FontSize="11"
                                   Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- Console Output Box -->
                <TextBox Grid.Row="3" 
                         Text="{Binding ConsoleLogs, Mode=OneWay}" 
                         IsReadOnly="True" 
                         TextChanged="OnConsoleTextBoxTextChanged"
                         FontFamily="Consolas, Cascadia Code, Courier New" 
                         FontSize="11" 
                         Background="#080C14" 
                         Foreground="#A5B4FC" 
                         BorderThickness="0" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Konsol Günlükleri">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Height" Value="110"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConsoleExpanded}" Value="True">
                                    <Setter Property="Height" Value="260"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
