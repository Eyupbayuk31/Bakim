<UserControl x:Class="Bakım.Views.Modules.NetworkConnectionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkMonitorViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <!-- Ağ İzleyici › Bağlantılar -->
    <UserControl.Resources>
        <Style x:Key="PortCategoryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="LISTENING">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Search & Filters -->
            <RowDefinition Height="*"/>    <!-- Split View (Table + Detail Drawer) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Search & Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" 
                        PlaceholderText="Süreç adı, PID, IP, Port veya Servis ile canlı ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ClearButtonEnabled="True" 
                        Padding="12,9" 
                        Margin="0,0,10,0" 
                        Icon="{ui:SymbolIcon Search20}"
                        VerticalContentAlignment="Center"/>

            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="{Binding IsAllFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Tümü" Command="{Binding SetFilterCommand}" CommandParameter="All" Padding="12,7" Margin="0,0,6,4"/>
                <ui:Button Appearance="{Binding IsTcpFilter, Converter={StaticResource BoolToNavAppearance}}" Content="TCP" Command="{Binding SetFilterCommand}" CommandParameter="TCP" Padding="12,7" Margin="0,0,6,4"/>
                <ui:Button Appearance="{Binding IsUdpFilter, Converter={StaticResource BoolToNavAppearance}}" Content="UDP" Command="{Binding SetFilterCommand}" CommandParameter="UDP" Padding="12,7" Margin="0,0,6,4"/>
                <ui:Button Appearance="{Binding IsExternalFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Dış bağlantılar" Command="{Binding SetFilterCommand}" CommandParameter="External" Padding="12,7" Margin="0,0,6,4"/>
                <ui:Button Appearance="{Binding IsListeningFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Dinleme" Command="{Binding SetFilterCommand}" CommandParameter="Listening" Padding="12,7" Margin="0,0,6,4"/>
                <ui:Button Appearance="{Binding IsSuspiciousFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Şüpheli / riskli" Command="{Binding SetFilterCommand}" CommandParameter="Suspicious" Padding="12,7" Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>

        <!-- Split Grid: Column 0 = Connections List, Column 1 = Inspection Drawer -->
        <Grid Grid.Row="1" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main Connections List Card -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource Card.Fill}" 
                    BorderBrush="{DynamicResource Card.Stroke.Glass}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource Radius.MD}" 
                    Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <Border Grid.Row="0" Style="{StaticResource Table.HeaderRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*" MinWidth="150"/> <!-- Process & PID -->
                                <ColumnDefinition Width="Auto" MinWidth="85"/>   <!-- Protokol / Durum -->
                                <ColumnDefinition Width="1.6*" MinWidth="165"/> <!-- Yerel Soket (Kırpılma Engelli) -->
                                <ColumnDefinition Width="2.0*" MinWidth="190"/> <!-- Uzak Hedef & Servis -->
                                <ColumnDefinition Width="Auto" MinWidth="130"/> <!-- Güvenlik Analizi -->
                                <ColumnDefinition Width="Auto" MinWidth="100"/> <!-- İşlemler -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Süreç adı ve PID" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Protokol / durum" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Yerel soket" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Uzak hedef ve servis" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="Güvenlik analizi" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="5" Text="İşlemler" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized Connections ListView -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding FilteredConnections}"
                              SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder" 
                                                    Background="Transparent" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="0,0,0,1" 
                                                    Padding="16,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NetworkConnectionItem}">
                                <Grid>
                                    <!-- Context Menu -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="IP / host adresini kopyala" 
                                                      Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding RemoteAddress}"/>
                                            <MenuItem Header="Güvenlik duvarıyla engelle" 
                                                      Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Süreci sonlandır (Kill)" 
                                                      Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Dosya konumunu aç" 
                                                      Command="{Binding DataContext.OpenProcessLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*" MinWidth="150"/> <!-- Process & PID -->
                                        <ColumnDefinition Width="Auto" MinWidth="85"/>   <!-- Protokol / Durum -->
                                        <ColumnDefinition Width="1.6*" MinWidth="165"/> <!-- Yerel Soket (Kırpılma Engelli) -->
                                        <ColumnDefinition Width="2.0*" MinWidth="190"/> <!-- Uzak Hedef & Servis -->
                                        <ColumnDefinition Width="Auto" MinWidth="130"/> <!-- Güvenlik Analizi -->
                                        <ColumnDefinition Width="Auto" MinWidth="100"/> <!-- İşlemler -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: Process Name & PID -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Col 1: Protocol & State -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Protocol}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding State}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Col 2: Local Endpoint (Asla Kırpılmaz) -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding LocalEndpoint}" 
                                               FontSize="{StaticResource Font.Caption}" 
                                               FontFamily="Consolas" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center"/>

                                    <!-- Col 3: Remote Endpoint & Service Name -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding RemoteEndpoint}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RemoteHostName, TargetNullValue=''}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{Binding IsExternal, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <!-- Col 4: Security Threat Badge -->
                                    <Border Grid.Column="4" 
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{StaticResource Radius.SM}" 
                                            Padding="8,4" 
                                            Margin="0,0,12,0" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PortCategory}" Style="{StaticResource PortCategoryTextStyle}" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- Col 5: Quick Action Buttons (Modern Subtle Icon Buttons) -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" Padding="5" Margin="0,0,2,0" ToolTip="Güvenlik duvarıyla engelle" Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ShieldKeyhole20}"/>
                                        <ui:Button Appearance="Transparent" Padding="5" Margin="0,0,2,0" ToolTip="Süreci ve soketi sonlandır" Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Dismiss20}"/>
                                        <ui:Button Appearance="Transparent" Padding="5" ToolTip="Dosya konumunu aç" Command="{Binding DataContext.OpenProcessLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon FolderOpen20}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right Side Master-Detail Inspection Drawer (Röntgen Paneli) -->
            <Border Grid.Column="1" 
                    Width="360" 
                    Margin="14,0,0,0" 
                    Background="{DynamicResource Card.Fill}" 
                    BorderBrush="{DynamicResource Card.Stroke.Glass}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource Radius.MD}" 
                    Padding="16"
                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Empty State if no item selected -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Margin="16"
                                Visibility="{Binding SelectedConnection, Converter={StaticResource InverseNullToVisibilityConverter}}">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                Width="56" Height="56" 
                                CornerRadius="28" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="28" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Bağlantı seçin" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Listeden bir bağlantı seçtiğinizde süreci, adresleri ve güvenlik bilgisini burada görürsünüz." 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Rich Process & Socket Inspection Details -->
                    <Grid DataContext="{Binding SelectedConnection}"
                          Visibility="{Binding DataContext.SelectedConnection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Close -->
                            <RowDefinition Height="Auto"/> <!-- Process Info -->
                            <RowDefinition Height="Auto"/> <!-- Socket Details -->
                            <RowDefinition Height="Auto"/> <!-- Threat Assessment -->
                            <RowDefinition Height="*"/>    <!-- Spacer / Notes -->
                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        </Grid.RowDefinitions>

                        <!-- Drawer Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bağlantı ayrıntıları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Ayrıntılı soket ve güvenlik denetimi" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1" 
                                       Appearance="Secondary" 
                                       Padding="6,4" 
                                       Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                       ToolTip="Ayrıntıları kapat"
                                       Icon="{ui:SymbolIcon Dismiss20}"/>
                        </Grid>

                        <!-- Process Overview -->
                        <Border Style="{StaticResource Card.Surface.Compact}" Grid.Row="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding ProcessName}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,4"/>
                                
                                <TextBlock Text="Yayımcı / imza:" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Publisher}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="Yürütülebilir dosya:" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ProcessPath}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" ToolTip="{Binding ProcessPath}"/>
                            </StackPanel>
                        </Border>

                        <!-- Socket Endpoints -->
                        <Border Style="{StaticResource Card.Surface.Compact}" Grid.Row="2" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Soket ve protokol detayları" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,2">
                                    <TextBlock Text="Protokol / durum:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Protocol, StringFormat='{}{0}'}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Yerel uç nokta:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding LocalEndpoint}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Uzak hedef:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding RemoteEndpoint}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Tanımlı servis:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding ServiceDescription}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Ters DNS çözümü:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding RemoteHostName}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Threat Assessment -->
                        <Border Grid.Row="3" 
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="{StaticResource Radius.SM}" 
                                Padding="12" 
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Shield20" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding PortCategory}" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ThreatDescription}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Grid.Row="5">
                            <ui:Button Appearance="Secondary" 
                                       HorizontalAlignment="Stretch" 
                                       Padding="12,8" 
                                       Margin="0,0,0,6"
                                       Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       Content="Güvenlik duvarıyla engelle" 
                                       Icon="{ui:SymbolIcon ShieldKeyhole20}"/>

                            <ui:Button Appearance="Secondary" 
                                       HorizontalAlignment="Stretch" 
                                       Padding="12,8" 
                                       Margin="0,0,0,6"
                                       Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       Content="Süreci ve soketi sonlandır" 
                                       Icon="{ui:SymbolIcon Dismiss20}"/>

                            <ui:Button Appearance="Secondary" 
                                       HorizontalAlignment="Stretch" 
                                       Padding="12,8" 
                                       Margin="0,0,0,6"
                                       Command="{Binding DataContext.AnalyzeProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       Content="Analizör ile tara" 
                                       Icon="{ui:SymbolIcon ShieldTask20}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0" 
                                           Appearance="Secondary" 
                                           HorizontalAlignment="Stretch" 
                                           Padding="8,6" 
                                           Command="{Binding DataContext.OpenProcessLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Content="Konum" 
                                           Icon="{ui:SymbolIcon FolderOpen20}"/>

                                <ui:Button Grid.Column="2" 
                                           Appearance="Secondary" 
                                           HorizontalAlignment="Stretch" 
                                           Padding="8,6" 
                                           Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding RemoteAddress}"
                                           Content="IP kopyala" 
                                           Icon="{ui:SymbolIcon Copy20}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="{StaticResource Radius.MD}" 
                Padding="14,8" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="İpucu: Bir satıra tıkladığınızda sağda ayrıntılar ve güvenlik paneli açılır." 
                           FontSize="{StaticResource Font.Caption}" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
