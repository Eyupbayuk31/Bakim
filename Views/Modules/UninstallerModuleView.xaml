<UserControl x:Class="Bakım.Views.Modules.UninstallerModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:UninstallerViewModel}"
             d:DesignHeight="780" d:DesignWidth="1050">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Metrics -->
            <RowDefinition Height="Auto"/> <!-- 2: Toolbar / Actions -->
            <RowDefinition Height="*"/>    <!-- 3: Content (App List or Leftovers) -->
            <RowDefinition Height="Auto"/> <!-- 4: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
                <!-- Sayfa basligi — tasarim sistemi bileseni -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Derin Kalıntı Temizleyici &amp; Program Kaldırıcı"
                         Description="Revo stili iki aşamalı derin disk ve kayıt defteri kalıntı taraması ile yazılımları eksiksiz silin.">
            <c:SectionHeader.Actions>
                <!-- Header Action Buttons: Hunter Mode, Installation Monitor, Refresh -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Avcı Modu (Hunter Mode) -->
                <ui:Button Appearance="Secondary"
                Command="{Binding LaunchHunterModeCommand}"
                Padding="12,8"
                Margin="0,0,8,0"
                Content="Avcı Modu"
                ToolTip="Açık pencere veya kısayolu hedef alarak hızlıca kaldırın"
                Icon="{ui:SymbolIcon Target24}"/>

                <!-- Kurulum İzleyici (Installation Monitor) -->
                <ui:Button Appearance="Secondary"
                Command="{Binding LaunchInstallationMonitorCommand}"
                Padding="12,8"
                Margin="0,0,8,0"
                Content="Kurulum İzle"
                ToolTip="Yeni bir kurulum paketini izleyip sıfır kalıntı logu oluşturun"
                Icon="{ui:SymbolIcon Record24}"/>


                <!-- Yenile -->
                <ui:Button Appearance="Secondary"
                Command="{Binding RefreshAppsCommand}"
                Padding="12,8"
                Content="Yenile"
                Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. Top KPI Metrics -->
        <!-- 1. Top KPI Metrics (İnteraktif Filtreleme Desteği) -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Kaldırılabilir Programlar (Tıklanabilir Filtre) -->
            <ui:Card Grid.Column="0" Padding="16,14" Cursor="Hand" ToolTip="Yalnızca kaldırılabilir programları filtrele">
                <ui:Card.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetAppFilterCategoryCommand}" CommandParameter="UserOnly"/>
                </ui:Card.InputBindings>
                <ui:Card.Style>
                    <Style TargetType="{x:Type ui:Card}">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUserOnlyFilter}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kaldırılabilir Programlar" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding UserAppsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text=" yazılım" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Apps24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Total Footprint -->
            <ui:Card Grid.Column="2" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Toplam Kaplanan Alan" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.FormattedTotalFootprint}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Desktop24" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: System Components (Tıklanabilir Filtre) -->
            <ui:Card Grid.Column="4" Padding="16,14" Cursor="Hand" ToolTip="Korumalı sistem bileşenlerini ve kütüphaneleri filtrele">
                <ui:Card.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetAppFilterCategoryCommand}" CommandParameter="SystemOnly"/>
                </ui:Card.InputBindings>
                <ui:Card.Style>
                    <Style TargetType="{x:Type ui:Card}">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemOnlyFilter}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sistem Bileşenleri" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SystemAppsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            <TextBlock Text=" korumalı" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark24" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 4: Leftovers Found -->
            <ui:Card Grid.Column="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bulunan Kalıntılar" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.LeftoversFoundCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="{Binding Stats.FormattedTotalLeftovers, StringFormat=' ({0})'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Delete24" FontSize="24" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 2. Modern 2-Katmanlı Toolbar: Segment Filtreleri, Sıralama & Arama -->
        <Grid Grid.Row="2" Margin="0,0,0,14"
              Visibility="{Binding ActiveViewMode, Converter={StaticResource StringToVis}, ConverterParameter=AppList}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Katman 1: Segment Filtreleri & Arama -->
                <RowDefinition Height="Auto"/> <!-- Katman 2: Sıralama & Toplu İşlem Butonları -->
            </Grid.RowDefinitions>

            <!-- Katman 1: Segment Kategori Filtresi & Arama -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 3'lü Segment Kategori Çubuğu -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Segment 1: Kaldırılabilir Programlar -->
                    <ui:Button Command="{Binding SetAppFilterCategoryCommand}" CommandParameter="UserOnly" Padding="14,7" Margin="0,0,6,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserOnlyFilter}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UserAppsCount, StringFormat='Kaldırılabilir Yazılımlar ({0})'}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Segment 2: Korumalı Sistem Bileşenleri -->
                    <ui:Button Command="{Binding SetAppFilterCategoryCommand}" CommandParameter="SystemOnly" Padding="14,7" Margin="0,0,6,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemOnlyFilter}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldKeyhole20" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SystemAppsCount, StringFormat='Korumalı Sistem ({0})'}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Segment 3: Tümü -->
                    <ui:Button Command="{Binding SetAppFilterCategoryCommand}" CommandParameter="All" Padding="14,7" Margin="0,0,6,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllFilter}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Stats.TotalAppsCount, StringFormat='Tümü ({0})'}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                </WrapPanel>

                <!-- Search Box (Sağ Taraf) -->
                <ui:TextBox Grid.Column="1" 
                            MinWidth="220" MaxWidth="380"
                            PlaceholderText="Yüklü program veya yayıncı ara..." 
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            VerticalContentAlignment="Center"
                            Padding="12,8" AutomationProperties.Name="Yüklü program veya yayıncı ara..."/>
            </Grid>

            <!-- Katman 2: Sıralama Hapları & Toplu İşlem Butonları -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Taraf: Sıralama Butonları & Otomatik Temizle -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sırala:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,4"/>

                    <!-- Boyut -->
                    <ui:Button Content="Boyut" Command="{Binding SetSortCommand}" CommandParameter="Size" Padding="10,5" Margin="0,0,4,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSortBySize}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- İsim -->
                    <ui:Button Content="İsim" Command="{Binding SetSortCommand}" CommandParameter="Name" Padding="10,5" Margin="0,0,4,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSortByName}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Tarih -->
                    <ui:Button Content="Tarih" Command="{Binding SetSortCommand}" CommandParameter="Date" Padding="10,5" Margin="0,0,4,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSortByDate}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Yayıncı -->
                    <ui:Button Content="Yayıncı" Command="{Binding SetSortCommand}" CommandParameter="Publisher" Padding="10,5" Margin="0,0,14,4">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSortByPublisher}" Value="True">
                                        <Setter Property="Appearance" Value="Primary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Auto-Clean Toggle -->
                    <ui:ToggleSwitch IsChecked="{Binding IsAutoCleanEnabled}" AutomationProperties.Name="Kaldırma sonrası kalıntıları otomatik temizle"
                                     OnContent="Otomatik Kalıntı Temizle"
                                     OffContent="Kalıntıları Elle Onayla"
                                     VerticalAlignment="Center"
                                     Margin="0,0,14,4"/>
                </WrapPanel>

                <!-- Sağ Taraf: Toplu Seçim & Kaldırma Butonları -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary"
                               Content="Tümünü Seç"
                               Command="{Binding SelectAllAppsCommand}"
                               CommandParameter="true"
                               Padding="10,5"
                               Margin="0,0,4,4"/>
                    <ui:Button Appearance="Secondary"
                               Content="Seçimi Kaldır"
                               Command="{Binding SelectAllAppsCommand}"
                               CommandParameter="false"
                               Padding="10,5"
                               Margin="0,0,8,4"
                               Visibility="{Binding HasSelectedApps, Converter={StaticResource BoolToVis}}"/>

                    <!-- Batch Silent Uninstall Button -->
                    <ui:Button Appearance="Danger"
                               Content="{Binding SelectedAppsCount, StringFormat='Seçilenleri Toplu Kaldır ({0})'}"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding BatchUninstallCommand}"
                               Padding="12,5"
                               Margin="0,0,0,4"
                               Visibility="{Binding HasSelectedApps, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </Grid>
        </Grid>

        <!-- 3. Active Content Area -->
        <Grid Grid.Row="3">
            <!-- VIEW 1: Installed Programs List -->
            <Grid Visibility="{Binding ActiveViewMode, Converter={StaticResource StringToVis}, ConverterParameter=AppList}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Batch Progress Overlay -->
                    <RowDefinition Height="Auto"/> <!-- System Protected InfoBar -->
                    <RowDefinition Height="*"/>    <!-- ListView -->
                </Grid.RowDefinitions>

                <!-- Batch Progress Banner -->
                <ui:Card Grid.Row="0"
                         Margin="0,0,0,10" 
                         Padding="14,10" 
                         Background="{DynamicResource ControlFillColorSecondaryBrush}"
                         Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BatchStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Margin="0,8,0,0" Height="4" Value="{Binding BatchProgress}" Maximum="{Binding BatchProgressMax}"/>
                    </Grid>
                </ui:Card>

                <!-- Korumalı Sistem Katmanı Bilgilendirme Çubuğu -->
                <ui:InfoBar Grid.Row="1"
                            Title="Korumalı Sistem Katmanı"
                            Message="Aşağıdaki bileşenler Windows işletim sisteminin ve yüklü yazılımların temel bağımlılıklarıdır (.NET, Visual C++ Runtimes, Edge WebView2, SDK). Sistem kararsızlıklarını önlemek için doğrudan kaldırılması kilitlenmiştir."
                            Severity="Warning"
                            IsOpen="{Binding IsSystemOnlyFilter}"
                            IsClosable="False"
                            Margin="0,0,0,10"/>

                <ListView Grid.Row="2"
                          Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding FilteredApps}"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:InstalledAppItem}">
                            <!-- SATIR KARTI (Responsive Padding & ClipToBounds=False) -->
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Margin="0,0,0,8" 
                                    Padding="14,10"
                                    ClipToBounds="False">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <!-- Col 0: CheckBox (SharedSizeGroup ile korumalı öğelerde dahi kolon hizası bozulmaz) -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                                        <!-- Col 1: İkon (Otomatik) -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Col 2: Bilgiler & Rozetler (Kalan Tüm Esnek Alan) -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Col 3: Boyut (Satırlar Arası Otomatik Senkronize Genişlik) -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                                        <!-- Col 4: İşlem Butonları (Satırlar Arası Otomatik Senkronize Genişlik) -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ActionCol"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: CheckBox (Margin ile Otomatik İç Pay, Kırpılma Yok) -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"
                                              Margin="0,0,12,0"
                                              Cursor="Hand"
                                              Visibility="{Binding IsSystemComponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                    <!-- Col 1: İkon (Gerçek .ico veya Fluent Symbol) -->
                                    <Border Grid.Column="1" 
                                            Width="38" Height="38"
                                            CornerRadius="8" 
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            Padding="6"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding IconSource}" 
                                                   Width="24" Height="24" 
                                                   Visibility="{Binding IconSource, Converter={StaticResource NullToVisibilityConverter}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <ui:SymbolIcon Symbol="Apps24" FontSize="18" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Col 2: Başlık, Yayıncı ve Dinamik Rozetler -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <!-- Başlık ve Rozetler -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" 
                                                       Margin="0,0,8,0"/>

                                            <!-- Rozetler (Boşsa Otomatik Gizlenir, Boş Gri Kutucuk Oluşmaz) -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Sürüm Rozeti -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                        BorderThickness="1" 
                                                        Visibility="{Binding DisplayVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DisplayVersion, StringFormat='v{0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>

                                                <!-- Mimari Rozeti: 64-Bit / 32-Bit -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                        BorderThickness="1" 
                                                        Visibility="{Binding Is64Bit, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="64-Bit" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </Border>
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                        BorderThickness="1" 
                                                        Visibility="{Binding Is64Bit, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="32-Bit" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </Border>

                                                <!-- Kurulum Türü Rozeti -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                        BorderThickness="1"
                                                        Visibility="{Binding InstallerKind, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding InstallerKind}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </WrapPanel>

                                        <!-- Yayıncı ve Yükleme Tarihi (Boş olanlar gizlenir) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Publisher, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding InstallDate, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding InstallDate, StringFormat='Yüklendi: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding InstallDate, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Col 3: Boyut (Satırlar Arası Otomatik Senkronize Genişlik) -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,24,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Disk Alanı" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Col 4: İşlem Butonları (Satırlar Arası Otomatik Senkronize Genişlik) -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Protected System Component Badge -->
                                        <Border CornerRadius="6" Padding="12,7" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" 
                                                BorderThickness="1"
                                                Visibility="{Binding IsSystemComponent, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ShieldKeyhole20" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Korumalı Sistem Bileşeni" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Deep Residual Scan Modal Button -->
                                        <ui:Button Appearance="Secondary" 
                                                   Icon="{ui:SymbolIcon Search20}"
                                                   ToolTip="Kalıntıları İncele ve Temizle"
                                                   Command="{Binding DataContext.ShowResidualCleanupDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="10,8"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSystemComponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}" AutomationProperties.Name="Kalıntıları İncele ve Temizle"/>

                                        <!-- AI Heuristic Threat Analysis Button -->
                                        <ui:Button Appearance="Secondary" 
                                                   Icon="{ui:SymbolIcon ShieldKeyhole20}"
                                                   ToolTip="Sezgisel Tehdit &amp; Güvenlik Analizi Yap"
                                                   Command="{Binding DataContext.AnalyzeThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="10,8"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSystemComponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}" AutomationProperties.Name="Sezgisel Tehdit &amp; Güvenlik Analizi Yap"/>

                                        <!-- Standard Uninstall Button -->
                                        <ui:Button Appearance="Primary" 
                                                   Content="Kaldır" 
                                                   Icon="{ui:SymbolIcon Delete20}"
                                                   Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="14,8"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSystemComponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                        <!-- Force Uninstall Button -->
                                        <ui:Button Appearance="Secondary" 
                                                   Content="Zorla Kaldır" 
                                                   Icon="{ui:SymbolIcon Broom24}"
                                                   Command="{Binding DataContext.ForceUninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="14,8"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSystemComponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 2: Leftovers Deep Clean View -->
            <Grid Visibility="{Binding ActiveViewMode, Converter={StaticResource StringToVis}, ConverterParameter=Leftovers}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Leftovers Action Header -->
                    <RowDefinition Height="*"/>    <!-- Leftovers List -->
                </Grid.RowDefinitions>

                <!-- Leftovers Action Bar -->
                <ui:Card Grid.Row="0" Padding="16,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kalıntı Analizi: " FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedApp.DisplayName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Aşağıdaki dosya ve kayıt defteri anahtarları programın geride bıraktığı yetim kalıntılardır." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Batch Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary" 
                                       Content="Tümünü Seç" 
                                       Command="{Binding SelectAllLeftoversCommand}" 
                                       CommandParameter="true"
                                       Padding="10,6" 
                                       Margin="0,0,6,0"/>
                            <ui:Button Appearance="Secondary" 
                                       Content="Seçimi Kaldır" 
                                       Command="{Binding SelectAllLeftoversCommand}" 
                                       CommandParameter="false"
                                       Padding="10,6" 
                                       Margin="0,0,12,0"/>
                            <ui:Button Appearance="Success" 
                                       Content="Seçili Kalıntıları Temizle" 
                                       Icon="{ui:SymbolIcon Broom24}"
                                       Command="{Binding CleanSelectedLeftoversCommand}"
                                       Padding="14,8"
                                       Margin="0,0,8,0"/>
                            <ui:Button Appearance="Secondary" 
                                       Content="Geri Dön" 
                                       Command="{Binding BackToAppListCommand}"
                                       Padding="12,8"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Leftovers ListView -->
                <ListView Grid.Row="1" 
                          Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding Leftovers}"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LeftoverItem}">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Margin="0,0,0,8" 
                                    Padding="14,10"
                                    ClipToBounds="False">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LeftoverCheckCol"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LeftoverTypeCol"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LeftoverSizeCol"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CheckBox (Kırpılma Yok, Margin ile İç Pay) -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"
                                              Margin="0,0,12,0"
                                              Cursor="Hand"/>

                                    <!-- Type Badge -->
                                    <Border Grid.Column="1" 
                                            CornerRadius="6" 
                                            Padding="10,4" 
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding TypeBadgeText}" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>

                                    <!-- Path & Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Path}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding FormattedSize}" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Margin="0,12,0,0" 
                Padding="12,8" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" 
                                 IsIndeterminate="True" 
                                 Width="18" Height="18" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
