<UserControl x:Class="Bakım.Views.Modules.NetworkDiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkMonitorViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <!-- Ağ İzleyici › Tanılama -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ping -->
                <ui:CardExpander Grid.Row="0" Icon="{ui:SymbolIcon Pulse24}" Padding="16">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Ping" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Bir adrese ping gönderip gidiş-dönüş süresini ölçer." Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" 
                                        PlaceholderText="Adres (ör. 8.8.8.8 veya google.com)" 
                                        Text="{Binding PingTarget, UpdateSourceTrigger=PropertyChanged}" 
                                        ClearButtonEnabled="True" 
                                        Padding="12,9" 
                                        VerticalContentAlignment="Center" 
                                        Icon="{ui:SymbolIcon Globe20}"/>

                            <ui:Button Grid.Column="2" 
                                       Appearance="Secondary" 
                                       Command="{Binding RunPingCommand}" 
                                       Padding="16,8" 
                                       Content="Gönder" 
                                       Icon="{ui:SymbolIcon Play20}"/>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Card.Inset}">
                            <TextBlock Text="{Binding PingResult}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </ui:CardExpander>

                <!-- DNS önbelleği -->
                <ui:CardControl Grid.Row="2" Style="{StaticResource Card.Setting}" Margin="0" Icon="{ui:SymbolIcon ArrowClockwise24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="DNS önbelleğini temizle" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Eski ya da bozuk DNS kayıtlarını siler; bazı sitelere erişilemiyorsa işe yarar." Style="{StaticResource Text.SettingDescription}"/>
                            <TextBlock Text="{Binding FlushDnsStatus}" Style="{StaticResource Text.SettingDescription}"
                                       Visibility="{Binding FlushDnsStatus, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Appearance="Secondary" Command="{Binding FlushDnsCommand}" Content="Temizle"/>
                </ui:CardControl>

                <!-- Port denetimi -->
                <ui:CardExpander Grid.Row="4" Icon="{ui:SymbolIcon PlugConnected24}" Padding="16">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Port denetimi" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Bir sunucudaki TCP portunun açık olup olmadığını dener." Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" 
                                        PlaceholderText="Sunucu (ör. google.com)" 
                                        Text="{Binding PortCheckHost, UpdateSourceTrigger=PropertyChanged}" 
                                        ClearButtonEnabled="True" 
                                        Padding="12,9" 
                                        VerticalContentAlignment="Center" 
                                        Icon="{ui:SymbolIcon Globe20}"/>

                            <ui:TextBox Grid.Column="2" 
                                        PlaceholderText="Port (ör. 443)" 
                                        Text="{Binding PortCheckPort, UpdateSourceTrigger=PropertyChanged}" 
                                        ClearButtonEnabled="True" 
                                        Padding="12,9" 
                                        VerticalContentAlignment="Center" 
                                        Icon="{ui:SymbolIcon NumberSymbol20}"/>

                            <ui:Button Grid.Column="4" 
                                       Appearance="Secondary" 
                                       Command="{Binding CheckPortCommand}" 
                                       Padding="16,8" 
                                       Content="Dene" 
                                       Icon="{ui:SymbolIcon Checkmark20}"/>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Card.Inset}">
                            <TextBlock Text="{Binding PortCheckResultText}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </ui:CardExpander>

                <!-- Rota izleme -->
                <ui:CardExpander Grid.Row="6" Icon="{ui:SymbolIcon Router24}" Padding="16">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Rota izleme" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Paketlerin hedefe giderken geçtiği yönlendiricileri ve gecikmelerini gösterir." Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" 
                                        PlaceholderText="Hedef IP veya Alan Adı (Örn: 1.1.1.1 veya google.com)" 
                                        Text="{Binding TracerouteTarget, UpdateSourceTrigger=PropertyChanged}" 
                                        ClearButtonEnabled="True" 
                                        Padding="12,9" 
                                        VerticalContentAlignment="Center" 
                                        Icon="{ui:SymbolIcon Globe20}"/>

                            <ui:Button Grid.Column="2" 
                                       Appearance="Secondary" 
                                       Command="{Binding RunTracerouteCommand}" 
                                       IsEnabled="{Binding IsTracerouteRunning, Converter={StaticResource InverseBool}}"
                                       Padding="16,8" 
                                       Content="İzlemeyi başlat" 
                                       Icon="{ui:SymbolIcon Play20}"/>

                            <ui:Button Grid.Column="4" 
                                       Appearance="Secondary" 
                                       Command="{Binding CancelTracerouteCommand}" 
                                       IsEnabled="{Binding IsTracerouteRunning}"
                                       Padding="14,8" 
                                       Content="Durdur" 
                                       Icon="{ui:SymbolIcon Dismiss20}"/>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Card.Inset}">
                            <StackPanel>
                                <TextBlock Text="{Binding TracerouteStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding TracerouteHops}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding HopNumber, StringFormat='{}{0}.'}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RoundtripTimeMs, StringFormat='{}{0} ms'}" FontFamily="Consolas" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Hostname}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ui:CardExpander>

                <!-- DNS sunucusu karşılaştırma -->
                <ui:CardExpander Grid.Row="8" Icon="{ui:SymbolIcon Server24}" Padding="16">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="DNS sunucusu karşılaştırma" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Yaygın DNS sağlayıcılarının yanıt süresini ölçer ve en hızlısını gösterir." Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" HorizontalAlignment="Left" 
                                       Appearance="Secondary" 
                                       Command="{Binding RunDnsBenchmarkCommand}" 
                                       IsEnabled="{Binding IsDnsBenchmarking, Converter={StaticResource InverseBool}}"
                                       Padding="16,8" 
                                       Content="Başlat" 
                                       Icon="{ui:SymbolIcon Play20}"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding DnsBenchmarkStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" FontWeight="SemiBold"/>

                        <Border Grid.Row="2" Style="{StaticResource Card.Inset}">
                            <ItemsControl ItemsSource="{Binding DnsBenchmarkResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Card.Fill.Secondary}" BorderBrush="{DynamicResource Divider.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12,8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Provider}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding PrimaryIp}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding DisplayLatency}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="3" 
                                                        Background="{DynamicResource SystemFillColorSuccessBrush}" 
                                                        CornerRadius="{StaticResource Radius.SM}" 
                                                        Padding="8,4" 
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="En hızlı" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </ui:CardExpander>

                <!-- Bakım'ın güvenlik duvarı kuralları -->
                <ui:CardExpander Grid.Row="10" Icon="{ui:SymbolIcon ShieldKeyhole24}" Padding="16">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Bakım'ın güvenlik duvarı kuralları" Style="{StaticResource Text.SettingTitle}"/>
                            <TextBlock Text="Bakım ile engellenen programların kurallarını listeler; engeli buradan kaldırabilirsiniz." Style="{StaticResource Text.SettingDescription}"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" HorizontalAlignment="Left" 
                                       Appearance="Secondary" 
                                       Command="{Binding LoadBakimFirewallRulesCommand}" 
                                       Padding="14,8" 
                                       Content="Yenile" 
                                       Icon="{ui:SymbolIcon ArrowClockwise20}"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding FirewallRulesStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                        <Border Grid.Row="2" Style="{StaticResource Card.Inset}">
                            <ItemsControl ItemsSource="{Binding BakimFirewallRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Card.Fill.Secondary}" BorderBrush="{DynamicResource Divider.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12,8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="ShieldDismiss20" FontSize="20" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" 
                                                           Appearance="Secondary" 
                                                           Padding="10,6" 
                                                           Command="{Binding DataContext.RemoveBakimFirewallRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Engeli kaldır" 
                                                           Icon="{ui:SymbolIcon Dismiss20}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </ui:CardExpander>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
