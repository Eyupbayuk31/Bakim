<UserControl x:Class="Bakım.Views.Modules.ActivityCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ActivityCenterViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık -->
            <RowDefinition Height="Auto"/> <!-- 1: Özet kartları -->
            <RowDefinition Height="Auto"/> <!-- 2: Filtre çubuğu -->
            <RowDefinition Height="*"/>    <!-- 3: Zaman çizelgesi + ayrıntı -->
            <RowDefinition Height="Auto"/> <!-- 4: Durum -->
        </Grid.RowDefinitions>

        <!-- 0. Başlık -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         Icon="History24"
                         HeaderMargin="0,0,0,18"
                         Title="Etkinlik Merkezi"
                         Description="Bakım'ın sisteminizde yaptığı her değişiklik burada. Yedeği olan işlemler geri alınabilir.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               Padding="{StaticResource Pad.Control}"
                               Margin="{StaticResource Gap.Right.SM}"
                               Icon="{ui:SymbolIcon ArrowDownload20}"
                               Content="Dışa aktar"
                               Command="{Binding ExportCommand}"
                               AutomationProperties.Name="Görünen kayıtları CSV olarak dışa aktar"/>
                    <ui:Button Appearance="Secondary"
                               Padding="{StaticResource Pad.Control}"
                               Icon="{ui:SymbolIcon Delete20}"
                               Content="Kaydı temizle"
                               Command="{Binding ClearAllCommand}"
                               AutomationProperties.Name="Etkinlik kaydının tamamını sil"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 1. Özet -->
        <c:SummaryStrip Grid.Row="1" Margin="{StaticResource Gap.Bottom.MD}">
            <c:StatCard Icon="History24" Label="Toplam kayıt" Value="{Binding TotalCount}" Intent="Neutral"/>
            <c:StatCard Icon="CalendarLtr24" Label="Bugün" Value="{Binding TodayCount}" Intent="Accent"/>
            <c:StatCard Icon="ArrowUndo20" Label="Geri alınabilir" Value="{Binding UndoableCount}" Intent="Success"/>
            <c:StatCard Icon="ErrorCircle24" Label="Başarısız" Value="{Binding FailedCount}" Intent="Critical"/>
        </c:SummaryStrip>

        <!-- 2. Filtre çubuğu -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="{StaticResource Pad.CardCompact}"
                Margin="{StaticResource Gap.Bottom.MD}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Başlığa, modüle ya da dosya/anahtar yoluna göre ara…"
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            Margin="{StaticResource Gap.Right.SM}"
                            AutomationProperties.Name="Etkinliklerde ara"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding KindOptions}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedKind}"
                          MinWidth="160"
                          Margin="{StaticResource Gap.Right.SM}"
                          AutomationProperties.Name="Türe göre filtrele"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding OutcomeOptions}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedOutcome}"
                          MinWidth="150"
                          AutomationProperties.Name="Sonuca göre filtrele"/>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="{StaticResource Gap.Top.SM}" VerticalAlignment="Center">
                    <TextBlock Text="Tarih:" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center" Margin="{StaticResource Gap.Right.SM}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <RadioButton Content="Bugün" GroupName="ActivityRange" Margin="{StaticResource Gap.Right.SM}"
                                 Command="{Binding SetRangeCommand}" CommandParameter="Today"/>
                    <RadioButton Content="7 gün" GroupName="ActivityRange" Margin="{StaticResource Gap.Right.SM}"
                                 Command="{Binding SetRangeCommand}" CommandParameter="7"/>
                    <RadioButton Content="30 gün" GroupName="ActivityRange" Margin="{StaticResource Gap.Right.SM}"
                                 Command="{Binding SetRangeCommand}" CommandParameter="30"/>
                    <RadioButton Content="Tümü" GroupName="ActivityRange" IsChecked="True" Margin="0,0,16,0"
                                 Command="{Binding SetRangeCommand}" CommandParameter="All"/>
                    <CheckBox Content="Yalnızca geri alınabilir" IsChecked="{Binding UndoableOnly}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 3. Zaman çizelgesi + ayrıntı -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}">
                <Grid>
                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                             SelectedItem="{Binding Selected}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Etkinlik zaman çizelgesi">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource Font.Body}"
                                                   FontWeight="SemiBold"
                                                   Margin="12,12,0,4"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding KindSymbol}" FontSize="18"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                               FontSize="{StaticResource Font.Body}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="2" Margin="{StaticResource Gap.Right.SM}">
                                        <TextBlock FontSize="{StaticResource Font.BodyLarge}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="{Binding Module, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Run Text=" · " Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <c:StatusBadge Text="{Binding OutcomeText}" Intent="{Binding OutcomeIntent}" Margin="{StaticResource Gap.Right.XS}"
                                                       Visibility="{Binding ShowOutcome, Converter={StaticResource BoolToVis}}"/>
                                        <c:StatusBadge Text="{Binding UndoText}" Intent="{Binding UndoIntent}" Margin="{StaticResource Gap.Right.XS}"
                                                       Visibility="{Binding HasUndoText, Converter={StaticResource BoolToVis}}"/>
                                        <ui:Button Appearance="Secondary" Padding="8,4"
                                                   Icon="{ui:SymbolIcon ArrowUndo16}"
                                                   Content="{Binding UndoButtonText}"
                                                   Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                   Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding}"
                                                   AutomationProperties.Name="Bu işlemi geri al"/>
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="8,0,0,0"
                                                         Visibility="{Binding IsUndoing, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <c:EmptyState Icon="History24"
                                  Title="Henüz kayıtlı etkinlik yok"
                                  Description="Temizlik, program kaldırma, ince ayar, başlangıç ve hizmet değişiklikleri yapıldıkça burada listelenir. Filtre kullanıyorsanız temizlemeyi deneyin."
                                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Ayrıntı -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="{StaticResource Pad.Card}">
                <Grid>
                    <TextBlock Text="Ayrıntıları görmek için soldan bir etkinlik seçin."
                               FontSize="{StaticResource Font.Body}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding Selected.Title}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding Selected.Summary}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="{StaticResource Gap.Top.XS}"/>
                            <WrapPanel Margin="{StaticResource Gap.Top.SM}">
                                <c:StatusBadge Text="{Binding Selected.KindText}" Intent="Neutral" Margin="{StaticResource Gap.Right.XS}"/>
                                <c:StatusBadge Text="{Binding Selected.OutcomeText}" Intent="{Binding Selected.OutcomeIntent}" Margin="{StaticResource Gap.Right.XS}"/>
                                <c:StatusBadge Text="{Binding Selected.UndoText}" Intent="{Binding Selected.UndoIntent}"
                                               Visibility="{Binding Selected.HasUndoText, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>
                            <TextBlock FontSize="{StaticResource Font.Body}" Margin="{StaticResource Gap.Top.XS}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <Run Text="{Binding Selected.DateText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Selected.Module, Mode=OneWay}"/>
                            </TextBlock>

                            <Border Margin="{StaticResource Gap.Top.SM}"
                                    Padding="{StaticResource Pad.CardCompact}"
                                    CornerRadius="{StaticResource Radius.SM}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding Selected.HasUndoMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource Font.Body}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="Geri alma sonucu: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Selected.UndoMessage, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{Binding Selected.ItemsHeader}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.MD}"
                                       Visibility="{Binding Selected.HasItems, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Selected.Items}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="{StaticResource Gap.Top.XS}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 AutomationProperties.Name="Etkinliğin öğeleri">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Target}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Action, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Result, Mode=OneWay}"/>
                                            <Run Text="{Binding Detail, Mode=OneWay, StringFormat=' · {0}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Grid.Row="2" Margin="{StaticResource Gap.Top.MD}">
                            <ui:Button Appearance="Primary" Padding="{StaticResource Pad.Control}" Margin="0,0,8,8"
                                       Icon="{ui:SymbolIcon ArrowUndo20}"
                                       Content="{Binding Selected.UndoButtonText}"
                                       Visibility="{Binding Selected.CanUndo, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding UndoCommand}"
                                       CommandParameter="{Binding Selected}"/>
                            <ui:Button Appearance="Secondary" Padding="{StaticResource Pad.Control}" Margin="0,0,8,8"
                                       Icon="{ui:SymbolIcon Open20}"
                                       Content="Modülde aç"
                                       Visibility="{Binding Selected.HasDeepLink, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding OpenDeepLinkCommand}"
                                       CommandParameter="{Binding Selected}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Durum -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="{StaticResource Gap.Top.SM}"
                   FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Grid>
</UserControl>
