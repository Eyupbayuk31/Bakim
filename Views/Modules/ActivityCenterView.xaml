<UserControl x:Class="Bakım.Views.Modules.ActivityCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:c="clr-namespace:Bakım.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ActivityCenterViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <c:ModulePage Title="Etkinlik Merkezi"
                  Subtitle="Bakım'ın sisteminizde yaptığı her değişiklik burada. Yedeği olan işlemler geri alınabilir."
                  IsScrollable="False">
    <c:ModulePage.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               Padding="{StaticResource Pad.Control}"
                               Margin="{StaticResource Gap.Right.SM}"
                               Icon="{ui:SymbolIcon ArrowDownload20}"
                               Content="Dışa aktar"
                               Command="{Binding ExportCommand}"
                               AutomationProperties.Name="Görünen kayıtları CSV olarak dışa aktar"/>
                    <ui:Button Appearance="Secondary"
                               Padding="{StaticResource Pad.Control}"
                               Icon="{ui:SymbolIcon Delete20}"
                               Content="Kaydı temizle"
                               Command="{Binding ClearAllCommand}"
                               AutomationProperties.Name="Etkinlik kaydının tamamını sil"/>
                </StackPanel>
            
    </c:ModulePage.Actions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık -->
            <RowDefinition Height="Auto"/> <!-- 1: Özet kartları -->
            <RowDefinition Height="Auto"/> <!-- 2: Filtre çubuğu -->
            <RowDefinition Height="*"/>    <!-- 3: Zaman çizelgesi + ayrıntı -->
            <RowDefinition Height="Auto"/> <!-- 4: Durum -->
        </Grid.RowDefinitions>

        <!-- 1. Özet: sayılar aynı zamanda hızlı filtredir -->
        <c:SummaryStrip Grid.Row="1" Margin="{StaticResource Gap.Bottom.LG}">
            <c:StatCard Icon="History24" Intent="Accent" Label="Toplam işlem" Value="{Binding TotalCount}"
                        Caption="Tüm filtreleri temizle" IsInteractive="True" ClickCommand="{Binding ShowAllCommand}"/>
            <c:StatCard Icon="CalendarToday24" Intent="Neutral" Label="Bugün" Value="{Binding TodayCount}"
                        Caption="Yalnızca bugünkü işlemler" IsInteractive="True" ClickCommand="{Binding ShowTodayCommand}"/>
            <c:StatCard Icon="ArrowUndo24" Intent="Success" Label="Geri alınabilir" Value="{Binding UndoableCount}"
                        Caption="Yedeği olan değişiklikler" IsInteractive="True" ClickCommand="{Binding ShowUndoableCommand}"/>
            <c:StatCard Icon="ErrorCircle24" Intent="Critical" Label="Başarısız" Value="{Binding FailedCount}"
                        Caption="Tamamlanamayan işlemler" IsInteractive="True" ClickCommand="{Binding ShowFailedCommand}"/>
        </c:SummaryStrip>

        <!-- 2. Komut çubuğu: arama ve filtreler tek satırda (çerçevesiz, Fluent) -->
        <Grid Grid.Row="2" Margin="{StaticResource Gap.Bottom.MD}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Başlık, modül ya da dosya/anahtar yolu ara"
                        Icon="{ui:SymbolIcon Search20}"
                        ClearButtonEnabled="True"
                        Margin="{StaticResource Gap.Right.SM}"
                        AutomationProperties.Name="Etkinliklerde ara"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding KindOptions}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding SelectedKind}"
                      MinWidth="150"
                      Margin="{StaticResource Gap.Right.SM}"
                      AutomationProperties.Name="Türe göre filtrele"/>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding OutcomeOptions}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding SelectedOutcome}"
                      MinWidth="140"
                      Margin="{StaticResource Gap.Right.SM}"
                      AutomationProperties.Name="Sonuca göre filtrele"/>
            <ComboBox Grid.Column="3"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding Range}"
                      MinWidth="120"
                      Margin="{StaticResource Gap.Right.MD}"
                      AutomationProperties.Name="Tarih aralığı">
                <ComboBoxItem Content="Bugün" Tag="Today"/>
                <ComboBoxItem Content="Son 7 gün" Tag="7"/>
                <ComboBoxItem Content="Son 30 gün" Tag="30"/>
                <ComboBoxItem Content="Tüm zamanlar" Tag="All"/>
            </ComboBox>
            <CheckBox Grid.Column="4"
                      Content="Yalnızca geri alınabilir"
                      IsChecked="{Binding UndoableOnly}"
                      VerticalAlignment="Center"/>
        </Grid>

        <!-- 3. Zaman çizelgesi (kartlar) + ayrıntı -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                         SelectedItem="{Binding Selected}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource ListItem.Card}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Etkinlik zaman çizelgesi">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ListItem.Card.GroupHeader}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActivityRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tür simgesi kutusu -->
                                <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.MD}"
                                        Background="{DynamicResource Subtle.Fill.Hover}"
                                        Margin="{StaticResource Gap.Right.MD}" VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="{Binding KindSymbol}" FontSize="18"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource Gap.Right.SM}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Gap.Top.XS}">
                                        <Run Text="{Binding TimeText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Module, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.BodySecondary}" TextTrimming="CharacterEllipsis"
                                               Margin="{StaticResource Gap.Top.XS}"
                                               Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:StatusBadge Text="{Binding OutcomeText}" Intent="{Binding OutcomeIntent}" Margin="{StaticResource Gap.Right.XS}"
                                                   Visibility="{Binding ShowOutcome, Converter={StaticResource BoolToVis}}"/>
                                    <c:StatusBadge Text="{Binding UndoText}" Intent="{Binding UndoIntent}" Margin="{StaticResource Gap.Right.XS}"
                                                   Visibility="{Binding HasUndoText, Converter={StaticResource BoolToVis}}"/>
                                    <ui:Button Appearance="Secondary" Padding="8,4"
                                               Icon="{ui:SymbolIcon ArrowUndo16}"
                                               Content="{Binding UndoButtonText}"
                                               Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding}"
                                               AutomationProperties.Name="Bu işlemi geri al"/>
                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="{StaticResource Gap.Right.XS}"
                                                     Visibility="{Binding IsUndoing, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <c:EmptyState Icon="History24"
                              Title="Henüz kayıtlı etkinlik yok"
                              Description="Temizlik, program kaldırma, ince ayar, başlangıç ve hizmet değişiklikleri yapıldıkça burada listelenir. Filtre kullanıyorsanız temizlemeyi deneyin."
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Ayrıntı paneli -->
            <Border Grid.Column="2" Style="{StaticResource Card.Surface}">
                <Grid>
                    <c:EmptyState IsEmbedded="True" Icon="DocumentBulletList24"
                                  Title="Bir etkinlik seçin"
                                  Description="Ne değiştiği, hangi öğeleri etkilediği ve geri alınıp alınamayacağı burada görünür."
                                  Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- Başlık: simge kutusu + başlık -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card.IconTile}" Margin="{StaticResource Gap.Right.MD}" VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="{Binding Selected.KindSymbol}" FontSize="24"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Selected.Summary}" Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap"
                                               Margin="{StaticResource Gap.Top.XS}"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="{StaticResource Gap.Top.MD}">
                                <c:StatusBadge Text="{Binding Selected.OutcomeText}" Intent="{Binding Selected.OutcomeIntent}" Margin="{StaticResource Gap.Right.XS}"/>
                                <c:StatusBadge Text="{Binding Selected.UndoText}" Intent="{Binding Selected.UndoIntent}"
                                               Visibility="{Binding Selected.HasUndoText, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>

                            <!-- Bilgi tablosu -->
                            <Border Style="{StaticResource Card.Inset}" Margin="{StaticResource Gap.Top.MD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Tarih" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Right.MD}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.DateText}" Style="{StaticResource Text.Body}"/>
                                    <TextBlock Grid.Row="1" Text="Modül" Style="{StaticResource Text.Caption}" Margin="0,6,12,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Module}" Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Top.XS}"/>
                                    <TextBlock Grid.Row="2" Text="Tür" Style="{StaticResource Text.Caption}" Margin="0,6,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.KindText}" Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Top.XS}"/>
                                </Grid>
                            </Border>

                            <Border Margin="{StaticResource Gap.Top.SM}"
                                    Style="{StaticResource Card.Inset}"
                                    Visibility="{Binding Selected.HasUndoMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Body}">
                                    <Run Text="Geri alma sonucu: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Selected.UndoMessage, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{Binding Selected.ItemsHeader}" Style="{StaticResource Text.SectionLabel}" Margin="{StaticResource Gap.Top.MD}"
                                       Visibility="{Binding Selected.HasItems, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Etkilenen öğeler: her biri iç kart -->
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Selected.Items}"
                                      Margin="{StaticResource Gap.Top.SM}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      ScrollViewer.CanContentScroll="True"
                                      AutomationProperties.Name="Etkinliğin öğeleri">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Inset}" Padding="{StaticResource Pad.Row}" Margin="{StaticResource Gap.Bottom.XS}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Gap.Top.XS}">
                                                <Run Text="{Binding Action, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Result, Mode=OneWay}"/>
                                                <Run Text="{Binding Detail, Mode=OneWay, StringFormat=' · {0}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Grid.Row="2" Margin="{StaticResource Gap.Top.MD}">
                            <ui:Button Appearance="Primary" Padding="{StaticResource Pad.Control}" Margin="{StaticResource Gap.Right.SM}"
                                       Icon="{ui:SymbolIcon ArrowUndo20}"
                                       Content="{Binding Selected.UndoButtonText}"
                                       Visibility="{Binding Selected.CanUndo, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding UndoCommand}"
                                       CommandParameter="{Binding Selected}"/>
                            <ui:Button Appearance="Secondary" Padding="{StaticResource Pad.Control}"
                                       Icon="{ui:SymbolIcon Open20}"
                                       Content="Modülde aç"
                                       Visibility="{Binding Selected.HasDeepLink, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding OpenDeepLinkCommand}"
                                       CommandParameter="{Binding Selected}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Durum -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="{StaticResource Gap.Top.SM}"
                   FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Grid>
    </c:ModulePage>
</UserControl>
