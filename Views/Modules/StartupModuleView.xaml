<UserControl x:Class="Bakım.Views.Modules.StartupModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. KPI Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- 2. Filter & Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- 3. Main Content (List + Inspection Drawer) -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: SAYFA BAŞLIĞI & EYLEMLER                                            -->
        <!-- ========================================================================= -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,16"
                         Title="Başlangıç Uygulamaları &amp; Açılış Optimizasyonu"
                         Description="Windows oturumu açılırken otomatik başlatılan tüm uygulama, servis ve kayıt defteri ögelerini yönetin.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary"
                               Command="{Binding OptimizeBootCommand}"
                               Content="Açılışı Hızlandır"
                               Icon="{ui:SymbolIcon TopSpeed24}"
                               Padding="14,8"
                               Margin="0,0,8,0"
                               ToolTip="Windows açılışını geciktiren yüksek etkili gereksiz başlatıcıları analiz edip tek tıkla optimize edin."/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding AddNewStartupProgramCommand}"
                               Content="Uygulama Ekle"
                               Icon="{ui:SymbolIcon Add24}"
                               Padding="14,8"
                               Margin="0,0,8,0"
                               ToolTip="Açılışta otomatik çalışması için yeni bir program (.exe) veya kısayol (.lnk) ekleyin."/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Padding="12,8"
                               ToolTip="Başlangıç listesini ve kayıt defterini yeniden tara."/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- ========================================================================= -->
        <!-- ROW 1: 4 ADET İNTERAKTİF KPI METRİK KARTI                                 -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Toplam Başlangıç Ögesi -->
            <c:StatCard Grid.Column="0" 
                        Icon="Apps24" 
                        Label="Toplam Başlatıcı" 
                        Value="{Binding Stats.TotalCount, FallbackValue='0'}" 
                        Caption="Kayıtlı açılış ögesi" 
                        Intent="Accent" 
                        IsInteractive="True"/>

            <!-- Card 2: Etkin Başlatıcılar -->
            <c:StatCard Grid.Column="2" 
                        Icon="CheckmarkCircle24" 
                        Label="Etkin Uygulamalar" 
                        Value="{Binding Stats.EnabledCount, FallbackValue='0'}" 
                        Caption="Açılışta otomatik çalışan" 
                        Intent="Success" 
                        IsInteractive="True"/>

            <!-- Card 3: Devre Dışı Ögeler -->
            <c:StatCard Grid.Column="4" 
                        Icon="DismissCircle24" 
                        Label="Devre Dışı" 
                        Value="{Binding Stats.DisabledCount, FallbackValue='0'}" 
                        Caption="Sistemi yormayan pasif" 
                        Intent="Neutral" 
                        IsInteractive="True"/>

            <!-- Card 4: Son açılış (Windows ölçümü) -->
            <ui:Card Grid.Column="6" Padding="14" Style="{StaticResource InteractiveCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Stats.BootDetail, FallbackValue='Son açılış'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.FormattedBootDelay, FallbackValue='Ölçüm yok'}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding Stats.HighImpactCount, StringFormat='{}{0} uygulama açılışı yavaşlatıyor'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        <!-- Son açılışlar (Windows ölçümü) -->
                        <ItemsControl ItemsSource="{Binding BootHistory}" Height="64" Margin="0,8,0,0"
                                      Visibility="{Binding HasBootHistory, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="10" Height="{Binding Height}" Margin="0,0,3,0" VerticalAlignment="Bottom"
                                            CornerRadius="{StaticResource Radius.XS}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            ToolTip="{Binding Tooltip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding BootMeasurementNote}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Caution.Subtle}" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="20" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: FİLTRE ÇİPLERİ VE ARAMA ÇUBUĞU                                     -->
        <!-- ========================================================================= -->
        <ui:Card Grid.Row="2" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Filter Pills in WrapPanel -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:Button Appearance="{Binding IsAllFilter, Converter={StaticResource BoolToNavAppearance}}"
                               Command="{Binding SetFilterCommand}" CommandParameter="All"
                               Content="Tümü" Padding="12,6" Margin="0,0,6,4"/>

                    <ui:Button Appearance="{Binding IsEnabledFilter, Converter={StaticResource BoolToNavAppearance}}"
                               Command="{Binding SetFilterCommand}" CommandParameter="Enabled"
                               Content="Etkin" Padding="12,6" Margin="0,0,6,4"/>

                    <ui:Button Appearance="{Binding IsDisabledFilter, Converter={StaticResource BoolToNavAppearance}}"
                               Command="{Binding SetFilterCommand}" CommandParameter="Disabled"
                               Content="Devre Dışı" Padding="12,6" Margin="0,0,6,4"/>

                    <ui:Button Appearance="{Binding IsHighImpactFilter, Converter={StaticResource BoolToNavAppearance}}"
                               Command="{Binding SetFilterCommand}" CommandParameter="HighImpact"
                               Content="Açılışı yavaşlatanlar" ToolTip="Windows'un ölçümüne göre açılışı 1 saniyeden fazla geciktirenler" Padding="12,6" Margin="0,0,6,4"/>

                    <ui:Button Appearance="{Binding IsRegistryFilter, Converter={StaticResource BoolToNavAppearance}}"
                               Command="{Binding SetFilterCommand}" CommandParameter="Registry"
                               Content="Kayıt Defteri" Padding="12,6" Margin="0,0,6,4"/>

                    <ui:Button Appearance="{Binding IsFolderFilter, Converter={StaticResource BoolToNavAppearance}}"
                               Command="{Binding SetFilterCommand}" CommandParameter="Folder"
                               Content="Başlangıç Klasörü" Padding="12,6" Margin="0,0,0,4"/>
                </WrapPanel>

                <!-- Right: Search Box -->
                <ui:TextBox Grid.Column="1" 
                            MinWidth="220" MaxWidth="320"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="Uygulama adı, yayıncı veya yol ara..." 
                            ClearButtonEnabled="True" 
                            VerticalContentAlignment="Center" 
                            Padding="12,8"
                            Icon="{ui:SymbolIcon Search24}" 
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Arama"/>
            </Grid>
        </ui:Card>

        <!-- ========================================================================= -->
        <!-- ROW 3: LİSTE VE AYRINTILI TEFTİŞ ÇEKMECESİ                                -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main Items Card -->
            <ui:Card Grid.Column="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="{StaticResource Radius.SM}" 
                            Padding="14,10" 
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Uygulama &amp; Yayıncı" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Açılış Etkisi &amp; Gecikme" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Kayıt Konumu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Durum" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="İşlemler" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized List -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding StartupPrograms}"
                              SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="48"/>
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="{StaticResource Radius.SM}" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StartupProgramItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.8*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: App Icon + Name + Publisher -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Native High-Res App Icon -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource Radius.SM}" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding IconSource}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Text -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Publisher}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Col 1: Impact Badge -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="{StaticResource Radius.SM}" 
                                                Padding="8,3" 
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ImpactText}" 
                                                       FontSize="{StaticResource Font.Caption}" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{Binding ImpactLevel, Converter={StaticResource ImpactLevelToBrush}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock Text="{Binding EstimatedDelayText}" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="2,2,0,0" TextWrapping="Wrap" MaxWidth="220"/>
                                    </StackPanel>

                                    <!-- Col 2: Location Badge -->
                                    <Border Grid.Column="2" 
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{StaticResource Radius.SM}" 
                                            Padding="8,4" 
                                            Margin="12,0,12,0" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LocationType}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- Col 3: Status Toggle -->
                                    <ui:ToggleSwitch Grid.Column="3" 
                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                     AutomationProperties.Name="{Binding Name}"
                                                     Command="{Binding DataContext.ToggleProgramStateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     IsEnabled="{Binding IsActionBusy, Converter={StaticResource InverseBool}}"
                                                     OnContent="Etkin" 
                                                     OffContent="Devre Dışı"
                                                     VerticalAlignment="Center"
                                                     Margin="12,0,12,0"/>

                                    <!-- Col 4: Action Buttons -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" 
                                                   Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="5" 
                                                   Margin="0,0,4,0"
                                                   ToolTip="Dosya Konumunu Gezginde Aç" 
                                                   Icon="{ui:SymbolIcon FolderOpen20}"/>

                                        <ui:Button Appearance="Transparent" 
                                                   Command="{Binding DataContext.CopyRegistryPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="5" 
                                                   Margin="0,0,4,0"
                                                   ToolTip="Kayıt Konumunu Kopyala" 
                                                   Icon="{ui:SymbolIcon Copy20}"/>

                                        <ui:Button Appearance="Transparent" 
                                                   Command="{Binding DataContext.DeleteProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Padding="5" 
                                                   ToolTip="Başlangıçtan Tamamen Kaldır" 
                                                   Icon="{ui:SymbolIcon Delete20}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Footer Status Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="12,6" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- ========================================================================= -->
            <!-- RIGHT SIDE MASTER-DETAIL INSPECTION DRAWER                                -->
            <!-- ========================================================================= -->
            <Border Grid.Column="1" 
                    Width="340" 
                    Margin="14,0,0,0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource Radius.MD}" 
                    Padding="16"
                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Grid DataContext="{Binding SelectedProgram}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- App Identity Card -->
                        <RowDefinition Height="Auto"/> <!-- Technical Metadata -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- 1. Drawer Header & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Başlatıcı Röntgeni" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Ayrıntılı dosya ve kayıt denetimi" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" 
                                   Appearance="Secondary" 
                                   Padding="6,4" 
                                   Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                   ToolTip="Paneli Kapat"
                                   Icon="{ui:SymbolIcon Dismiss20}"/>
                    </Grid>

                    <!-- 2. App Identity Header Card -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource Radius.MD}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding IconSource}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IconSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Publisher}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="{StaticResource Radius.XS}" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Brush.Caution.Subtle}" CornerRadius="{StaticResource Radius.XS}" Padding="6,2">
                                        <TextBlock Text="{Binding EstimatedDelayText, StringFormat='Gecikme {0}'}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Technical Metadata List -->
                    <StackPanel Grid.Row="2">
                        <!-- File Path -->
                        <TextBlock Text="Dosya Yolu / Komut" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding FilePath}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Clean Path & File Status -->
                        <TextBlock Text="Hedef Çalıştırılabilir (.exe)" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CleanExePath}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Dosya Durumu: " FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="Disk üzerinde mevcut" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding FileExists, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Dosya bulunamadı (Bozuk kayıt)" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding FileExists, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Registry / Folder Location -->
                        <TextBlock Text="Kayıt Konumu" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock Text="{Binding RegistryPath}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 4. Action Buttons -->
                    <StackPanel Grid.Row="4">
                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Dosya Konumunu Aç" 
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Padding="12,8" 
                                   Margin="0,0,0,6"/>

                        <ui:Button Appearance="Secondary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.CopyRegistryPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Kayıt Yolunu Kopyala" 
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Padding="12,8" 
                                   Margin="0,0,0,6"/>

                        <ui:Button Appearance="Danger" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.DeleteProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="Başlangıçtan Tamamen Kaldır" 
