<UserControl x:Class="Bakım.Views.Modules.NetworkMonitorModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NetworkMonitorViewModel}"
             d:DesignHeight="850" d:DesignWidth="1150">
    <UserControl.Resources>
        <Style x:Key="PortCategoryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="LISTENING">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Global Actions -->
            <RowDefinition Height="Auto"/> <!-- 4 Quick Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- 5-Tab Segmented Switcher -->
            <RowDefinition Height="*"/>    <!-- Tab Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,16"
                         Title="Ağ İzleyici"
                         Description="Etkin bağlantılar, dinleyen portlar, ağ bağdaştırıcıları ve hız testi.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-Refresh Toggle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Canlı izleme:"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ui:ToggleSwitch IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" 
                                         AutomationProperties.Name="Otomatik yenilemeyi aç veya kapat" 
                                         VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Global Refresh Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Padding="14,8"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 2. Metric Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Connections -->
            <ui:Card Grid.Column="0" Padding="16,12" Style="{StaticResource InteractiveCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam bağlantı" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.TotalConnections}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Primary.Subtle}" CornerRadius="{StaticResource Radius.MD}" Width="40" Height="40" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Card 2: Established -->
            <ui:Card Grid.Column="2" Padding="16,12" Style="{StaticResource InteractiveCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Aktif iletişim" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.EstablishedCount}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="{StaticResource Radius.MD}" Width="40" Height="40" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Card 3: Listening Ports -->
            <ui:Card Grid.Column="4" Padding="16,12" Style="{StaticResource InteractiveCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dinlenen portlar" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.ListeningCount}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="{StaticResource Radius.MD}" Width="40" Height="40" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Laptop24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Card 4: Bandwidth Speed -->
            <ui:Card Grid.Column="6" Padding="16,12" Style="{StaticResource InteractiveCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Ağ hızı (indirme / yükleme)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.FormattedDownloadSpeed, StringFormat='↓ {0}'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding Stats.FormattedUploadSpeed, StringFormat='  ↑ {0}'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Primary.Subtle}" CornerRadius="{StaticResource Radius.MD}" Width="40" Height="40" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 3. Modern Segmented Tab Switcher (Windows 11 Fluent Pill Container) -->
        <Border Grid.Row="2" 
                Style="{StaticResource FluentSegmentedContainer}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tab 1: Active Connections -->
                <ui:Button Grid.Column="0" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsConnectionsTab}"
                           Command="{Binding SetTabCommand}" 
                           CommandParameter="Connections" 
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Globe20" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Canlı bağlantılar" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <!-- Tab 2: Listening Ports -->
                <ui:Button Grid.Column="1" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsListeningTab}"
                           Command="{Binding SetTabCommand}" 
                           CommandParameter="Listening" 
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Laptop20" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Dinlenen portlar" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <!-- Tab 3: Adapters -->
                <ui:Button Grid.Column="2" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsAdaptersTab}"
                           Command="{Binding SetTabCommand}" 
                           CommandParameter="Adapters" 
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="DeveloperBoard20" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Ağ adaptörleri ve IP" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <!-- Tab 4: Speed Test -->
                <ui:Button Grid.Column="3" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsSpeedTestTab}"
                           Command="{Binding SetTabCommand}" 
                           CommandParameter="SpeedTest" 
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload20" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Hız testi" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <!-- Tab 5: Diagnostics Tools -->
                <ui:Button Grid.Column="4" Style="{StaticResource Tab.Item}" helpers:NavSelection.IsSelected="{Binding IsDiagnosticsTab}"
                           Command="{Binding SetTabCommand}" 
                           CommandParameter="Diagnostics">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wrench20" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Ağ teşhis araçları" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <!-- 4. Content Area (Tab Dependent) -->
        <Grid Grid.Row="3">

            <!-- ========================================================================= -->
            <!-- TAB 1: CANLI BAĞLANTILAR & MASTER-DETAIL DRAWER                           -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Connections}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Filters -->
                    <RowDefinition Height="*"/>    <!-- Split View (Table + Detail Drawer) -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
                </Grid.RowDefinitions>

                <!-- Search & Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" 
                                PlaceholderText="Süreç adı, PID, IP, Port veya Servis ile canlı ara..." 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ClearButtonEnabled="True" 
                                Padding="12,9" 
                                Margin="0,0,10,0" 
                                Icon="{ui:SymbolIcon Search20}"
                                VerticalContentAlignment="Center"/>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="{Binding IsAllFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Tümü" Command="{Binding SetFilterCommand}" CommandParameter="All" Padding="12,7" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding IsTcpFilter, Converter={StaticResource BoolToNavAppearance}}" Content="TCP" Command="{Binding SetFilterCommand}" CommandParameter="TCP" Padding="12,7" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding IsUdpFilter, Converter={StaticResource BoolToNavAppearance}}" Content="UDP" Command="{Binding SetFilterCommand}" CommandParameter="UDP" Padding="12,7" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding IsExternalFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Dış bağlantılar" Command="{Binding SetFilterCommand}" CommandParameter="External" Padding="12,7" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding IsListeningFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Dinleme" Command="{Binding SetFilterCommand}" CommandParameter="Listening" Padding="12,7" Margin="0,0,6,4"/>
                        <ui:Button Appearance="{Binding IsSuspiciousFilter, Converter={StaticResource BoolToNavAppearance}}" Content="Şüpheli / riskli" Command="{Binding SetFilterCommand}" CommandParameter="Suspicious" Padding="12,7" Margin="0,0,0,4"/>
                    </WrapPanel>
                </Grid>

                <!-- Split Grid: Column 0 = Connections List, Column 1 = Inspection Drawer -->
                <Grid Grid.Row="1" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Connections List Card -->
                    <Border Grid.Column="0" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="{StaticResource Radius.MD}" 
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="*"/>    <!-- Virtualized ListView -->
                            </Grid.RowDefinitions>

                            <!-- Column Headers -->
                            <Border Grid.Row="0" Style="{StaticResource Table.HeaderRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*" MinWidth="150"/> <!-- Process & PID -->
                                        <ColumnDefinition Width="Auto" MinWidth="85"/>   <!-- Protokol / Durum -->
                                        <ColumnDefinition Width="1.6*" MinWidth="165"/> <!-- Yerel Soket (Kırpılma Engelli) -->
                                        <ColumnDefinition Width="2.0*" MinWidth="190"/> <!-- Uzak Hedef & Servis -->
                                        <ColumnDefinition Width="Auto" MinWidth="130"/> <!-- Güvenlik Analizi -->
                                        <ColumnDefinition Width="Auto" MinWidth="100"/> <!-- İşlemler -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Süreç adı ve PID" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Protokol / durum" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="Yerel soket" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="Uzak hedef ve servis" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,12,0"/>
                                    <TextBlock Grid.Column="4" Text="Güvenlik analizi" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="5" Text="İşlemler" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Virtualized Connections ListView -->
                            <ListView Grid.Row="1" 
                                      ItemsSource="{Binding FilteredConnections}"
                                      SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="MinHeight" Value="46"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ItemBorder" 
                                                            Background="Transparent" 
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                            BorderThickness="0,0,0,1" 
                                                            Padding="16,8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:NetworkConnectionItem}">
                                        <Grid>
                                            <!-- Context Menu -->
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="IP / host adresini kopyala" 
                                                              Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding RemoteAddress}"/>
                                                    <MenuItem Header="Güvenlik Duvarı ile Engelle" 
                                                              Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Süreci sonlandır (Kill)" 
                                                              Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Dosya konumunu aç" 
                                                              Command="{Binding DataContext.OpenProcessLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*" MinWidth="150"/> <!-- Process & PID -->
                                                <ColumnDefinition Width="Auto" MinWidth="85"/>   <!-- Protokol / Durum -->
                                                <ColumnDefinition Width="1.6*" MinWidth="165"/> <!-- Yerel Soket (Kırpılma Engelli) -->
                                                <ColumnDefinition Width="2.0*" MinWidth="190"/> <!-- Uzak Hedef & Servis -->
                                                <ColumnDefinition Width="Auto" MinWidth="130"/> <!-- Güvenlik Analizi -->
                                                <ColumnDefinition Width="Auto" MinWidth="100"/> <!-- İşlemler -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: Process Name & PID -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Col 1: Protocol & State -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding Protocol}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding State}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Col 2: Local Endpoint (Asla Kırpılmaz) -->
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding LocalEndpoint}" 
                                                       FontSize="{StaticResource Font.Caption}" 
                                                       FontFamily="Consolas" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Col 3: Remote Endpoint & Service Name -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding RemoteEndpoint}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RemoteHostName, TargetNullValue=''}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{Binding IsExternal, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- Col 4: Security Threat Badge -->
                                            <Border Grid.Column="4" 
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="{StaticResource Radius.SM}" 
                                                    Padding="8,4" 
                                                    Margin="0,0,12,0" 
                                                    VerticalAlignment="Center" 
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding PortCategory}" Style="{StaticResource PortCategoryTextStyle}" TextTrimming="CharacterEllipsis"/>
                                            </Border>

                                            <!-- Col 5: Quick Action Buttons (Modern Subtle Icon Buttons) -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:Button Appearance="Transparent" Padding="5" Margin="0,0,2,0" ToolTip="Güvenlik Duvarı ile Engelle" Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ShieldKeyhole20}"/>
                                                <ui:Button Appearance="Transparent" Padding="5" Margin="0,0,2,0" ToolTip="Süreci ve Soketi Sonlandır" Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Dismiss20}"/>
                                                <ui:Button Appearance="Transparent" Padding="5" ToolTip="Dosya konumunu aç" Command="{Binding DataContext.OpenProcessLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon FolderOpen20}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right Side Master-Detail Inspection Drawer (Röntgen Paneli) -->
                    <Border Grid.Column="1" 
                            Width="360" 
                            Margin="14,0,0,0" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="{StaticResource Radius.MD}" 
                            Padding="16"
                            Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <!-- Empty State if no item selected -->
                            <StackPanel VerticalAlignment="Center" 
                                        HorizontalAlignment="Center" 
                                        Margin="16"
                                        Visibility="{Binding SelectedConnection, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <Border Background="{DynamicResource Brush.Accent.Subtle}" 
                                        Width="56" Height="56" 
                                        CornerRadius="28" 
                                        HorizontalAlignment="Center" 
                                        Margin="0,0,0,14">
                                    <ui:SymbolIcon Symbol="Shield24" FontSize="28" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Ayrıntılar" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Soldaki listeden bir bağlantıya tıklayarak süreç kimliği, soket, ters DNS ve güvenlik analizini inceleyebilirsiniz." 
                                           FontSize="{StaticResource Font.Caption}" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center" 
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Rich Process & Socket Inspection Details -->
                            <Grid DataContext="{Binding SelectedConnection}"
                                  Visibility="{Binding DataContext.SelectedConnection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header & Close -->
                                    <RowDefinition Height="Auto"/> <!-- Process Info -->
                                    <RowDefinition Height="Auto"/> <!-- Socket Details -->
                                    <RowDefinition Height="Auto"/> <!-- Threat Assessment -->
                                    <RowDefinition Height="*"/>    <!-- Spacer / Notes -->
                                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                </Grid.RowDefinitions>

                                <!-- Drawer Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bağlantı ayrıntıları" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Ayrıntılı soket ve güvenlik denetimi" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" 
                                               Appearance="Secondary" 
                                               Padding="6,4" 
                                               Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                               ToolTip="Ayrıntıları kapat"
                                               Icon="{ui:SymbolIcon Dismiss20}"/>
                                </Grid>

                                <!-- Process Overview -->
                                <ui:Card Grid.Row="1" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProcessName}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,4"/>
                                        
                                        <TextBlock Text="Yayımcı / imza:" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Publisher}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="Yürütülebilir dosya:" FontSize="{StaticResource Font.Micro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding ProcessPath}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" ToolTip="{Binding ProcessPath}"/>
                                    </StackPanel>
                                </ui:Card>

                                <!-- Socket Endpoints -->
                                <ui:Card Grid.Row="2" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Soket ve protokol detayları" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Protokol / durum:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Protocol, StringFormat='{}{0}'}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Yerel uç nokta:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding LocalEndpoint}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Uzak hedef:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding RemoteEndpoint}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Tanımlı servis:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ServiceDescription}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Ters DNS çözümü:" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding RemoteHostName}" HorizontalAlignment="Right" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <!-- Threat Assessment -->
                                <Border Grid.Row="3" 
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="{StaticResource Radius.SM}" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <ui:SymbolIcon Symbol="Shield20" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding PortCategory}" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ThreatDescription}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Row="5">
                                    <ui:Button Appearance="Secondary" 
                                               HorizontalAlignment="Stretch" 
                                               Padding="12,8" 
                                               Margin="0,0,0,6"
                                               Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Content="Güvenlik Duvarı ile Engelle" 
                                               Icon="{ui:SymbolIcon ShieldKeyhole20}"/>

                                    <ui:Button Appearance="Secondary" 
                                               HorizontalAlignment="Stretch" 
                                               Padding="12,8" 
                                               Margin="0,0,0,6"
                                               Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Content="Süreci ve Soketi Sonlandır" 
                                               Icon="{ui:SymbolIcon Dismiss20}"/>

                                    <ui:Button Appearance="Secondary" 
                                               HorizontalAlignment="Stretch" 
                                               Padding="12,8" 
                                               Margin="0,0,0,6"
                                               Command="{Binding DataContext.AnalyzeProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Content="Analizör ile Tara" 
                                               Icon="{ui:SymbolIcon ShieldTask20}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0" 
                                                   Appearance="Secondary" 
                                                   HorizontalAlignment="Stretch" 
                                                   Padding="8,6" 
                                                   Command="{Binding DataContext.OpenProcessLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Konum" 
                                                   Icon="{ui:SymbolIcon FolderOpen20}"/>

                                        <ui:Button Grid.Column="2" 
                                                   Appearance="Secondary" 
                                                   HorizontalAlignment="Stretch" 
                                                   Padding="8,6" 
                                                   Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding RemoteAddress}"
                                                   Content="IP kopyala" 
                                                   Icon="{ui:SymbolIcon Copy20}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Status Bar -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="{StaticResource Radius.MD}" 
                        Padding="14,8" 
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                   Text="İpucu: Bir satıra tıkladığınızda sağda ayrıntılar ve güvenlik paneli açılır." 
                                   FontSize="{StaticResource Font.Caption}" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- TAB 2: DİNLENEN PORTLAR & SERVİSLER                                      -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Listening}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Controls -->
                    <RowDefinition Height="*"/>    <!-- Listening Ports Table -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" 
                                PlaceholderText="Dinlenen port numarası, servis adı veya süreç ile filtrele..." 
                                Text="{Binding ListeningSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                ClearButtonEnabled="True" 
                                Padding="12,9" 
                                Margin="0,0,10,0" 
                                Icon="{ui:SymbolIcon Search20}" 
                                VerticalContentAlignment="Center"/>

                    <ui:Button Grid.Column="1" 
                               Appearance="Secondary" 
                               Command="{Binding RefreshCommand}" 
                               Padding="14,8" 
                               Content="Portları tara" 
                               Icon="{ui:SymbolIcon ArrowClockwise20}"/>
                </Grid>

                <Border Grid.Row="1" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="{StaticResource Radius.MD}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Headers -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="0,0,0,1" 
                                CornerRadius="8,8,0,0" 
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/> <!-- Port & Protocol -->
                                    <ColumnDefinition Width="2.2*"/> <!-- Service & Description -->
                                    <ColumnDefinition Width="2*"/>   <!-- Process Name & PID -->
                                    <ColumnDefinition Width="2*"/>   <!-- Local Binding Address -->
                                    <ColumnDefinition Width="1.8*"/> <!-- Security Exposure Status -->
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Port ve protokol" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Tanımlı servis" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="İlişkili süreç ve PID" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="Dinleme soketi" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="Erişim durumu" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <!-- ListView -->
                        <ListView Grid.Row="1" 
                                  ItemsSource="{Binding FilteredListeningPorts}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="44"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ListeningPortItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: Port & Protocol -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Port}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Protocol, StringFormat='({0})'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Col 1: Service Name -->
                                        <TextBlock Grid.Column="1" Text="{Binding ServiceName}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Col 2: Process Name & PID -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Col 3: Local Address -->
                                        <TextBlock Grid.Column="3" Text="{Binding LocalAddress}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                        <!-- Col 4: Exposure Badge -->
                                        <Border Grid.Column="4" 
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="{StaticResource Radius.SM}" 
                                                Padding="8,3" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ExposureText}" FontSize="{StaticResource Font.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- TAB 3: AĞ ADAPTÖRLERİ & IP DONANIM BİLGİSİ                               -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Adapters}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Sistemdeki Aktif Ağ Arayüzleri ve IP Yapılandırması" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding FlushDnsFromAdaptersCommand}" 
                                   Content="DNS sıfırla" 
                                   Icon="{ui:SymbolIcon Broom20}" 
                                   Padding="12,8" 
                                   Margin="0,0,8,0"
                                   ToolTip="DNS önbelleğini temizle"/>
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding RenewIpFromAdaptersCommand}" 
                                   Content="IP yenile" 
                                   Icon="{ui:SymbolIcon ArrowClockwise20}" 
                                   Padding="12,8" 
                                   Margin="0,0,8,0"
                                   ToolTip="DHCP Kira Süresini ve IP Adresini Yenile (ipconfig /renew)"/>
                        <ui:Button Appearance="Secondary" 
                                   Command="{Binding RefreshCommand}" 
                                   Content="Yenile" 
                                   Icon="{ui:SymbolIcon ArrowSync20}" 
                                   Padding="12,8"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NetworkAdapterItem}">
                                <ui:Card Padding="18" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row -->
                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.Column="0" Symbol="DeveloperBoard24" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.XS}" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeName}" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Details Grid -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Box 1: IP & Subnet -->
                                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="IPv4 ve alt ağ" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding Ipv4Address}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,2"/>
                                                    <TextBlock Text="{Binding SubnetMask, StringFormat='Mask: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Box 2: Gateway & DNS -->
                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Ağ geçidi ve DNS" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding Gateway, StringFormat='Ağ Geçidi: {0}'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,2"/>
                                                    <TextBlock Text="{Binding DnsServers, StringFormat='DNS: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Box 3: Speed & Transferred Data -->
                                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Donanım hızı ve MAC" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding SpeedText}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,2"/>
                                                    <TextBlock Text="{Binding MacAddress, StringFormat='MAC: {0}'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================================= -->
            <!-- TAB 4: 1000 MBPS GİGABİT HIZ TESTİ                                       -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=SpeedTest}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Metered Connection Warning Banner -->
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.MD}"
                                Padding="16,12"
                                Margin="0,0,0,16"
                                Visibility="{Binding IsMeteredConnection, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tarifeli / kotalı ağ bağlantısı algılandı" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Mevcut ağ bağlantınız tarifeli / kotalı olarak belirlenmiş. Hız testi ~50-100 MB veri transferi gerçekleştirecektir. Test başlatılırken onayınız istenecektir." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Speed Gauge Card -->
                        <ui:Card Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title & Intro -->
                                    <RowDefinition Height="Auto"/> <!-- Big Speed Display -->
                                    <RowDefinition Height="Auto"/> <!-- Progress Bar -->
                                    <RowDefinition Height="Auto"/> <!-- 4-KPI Metric Badges -->
                                    <RowDefinition Height="Auto"/> <!-- Actions -->
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Hız testi" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Yüksek hızlı fiber bağlantılar için optimize edilmiş, kesintisiz 6 saniyelik çoklu akış (multi-stream) indirme motoru." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Big Speed Display -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,20">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentSpeedMbps, StringFormat='{}{0:F1}'}" FontSize="64" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Mbps" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SpeedTestStatus}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Progress Bar -->
                                <Grid Grid.Row="2" Margin="40,0,40,24">
                                    <ProgressBar Value="{Binding SpeedProgressPercent}" Maximum="100" Height="8"/>
                                </Grid>

                                <!-- 4-KPI Metric Badges -->
                                <Grid Grid.Row="3" Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- KPI 1: Ping -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Gecikme (Ping)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding SpeedPingMs, StringFormat='{}{0:F1} ms'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI 2: Jitter -->
                                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Jitter (Dalgalanma)" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding SpeedJitterMs, StringFormat='{}{0:F1} ms'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI 3: Peak Speed -->
                                    <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Tepe (Peak) hız" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding PeakSpeedMbps, StringFormat='{}{0:F1} Mbps'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI 4: Downloaded Data -->
                                    <Border Grid.Column="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource Radius.MD}" Padding="14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="İndirilen veri" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadedMb, StringFormat='{}{0:F1} MB'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:Button Appearance="Primary" 
                                               Padding="24,12" 
                                               Margin="0,0,12,0" 
                                               Command="{Binding StartSpeedTestCommand}" 
                                               IsEnabled="{Binding IsSpeedTestRunning, Converter={StaticResource InverseBool}}"
                                               Content="Hız testini başlat" 
                                               Icon="{ui:SymbolIcon Play24}"/>

                                    <ui:Button Appearance="Secondary" 
                                               Padding="20,12" 
                                               Command="{Binding CancelSpeedTestCommand}" 
                                               IsEnabled="{Binding IsSpeedTestRunning}"
                                               Content="İptal et" 
                                               Icon="{ui:SymbolIcon Dismiss24}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- Informative Card -->
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Hız testi nasıl çalışır?" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Bu test, 1000 Mbps fiber hatlarda küçük dosya hatalarını önlemek için 3 paralel bağlantı üzerinden dinamik 100 MB veri blokları indirir. 6 saniye boyunca hat sonuna kadar yüklenir ve gerçek bant genişliği kayan pencere algoritmasıyla ölçülür." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================================= -->
            <!-- TAB 5: AĞ TEŞHİS ARAÇLARI (Ping, Flush DNS, Port Check)                  -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Diagnostics}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tool 1: Canlı Ping Testi -->
                        <ui:Card Grid.Row="0" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Canlı ping ve gecikme testi" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Herhangi bir IP veya web adresine ICMP ping paketi göndererek gidiş-dönüş süresini (RTT) test edin." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0" 
                                                PlaceholderText="Hedef IP veya Alan Adı (Örn: 8.8.8.8 veya google.com)" 
                                                Text="{Binding PingTarget, UpdateSourceTrigger=PropertyChanged}" 
                                                ClearButtonEnabled="True" 
                                                Padding="12,9" 
                                                VerticalContentAlignment="Center" 
                                                Icon="{ui:SymbolIcon Globe20}"/>

                                    <ui:Button Grid.Column="2" 
                                               Appearance="Secondary" 
                                               Command="{Binding RunPingCommand}" 
                                               Padding="16,8" 
                                               Content="Ping gönder" 
                                               Icon="{ui:SymbolIcon Play20}"/>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                    <TextBlock Text="{Binding PingResult}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </ui:Card>

                        <!-- Tool 2: Flush DNS -->
                        <ui:Card Grid.Row="2" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="DNS önbelleğini temizle" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Bozuk veya eski DNS kayıtlarını sıfırlayarak internet bağlantı ve erişim problemlerini çözer." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>
                                    <TextBlock Text="{Binding FlushDnsStatus}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <ui:Button Grid.Column="1" 
                                           Appearance="Secondary" 
                                           Command="{Binding FlushDnsCommand}" 
                                           Padding="16,10" 
                                           VerticalAlignment="Center" 
                                           Content="DNS'i temizle" 
                                           Icon="{ui:SymbolIcon ArrowClockwise20}"/>
                            </Grid>
                        </ui:Card>

                        <!-- Tool 3: Port Connectivity Check -->
                        <ui:Card Grid.Row="4" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Port erişilebilirlik testi (Port Connectivity Checker)" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Hedef sunucu ve portun açık, filtrelenmiş veya erişilebilir olup olmadığını TCP bağlantısıyla test edin." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0" 
                                                PlaceholderText="Hedef Host / IP (Örn: google.com)" 
                                                Text="{Binding PortCheckHost, UpdateSourceTrigger=PropertyChanged}" 
                                                ClearButtonEnabled="True" 
                                                Padding="12,9" 
                                                VerticalContentAlignment="Center" 
                                                Icon="{ui:SymbolIcon Globe20}"/>

                                    <ui:TextBox Grid.Column="2" 
                                                PlaceholderText="Port (Örn: 443)" 
                                                Text="{Binding PortCheckPort, UpdateSourceTrigger=PropertyChanged}" 
                                                ClearButtonEnabled="True" 
                                                Padding="12,9" 
                                                VerticalContentAlignment="Center" 
                                                Icon="{ui:SymbolIcon NumberSymbol20}"/>

                                    <ui:Button Grid.Column="4" 
                                               Appearance="Secondary" 
                                               Command="{Binding CheckPortCommand}" 
                                               Padding="16,8" 
                                               Content="Portu test et" 
                                               Icon="{ui:SymbolIcon Checkmark20}"/>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                    <TextBlock Text="{Binding PortCheckResultText}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </ui:Card>

                        <!-- Tool 4: Traceroute (Rota İzleme) -->
                        <ui:Card Grid.Row="6" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Gelişmiş ağ rota izleme (Traceroute)" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Veri paketlerinin hedefe ulaşana kadar geçtiği tüm ağ yönlendiricilerini (hop), gecikme sürelerini ve ters DNS kayıtlarını adım adım analiz edin." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0" 
                                                PlaceholderText="Hedef IP veya Alan Adı (Örn: 1.1.1.1 veya google.com)" 
                                                Text="{Binding TracerouteTarget, UpdateSourceTrigger=PropertyChanged}" 
                                                ClearButtonEnabled="True" 
                                                Padding="12,9" 
                                                VerticalContentAlignment="Center" 
                                                Icon="{ui:SymbolIcon Globe20}"/>

                                    <ui:Button Grid.Column="2" 
                                               Appearance="Secondary" 
                                               Command="{Binding RunTracerouteCommand}" 
                                               IsEnabled="{Binding IsTracerouteRunning, Converter={StaticResource InverseBool}}"
                                               Padding="16,8" 
                                               Content="İzlemeyi başlat" 
                                               Icon="{ui:SymbolIcon Play20}"/>

                                    <ui:Button Grid.Column="4" 
                                               Appearance="Secondary" 
                                               Command="{Binding CancelTracerouteCommand}" 
                                               IsEnabled="{Binding IsTracerouteRunning}"
                                               Padding="14,8" 
                                               Content="Durdur" 
                                               Icon="{ui:SymbolIcon Dismiss20}"/>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TracerouteStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding TracerouteHops}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding HopNumber, StringFormat='{}{0}.'}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding RoundtripTimeMs, StringFormat='{}{0} ms'}" FontFamily="Consolas" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Hostname}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ui:Card>

                        <!-- Tool 5: DNS Benchmark (Hız Karşılaştırma) -->
                        <ui:Card Grid.Row="8" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DNS sunucu yanıt süresi ve benchmark" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Dünyanın önde gelen DNS sağlayıcılarını (Cloudflare, Google, Quad9, AdGuard vb.) sorgulayarak en düşük gecikmeli sunucuyu tespit edin." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" 
                                               Appearance="Secondary" 
                                               Command="{Binding RunDnsBenchmarkCommand}" 
                                               IsEnabled="{Binding IsDnsBenchmarking, Converter={StaticResource InverseBool}}"
                                               Padding="16,8" 
                                               Content="Karşılaştırmayı başlat" 
                                               Icon="{ui:SymbolIcon Play20}"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding DnsBenchmarkStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" FontWeight="SemiBold"/>

                                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                    <ItemsControl ItemsSource="{Binding DnsBenchmarkResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12,8" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Provider}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding PrimaryIp}" FontSize="{StaticResource Font.Caption}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayLatency}" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <Border Grid.Column="3" 
                                                                Background="{DynamicResource SystemFillColorSuccessBrush}" 
                                                                CornerRadius="{StaticResource Radius.SM}" 
                                                                Padding="8,4" 
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="En hızlı" FontSize="{StaticResource Font.Micro}" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </ui:Card>

                        <!-- Tool 6: Bakım Güvenlik Duvarı Kuralları -->
                        <ui:Card Grid.Row="10" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bakım tarafından eklenen Güvenlik Duvarı kuralları" FontSize="{StaticResource Font.BodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Bakım üzerinden engellenen programların güvenlik duvarı kurallarını inceleyin ve dilediğiniz engeli tek tıkla kaldırın." FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" 
                                               Appearance="Secondary" 
                                               Command="{Binding LoadBakimFirewallRulesCommand}" 
                                               Padding="14,8" 
                                               Content="Kuralları yenile" 
                                               Icon="{ui:SymbolIcon ArrowClockwise20}"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding FirewallRulesStatusText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12">
                                    <ItemsControl ItemsSource="{Binding BakimFirewallRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="12,8" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="ShieldDismiss20" FontSize="20" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="2" 
                                                                   Appearance="Secondary" 
                                                                   Padding="10,6" 
                                                                   Command="{Binding DataContext.RemoveBakimFirewallRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Content="Engeli kaldır" 
                                                                   Icon="{ui:SymbolIcon Dismiss20}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
