<UserControl x:Class="Bakım.Views.Modules.NetworkMonitorModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             xmlns:local="clr-namespace:Bakım.Views.Modules"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NetworkMonitorViewModel}"
             d:DesignHeight="850" d:DesignWidth="1150">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Global Actions -->
            <RowDefinition Height="Auto"/> <!-- 4 Quick Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- 5-Tab Segmented Switcher -->
            <RowDefinition Height="*"/>    <!-- Tab Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,12"
                         Title="Ağ İzleyici"
                         Description="Etkin bağlantılar, dinleyen portlar, ağ bağdaştırıcıları ve hız testi.">
            <c:SectionHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch Content="Otomatik yenile"
                                     IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"/>

                    <!-- Global Refresh Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Content="Yenile"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>


        <!-- 2. Özet şeridi -->
        <c:SummaryStrip Grid.Row="1">
            <c:StatCard Icon="Globe24" Label="Bağlantı" Value="{Binding Stats.TotalConnections}" Caption="Toplam TCP/UDP"/>
            <c:StatCard Icon="PlugConnected24" Label="Kurulu" Value="{Binding Stats.EstablishedCount}" Caption="Veri alışverişi yapan"/>
            <c:StatCard Icon="Laptop24" Label="Dinleyen port" Value="{Binding Stats.ListeningCount}" Caption="Gelen bağlantı bekleyen"/>
            <c:StatCard Icon="ArrowSync24" Label="Anlık hız" Value="{Binding Stats.FormattedDownloadSpeed}"
                        Caption="{Binding Stats.FormattedUploadSpeed, StringFormat='Yükleme {0}'}"/>
        </c:SummaryStrip>

        <!-- 3. Sekmeler (Fluent SelectorBar) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{StaticResource Gap.Bottom.MD}">
            <ui:Button Style="{StaticResource Tab.Item}" Content="Bağlantılar"
                       helpers:NavSelection.IsSelected="{Binding IsConnectionsTab}"
                       Command="{Binding SetTabCommand}" CommandParameter="Connections"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Dinleyen portlar"
                       helpers:NavSelection.IsSelected="{Binding IsListeningTab}"
                       Command="{Binding SetTabCommand}" CommandParameter="Listening"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Bağdaştırıcılar"
                       helpers:NavSelection.IsSelected="{Binding IsAdaptersTab}"
                       Command="{Binding SetTabCommand}" CommandParameter="Adapters"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Hız testi"
                       helpers:NavSelection.IsSelected="{Binding IsSpeedTestTab}"
                       Command="{Binding SetTabCommand}" CommandParameter="SpeedTest"/>
            <ui:Button Style="{StaticResource Tab.Item}" Content="Tanılama"
                       helpers:NavSelection.IsSelected="{Binding IsDiagnosticsTab}"
                       Command="{Binding SetTabCommand}" CommandParameter="Diagnostics"/>
        </StackPanel>

        <!-- 4. Etkin sekme -->
        <Grid Grid.Row="3">
            <local:NetworkConnectionsPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Connections}"/>
            <local:NetworkListeningPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Listening}"/>
            <local:NetworkAdaptersPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Adapters}"/>
            <local:NetworkSpeedTestPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=SpeedTest}"/>
            <local:NetworkDiagnosticsPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringToVis}, ConverterParameter=Diagnostics}"/>
        </Grid>
    </Grid>
</UserControl>
