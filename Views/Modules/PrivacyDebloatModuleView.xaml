<UserControl x:Class="Bakım.Views.Modules.PrivacyDebloatModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PrivacyDebloatViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Metric KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- 1: Action Toolbar & Segmented Switcher -->
            <RowDefinition Height="Auto"/> <!-- 2: Category Filter Chips & Info -->
            <RowDefinition Height="*"/>    <!-- 3: Active Content (Privacy Tweaks or Bloatware List) -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Metric Overview Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Privacy Score -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Gizlilik Koruma Skoru" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{Binding Stats.ProtectionPercentage}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Card 2: Active Tweaks -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Aktif Koruma Kuralı" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.ActiveTweaksCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text=" / " FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Stats.TotalTweaksCount}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="CheckmarkCircle24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Card 3: Recommended Tweaks Active -->
            <Border Grid.Column="4" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Önerilen Korumalar" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.RecommendedActiveCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Star24" FontSize="22" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Card 4: Installed Bloatware -->
            <Border Grid.Column="6" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Yüklü Bloatware" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.InstalledBloatwareCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Apps24" FontSize="22" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 1. Action Toolbar & Segmented Switcher -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Segmented Sub-Tab Switcher (Left) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="{Binding IsPrivacyTab, Converter={StaticResource BoolToNavAppearance}}"
                               Content="Gizlilik &amp; Telemetri"
                               Icon="{ui:SymbolIcon ShieldCheckmark20}"
                               Command="{Binding SwitchSubTabCommand}"
                               CommandParameter="Privacy"
                               Padding="14,6"
                               Margin="0,0,4,0"/>
                    <ui:Button Appearance="{Binding IsDebloatTab, Converter={StaticResource BoolToNavAppearance}}"
                               Content="Bloatware Kaldırıcı"
                               Icon="{ui:SymbolIcon Delete20}"
                               Command="{Binding SwitchSubTabCommand}"
                               CommandParameter="Debloat"
                               Padding="14,6"/>
                </StackPanel>
            </Border>

            <!-- Search Input Box (Center-Right) -->
            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Gizlilik kuralı veya uygulama ara..." 
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        VerticalContentAlignment="Center"
                        Padding="10,6"
                        Margin="12,0,12,0"
                        HorizontalAlignment="Right"
                        MinWidth="240"
                        MaxWidth="340" AutomationProperties.Name="Gizlilik kuralı veya uygulama ara..."/>

            <!-- Action Buttons (Right) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Privacy Tab Actions -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPrivacyTab, Converter={StaticResource BoolToVis}}">
                    <ui:Button Appearance="Primary"
                               Command="{Binding ApplyRecommendedCommand}"
                               Padding="12,6"
                               Margin="0,0,6,0"
                               Content="Önerilenleri Koru"
                               Icon="{ui:SymbolIcon ShieldCheckmark20}"/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding CreateRestorePointCommand}"
                               Padding="10,6"
                               Margin="0,0,6,0"
                               Content="Geri Yükleme Noktası"
                               Icon="{ui:SymbolIcon History20}"/>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding RestoreDefaultsCommand}"
                               Padding="10,6"
                               Margin="0,0,6,0"
                               Content="Varsayılanlara Dön"
                               Icon="{ui:SymbolIcon ArrowCounterclockwise20}"/>
                </StackPanel>

                <!-- Debloat Tab Actions -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDebloatTab, Converter={StaticResource BoolToVis}}">
                    <ui:Button Appearance="Danger"
                               Command="{Binding RemoveAllSafeBloatwareCommand}"
                               Padding="12,6"
                               Margin="0,0,6,0"
                               Content="Tüm Güvenli Bloatware'leri Kaldır"
                               Icon="{ui:SymbolIcon Delete20}"/>
                </StackPanel>

                <!-- Common Refresh Action -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding RefreshAllCommand}"
                           Padding="10,6"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowClockwise20}"/>
            </StackPanel>
        </Grid>

        <!-- 2. Category Filter Chips & Info -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <!-- Privacy Filter Chips -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"
                       Visibility="{Binding IsPrivacyTab, Converter={StaticResource BoolToVis}}">
                <ui:Button Appearance="{Binding IsFilterAll, Converter={StaticResource BoolToNavAppearance}}"
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="All"
                           Padding="12,5" 
                           Margin="0,0,6,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AppsList20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tümü" FontSize="12" VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="5,1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.TotalTweaksCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="{Binding IsFilterTelemetry, Converter={StaticResource BoolToNavAppearance}}"
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="Telemetri &amp; Tanılama"
                           Padding="12,5" 
                           Margin="0,0,6,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Telemetri &amp; Tanılama" FontSize="12" VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="5,1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TelemetryCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="{Binding IsFilterAds, Converter={StaticResource BoolToNavAppearance}}"
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="Reklamlar &amp; Öneriler"
                           Padding="12,5" 
                           Margin="0,0,6,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Megaphone20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Reklamlar &amp; Öneriler" FontSize="12" VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="5,1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AdsCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="{Binding IsFilterLocation, Converter={StaticResource BoolToNavAppearance}}"
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="Konum &amp; İzinler"
                           Padding="12,5" 
                           Margin="0,0,6,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Location20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Konum &amp; İzinler" FontSize="12" VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="5,1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocationCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ui:Button>
            </WrapPanel>

            <!-- Bloatware Notice for Debloat Tab -->
            <Border Visibility="{Binding IsDebloatTab, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed20" FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" 
                               Text="Hesap Makinesi, Windows Mağazası gibi temel sistem bileşenleri sistem kararlılığı için kilitlidir ve silinemez. Gereksiz OEM ve reklam uygulamalarını güvenle kaldırabilirsiniz." 
                               FontSize="11.5" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Active Content Area -->
        <Grid Grid.Row="3">
            <!-- View 1: Privacy Tweaks List (Solid Border Cards with Separator Lines) -->
            <ListView ItemsSource="{Binding FilteredTweaks}"
                      Visibility="{Binding IsPrivacyTab, Converter={StaticResource BoolToVis}}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PrivacyTweakItem}">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Main Header & Details -->
                                    <RowDefinition Height="Auto"/> <!-- Separator Line -->
                                    <RowDefinition Height="Auto"/> <!-- Footer Status & Action -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Icon + Info & Description -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Tinted Icon Box -->
                                    <Border Grid.Column="0" 
                                            Width="38" Height="38" 
                                            CornerRadius="8" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            Margin="0,0,12,0" 
                                            VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Main Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <!-- Badges Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <!-- Category Badge -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>

                                            <!-- Risk Level Badge: Önerilen (Green) -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLevel}" Value="Önerilen">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Önerilen Koruma" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Risk Level Badge: Gelişmiş (Caution) -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLevel}" Value="Gelişmiş">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Warning16" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Gelişmiş Kural" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Risk Level Badge: İsteğe Bağlı (Accent) -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLevel}" Value="İsteğe Bağlı">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Info16" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="İsteğe Bağlı" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="13.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   TextWrapping="Wrap"/>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="11.5" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Right Toggle Switch -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" 
                                                         AutomationProperties.Name="{Binding Title}"
                                                         Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}"
                                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Interior Separator Line -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Opacity="0.5" Margin="0,10,0,8"/>

                                <!-- Row 2: Status & Details Footer -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Info16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kayıt Defteri &amp; Servis Düzeyi Müdahale • Anında Etkili" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Active State Indicator -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Checkmark16" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                                    <Setter Property="Symbol" Value="Checkmark16"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                    <Setter Property="Symbol" Value="Dismiss16"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="Koruma Aktif"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="Pasif / Açık"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- View 2: Bloatware Remover List (Solid Border Cards with Separator Lines) -->
            <ListView ItemsSource="{Binding FilteredBloatware}"
                      Visibility="{Binding IsDebloatTab, Converter={StaticResource BoolToVis}}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BloatwareAppItem}">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- App Info & Badges -->
                                    <RowDefinition Height="Auto"/> <!-- Separator Line -->
                                    <RowDefinition Height="Auto"/> <!-- Action & Status Bar -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: App Details -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icon Box -->
                                    <Border Grid.Column="0" 
                                            Width="38" Height="38" 
                                            CornerRadius="8" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            Margin="0,0,12,0" 
                                            VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Apps20" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- App Text Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                            <!-- Category Badge -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>

                                            <!-- Essential Badge -->
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}" 
                                                    BorderThickness="1" 
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsEssential, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="LockClosed16" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Temel Sistem Bileşeni" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="11.5" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Action Button / Protected State -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <!-- Protected Badge -->
                                        <Border CornerRadius="6" Padding="10,5" 
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsEssential, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="LockClosed16" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Korumalı" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Uninstall Button -->
                                        <ui:Button Appearance="Danger" 
                                                   Content="Kaldır" 
                                                   Icon="{ui:SymbolIcon Delete20}"
                                                   Command="{Binding DataContext.RemoveBloatwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                   Padding="14,6">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEssential}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>

                                        <!-- Uninstalled Badge -->
                                        <Border CornerRadius="6" Padding="10,5" 
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEssential}" Value="False"/>
                                                                <Condition Binding="{Binding IsInstalled}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Kaldırıldı" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Interior Separator Line -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Opacity="0.5" Margin="0,10,0,8"/>

                                <!-- Row 2: Package Details Footer -->
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Code20" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PackageName}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Margin="0,10,0,0" 
                Padding="12,7" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" 
                                 IsIndeterminate="True" 
                                 Width="18" Height="18" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
