<UserControl x:Class="Bakım.Views.Modules.PrivacyDebloatModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PrivacyDebloatViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Risk Level Badge Style -->
        <Style x:Key="RiskBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskLevel}" Value="Önerilen">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="İsteğe Bağlı">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="Gelişmiş">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RiskBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskLevel}" Value="Önerilen">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="İsteğe Bağlı">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="Gelişmiş">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Controls -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- Search & Filters -->
            <RowDefinition Height="*"/>    <!-- Active Content (Privacy Tweaks or Bloatware List) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
                <!-- Sayfa basligi — tasarim sistemi bileseni -->
        <c:SectionHeader Grid.Row="0"
                         IsPageTitle="True"
                         HeaderMargin="0,0,0,20"
                         Title="Gizlilik &amp; Telemetri Engelleyici"
                         Description="Microsoft telemetri, veri toplama, reklam kimliği ve gereksiz AppX bloatware optimizasyonu.">
            <c:SectionHeader.Actions>
                <!-- Sub-Tab Switcher & Action Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Sub-Tab Switcher -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                <ui:Button Content="Gizlilik &amp; Telemetri"
                Command="{Binding SwitchSubTabCommand}"
                CommandParameter="Privacy"
                Padding="14,6"
                Margin="0,0,4,0"/>
                <ui:Button Content="Bloatware Kaldırıcı"
                Command="{Binding SwitchSubTabCommand}"
                CommandParameter="Debloat"
                Padding="14,6"/>
                </StackPanel>
                </Border>

                <!-- Actions -->
                <ui:Button Appearance="Primary"
                Command="{Binding ApplyRecommendedCommand}"
                Padding="14,8"
                Margin="0,0,8,0"
                Content="Önerilenleri Koru"
                Icon="{ui:SymbolIcon ShieldCheckmark24}"/>

                <ui:Button Appearance="Secondary"
                Command="{Binding CreateRestorePointCommand}"
                Padding="12,8"
                Margin="0,0,8,0"
                Content="Geri Yükleme Noktası"
                Icon="{ui:SymbolIcon History24}"/>

                <ui:Button Appearance="Secondary"
                Command="{Binding RestoreDefaultsCommand}"
                Padding="12,8"
                Margin="0,0,8,0"
                Content="Varsayılanlara Dön"
                Icon="{ui:SymbolIcon ArrowReset24}"/>

                <ui:Button Appearance="Secondary"
                Command="{Binding RefreshAllCommand}"
                Padding="12,8"
                Content="Yenile"
                Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                </StackPanel>
            </c:SectionHeader.Actions>
        </c:SectionHeader>

        <!-- 2. Metric Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Privacy Score -->
            <ui:Card Grid.Column="0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Gizlilik Koruma Skoru" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{Binding Stats.ProtectionPercentage}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark24" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 2: Active Tweaks -->
            <ui:Card Grid.Column="2" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Aktif Koruma Kuralı" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stats.ActiveTweaksCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text=" / " FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Stats.TotalTweaksCount}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 3: Recommended Tweaks Active -->
            <ui:Card Grid.Column="4" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Önerilen Korumalar" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.RecommendedActiveCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Star24" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- Card 4: Installed Bloatware -->
            <ui:Card Grid.Column="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Yüklü Bloatware" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Stats.InstalledBloatwareCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Apps24" FontSize="24" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 3. Search & Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Category Pills for Privacy Tab -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ActiveSubTab, Converter={StaticResource StringToVis}, ConverterParameter=Privacy}">
                <ui:Button Content="Tümü" 
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="All"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Telemetri &amp; Tanılama" 
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="Telemetri &amp; Tanılama"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Reklamlar &amp; Öneriler" 
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="Reklamlar &amp; Öneriler"
                           Padding="12,6" 
                           Margin="0,0,6,0"/>
                <ui:Button Content="Konum &amp; İzinler" 
                           Command="{Binding SetCategoryFilterCommand}" 
                           CommandParameter="Konum &amp; İzinler"
                           Padding="12,6"/>
            </StackPanel>

            <!-- Bloatware Notice for Debloat Tab -->
            <TextBlock Grid.Column="0" 
                       Text="Sistem kararlılığı için temel hesap makinesi ve mağaza uygulamaları korumalıdır." 
                       FontSize="12" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       VerticalAlignment="Center"
                       Visibility="{Binding ActiveSubTab, Converter={StaticResource StringToVis}, ConverterParameter=Debloat}"/>

            <!-- Search Input Box -->
            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Gizlilik kuralı veya uygulama ara..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        VerticalContentAlignment="Center"
                        Padding="12,8"
                        MinWidth="220"
                        MaxWidth="360" AutomationProperties.Name="Gizlilik kuralı veya uygulama ara..."/>
        </Grid>

        <!-- 4. Active Content Area -->
        <Grid Grid.Row="3">
            <!-- View 1: Privacy Tweaks List -->
            <ListView ItemsSource="{Binding FilteredTweaks}"
                      Visibility="{Binding ActiveSubTab, Converter={StaticResource StringToVis}, ConverterParameter=Privacy}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PrivacyTweakItem}">
                        <ui:Card Padding="18,14" Margin="0,0,0,8" ClipToBounds="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Details -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <!-- Badges Row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <!-- Category Badge -->
                                        <Border CornerRadius="4" Padding="8,2" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                Margin="0,0,8,0"
                                                Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <!-- Risk Level Badge -->
                                        <Border Style="{StaticResource RiskBadgeStyle}"
                                                Visibility="{Binding RiskLevel, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource RiskBadgeTextStyle}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                               TextWrapping="Wrap"/>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Right Toggle Switch -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" AutomationProperties.Name="{Binding Title}"
                                                     Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- View 2: Bloatware Remover List -->
            <ListView ItemsSource="{Binding FilteredBloatware}"
                      Visibility="{Binding ActiveSubTab, Converter={StaticResource StringToVis}, ConverterParameter=Debloat}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BloatwareAppItem}">
                        <ui:Card Padding="18,14" Margin="0,0,0,8" ClipToBounds="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Icon -->
                                <Border Grid.Column="0" 
                                        Width="34" Height="34" 
                                        CornerRadius="8" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" 
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <!-- App Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <Border CornerRadius="4" Padding="6,2" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                Margin="10,0,0,0"
                                                Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <!-- Essential Badge if applicable -->
                                        <Border CornerRadius="4" Padding="6,2" 
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" 
                                                BorderThickness="1" 
                                                Margin="6,0,0,0"
                                                Visibility="{Binding IsEssential, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Temel Sistem Bileşeni" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Package Name -->
                                    <TextBlock Text="{Binding PackageName}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               Margin="0,2,0,0"/>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons / Status -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <!-- When App is Essential -->
                                    <Border CornerRadius="6" Padding="10,6" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding IsEssential, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldKeyhole20" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Korumalı" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- When App is Not Essential and Installed -->
                                    <ui:Button Appearance="Danger" 
                                               Content="Kaldır" 
                                               Icon="{ui:SymbolIcon Delete20}"
                                               Command="{Binding DataContext.RemoveBloatwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEssential}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <!-- When App has been Uninstalled -->
                                    <Border CornerRadius="6" Padding="10,6" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEssential}" Value="False"/>
                                                            <Condition Binding="{Binding IsInstalled}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Kaldırıldı" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 5. Bottom Status Bar -->
        <Border Grid.Row="4" 
                Margin="0,12,0,0" 
                Padding="12,8" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" 
                                 IsIndeterminate="True" 
                                 Width="18" Height="18" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
