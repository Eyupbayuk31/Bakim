<UserControl x:Class="Bakım.Views.Modules.NetworkSpeedTestPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Bakım.Helpers"
             xmlns:c="clr-namespace:Bakım.Controls"
             xmlns:vm="clr-namespace:Bakım.ViewModels"
             xmlns:models="clr-namespace:Bakım.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkMonitorViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <!-- Ağ İzleyici › Hız testi -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch">
                <!-- Tarifeli bağlantı uyarısı -->
                <ui:InfoBar Severity="Warning" IsOpen="{Binding IsMeteredConnection, Mode=OneWay}" IsClosable="False"
                            Title="Tarifeli bağlantı"
                            Message="Test yaklaşık 50–100 MB veri kullanır. Başlatmadan önce onayınız istenir."
                            Margin="{StaticResource Gap.Bottom.MD}"/>

                <!-- Main Speed Gauge Card -->
                <Border Style="{StaticResource Card.Surface}" Margin="{StaticResource Gap.Bottom.MD}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title & Intro -->
                            <RowDefinition Height="Auto"/> <!-- Big Speed Display -->
                            <RowDefinition Height="Auto"/> <!-- Progress Bar -->
                            <RowDefinition Height="Auto"/> <!-- 4-KPI Metric Badges -->
                            <RowDefinition Height="Auto"/> <!-- Actions -->
                        </Grid.RowDefinitions>

                        <!-- Big Speed Display -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSpeedMbps, StringFormat='{}{0:F1}'}" FontSize="64" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Mbps" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeedTestStatus}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Progress Bar -->
                        <Grid Grid.Row="2" Margin="40,0,40,24">
                            <ProgressBar Value="{Binding SpeedProgressPercent}" Maximum="100" Height="4"/>
                        </Grid>

                        <!-- 4-KPI Metric Badges -->
                        <Grid Grid.Row="3" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KPI 1: Ping -->
                            <Border Grid.Column="0" Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Gecikme" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding SpeedPingMs, StringFormat='{}{0:F1} ms'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 2: Jitter -->
                            <Border Grid.Column="2" Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Dalgalanma" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding SpeedJitterMs, StringFormat='{}{0:F1} ms'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 3: Peak Speed -->
                            <Border Grid.Column="4" Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="En yüksek hız" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding PeakSpeedMbps, StringFormat='{}{0:F1} Mbps'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 4: Downloaded Data -->
                            <Border Grid.Column="6" Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="İndirilen veri" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding DownloadedMb, StringFormat='{}{0:F1} MB'}" FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Primary" 
                                       Padding="24,12" 
                                       Margin="0,0,12,0" 
                                       Command="{Binding StartSpeedTestCommand}" 
                                       IsEnabled="{Binding IsSpeedTestRunning, Converter={StaticResource InverseBool}}"
                                       Content="Testi başlat" 
                                       Icon="{ui:SymbolIcon Play24}"/>

                            <ui:Button Appearance="Secondary" 
                                       Padding="20,12" 
                                       Command="{Binding CancelSpeedTestCommand}" 
                                       IsEnabled="{Binding IsSpeedTestRunning}"
                                       Content="İptal" 
                                       Icon="{ui:SymbolIcon Dismiss24}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Test üç paralel bağlantıyla yaklaşık 6 saniye boyunca veri indirir ve ortalama hızı ölçer. Sonuç; tarayıcı, VPN ve arka plan indirmelerinden etkilenebilir."
                           FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
