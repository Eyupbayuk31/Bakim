<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BakimShell</AssemblyName>
    <Version>$(BakimVersion)</Version>
    <AssemblyVersion>$(BakimVersion).0</AssemblyVersion>
    <FileVersion>$(BakimVersion).0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Core\Shell\ShellTargetParser.cs" Link="ShellTargetParser.cs" />
  </ItemGroup>

</Project>
