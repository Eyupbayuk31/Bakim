<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Light Theme Brushes -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="#E0E7FF"/>

    <SolidColorBrush x:Key="Brush.Card.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#475569"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#94A3B8"/>

    <SolidColorBrush x:Key="Brush.Primary" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Primary.Active" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.Primary.Foreground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#0284C7"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#059669"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.Danger.Background" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#991B1B"/>

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.Input.Border.Focus" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Input.Foreground" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Input.Caret" Color="#2563EB"/>

    <SolidColorBrush x:Key="Brush.Badge.Background" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Badge.Border" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="Brush.Nav.Active" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#F1F5F9"/>

</ResourceDictionary>
