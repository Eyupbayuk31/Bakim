<!--
    DÜZEN v2 BİLEŞENLERİ (docs/FLUENT_DUZEN_PLANI.md §2.5)
    ======================================================
    c:ModulePage   Sayfa kabuğu: başlık 28, alt başlık, eylemler, sekmeler, komut satırı, içerik, alt çubuk.
    c:Section      Bölüm: başlık 20 kartın DIŞINDA, sağda bağlantı; bölümler arası 28.
    c:CardHeader   Kart başlık satırı: 16 simge + 14 SemiBold + sağ öğe.
    c:AdaptiveGrid Duyarlı ızgara (C#): eşit yükseklikte satırlar, aralık 12.
    c:MetricTile   Metrik kutucuğu: 136 px, etiket / büyük değer / tek satır bilgi / isteğe bağlı grafik.
    c:ListCard     Tek kart içinde ayırıcılı satırlar (c:ListRow).
    c:StatusGlyph  Renkli simge + metin (dolgu yok).
    c:SelectionBar Alt seçim çubuğu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:c="clr-namespace:Bakım.Controls"
                    xmlns:m="clr-namespace:Bakım.Models"
                    xmlns:conv="clr-namespace:Bakım.Converters"
                    xmlns:helpers="clr-namespace:Bakım.Helpers">

    <conv:SafeSymbolConverter x:Key="Layout.SafeSymbol"/>
    <conv:StringToVisConverter x:Key="Layout.StringToVis"/>
    <BooleanToVisibilityConverter x:Key="Layout.BoolToVis"/>

    <!-- ============ SAYFA ============ -->
    <Style TargetType="{x:Type c:ModulePage}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Page}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ModulePage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="PART_Scroll" Grid.Row="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      PanningMode="VerticalOnly"
                                      Focusable="False">
                            <Grid Margin="{TemplateBinding Padding}"
                                  MaxWidth="{TemplateBinding MaxContentWidth}"
                                  HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Başlık -->
                                    <RowDefinition Height="Auto"/> <!-- Sekmeler -->
                                    <RowDefinition Height="Auto"/> <!-- Komut satırı -->
                                    <RowDefinition x:Name="ContentRow" Height="Auto"/> <!-- İçerik -->
                                </Grid.RowDefinitions>

                                <!-- Başlık + eylemler -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   FontSize="{StaticResource Font.TitleLarge}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{TemplateBinding Subtitle}"
                                                   FontSize="{StaticResource Font.Body}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                                                   Margin="0,4,0,0"
                                                   Visibility="{TemplateBinding Subtitle, Converter={StaticResource Layout.StringToVis}}"/>
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}"
                                                      VerticalAlignment="Center" Margin="24,0,0,0"/>
                                </Grid>

                                <ContentPresenter Grid.Row="1" x:Name="TabsHost" Content="{TemplateBinding Tabs}" Margin="0,-8,0,16"/>
                                <ContentPresenter Grid.Row="2" x:Name="ToolbarHost" Content="{TemplateBinding Toolbar}" Margin="0,0,0,16"/>
                                <ContentPresenter Grid.Row="3" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Grid>
                        </ScrollViewer>
                        <ContentPresenter Grid.Row="1" Content="{TemplateBinding Footer}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tabs" Value="{x:Null}">
                            <Setter TargetName="TabsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Toolbar" Value="{x:Null}">
                            <Setter TargetName="ToolbarHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Kendi listesi kayan sayfa: içerik kalan yüksekliği doldurur -->
                        <Trigger Property="IsScrollable" Value="False">
                            <Setter TargetName="PART_Scroll" Property="VerticalScrollBarVisibility" Value="Disabled"/>
                            <Setter TargetName="ContentRow" Property="Height" Value="*"/>
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter Property="Padding" Value="{StaticResource Pad.Page.Compact}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ BÖLÜM ============ -->
    <Style TargetType="{x:Type c:Section}">
        <Setter Property="Margin" Value="{StaticResource Gap.Section}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Section}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12" x:Name="HeaderRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="{StaticResource Font.SectionTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{TemplateBinding Description}"
                                           FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                                           Visibility="{TemplateBinding Description, Converter={StaticResource Layout.StringToVis}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Trailing}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <ContentPresenter/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFirst" Value="True">
                <Setter Property="Margin" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bölüm/kart sağındaki metin bağlantısı ("Tümünü gör ›") -->
    <Style x:Key="Link.Button" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ============ KART BAŞLIĞI ============ -->
    <Style TargetType="{x:Type c:CardHeader}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:CardHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="IconPart" Grid.Column="0" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Symbol="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Layout.SafeSymbol}}"/>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Body}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding Trailing}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ METRİK KUTUCUĞU ============ -->
    <Style TargetType="{x:Type c:MetricTile}">
        <Setter Property="Height" Value="{StaticResource Layout.TileHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.CardCompact}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Thin}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MetricTile}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.MD}"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Grafik: alt kenara yaslı, kartın iç boşluğunu yok sayar -->
                            <ContentPresenter VerticalAlignment="Bottom" Height="44" Margin="0,0,0,0"/>
                            <StackPanel Margin="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="IconPart" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Symbol="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Layout.SafeSymbol}}"/>
                                    <TextBlock Text="{TemplateBinding Label}" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="ValuePart" Text="{TemplateBinding Value}"
                                               FontSize="{StaticResource Font.TitleLarge}" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{TemplateBinding Unit}" FontSize="{StaticResource Font.Body}" Margin="6,0,0,5"
                                               VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding Caption}" FontSize="{StaticResource Font.Caption}" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Intent" Value="{x:Static m:Intent.Caution}">
                            <Setter TargetName="ValuePart" Property="Foreground" Value="{DynamicResource Status.Caution.Text}"/>
                        </Trigger>
                        <Trigger Property="Intent" Value="{x:Static m:Intent.Critical}">
                            <Setter TargetName="ValuePart" Property="Foreground" Value="{DynamicResource Status.Critical.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ DURUM İŞARETİ ============ -->
    <Style TargetType="{x:Type c:StatusGlyph}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StatusGlyph}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="Glyph" Symbol="Circle16" Filled="True" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="Label" Text="{TemplateBinding Text}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Intent" Value="{x:Static m:Intent.Success}">
                            <Setter TargetName="Glyph" Property="Symbol" Value="CheckmarkCircle16"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="Intent" Value="{x:Static m:Intent.Caution}">
                            <Setter TargetName="Glyph" Property="Symbol" Value="Warning16"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                        </Trigger>
                        <Trigger Property="Intent" Value="{x:Static m:Intent.Critical}">
                            <Setter TargetName="Glyph" Property="Symbol" Value="ErrorCircle16"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                        </Trigger>
                        <Trigger Property="Intent" Value="{x:Static m:Intent.Accent}">
                            <Setter TargetName="Glyph" Property="Symbol" Value="Info16"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ LİSTE KARTI ============ -->
    <Style TargetType="{x:Type c:ListCard}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ListCard}">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="{StaticResource Stroke.Thin}"
                            CornerRadius="{StaticResource Radius.MD}">
                        <DockPanel>
                            <c:CardHeader x:Name="HeaderPart" DockPanel.Dock="Top" Margin="16,10,12,6"
                                          Title="{TemplateBinding Header}" Icon="{TemplateBinding HeaderIcon}"
                                          Trailing="{TemplateBinding HeaderTrailing}"/>
                            <Grid>
                                <ItemsPresenter x:Name="Items"/>
                                <ContentPresenter x:Name="EmptyPart" Content="{TemplateBinding EmptyContent}" Visibility="Collapsed" Margin="16"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEmpty" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="EmptyPart" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:ListCardItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="16,0,12,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ListCardItem}">
                    <Border x:Name="Row" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDivider" Value="False">
                            <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:ListRow}">
        <Setter Property="MinHeight" Value="{StaticResource Layout.RowHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ListRow}">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" x:Name="LeadingPart" Margin="0,0,14,0" VerticalAlignment="Center" MinWidth="20">
                            <ui:SymbolIcon x:Name="IconPart" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Symbol="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Layout.SafeSymbol}}"/>
                            <ContentPresenter x:Name="LeadingContent" Content="{TemplateBinding Leading}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="{StaticResource Font.Body}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SubtitlePart" Text="{TemplateBinding Subtitle}" FontSize="{StaticResource Font.Caption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="MetaPart" Text="{TemplateBinding Meta}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="{StaticResource Font.Body}" Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ContentPresenter Grid.Column="3" Content="{TemplateBinding Trailing}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitlePart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Meta" Value="">
                            <Setter TargetName="MetaPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value=""/>
                                <Condition Property="Leading" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeadingPart" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SEÇİM ÇUBUĞU ============ -->
    <Style TargetType="{x:Type c:SelectionBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SelectionBar}">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            Padding="36,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Summary}" VerticalAlignment="Center"
                                       FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TEMA ÖNİZLEMESİ ============ -->
    <!-- Önizleme renkleri diğer temaları temsil eder; bu yüzden sabittir (etkin temadan bağımsız). -->
    <SolidColorBrush x:Key="Preview.Dark.Window" Color="#202020"/>
    <SolidColorBrush x:Key="Preview.Dark.Card" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Preview.Dark.Text" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Preview.Dark.Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Preview.Light.Window" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Preview.Light.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Preview.Light.Text" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Preview.Light.Accent" Color="#005FB8"/>
    <SolidColorBrush x:Key="Preview.Slate.Window" Color="#0B1220"/>
    <SolidColorBrush x:Key="Preview.Slate.Card" Color="#18233A"/>
    <SolidColorBrush x:Key="Preview.Slate.Text" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Preview.Slate.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Preview.Amoled.Window" Color="#000000"/>
    <SolidColorBrush x:Key="Preview.Amoled.Card" Color="#121216"/>
    <SolidColorBrush x:Key="Preview.Amoled.Text" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="Preview.Amoled.Accent" Color="#9333EA"/>
    <SolidColorBrush x:Key="Preview.Neon.Window" Color="#090514"/>
    <SolidColorBrush x:Key="Preview.Neon.Card" Color="#180F30"/>
    <SolidColorBrush x:Key="Preview.Neon.Text" Color="#DDD6FE"/>
    <SolidColorBrush x:Key="Preview.Neon.Accent" Color="#8B5CF6"/>

    <Style TargetType="{x:Type c:ThemePreview}">
        <Setter Property="Height" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ThemePreview}">
                    <Border Background="{TemplateBinding WindowBrush}" CornerRadius="{StaticResource Radius.XS}" ClipToBounds="True">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Kenar çubuğu çizgileri -->
                            <StackPanel Grid.Column="0" Margin="0,4,6,0">
                                <Border Height="3" CornerRadius="{StaticResource Radius.Indicator}" Background="{TemplateBinding AccentBrush}" Margin="0,0,0,5"/>
                                <Border Height="3" CornerRadius="{StaticResource Radius.Indicator}" Background="{TemplateBinding TextBrush}" Opacity="0.5" Margin="0,0,0,5"/>
                                <Border Height="3" CornerRadius="{StaticResource Radius.Indicator}" Background="{TemplateBinding TextBrush}" Opacity="0.5"/>
                            </StackPanel>
                            <!-- Kart -->
                            <Border Grid.Column="1" Background="{TemplateBinding CardBrush}" CornerRadius="{StaticResource Radius.XS}" Padding="8">
                                <StackPanel>
                                    <Border Height="4" Width="44" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.Indicator}" Background="{TemplateBinding TextBrush}"/>
                                    <Border Height="3" Width="64" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.Indicator}" Background="{TemplateBinding TextBrush}" Opacity="0.5" Margin="0,6,0,0"/>
                                    <Border Height="10" Width="28" HorizontalAlignment="Right" CornerRadius="{StaticResource Radius.XS}" Background="{TemplateBinding AccentBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tema kutucuğu: önizleme + ad; seçili olanda 2 px vurgu çerçevesi -->
    <Style x:Key="Theme.Tile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.MD}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{StaticResource Stroke.Thin}" Padding="8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="helpers:NavSelection.IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Frame" Property="Padding" Value="7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
