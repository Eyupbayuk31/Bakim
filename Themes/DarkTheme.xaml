<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Dark Theme Brushes -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#273549"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="#1E3A5F"/>

    <SolidColorBrush x:Key="Brush.Card.Background" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#334155"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#64748B"/>

    <SolidColorBrush x:Key="Brush.Primary" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Primary.Active" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.Primary.Foreground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#38BDF8"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#10B981"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.Danger.Background" Color="#451A1A"/>
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FCA5A5"/>

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Input.Border.Focus" Color="#38BDF8"/>
    <SolidColorBrush x:Key="Brush.Input.Foreground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Input.Caret" Color="#38BDF8"/>

    <SolidColorBrush x:Key="Brush.Badge.Background" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Badge.Border" Color="#475569"/>

    <SolidColorBrush x:Key="Brush.Nav.Active" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#273549"/>

</ResourceDictionary>
