<!--
    TİPOGRAFİ ÖLÇEĞİ
    ================
    Kod tabanında 22 farklı serbest FontSize değeri vardı (9, 10, 10.5, 11, 11.5, 12, 12.5 ...).
    Bu sözlük onları adlandırılmış bir ölçeğe indirger.

    İki ayrı ölçek bilinçlidir:
      • Font.*  → metin boyutları (TextBlock, Button içeriği)
      • Icon.*  → simge boyutları (ui:SymbolIcon)
    Sayısal değerleri şu an çakışsa da anlamları farklıdır; simge ölçeği metinden
    bağımsız değiştirilebilmelidir.

    Kullanım:  FontSize="{StaticResource Font.Body}"
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ METİN ÖLÇEĞİ (Windows 11 Fluent tip rampası) ============ -->
    <!-- Fluent: Caption 12 · Body 14 · Body Strong 14 SB · Body Large 18 · Subtitle 20 SB ·
         Title 28 SB · Title Large 40 SB · Display 68 SB. Anahtar adları geriye uyum için korunur;
         değerler rampaya oturtulmuştur. Kalın (Bold) kullanılmaz, vurgu SemiBold'dur.
         11 yalnızca rozet/InfoBadge (Font.Micro) içindir. -->
    <!-- Sabit FontSize yerine bu anahtarlar kullanılır: Tools/migrate-font-sizes.py -->

    <!-- Yardımcı etiketler, rozet alt yazıları -->
    <sys:Double x:Key="Font.Micro">11</sys:Double>

    <!-- İkincil bilgi, meta veri, tablo alt satırı (en yaygın) -->
    <sys:Double x:Key="Font.Caption">12</sys:Double>

    <!-- Gövde metni, açıklama satırları -->
    <sys:Double x:Key="Font.Body">14</sys:Double>

    <!-- Vurgulu gövde, liste öğesi başlığı (Fluent Body Strong boyutu; SemiBold ile kullanılır) -->
    <sys:Double x:Key="Font.BodyLarge">14</sys:Double>

    <!-- Kart içi alt başlık (Fluent Body Large) -->
    <sys:Double x:Key="Font.Subtitle">18</sys:Double>

    <!-- Kart / bölüm başlığı (Fluent Subtitle) -->
    <sys:Double x:Key="Font.SectionTitle">20</sys:Double>

    <!-- Büyük değer / öne çıkan başlık (Fluent Subtitle) -->
    <sys:Double x:Key="Font.Title">20</sys:Double>

    <!-- Sayfa başlığı (Fluent Title) -->
    <sys:Double x:Key="Font.TitleLarge">28</sys:Double>

    <!-- KPI sayıları, sağlık skoru (Fluent Title Large) -->
    <sys:Double x:Key="Font.Display">40</sys:Double>

    <!-- ============ SİMGE ÖLÇEĞİ (Fluent System Icons: 12/16/20/24/32) ============ -->

    <sys:Double x:Key="Icon.XS">12</sys:Double>
    <sys:Double x:Key="Icon.SM">16</sys:Double>
    <sys:Double x:Key="Icon.MD">16</sys:Double>
    <sys:Double x:Key="Icon.LG">20</sys:Double>
    <sys:Double x:Key="Icon.XL">24</sys:Double>
    <sys:Double x:Key="Icon.XXL">32</sys:Double>

    <!-- ============ HAZIR METİN STİLLERİ ============ -->
    <!-- Renk DynamicResource ile bağlanır: tema değişince metin de değişir. -->

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.TitleLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.SectionTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Micro}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <Style x:Key="Text.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.BodyLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- İkincil gövde metni. ("Text.Secondary" fırça anahtarıdır; stil adı çakışmasın.) -->
    <Style x:Key="Text.BodySecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Kenar çubuğu grup başlığı (Fluent NavigationViewItemHeader): Body Strong, büyük harf yok. -->
    <Style x:Key="Text.NavGroup" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- KPI ve skor: sabit genişlikli rakamlar, sayılar güncellenirken kaymaz. -->
    <Style x:Key="Text.KPI" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

</ResourceDictionary>
