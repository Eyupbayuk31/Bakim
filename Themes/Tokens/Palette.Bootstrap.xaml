    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#272727"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#404040"/>

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#323232"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#323232"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#282828"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3D3D3D"/>

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF"/>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9B9B9B"/>

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#99EBFF"/>
