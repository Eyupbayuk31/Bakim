    <SolidColorBrush x:Key="Brush.Card.Border" Color="#404040"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#CFCFCF"/>
