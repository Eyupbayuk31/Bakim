<!--
    AÇILIŞ / TASARIM ZAMANI PALETİ
    ===============================
    DİKKAT: Renklerin TEK GERÇEK KAYNAĞI Services/ThemeService.cs'tir.
    Bu sözlük yalnızca iki durum içindir:
      1) Visual Studio XAML tasarımcısı (ThemeService çalışmaz, kontroller renksiz görünürdü)
      2) ThemeService.RestorePersistedTheme() çağrılmadan önceki ilk milisaniyeler

    Değerler MicaDark (varsayılan tema) ile aynıdır. Yeni bir anlamsal anahtar
    eklerken ThemeService'e eklemek zorunludur; buraya eklemek isteğe bağlıdır.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ WPF-UI ANLAMSAL FIRÇALARI ============ -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0F172A"/>

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#172033"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#334155"/>

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#273549"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#273549"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3A4A63"/>

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#273549"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1B2637"/>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#56CCF8"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2563EB"/>

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F87171"/>

    <!-- ============ YEREL ANLAMSAL FIRÇALAR ============ -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#273549"/>
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#56CCF8"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Input.Border.Focus" Color="#56CCF8"/>
    <SolidColorBrush x:Key="Brush.Input.Foreground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Badge.Background" Color="#273549"/>
    <SolidColorBrush x:Key="Brush.Badge.Border" Color="#3A4A63"/>
    <SolidColorBrush x:Key="Brush.Nav.Active" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#273549"/>

    <!-- ============ TONLU (SUBTLE) ZEMİNLER ============ -->
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#2256CCF8"/>
    <SolidColorBrush x:Key="Brush.Primary.Subtle" Color="#222563EB"/>
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#2234D399"/>
    <SolidColorBrush x:Key="Brush.Caution.Subtle" Color="#22FBBF24"/>
    <SolidColorBrush x:Key="Brush.Critical.Subtle" Color="#25F87171"/>
    <SolidColorBrush x:Key="Brush.Muted.Subtle" Color="#1A94A3B8"/>
    <SolidColorBrush x:Key="Brush.Danger.Background" Color="#25F87171"/>

    <!-- ============ TONLU ZEMİN ÜZERİ METİN ============ -->
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#80E4C1"/>
    <SolidColorBrush x:Key="Brush.Caution.Text" Color="#FDD56F"/>
    <SolidColorBrush x:Key="Brush.Critical.Text" Color="#FBACAC"/>
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FBACAC"/>

    <!-- ============ KAPLAMA & PARILTI ============ -->
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D00F172A"/>
    <SolidColorBrush x:Key="Brush.Glow.Strong" Color="#FF56CCF8"/>
    <SolidColorBrush x:Key="Brush.Glow.Medium" Color="#CC56CCF8"/>
    <SolidColorBrush x:Key="Brush.Glow.Soft" Color="#6656CCF8"/>

    <!-- ============ HAM RENKLER (Gradient & Gölge) ============ -->
    <Color x:Key="Color.Window.Background">#0F172A</Color>
    <Color x:Key="Color.Surface">#1E293B</Color>
    <Color x:Key="Color.Surface.Alt">#172033</Color>
    <Color x:Key="Color.Border">#334155</Color>
    <Color x:Key="Color.Control">#273549</Color>
    <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
    <Color x:Key="Color.Text.Secondary">#CBD5E1</Color>
    <Color x:Key="Color.Text.Tertiary">#94A3B8</Color>
    <Color x:Key="Color.Accent">#56CCF8</Color>
    <Color x:Key="Color.Primary">#2563EB</Color>
    <Color x:Key="Color.Success">#34D399</Color>
    <Color x:Key="Color.Caution">#FBBF24</Color>
    <Color x:Key="Color.Critical">#F87171</Color>
    <Color x:Key="Color.Critical.Text">#FBACAC</Color>
    <Color x:Key="Color.Accent.Transparent">#0056CCF8</Color>
    <Color x:Key="Color.Accent.Glow">#CC56CCF8</Color>
    <Color x:Key="Color.Success.Transparent">#0034D399</Color>
    <Color x:Key="Color.Surface.Transparent">#001E293B</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

</ResourceDictionary>
