    <SolidColorBrush x:Key="Brush.Danger.Background" Color="#25FF99A4"/>

    <!-- ============ TONLU ZEMİN ÜZERİ METİN ============ -->
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#AEE2A7"/>
    <SolidColorBrush x:Key="Brush.Caution.Text" Color="#FDEE73"/>
    <SolidColorBrush x:Key="Brush.Critical.Text" Color="#FFC7CD"/>
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FFC7CD"/>

    <!-- ============ KAPLAMA & PARILTI ============ -->
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D0202020"/>
    <SolidColorBrush x:Key="Brush.Glow.Strong" Color="#99EBFF"/>
    <SolidColorBrush x:Key="Brush.Glow.Medium" Color="#CC99EBFF"/>
    <SolidColorBrush x:Key="Brush.Glow.Soft" Color="#6699EBFF"/>

    <!-- ============ HAM RENKLER (Gradient & Gölge) ============ -->
    <Color x:Key="Color.Window.Background">#202020</Color>
    <Color x:Key="Color.Surface">#2B2B2B</Color>
