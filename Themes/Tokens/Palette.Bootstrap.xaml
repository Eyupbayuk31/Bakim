    <Color x:Key="Color.Primary">#60CDFF</Color>
    <Color x:Key="Color.Success">#6CCB5F</Color>
    <Color x:Key="Color.Caution">#FCE100</Color>
    <Color x:Key="Color.Critical">#FF99A4</Color>
    <Color x:Key="Color.Critical.Text">#FFC7CD</Color>
    <Color x:Key="Color.Accent.Transparent">#0099EBFF</Color>
    <Color x:Key="Color.Accent.Glow">#CC99EBFF</Color>
    <Color x:Key="Color.Success.Transparent">#006CCB5F</Color>
    <Color x:Key="Color.Surface.Transparent">#002B2B2B</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

